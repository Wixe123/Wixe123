# Copy to .env and fill in. See README.md for how to obtain each value.

# --- App ---
ENV=development
SECRET_KEY=replace-with-a-random-string
FERNET_KEY=replace-with-output-of: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FRONTEND_URL=http://localhost:3000

# --- Database / broker (docker-compose overrides these to the internal hostnames) ---
DATABASE_URL=postgresql+psycopg2://shortsforge:shortsforge@localhost:5432/shortsforge
REDIS_URL=redis://localhost:6379/0

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# Enable "YouTube Data API v3" on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/auth/youtube/callback

# --- Optional: use Claude for title/description/hashtag generation instead of the template fallback ---
ANTHROPIC_API_KEY=

# --- Optional: fixes "Please sign in" / bot-check errors when importing from a YouTube URL ---
# Export your browser's YouTube cookies to secrets/youtube_cookies.txt (see README), then uncomment:
# YTDLP_COOKIES_FILE=/secrets/youtube_cookies.txt

# --- Media pipeline ---
STORAGE_ROOT=/data
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
CELERY_CONCURRENCY=2
