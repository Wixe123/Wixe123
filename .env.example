# CreatorAI UGC Studio — environment variables
#
# The app runs fully in demo mode with none of these set: every AI call in
# lib/ai/engine.ts and the app/api/* routes falls back to a realistic mock.
# Set any of these to route that capability to the real provider instead.

# --- AI / generation providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
RUNWAY_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Data & storage ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_URL=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Integrations ---
TIKTOK_CLIENT_KEY=
META_APP_ID=
META_APP_SECRET=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SLACK_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
