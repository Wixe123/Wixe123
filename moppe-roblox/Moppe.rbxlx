<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="Workspace" referent="RBX1"><Properties><string name="Name">Workspace</string></Properties></Item>
<Item class="Lighting" referent="RBX2"><Properties><string name="Name">Lighting</string></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX11"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX10"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Builder</string><ProtectedString name="Source"><![CDATA[-- Builds the mopeds and the shop's part previews from Roblox parts.
-- Dimensions are written in metres and converted to studs (Config.STUD). Forward = -Z (Roblox LookVector), up = +Y, right = +X.
local Config = require(script.Parent.Config)
local Builder = {}
local S = 1 / Config.STUD -- studs per metre

local MAT = {
	paint = Enum.Material.SmoothPlastic, metal = Enum.Material.Metal, chrome = Enum.Material.Metal, rubber = Enum.Material.SmoothPlastic,
	plastic = Enum.Material.SmoothPlastic, neon = Enum.Material.Neon, glass = Enum.Material.Glass, alu = Enum.Material.DiamondPlate, fabric = Enum.Material.Fabric,
}
local C = {
	tire = Color3.fromRGB(22, 23, 25), dark = Color3.fromRGB(35, 37, 41), black = Color3.fromRGB(18, 18, 20), chrome = Color3.fromRGB(235, 238, 242),
	alu = Color3.fromRGB(190, 195, 202), eng = Color3.fromRGB(150, 155, 162), white = Color3.fromRGB(240, 240, 236), lamp = Color3.fromRGB(255, 238, 190),
	red = Color3.fromRGB(190, 25, 35), amber = Color3.fromRGB(255, 154, 26), carbon = Color3.fromRGB(30, 32, 36), gold = Color3.fromRGB(212, 168, 58),
}
Builder.C = C

-- small helper that adds parts to a model, welded to a root
local function maker(model, root)
	local K = {}
	function K.part(name, shape, sizeM, cf, color, material, refl)
		local p = Instance.new("Part")
		p.Name = name
		if shape == "cyl" then p.Shape = Enum.PartType.Cylinder elseif shape == "ball" then p.Shape = Enum.PartType.Ball end
		p.Size = Vector3.new(math.max(0.05, sizeM.X * S), math.max(0.05, sizeM.Y * S), math.max(0.05, sizeM.Z * S))
		p.CFrame = cf
		p.Color = color
		p.Material = material or MAT.plastic
		p.Reflectance = refl or 0
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.Anchored = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		if root then
			local w = Instance.new("WeldConstraint")
			w.Part0, w.Part1 = root, p
			w.Parent = p
		end
		return p
	end
	function K.wedge(name, sizeM, cf, color, material, refl)
		local p = K.part(name, "box", sizeM, cf, color, material, refl)
		local w = Instance.new("WedgePart")
		for _, prop in ipairs({ "Name", "Size", "CFrame", "Color", "Material", "Reflectance", "CanCollide", "CanTouch", "CanQuery", "Massless", "Anchored" }) do w[prop] = p[prop] end
		w.Parent = model
		p:Destroy()
		if root then local wc = Instance.new("WeldConstraint"); wc.Part0, wc.Part1 = root, w; wc.Parent = w end
		return w
	end
	-- metre coordinates (x right, y up, z forward like the web version) -> CFrame in the model's space
	function K.at(x, y, z) return CFrame.new(x * S, y * S, -z * S) end
	-- tube (cylinder) between two points in metres
	function K.tube(name, a, b, r, color, material, refl)
		local A, B = Vector3.new(a[1] * S, a[2] * S, -a[3] * S), Vector3.new(b[1] * S, b[2] * S, -b[3] * S)
		local len = (B - A).Magnitude / S
		if len < 0.001 then return nil end
		local cf = CFrame.lookAt((A + B) / 2, B) * CFrame.Angles(0, math.pi / 2, 0)
		return K.part(name, "cyl", Vector3.new(len, r * 2, r * 2), cf, color, material, refl)
	end
	-- part the client rotates (wheel spokes): Weld instead of WeldConstraint so C0 can be changed
	function K.spin(name, sizeM, cf, color, material, refl)
		local p = K.part(name, "box", sizeM, cf, color, material, refl)
		for _, c in ipairs(p:GetChildren()) do if c:IsA("WeldConstraint") then c:Destroy() end end
		local w = Instance.new("Weld")
		w.Name = "SpinWeld"
		w.Part0, w.Part1 = root, p
		w.C0 = root.CFrame:Inverse() * p.CFrame
		w.Parent = p
		return w
	end
	-- attachment on the root in metre coordinates (for lights and smoke)
	function K.attach(name, x, y, z)
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = root.CFrame:PointToObjectSpace(Vector3.new(x * S, y * S, -z * S))
		a.Parent = root
		return a
	end
	function K.box(name, w, h, d, x, y, z, color, material, refl, rx)
		return K.part(name, "box", Vector3.new(w, h, d), K.at(x, y, z) * CFrame.Angles(rx or 0, 0, 0), color, material, refl)
	end
	return K
end
Builder.maker = maker

local function rimLook(E, rimColor)
	if E.rims == "pol" then return C.chrome, MAT.chrome, 0.45 end
	if E.rims == "gold" then return C.gold, MAT.metal, 0.25 end
	return rimColor, MAT.metal, 0.1
end

-- wheel: tyre (collides with the ground) + rim + hub. Returns the tyre (collision) and a spinning group part.
local function wheel(K, name, wr, z, width, E, look)
	local tyre = K.part(name, "cyl", Vector3.new(width, wr * 2, wr * 2), K.at(0, wr, z), C.tire, MAT.rubber)
	tyre.CanCollide = true
	tyre.CanQuery = true
	tyre.Massless = false
	tyre.CustomPhysicalProperties = PhysicalProperties.new(3, 0.05, 0, 1, 1) -- slides on the ground, the controller decides speed
	local rc, rm, rr = rimLook(E, look.rim or C.alu)
	K.part(name .. "Rim", "cyl", Vector3.new(width * 1.05, wr * 1.25, wr * 1.25), K.at(0, wr, z), rc, rm, rr)
	K.part(name .. "Hub", "cyl", Vector3.new(width * 1.2, wr * 0.35, wr * 0.35), K.at(0, wr, z), C.alu, MAT.metal, 0.2)
	-- spokes as a separate part the client rotates (visual only)
	local spins = {}
	for i = 0, 2 do
		table.insert(spins, K.spin(name .. "Spoke", Vector3.new(width * 1.1, wr * 1.2, 0.025), K.at(0, wr, z) * CFrame.Angles(i * math.pi / 3, 0, 0), rc, rm, rr))
	end
	return tyre, spins
end

local function paintMat(look)
	local f = look.fin or "gloss"
	if f == "matt" then return MAT.plastic, 0 elseif f == "metal" then return MAT.metal, 0.2 end
	return MAT.paint, 0.12
end

-- E: effective config (Catalog.ecfg), look: { col, seat, rim, fin, num }
function Builder.moped(mop, E, look)
	local model = Instance.new("Model")
	model.Name = "Moped_" .. mop.id
	local wr, wb = mop.wr, mop.wb
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.35 * S, 0.3 * S, wb * 0.8 * S)
	root.CFrame = CFrame.new(0, (wr + 0.15) * S, 0)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CustomPhysicalProperties = PhysicalProperties.new(10, 0.3, 0, 1, 1) -- heavy and low-slung: low centre of mass, the rider does not tip it over
	root.Parent = model
	model.PrimaryPart = root
	local K = maker(model, root)
	local pm, pr = paintMat(look)
	local body, seatC = look.col, look.seat
	local z0 = wb / 2
	local fw, fsp = wheel(K, "FW", wr, z0, mop.id == "dt" and 0.09 or 0.11, E, look)
	local rw, rsp = wheel(K, "RW", wr, -z0, mop.id == "dt" and 0.1 or 0.12, E, look)
	local exh = Config.EXH[E.exh + 1]
	local seatY
	if mop.id == "dt" then
		-- enduro: frame, raked fork, tank, long seat, high fenders, finned cylinder, expansion chamber
		K.tube("Frame1", { 0, 0.98, 0.43 }, { 0, 0.84, -0.25 }, 0.024, C.dark, MAT.metal, 0.1)
		K.tube("Frame2", { 0, 0.82, 0.47 }, { 0, 0.3, 0.1 }, 0.022, C.dark, MAT.metal, 0.1)
		K.tube("Frame3", { 0, 0.3, 0.1 }, { 0, 0.32, -0.15 }, 0.022, C.dark, MAT.metal, 0.1)
		for _, s in ipairs({ -1, 1 }) do
			K.tube("Rail", { s * 0.08, 0.82, -0.25 }, { s * 0.1, 0.74, -0.75 }, 0.014, C.dark, MAT.metal, 0.1)
			K.tube("Strut", { s * 0.07, 0.32, -0.15 }, { s * 0.1, 0.74, -0.6 }, 0.013, C.dark, MAT.metal, 0.1)
			K.tube("ForkUp", { s * 0.075, 1.02, 0.4 }, { s * 0.075, 0.62, 0.56 }, 0.022, C.chrome, MAT.chrome, 0.4)
			K.tube("ForkLo", { s * 0.075, 0.66, 0.545 }, { s * 0.075, wr, z0 }, 0.028, C.black, MAT.plastic)
			K.tube("Swing", { s * 0.08, 0.3, -0.18 }, { s * 0.08, wr, -z0 }, 0.018, C.dark, MAT.metal, 0.1)
			K.tube("Shock", { s * 0.09, 0.3, -0.5 }, { s * 0.1, 0.78, -0.52 }, 0.022, Color3.fromRGB(216, 180, 30), MAT.metal, 0.1)
		end
		if E.tank ~= "none" then
			local tc = E.tank == "carbon" and C.carbon or body
			K.box("Tank", 0.26, 0.16, 0.42, 0, 0.9, 0.13, tc, pm, pr, math.rad(-9))
			K.box("TankTop", 0.2, 0.05, 0.3, 0, 0.98, 0.12, tc, pm, pr, math.rad(-9))
		end
		K.box("Seat", 0.22, 0.08, 0.62, 0, 0.9, -0.36, seatC, MAT.fabric, 0, math.rad(3))
		seatY = 0.95
		for _, s in ipairs({ -1, 1 }) do K.box("SidePanel", 0.01, 0.17, 0.22, s * 0.115, 0.74, -0.3, C.white, MAT.plastic) end
		if E.fender ~= "none" then
			local fc = E.fender == "carbon" and C.carbon or E.fender == "chrome" and C.chrome or C.white
			K.box("FrontFender", 0.11, 0.02, 0.42, 0, wr * 2 + 0.06, z0 + 0.05, fc, MAT.plastic, E.fender == "chrome" and 0.4 or 0, math.rad(-8))
		end
		K.box("RearFender", 0.13, 0.02, 0.5, 0, 0.88, -0.86, C.white, MAT.plastic, 0, math.rad(12))
		K.box("TailLight", 0.12, 0.05, 0.03, 0, 0.92, -1.08, C.red, MAT.neon)
		-- engine
		K.box("Crankcase", 0.2, 0.2, 0.3, 0, 0.3, 0, C.eng, MAT.metal, 0.1)
		for i = 0, 6 do K.box("Fin", 0.19, 0.012, 0.17, 0, 0.42 + i * 0.028, 0.1 + i * 0.01, C.alu, MAT.metal, 0.1, math.rad(20)) end
		-- expansion chamber
		local R = 0.035 + exh.l * 0.035
		K.tube("ExhA", { 0, 0.47, 0.22 }, { 0.02, 0.3, 0.32 }, 0.022, exh.col, MAT.metal, 0.3)
		K.tube("ExhB", { 0.02, 0.3, 0.32 }, { 0.1, 0.2, 0.15 }, R * 0.8, exh.col, MAT.metal, 0.3)
		K.tube("ExhC", { 0.1, 0.2, 0.15 }, { 0.15, 0.4, -0.3 }, R, exh.col, MAT.metal, 0.3)
		K.tube("ExhD", { 0.15, 0.4, -0.3 }, { 0.15, 0.6, -0.55 }, R * 0.6, exh.col, MAT.metal, 0.3)
		K.tube("Silencer", { 0.15, 0.6, -0.55 }, { 0.15, 0.7, -0.8 }, 0.03, C.black, MAT.metal)
		-- handlebar, mirrors, headlight
		local hb = E.bars == "high"
		local by, bw = 1.08 + (hb and 0.07 or 0), hb and 0.74 or 0.64
		K.tube("Bar", { -bw / 2, by, 0.38 }, { bw / 2, by, 0.38 }, 0.011, hb and C.alu or C.black, MAT.metal, 0.1)
		if E.mir ~= "none" then
			for _, s in ipairs({ -1, 1 }) do
				K.tube("MirStalk", { s * bw * 0.38, by, 0.38 }, { s * bw * 0.42, by + 0.24, 0.36 }, 0.006, C.black, MAT.metal)
				K.part("Mirror", "ball", Vector3.new(0.09, 0.07, 0.09), K.at(s * bw * 0.43, by + 0.27, 0.35), E.mir == "round" and C.chrome or C.black, MAT.metal, E.mir == "round" and 0.5 or 0)
			end
		end
		K.box("LampPlate", 0.22, 0.24, 0.04, 0, 0.9, 0.55, C.white, MAT.plastic, 0, math.rad(-25))
		K.part("Headlight", "cyl", Vector3.new(0.05, 0.14, 0.14), K.at(0, 0.9, 0.575) * CFrame.Angles(0, math.pi / 2, 0), E.glass == "tint" and C.dark or C.lamp, E.glass == "tint" and MAT.glass or MAT.neon)
	else
		-- scooters (Jogga: round classic, Aerox: low sporty)
		local sport = mop.id == "rok"
		local s = wb / 1.2
		for _, x in ipairs({ -1, 1 }) do
			K.tube("Fork", { x * 0.07, wr, z0 }, { x * 0.07, 0.75, 0.42 * s }, 0.022, C.dark, MAT.metal, 0.1)
		end
		K.box("Floor", 0.38, 0.06, 0.55 * s, 0, 0.25, 0.08 * s, C.dark, MAT.plastic)
		K.box("LegShield", 0.4, 0.62, 0.12, 0, 0.6, 0.42 * s, body, pm, pr, math.rad(sport and 18 or 10))
		if sport then
			K.wedge("Nose", Vector3.new(0.36, 0.3, 0.45), K.at(0, 0.95, 0.52 * s) * CFrame.Angles(0, math.pi, 0), body, pm, pr)
			for _, x in ipairs({ -1, 1 }) do K.part("Lamp", "ball", Vector3.new(0.08, 0.06, 0.08), K.at(x * 0.08, 0.92, 0.66 * s), E.glass == "tint" and C.dark or C.lamp, E.glass == "tint" and MAT.glass or MAT.neon) end
		else
			K.box("Headset", 0.3, 0.18, 0.22, 0, 1.0, 0.45 * s, body, pm, pr)
			K.part("Lamp", "ball", Vector3.new(0.13, 0.1, 0.06), K.at(0, 0.98, 0.57 * s), E.glass == "tint" and C.dark or C.lamp, E.glass == "tint" and MAT.glass or MAT.neon)
		end
		K.box("RearBody", 0.34, sport and 0.24 or 0.3, 0.6 * s, 0, sport and 0.55 or 0.5, -0.33 * s, body, pm, pr)
		if sport then K.wedge("Tail", Vector3.new(0.3, 0.16, 0.3), K.at(0, 0.62, -0.72 * s), body, pm, pr) end
		K.box("Seat", 0.28, 0.1, 0.6 * s, 0, sport and 0.72 or 0.7, -0.3 * s, seatC, MAT.fabric, 0, math.rad(-3))
		seatY = sport and 0.77 or 0.75
		K.tube("Bar", { -0.33, 1.07, 0.38 * s }, { 0.33, 1.07, 0.38 * s }, 0.013, C.chrome, MAT.chrome, 0.4)
		if E.fender ~= "none" and not sport then
			local fc = E.fender == "carbon" and C.carbon or E.fender == "chrome" and C.chrome or body
			K.box("FrontFender", 0.14, 0.03, 0.34, 0, wr * 2 + 0.04, z0, fc, E.fender == "chrome" and MAT.chrome or pm, E.fender == "chrome" and 0.45 or pr, math.rad(-5))
		end
		if E.mir ~= "none" then
			for _, x in ipairs({ -1, 1 }) do
				K.tube("MirStalk", { x * 0.27, 1.08, 0.38 * s }, { x * 0.3, 1.28, 0.34 * s }, 0.007, E.mir == "round" and C.chrome or C.black, MAT.metal)
				K.part("Mirror", "ball", Vector3.new(0.1, 0.07, 0.05), K.at(x * 0.3, 1.3, 0.33 * s), E.mir == "round" and C.chrome or C.black, MAT.metal, E.mir == "round" and 0.5 or 0)
			end
		end
		K.box("Engine", 0.16, 0.18, 0.55 * s, 0.05, 0.24, -0.34 * s, C.dark, MAT.metal)
		K.part("VarCover", "cyl", Vector3.new(0.08, 0.26, 0.26), K.at(0.17, 0.26, -0.2 * s), C.alu, MAT.metal, 0.15)
		local L = 0.7 + exh.l * 0.5
		K.tube("Exhaust", { 0.19, 0.15, 0.04 }, { 0.2, 0.22, 0.04 - L }, 0.05 + exh.l * 0.02, exh.col, MAT.metal, 0.3)
		K.box("TailLight", 0.14, 0.05, 0.04, 0, sport and 0.6 or 0.5, -0.66 * s, C.red, MAT.neon)
	end
	-- start number decals on both sides
	for _, sx in ipairs({ -1, 1 }) do
		local plate = K.part("NumPlate", "box", Vector3.new(0.005, 0.15, 0.15), K.at(sx * (mop.id == "dt" and 0.135 or 0.175), mop.id == "dt" and 0.74 or 0.45, mop.id == "dt" and -0.3 or -0.36), C.white, MAT.plastic)
		local gui = Instance.new("SurfaceGui")
		gui.Face = sx > 0 and Enum.NormalId.Right or Enum.NormalId.Left
		gui.CanvasSize = Vector2.new(100, 100)
		gui.Parent = plate
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Text = look.num or ""
		t.TextScaled = true
		t.Font = Enum.Font.GothamBlack
		t.TextColor3 = Color3.new(0.07, 0.07, 0.07)
		t.Parent = gui
	end
	-- seat for the rider
	local seat = Instance.new("Seat")
	seat.Name = "Seat"
	seat.Size = Vector3.new(0.3 * S, 0.1 * S, 0.4 * S)
	seat.CFrame = CFrame.new(0, seatY * S, -0.3 * (wb / 1.2) * S)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.Massless = true
	seat.Parent = model
	local sw = Instance.new("WeldConstraint"); sw.Part0, sw.Part1 = root, seat; sw.Parent = seat
	-- references for the client
	local refs = Instance.new("Folder"); refs.Name = "Refs"; refs.Parent = model
	for name, p in pairs({ FW = fw, RW = rw }) do
		local o = Instance.new("ObjectValue"); o.Name = name; o.Value = p; o.Parent = refs
	end
	for i, w in ipairs(fsp) do local o = Instance.new("ObjectValue"); o.Name = "SpinF" .. i; o.Value = w; o.Parent = refs end
	for i, w in ipairs(rsp) do local o = Instance.new("ObjectValue"); o.Name = "SpinR" .. i; o.Value = w; o.Parent = refs end
	-- headlight (real light), tail light and exhaust smoke
	local isDt, sc = mop.id == "dt", wb / 1.2
	local hl = K.attach("HeadlightAtt", 0, isDt and 0.9 or (mop.id == "rok" and 0.92 or 0.98), isDt and 0.6 or 0.7 * sc)
	local spot = Instance.new("SpotLight"); spot.Name = "Headlight"; spot.Face = Enum.NormalId.Front; spot.Angle = 55; spot.Range = 45; spot.Brightness = E.glass == "tint" and 1.2 or 2.5
	spot.Color = Color3.fromRGB(255, 240, 210); spot.Shadows = true; spot.Parent = hl
	local tl = K.attach("TailAtt", 0, isDt and 0.92 or (mop.id == "rok" and 0.6 or 0.5), isDt and -1.1 or -0.7 * sc)
	local pl = Instance.new("PointLight"); pl.Name = "TailLight"; pl.Color = Color3.fromRGB(255, 40, 40); pl.Range = 6; pl.Brightness = 1.2; pl.Parent = tl
	local ex = isDt and K.attach("ExhaustAtt", 0.15, 0.72, -0.85) or K.attach("ExhaustAtt", 0.2, 0.22, 0.04 - (0.7 + exh.l * 0.5) - 0.02)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Smoke"
	pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.6, 1.4)
	pe.Speed = NumberRange.new(2, 4)
	pe.SpreadAngle = Vector2.new(12, 12)
	pe.EmissionDirection = Enum.NormalId.Back
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 2.2) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	pe.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205))
	pe.LightInfluence = 1
	pe.Parent = ex
	return model
end

-- 3D preview of a part for the shop (ViewportFrame). Returns a Model centred around origin.
function Builder.preview(slot, val)
	local model = Instance.new("Model")
	local K = maker(model, nil)
	val = val or {}
	if slot == "kit" then
		local t = val.kit or 0
		local col = ({ C.eng, Color3.fromRGB(200, 205, 212), Color3.fromRGB(40, 42, 46) })[t + 1]
		K.part("Body", "cyl", Vector3.new(0.6, 0.4, 0.4), K.at(0, 0, 0) * CFrame.Angles(0, 0, math.pi / 2), col, MAT.metal, 0.1)
		for i = 0, 7 do K.box("Fin", 0.56, 0.02, 0.56, 0, -0.24 + i * 0.07, 0, col, MAT.metal, 0.1) end
		K.part("Head", "cyl", Vector3.new(0.1, 0.46, 0.46), K.at(0, 0.36, 0) * CFrame.Angles(0, 0, math.pi / 2), t == 2 and C.red or col, MAT.metal, 0.1)
	elseif slot == "exh" then
		local e = Config.EXH[(val.exh or 0) + 1]
		if (val.exh or 0) == 0 then
			K.part("Can", "cyl", Vector3.new(0.75, 0.28, 0.28), CFrame.new(), e.col, MAT.metal, 0.2)
		else
			local L = 1.2 + e.l * 0.5
			K.tube("A", { -L / 2, 0, 0 }, { -L / 6, 0, 0 }, 0.05, e.col, MAT.metal, 0.3)
			K.tube("B", { -L / 6, 0, 0 }, { L / 6, 0, 0 }, 0.12 + e.l * 0.05, e.col, MAT.metal, 0.3)
			K.tube("C", { L / 6, 0, 0 }, { L / 2, 0, 0 }, 0.05, e.col, MAT.metal, 0.3)
		end
	elseif slot == "carb" then
		local d = (({ 12, 17.5, 19, 21, 24 })[(val.carb or 0) + 1]) / 17.5
		K.box("Body", 0.32 * d, 0.3 * d, 0.28 * d, 0, 0, 0, C.alu, MAT.metal, 0.1)
		K.part("Mouth", "cyl", Vector3.new(0.24 * d, 0.24 * d, 0.24 * d), K.at(0, 0, 0.26 * d) * CFrame.Angles(0, math.pi / 2, 0), C.alu, MAT.metal, 0.1)
		K.part("Bowl", "cyl", Vector3.new(0.16 * d, 0.26 * d, 0.26 * d), K.at(0, -0.22 * d, 0) * CFrame.Angles(0, 0, math.pi / 2), C.alu, MAT.metal, 0.1)
	elseif slot == "jets" then
		K.box("Tray", 0.95, 0.05, 0.4, 0, -0.05, 0, C.black, MAT.plastic)
		for i = 0, 5 do K.part("Jet", "cyl", Vector3.new(0.12, 0.06, 0.06), K.at(-0.38 + i * 0.152, 0.06, 0) * CFrame.Angles(0, 0, math.pi / 2), C.gold, MAT.metal, 0.3) end
	elseif slot == "man" then
		local r = (val.maxd or 19) > 19 and 0.08 or 0.058
		K.tube("Pipe", { -0.4, 0, 0 }, { 0.35, 0.22, 0 }, r, C.black, MAT.plastic)
		K.box("Flange", 0.05, 0.28, 0.32, -0.42, 0, 0, C.alu, MAT.metal, 0.1)
	elseif slot == "filt" then
		if (val.fcap or 1) > 1 then K.part("Cone", "cyl", Vector3.new(0.36, 0.4, 0.4), CFrame.new(), C.red, MAT.fabric)
		else K.box("Box", 0.5, 0.28, 0.3, 0, 0, 0, C.black, MAT.plastic) end
	elseif slot == "ign" then
		K.box("Cdi", 0.36, 0.12, 0.26, 0, 0, 0, (val.icap or 11000) > 11000 and C.red or C.black, MAT.plastic)
		K.part("Coil", "cyl", Vector3.new(0.22, 0.14, 0.14), K.at(0.38, 0.02, 0) * CFrame.Angles(0, 0, math.pi / 2), C.dark, MAT.plastic)
	elseif slot == "cool" then
		local big = (val.cf or 1) > 1
		K.box("Core", big and 0.72 or 0.56, 0.46, 0.05, 0, 0, 0, C.alu, MAT.alu, 0.1)
		for i = 0, (big and 8 or 5) do K.box("Fin", (big and 0.72 or 0.56), 0.012, 0.08, 0, -0.2 + i * 0.05, 0, C.alu, MAT.metal, 0.1) end
	elseif slot == "var" then
		local col = (val.rmin or 0.85) < 0.75 and C.gold or (val.rmin or 0.85) < 0.8 and Color3.fromRGB(58, 111, 216) or C.alu
		K.part("Disc", "cyl", Vector3.new(0.1, 0.68, 0.68), K.at(0, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), col, MAT.metal, 0.2)
		K.part("Hub", "cyl", Vector3.new(0.24, 0.1, 0.1), K.at(0, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), C.chrome, MAT.chrome, 0.4)
	elseif slot == "roll" then
		local col = (val.rlo or 7) < 5 and C.white or (val.rlo or 7) > 10 and C.gold or C.black
		for i = 0, 5 do local a = i * math.pi / 3; K.part("Roller", "cyl", Vector3.new(0.11, 0.17, 0.17), K.at(math.cos(a) * 0.27, 0, math.sin(a) * 0.27), col, MAT.plastic) end
	elseif slot == "clutch" or slot == "contra" then
		local hard = slot == "clutch" and (val.slip or 7500) or (7500 + (val.cdt or 0) * 4)
		local col = hard > 9500 and C.red or hard > 8000 and Color3.fromRGB(240, 196, 25) or (slot == "contra" and C.dark or C.chrome)
		local n, r = slot == "clutch" and 3 or 1, slot == "clutch" and 0.06 or 0.22
		for k = 1, n do for i = 0, 7 do K.part("Coil", "cyl", Vector3.new(0.02, r * 2, r * 2), K.at(-0.22 * (n - 1) / 2 + (k - 1) * 0.22, -0.3 + i * 0.08, 0) * CFrame.Angles(0, 0, math.pi / 2), col, MAT.metal, 0.2) end end
	elseif slot == "belt" then
		for i = 0, 23 do local a = i / 24 * math.pi * 2; K.box("Seg", 0.08, 0.04, 0.06, math.cos(a) * 0.5, math.sin(a) * 0.2, 0, (val.blim or 7) > 7 and Color3.fromRGB(232, 118, 44) or C.black, MAT.rubber) end
	elseif slot == "fender" or slot == "tank" then
		local v = val.fender or val.tank
		local col = v == "carbon" and C.carbon or v == "chrome" and C.chrome or C.red
		if slot == "tank" then K.box("Tank", 0.46, 0.28, 0.72, 0, 0, 0, col, MAT.paint, 0.12)
		else K.wedge("Fender", Vector3.new(0.3, 0.2, 0.7), CFrame.new(), col, v == "chrome" and MAT.chrome or MAT.paint, v == "chrome" and 0.45 or 0.12) end
	elseif slot == "mir" then
		for _, x in ipairs({ -1, 1 }) do
			K.tube("Stalk", { x * 0.2, -0.2, 0 }, { x * 0.32, 0.22, 0 }, 0.012, C.dark, MAT.metal)
			K.part("Head", "ball", Vector3.new(0.22, 0.16, 0.1), K.at(x * 0.34, 0.3, 0), val.mir == "round" and C.chrome or C.dark, MAT.metal, val.mir == "round" and 0.5 or 0)
		end
	elseif slot == "bars" then
		local hi = val.bars == "high"
		K.tube("Bar", { -0.5, hi and 0.2 or 0.05, 0 }, { 0.5, hi and 0.2 or 0.05, 0 }, 0.022, hi and C.alu or C.dark, MAT.metal, 0.2)
		if hi then K.tube("Brace", { -0.2, 0.1, 0 }, { 0.2, 0.1, 0 }, 0.012, C.alu, MAT.metal, 0.2) end
	elseif slot == "rims" then
		local rc, rm, rr = rimLook(val, C.alu)
		K.part("Tyre", "cyl", Vector3.new(0.16, 0.92, 0.92), K.at(0, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), C.tire, MAT.rubber)
		K.part("Rim", "cyl", Vector3.new(0.17, 0.62, 0.62), K.at(0, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), rc, rm, rr)
	elseif slot == "glass" then
		K.part("Lens", "ball", Vector3.new(0.5, 0.5, 0.3), CFrame.new(), val.glass == "tint" and C.dark or C.lamp, val.glass == "tint" and MAT.glass or MAT.neon)
	else
		K.box("Box", 0.4, 0.4, 0.4, 0, 0, 0, C.dark, MAT.plastic)
	end
	return model
end

return Builder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Catalog</string><ProtectedString name="Source"><![CDATA[-- Parts catalogue: demo products with made-up manufacturers and prices (game money). Same as the web version.
-- One source of truth: the player's items + installed[moped][slot]; the engine config is derived with ecfg().
local Config = require(script.Parent.Config)
local Catalog = {}

Catalog.SLOTS = {
	kit = { "Cylinder", "Cylindrar" }, exh = { "Avgassystem", "Avgassystem" }, carb = { "Förgasare", "Förgasare" },
	jets = { "Munstyckessats", "Munstycken" }, man = { "Insug", "Insug" }, filt = { "Luftfilter", "Luftfilter" },
	ign = { "Tändning", "Tändning" }, cool = { "Kylning", "Kylning" }, var = { "Variator", "Variatorer" },
	roll = { "Rullsats", "Rullvikter" }, clutch = { "Kopplingsfjädrar", "Kopplingsfjädrar" }, contra = { "Kontrafjäder", "Kontrafjädrar" },
	belt = { "Rem", "Remmar" }, fender = { "Framskärm", "Kåpor" }, tank = { "Tankkåpa", "Kåpor" }, mir = { "Speglar", "Speglar" },
	bars = { "Styre", "Styren" }, rims = { "Fälgar", "Hjul & fälgar" }, glass = { "Lyktglas", "Kosmetik" },
}
Catalog.SLOT_ORDER = { "kit", "exh", "carb", "jets", "man", "filt", "ign", "cool", "var", "roll", "clutch", "contra", "belt", "fender", "tank", "mir", "bars", "rims", "glass" }
Catalog.REMOVABLE = { fender = true, tank = true, mir = true }
Catalog.ENGINE = { kit = true, exh = true, carb = true, jets = true, man = true, filt = true, ign = true, cool = true, var = true, roll = true, clutch = true, contra = true, belt = true }
Catalog.GROUPS = {
	{ "Motor", { "Cylindrar", "Avgassystem", "Förgasare", "Munstycken", "Insug", "Luftfilter", "Tändning", "Kylning" } },
	{ "Kraftöverföring", { "Variatorer", "Rullvikter", "Kopplingsfjädrar", "Kontrafjädrar", "Remmar" } },
	{ "Utseende", { "Kåpor", "Speglar", "Styren", "Hjul & fälgar", "Kosmetik" } },
}
Catalog.BASE = { kit = 0, exh = 0, carb = 1, jlo = 50, jhi = 110, maxd = 19, fcap = 1, icap = 11000, cf = 1, rmin = 0.85, rlo = 7, rhi = 12, slip = 7500, cdt = 0, blim = 7,
	fender = "none", tank = "none", mir = "none", bars = "std", rims = "std", glass = "clear" }

local PR, BY, OEM = {}, {}, { jog = {}, rok = {}, dt = {} }
Catalog.PR, Catalog.BY_SKU, Catalog.OEM = PR, BY, OEM
local ALL, CVT = { "jog", "rok", "dt" }, { "jog", "rok" }

local function has(t, x) for _, v in ipairs(t) do if v == x then return true end end return false end
Catalog.has = has

local function add(slot, v, name, man, price, val, fits, desc, oemFor, split)
	local groups = {}
	if split then for _, f in ipairs(fits) do table.insert(groups, { f }) end else groups = { fits } end
	for _, fs in ipairs(groups) do
		local sku = "D-" .. slot .. "-" .. v .. (split and ("-" .. fs[1]) or "")
		local p = { sku = sku, name = name .. (split and (" – " .. Config.BY_ID[fs[1]].n) or ""), man = man, cat = Catalog.SLOTS[slot][2], slot = slot,
			price = price, val = val, fits = fs, desc = desc }
		table.insert(PR, p)
		BY[sku] = p
		for _, f in ipairs(fs) do if oemFor and has(oemFor, f) then OEM[f][slot] = sku end end
	end
end
local function fmt(n) -- 11000 -> "11 000"
	local s = tostring(math.floor(n))
	return (s:reverse():gsub("(%d%d%d)", "%1 "):reverse():gsub("^ ", ""))
end

for i, k in ipairs(Config.KITS) do
	add("kit", i - 1, "Cylindersats " .. k.n, ({ "Originaldel", "Fartek", "Nordtrim" })[i], ({ 1200, 1900, 2900 })[i], { kit = i - 1 }, ALL,
		k.cc .. " cc, avgasport " .. k.ex .. "° grundtiming. Större slagvolym och högre effektvarv.", i == 1 and ALL or {}, true)
end
for i, e in ipairs(Config.EXH) do
	add("exh", i - 1, "Avgassystem " .. e.n, ({ "Originaldel", "Bruksmek", "Fartek", "Nordtrim", "Fartek" })[i], ({ 900, 1400, 1900, 2400, 3200 })[i], { exh = i - 1 }, ALL,
		"Inställt för ca " .. e.t .. " varv. Flyttar effekttoppen.", i == 1 and ALL or {}, true)
end
for i, d in ipairs(Config.CARB) do
	add("carb", i - 1, "Förgasare " .. d .. " mm", i > 3 and "Fartek" or "Vippa", ({ 500, 700, 900, 1300, 1700 })[i], { carb = i - 1 }, ALL,
		"Mer luft vid höga varv. Över 19 mm behövs större insug.", ({ { "jog" }, { "rok", "dt" } })[i])
end
for i, j in ipairs({ { 40, 70, "liten" }, { 50, 110, "standard" }, { 90, 160, "stor" } }) do
	add("jets", i - 1, "Munstyckessats " .. j[3] .. " (" .. j[1] .. "–" .. j[2] .. ")", "Vippa", 150, { jlo = j[1], jhi = j[2] }, ALL,
		"Låser upp huvudmunstycken " .. j[1] .. "–" .. j[2] .. ".", i == 2 and ALL or {})
end
add("man", 0, "Insug original (upp till 19 mm)", "Originaldel", 200, { maxd = 19 }, ALL, "Förgasare större än 19 mm stryps.", ALL, true)
add("man", 1, "Insug stort (upp till 24 mm)", "Nordtrim", 450, { maxd = 24 }, ALL, "Förgasare upp till 24 mm får fullt flöde.", {}, true)
add("filt", 0, "Luftfilter original", "Originaldel", 150, { fcap = 1 }, ALL, "Originalfilter.", ALL)
add("filt", 1, "Luftfilter sport", "Vippa", 350, { fcap = 1.12 }, ALL, "12 % mer luft, blandningen blir magrare.", {})
add("ign", 0, "Tändning original (spärr 11 000)", "Originaldel", 600, { icap = 11000 }, ALL, "Motorn kan inte varva över 11 000 rpm.", ALL, true)
add("ign", 1, "Tändning sport (spärr 14 000)", "Fartek", 1300, { icap = 14000 }, ALL, "Motorn kan varva till 14 000 rpm.", {}, true)
add("cool", 0, "Topplock original", "Originaldel", 500, { cf = 1 }, { "jog", "dt" }, "Originaltopplock.", { "jog", "dt" }, true)
add("cool", 1, "Topplock storflänsat", "Kylstad", 900, { cf = 1.25 }, { "jog", "dt" }, "25 % bättre luftkylning.", {}, true)
add("cool", 2, "Kylare original", "Originaldel", 700, { cf = 1 }, { "rok" }, "Originalkylare.", { "rok" })
add("cool", 3, "Kylare stor", "Kylstad", 1300, { cf = 1.25 }, { "rok" }, "25 % bättre kylning av kylvätskan.", {})
for i, r in ipairs({ { 0.85, "original", 600 }, { 0.78, "sport", 1100 }, { 0.72, "race", 1600 } }) do
	add("var", i - 1, "Variator " .. r[2], ({ "Originaldel", "Nordtrim", "Fartek" })[i], r[3], { rmin = r[1] }, CVT, "Högsta utväxling " .. r[1] .. ":1, högre toppfart.", i == 1 and CVT or {}, true)
end
for i, r in ipairs({ { 4, 8, "lätt" }, { 7, 12, "standard" }, { 11, 14, "tung" } }) do
	add("roll", i - 1, "Rullsats " .. r[3] .. " (" .. r[1] .. "–" .. r[2] .. " g)", "Vippa", 120, { rlo = r[1], rhi = r[2] }, CVT, "Låser upp rullvikter " .. r[1] .. "–" .. r[2] .. " g.", i == 2 and CVT or {}, true)
end
for i, r in ipairs({ { 7500, "original", 150 }, { 9000, "sport", 220 }, { 10500, "race", 260 } }) do
	add("clutch", i - 1, "Kopplingsfjädrar " .. r[2], i == 1 and "Originaldel" or "Fartek", r[3], { slip = r[1] }, CVT, "Kopplingen slirar upp till ca " .. fmt(r[1]) .. " rpm från stillastående.", i == 1 and CVT or {}, true)
end
for i, r in ipairs({ { 0, "original", 150 }, { 400, "+15 %", 200 }, { 800, "+30 %", 250 } }) do
	add("contra", i - 1, "Kontrafjäder " .. r[2], i == 1 and "Originaldel" or "Nordtrim", r[3], { cdt = r[1] }, CVT, "Variatorn håller " .. (r[1] > 0 and (r[1] .. " rpm högre") or "originalvarvet") .. ".", i == 1 and CVT or {}, true)
end
add("belt", 0, "Rem original", "Originaldel", 300, { blim = 7 }, CVT, "Slirar över ca 7 hk.", CVT, true)
add("belt", 1, "Rem förstärkt", "Bruksmek", 550, { blim = 15 }, CVT, "Slirar över ca 15 hk.", {}, true)
for i, r in ipairs({ { "paint", "original (lackad)", 400 }, { "carbon", "karbonlook", 650 }, { "chrome", "krom", 750 } }) do
	add("fender", i - 1, "Framskärm " .. r[2], i == 1 and "Originaldel" or "Bruksmek", r[3], { fender = r[1] }, { "jog", "dt" }, "Syns på mopeden.", i == 1 and { "jog", "dt" } or {})
end
for i, r in ipairs({ { "paint", "original (lackad)", 500 }, { "carbon", "karbonlook", 800 } }) do
	add("tank", i - 1, "Tankkåpa " .. r[2], i == 1 and "Originaldel" or "Bruksmek", r[3], { tank = r[1] }, { "dt" }, "Syns på mopeden.", i == 1 and { "dt" } or {})
end
for i, r in ipairs({ { "std", "original", 250 }, { "round", "runda krom", 380 } }) do
	add("mir", i - 1, "Speglar " .. r[2], i == 1 and "Originaldel" or "Vippa", r[3], { mir = r[1] }, { "jog", "dt" }, "Syns på mopeden.", i == 1 and { "jog" } or {})
end
for i, r in ipairs({ { "std", "original", 300 }, { "high", "crossstyre högt", 550 } }) do
	add("bars", i - 1, "Styre " .. r[2], i == 1 and "Originaldel" or "Nordtrim", r[3], { bars = r[1] }, { "dt" }, "Syns på mopeden.", i == 1 and { "dt" } or {})
end
add("rims", 0, "Fälgar original", "Originaldel", 900, { rims = "std" }, ALL, "Originalfälgar.", ALL, true)
add("rims", 1, "Fälgar polerade", "Bruksmek", 1400, { rims = "pol" }, ALL, "Spegelblank metall.", {}, true)
add("rims", 2, "Fälgar guld", "Nordtrim", 1300, { rims = "gold" }, ALL, "Guldfärgade fälgar.", {}, true)
for i, r in ipairs({ { "clear", "klart (original)", 200 }, { "tint", "tonat", 300 } }) do
	add("glass", i - 1, "Lyktglas " .. r[2], i == 1 and "Originaldel" or "Vippa", r[3], { glass = r[1] }, ALL, "Syns på mopeden.", i == 1 and ALL or {})
end

function Catalog.slotsOf(id)
	local o = {}
	for _, p in ipairs(PR) do if has(p.fits, id) then o[p.slot] = true end end
	return o
end
function Catalog.fits(p, id) return p ~= nil and has(p.fits, id) end

-- effective config for a moped: base -> tuning values -> installed parts (or OEM if a required slot is empty)
-- data: { cfg = {jet,port,roller,...}, inst = {slot = itemId}, items = {itemId = {s = sku}} }
function Catalog.ecfg(id, cfg, inst, items)
	local c = {}
	for k, v in pairs(Catalog.BASE) do c[k] = v end
	for k, v in pairs(cfg or {}) do c[k] = v end
	for slot in pairs(Catalog.slotsOf(id)) do
		local u = inst and inst[slot]
		local it = u and items and items[u]
		local p = it and BY[it.s]
		if p then
			for k, v in pairs(p.val) do c[k] = v end
		elseif not Catalog.REMOVABLE[slot] and OEM[id][slot] then
			for k, v in pairs(BY[OEM[id][slot]].val) do c[k] = v end
		end
	end
	c.jet = math.min(c.jhi, math.max(c.jlo, c.jet))
	c.roller = math.min(c.rhi, math.max(c.rlo, c.roller))
	return c
end

Catalog.fmt = fmt
return Catalog
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">ClientState</string><ProtectedString name="Source"><![CDATA[-- Shared state between the client's scripts (Ride and UI). Used only on the client.
local ClientState = {
	profile = nil, -- latest profile from the server
	ride = nil, -- riding state (speed, rpm, temperature ...), set by Ride.client
	changed = Instance.new("BindableEvent"), -- fired when the profile changes
	toast = Instance.new("BindableEvent"), -- short messages to the HUD
}
return ClientState
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Moppe Garage (Roblox): all data in one place. Same values as the web version (moppe/index.html).
-- Numbers are game tuning values, not measured data.
local Config = {}

Config.KITS = {
	{ n = "Original 50 cc", cc = 50, ex = 178, q = 1 },
	{ n = "Sport 70 cc", cc = 70, ex = 184, q = 1.05 },
	{ n = "Race 70 cc", cc = 70, ex = 192, q = 1.08 },
}
Config.EXH = {
	{ n = "Original", t = 7000, w = 3600, g = 0.85, col = Color3.fromRGB(119, 119, 119), l = 0.5 },
	{ n = "Touring", t = 8000, w = 4000, g = 0.92, col = Color3.fromRGB(153, 153, 153), l = 0.6 },
	{ n = "Sport", t = 9500, w = 3300, g = 1, col = Color3.fromRGB(204, 204, 204), l = 0.7 },
	{ n = "Mellankammare", t = 10500, w = 2800, g = 1.04, col = Color3.fromRGB(216, 216, 224), l = 0.85 },
	{ n = "Race-kammare", t = 12000, w = 2100, g = 1.1, col = Color3.fromRGB(176, 160, 144), l = 1 },
}
Config.CARB = { 12, 17.5, 19, 21, 24 }
Config.GEARS = { 3.0, 1.95, 1.45, 1.12 }

-- wb = wheelbase (m), wr = wheel radius (m), fd = final drive. Roblox: 1 stud = 0.28 m (STUD below)
Config.MOPEDS = {
	{ id = "jog", n = "Jogga 50", cvt = true, cool = "air", fan = true, fam = "V-AC", m = 85, wb = 1.2, wr = 0.17, fd = 9.4, price = 6000,
		d = { jet = 58, port = 0, roller = 10, col = Color3.fromRGB(230, 57, 70), seat = Color3.fromRGB(34, 34, 34), num = "7" } },
	{ id = "rok", n = "Aerox 50", cvt = true, cool = "liquid", fan = false, fam = "H-LC", m = 98, wb = 1.3, wr = 0.26, fd = 13, price = 9000,
		d = { jet = 85, port = 0, roller = 9, col = Color3.fromRGB(29, 111, 224), seat = Color3.fromRGB(34, 34, 34), num = "27" } },
	{ id = "dt", n = "Enduro DT 50", cvt = false, cool = "air", fan = false, fam = "G-AC", m = 80, wb = 1.3, wr = 0.22, fd = 12.8, price = 8000,
		d = { jet = 85, port = 0, roller = 9, col = Color3.fromRGB(244, 194, 13), seat = Color3.fromRGB(34, 34, 34), num = "3" } },
}
Config.BY_ID = {}
for _, m in ipairs(Config.MOPEDS) do Config.BY_ID[m.id] = m end

Config.FAM = { ["V-AC"] = "Vertikal luftkyld skotermotor", ["H-LC"] = "Horisontell vätskekyld skotermotor", ["G-AC"] = "Växlad luftkyld motor" }

Config.STUD = 0.28 -- meter per stud (Roblox character ≈ 5 studs ≈ 1.4–1.8 m)
Config.AMB = 15 -- outside temperature, °C (assumed)

-- economy (in-game kronor, not real prices)
Config.ECON = {
	start = 2000,
	distKr = 5, distM = 100, -- 5 kr per 100 m with the engine running
	cleanKr = 40, cleanM = 2000, -- 40 kr per 2 km without crash/overheating
	crashKr = 50,
	mopSell = 0.6,
	maxSpeed = 40, -- m/s, faster movement than this is not paid (anti-cheat)
}
-- wheelie: rewards with diminishing returns, cap per minute
Config.WHEELIE = { h = { jog = 0.55, rok = 0.55, dt = 0.65 }, fr = 0.45, back = 0.2, pull = 400, pullT = 0.3, damp = 2.5, over = 0.14,
	minV = 8 / 3.6, minT = 0.5, max = 200, tau = 5, rate = 400 }

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[-- Player profile and economy rules (server authoritative). Pure logic without Roblox services so it can be tested.
-- Every function that changes money goes through book(), and money can never go below 0.
local Config = require(script.Parent.Config)
local Catalog = require(script.Parent.Catalog)
local Engine = require(script.Parent.Engine)
local Economy = {}
local E = Config.ECON

local function hex(c) return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
Economy.hex = hex
local function num(x, d, lo, hi) if type(x) ~= "number" or x ~= x or x == math.huge or x == -math.huge then return d end return math.min(hi, math.max(lo, x)) end

local function defCfg(m)
	return { jet = m.d.jet, port = m.d.port, roller = m.d.roller, col = hex(m.d.col), seat = hex(m.d.seat), num = m.d.num, fin = "gloss" }
end

local function newItem(p, sku, src, paid)
	p.uid = p.uid + 1
	local u = "i" .. p.uid
	p.items[u] = { s = sku, used = false, src = src, paid = paid or 0 }
	return u
end

function Economy.equipOEM(p, id)
	local inst = {}
	for slot in pairs(Catalog.slotsOf(id)) do
		local sku = Catalog.OEM[id][slot]
		if sku then inst[slot] = newItem(p, sku, "oem", 0) end
	end
	p.inst[id] = inst
end

function Economy.new()
	local p = { v = 1, money = E.start, own = {}, cur = "jog", cfgs = {}, items = {}, uid = 0, inst = {}, dmg = {},
		stats = { dist = 0, top = 0, wn = 0, best = 0, crash = 0, earned = 0 }, paid = 0, clean = 0, cleanPaid = 0, rep = 0, ledger = {} }
	for _, m in ipairs(Config.MOPEDS) do
		p.own[m.id] = true
		p.cfgs[m.id] = defCfg(m)
		p.dmg[m.id] = 0
		Economy.equipOEM(p, m.id)
	end
	return p
end

-- sanitize a stored profile (DataStore data is never trusted blindly)
function Economy.load(raw)
	local p = Economy.new()
	if type(raw) ~= "table" then return p end
	p.money = math.floor(num(raw.money, E.start, 0, 1e9))
	if type(raw.items) == "table" then
		p.items, p.uid = {}, math.floor(num(raw.uid, 0, 0, 1e9))
		for u, it in pairs(raw.items) do
			if type(u) == "string" and type(it) == "table" and Catalog.BY_SKU[it.s] then p.items[u] = { s = it.s, used = it.used == true, src = tostring(it.src or ""), paid = num(it.paid, 0, 0, 1e7) } end
		end
	end
	for _, m in ipairs(Config.MOPEDS) do
		local id = m.id
		if type(raw.own) == "table" then p.own[id] = raw.own[id] == true end
		local c = type(raw.cfgs) == "table" and raw.cfgs[id]
		if type(c) == "table" then
			local d = p.cfgs[id]
			d.jet = num(c.jet, d.jet, 40, 160); d.port = num(c.port, d.port, -4, 8); d.roller = num(c.roller, d.roller, 4, 14)
			if type(c.col) == "string" and c.col:match("^#%x%x%x%x%x%x$") then d.col = c.col end
			if type(c.seat) == "string" and c.seat:match("^#%x%x%x%x%x%x$") then d.seat = c.seat end
			if type(c.num) == "string" then d.num = c.num:gsub("%D", ""):sub(1, 2) end
			if c.fin == "gloss" or c.fin == "matt" or c.fin == "metal" then d.fin = c.fin end
		end
		p.dmg[id] = num(type(raw.dmg) == "table" and raw.dmg[id], 0, 0, 1)
		if type(raw.items) == "table" and type(raw.inst) == "table" and type(raw.inst[id]) == "table" then
			local inst, used = {}, {}
			for slot in pairs(Catalog.slotsOf(id)) do
				local u = raw.inst[id][slot]
				local it = type(u) == "string" and p.items[u]
				if it and not used[u] and Catalog.fits(Catalog.BY_SKU[it.s], id) and Catalog.BY_SKU[it.s].slot == slot then inst[slot] = u; used[u] = true
				elseif not Catalog.REMOVABLE[slot] and Catalog.OEM[id][slot] then inst[slot] = newItem(p, Catalog.OEM[id][slot], "oem", 0) end
			end
			p.inst[id] = inst
		elseif type(raw.items) == "table" then
			Economy.equipOEM(p, id) -- the items were replaced by the stored ones, so give this moped fresh original parts
		end
	end
	local anyOwn = false
	for _, m in ipairs(Config.MOPEDS) do if p.own[m.id] then anyOwn = true end end
	if not anyOwn then p.own.jog = true end
	if type(raw.cur) == "string" and Config.BY_ID[raw.cur] then p.cur = raw.cur end
	if type(raw.stats) == "table" then for k in pairs(p.stats) do p.stats[k] = num(raw.stats[k], 0, 0, 1e12) end end
	p.rep = math.floor(num(raw.rep, 0, 0, 1e9))
	p.paid = math.floor(num(raw.paid, 0, 0, 1e12)); p.clean = num(raw.clean, 0, 0, 1e9); p.cleanPaid = math.floor(num(raw.cleanPaid, 0, 0, 1e9))
	if type(raw.ledger) == "table" then for i = 1, math.min(#raw.ledger, 40) do local l = raw.ledger[i]; if type(l) == "table" and type(l.x) == "string" and type(l.a) == "number" then table.insert(p.ledger, { a = l.a, x = l.x, t = num(l.t, 0, 0, 1e12) }) end end end
	return p
end

function Economy.book(p, a, text, now)
	a = math.floor(a + 0.5)
	if a == 0 then return 0 end
	p.money = p.money + a
	if a > 0 then p.stats.earned = p.stats.earned + a end
	table.insert(p.ledger, 1, { a = a, x = text, t = now or 0 })
	while #p.ledger > 40 do table.remove(p.ledger) end
	return a
end
function Economy.spend(p, a, text, now)
	a = math.floor(a + 0.5)
	if a < 0 or a > p.money then return false end
	Economy.book(p, -a, text, now)
	return true
end
function Economy.fine(p, a, text, now) return -Economy.book(p, -math.min(math.floor(a + 0.5), p.money), text, now) end

function Economy.installedOn(p, u)
	for id, inst in pairs(p.inst) do for slot, v in pairs(inst) do if v == u then return id, slot end end end
	return nil
end
function Economy.ecfg(p, id)
	local c = p.cfgs[id]
	return Catalog.ecfg(id, { jet = c.jet, port = c.port, roller = c.roller }, p.inst[id], p.items)
end
function Economy.engine(p, id)
	local P = Engine.calc(Economy.ecfg(p, id))
	P.cond = 1 - 0.4 * (p.dmg[id] or 0)
	P.hp = Engine.peakHp(P)
	return P
end

function Economy.canInstall(p, u, id)
	local it = p.items[u]
	local pr = it and Catalog.BY_SKU[it.s]
	if not pr then return "Okänd del" end
	if not p.own[id] then return "Du äger inte mopeden" end
	if not Catalog.fits(pr, id) then return "Passar inte " .. Config.BY_ID[id].n end
	if Economy.installedOn(p, u) then return "Redan monterad" end
	local cur = p.inst[id][pr.slot]
	if cur and p.items[cur] and p.items[cur].s == it.s then return "Samma del sitter redan på mopeden" end
	return nil
end
function Economy.install(p, u, id)
	local why = Economy.canInstall(p, u, id)
	if why then return false, why end
	local slot = Catalog.BY_SKU[p.items[u].s].slot
	local old = p.inst[id][slot]
	p.inst[id][slot] = u
	p.items[u].used = true
	if old and p.items[old] then p.items[old].used = true end
	return true
end
function Economy.uninstall(p, id, slot)
	if not Catalog.REMOVABLE[slot] then return false, "Den här delen byts genom att montera en annan" end
	if not p.inst[id] or not p.inst[id][slot] then return false, "Ingen del monterad" end
	p.inst[id][slot] = nil
	return true
end

-- buy: all or nothing. qty 1..10. installOn = moped id to install on directly (optional)
function Economy.buy(p, sku, qty, installOn, now)
	local pr = Catalog.BY_SKU[sku]
	qty = math.floor(num(qty, 1, 1, 10))
	if not pr then return false, "Produkten finns inte" end
	local tot = pr.price * qty
	if tot > p.money then return false, "Du har inte råd (" .. tot .. " kr, du har " .. p.money .. " kr)" end
	Economy.spend(p, tot, "Köp: " .. qty .. "× " .. pr.name, now)
	local us = {}
	for _ = 1, qty do table.insert(us, newItem(p, sku, "demo", pr.price)) end
	local installed = false
	if installOn and Config.BY_ID[installOn] and Catalog.fits(pr, installOn) then installed = Economy.install(p, us[1], installOn) end
	return true, nil, us, installed
end
function Economy.sellPrice(p, u)
	local it = p.items[u]
	local pr = it and Catalog.BY_SKU[it.s]
	if not pr then return 0 end
	return math.floor(pr.price * (it.used and 0.5 or 0.7) + 0.5)
end
function Economy.sell(p, u, now)
	if not p.items[u] then return false, "Okänd del" end
	if Economy.installedOn(p, u) then return false, "Delen är monterad" end
	local v = Economy.sellPrice(p, u)
	local name = Catalog.BY_SKU[p.items[u].s].name
	p.items[u] = nil
	Economy.book(p, v, "Sålde " .. name, now)
	return true
end

function Economy.tune(p, id, key, value)
	local c = p.cfgs[id]
	if not c or not p.own[id] then return false, "Du äger inte mopeden" end
	if key == "jet" or key == "roller" then
		local e = Economy.ecfg(p, id)
		local lo, hi = key == "jet" and e.jlo or e.rlo, key == "jet" and e.jhi or e.rhi
		c[key] = num(value, c[key], lo, hi)
		if key == "roller" then c[key] = math.floor(c[key] * 2 + 0.5) / 2 else c[key] = math.floor(c[key] + 0.5) end
	elseif key == "port" then c.port = math.floor(num(value, c.port, -4, 8) * 2 + 0.5) / 2
	elseif key == "fin" then if value == "gloss" or value == "matt" or value == "metal" then c.fin = value else return false, "Okänd finish" end
	elseif key == "col" or key == "seat" then if type(value) == "string" and value:match("^#%x%x%x%x%x%x$") then c[key] = value else return false, "Ogiltig färg" end
	elseif key == "num" then c.num = tostring(value):gsub("%D", ""):sub(1, 2)
	else return false, "Okänd inställning" end
	return true
end

function Economy.repairCost(p, id) local d = p.dmg[id] or 0; if d >= 1 then return 1500 end return math.floor(100 + 900 * d + 0.5) end
function Economy.repair(p, id, emergency, now)
	local d = p.dmg[id] or 0
	if d <= 0 then return false, "Motorn är hel" end
	if emergency then
		if d <= 0.5 then return false, "Nödlagning behövs inte" end
		if p.money >= Economy.repairCost(p, id) then return false, "Du har råd med en riktig reparation" end
		p.dmg[id] = 0.5
		p.rep = (p.rep or 0) + 1
		return true
	end
	if not Economy.spend(p, Economy.repairCost(p, id), "Reparation, " .. Config.BY_ID[id].n, now) then return false, "Du har inte råd" end
	p.dmg[id] = 0
	p.rep = (p.rep or 0) + 1
	return true
end

function Economy.sellValue(p, id) return math.floor(Config.BY_ID[id].price * E.mopSell * (1 - 0.5 * (p.dmg[id] or 0)) + 0.5) end
function Economy.sellMoped(p, id, now)
	if not p.own[id] then return false, "Du äger inte mopeden" end
	local owned = 0
	for _, m in ipairs(Config.MOPEDS) do if p.own[m.id] then owned = owned + 1 end end
	if owned < 2 then return false, "Du måste ha minst en moped" end
	local v = Economy.sellValue(p, id)
	for _, u in pairs(p.inst[id] or {}) do if p.items[u] and p.items[u].src == "oem" then p.items[u] = nil end end -- OEM parts go with the moped, aftermarket parts go to storage
	p.inst[id] = {}
	p.own[id] = false
	p.dmg[id] = 0
	p.cfgs[id] = defCfg(Config.BY_ID[id])
	Economy.book(p, v, "Sålde " .. Config.BY_ID[id].n, now)
	if p.cur == id then for _, m in ipairs(Config.MOPEDS) do if p.own[m.id] then p.cur = m.id; break end end end
	return true
end
function Economy.buyMoped(p, id, now)
	local m = Config.BY_ID[id]
	if not m then return false, "Okänd moped" end
	if p.own[id] then return false, "Du äger redan mopeden" end
	if not Economy.spend(p, m.price, "Köpte " .. m.n, now) then return false, "Du har inte råd" end
	p.own[id] = true
	p.cfgs[id] = defCfg(m)
	p.dmg[id] = 0
	Economy.equipOEM(p, id)
	return true
end

-- riding: the server measures the distance itself; money is paid per completed 100 m block, never twice
function Economy.addDistance(p, meters, now)
	if meters <= 0 then return 0 end
	p.stats.dist = p.stats.dist + meters
	p.clean = p.clean + meters
	local got = 0
	local b = math.floor(p.stats.dist / E.distM)
	if b > p.paid then got = got + Economy.book(p, (b - p.paid) * E.distKr, "Körsträcka", now); p.paid = b end
	local c = math.floor(p.clean / E.cleanM)
	if c > p.cleanPaid then got = got + Economy.book(p, (c - p.cleanPaid) * E.cleanKr, "Ren körning 2 km", now); p.cleanPaid = c end
	return got
end
function Economy.dirty(p) p.clean = 0; p.cleanPaid = 0 end
function Economy.crash(p, why, now)
	p.stats.crash = p.stats.crash + 1
	Economy.dirty(p)
	return Economy.fine(p, E.crashKr, "Vurpa: " .. tostring(why or ""), now)
end

-- wheelie: the server calculates the reward itself from the reported values and checks them against what it saw
-- t = valid time (s), vAvg = average speed (m/s), sd = pitch spread (rad), imp = landing speed (rad/s)
function Economy.wheelieValue(t, vAvg, sd, imp)
	local W = Config.WHEELIE
	if t < W.minT then return 0, 0 end
	local base = W.max * (1 - math.exp(-t / W.tau))
	local mult = math.min(1.5, math.max(0.5, vAvg * 3.6 / 30)) * (1 - math.min(0.5, sd / 0.15))
	local q = imp < 1 and 1 or imp < 2.5 and 0.7 or 0.4
	return math.floor(base * mult * q + 0.5), mult
end
function Economy.wheelie(p, t, vAvg, sd, imp, now, seenDist)
	local W = Config.WHEELIE
	t, vAvg, sd, imp = num(t, 0, 0, 120), num(vAvg, 0, 0, E.maxSpeed), num(sd, 0, 0, 3), num(imp, 0, 0, 50)
	if t < W.minT then return 0, "För kort" end
	if seenDist and seenDist < t * W.minV * 0.5 then return 0, "Servern såg inte att du rörde dig" end
	local r = Economy.wheelieValue(t, vAvg, sd, imp)
	p._wh = p._wh or {}
	local keep, used = {}, 0
	for _, x in ipairs(p._wh) do if now - x[1] < 60 then table.insert(keep, x); used = used + x[2] end end
	p._wh = keep
	r = math.min(r, math.max(0, W.rate - used))
	p.stats.wn = p.stats.wn + 1
	p.stats.best = math.max(p.stats.best, t)
	if r > 0 then table.insert(p._wh, { now, r }); Economy.book(p, r, string.format("Stegring %.1f s", t), now) end
	return r
end

-- data sent to the client (without transient fields)
function Economy.public(p)
	local o = {}
	for k, v in pairs(p) do if k:sub(1, 1) ~= "_" then o[k] = v end end
	return o
end

return Economy
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Engine</string><ProtectedString name="Source"><![CDATA[-- Engine model, ported line by line from the web version (calc/torque/target/therm in moppe/index.html).
local Config = require(script.Parent.Config)
local Engine = {}

local function clamp(x, a, b) if x < a then return a elseif x > b then return b end return x end

-- c: effective config (tuning values + values from installed parts, see Catalog.ecfg)
function Engine.calc(c)
	local k, e = Config.KITS[c.kit + 1], Config.EXH[c.exh + 1]
	local D, dia = k.cc / 50, Config.CARB[c.carb + 1]
	local fdia, fc = math.min(dia, c.maxd or 99), c.fcap or 1 -- the intake throttles flow, a sport filter adds air
	local ex = k.ex + c.port
	local portPk = 7000 + (ex - 175) * 233
	local pk = 0.4 * portPk + 0.6 * e.t
	local match = math.exp(-((portPk - e.t) / 2800) ^ 2)
	local opt = dia * 5 * math.sqrt(D) * (0.85 + pk / 60000)
	local m = c.jet / opt / math.sqrt(fc)
	local fuelF
	if m < 1 then fuelF = 1 - 3 * (1 - m) ^ 2 else fuelF = 1 - 0.8 * (m - 1) ^ 2 end
	fuelF = math.max(0.45, fuelF)
	local cap, need = (fdia / 17.5) ^ 2 * fc, D * pk / 12000
	local restr = math.min(1, math.sqrt(cap / need))
	return {
		ex = ex, portPk = portPk, pk = pk, w = e.w, match = match, m = m, fuelF = fuelF,
		resp = fuelF * (0.55 + 0.45 * match) * (0.7 + 0.3 * restr), restr = restr, over = math.max(0, cap / need - 1.6),
		tmax = 4.2 * D * k.q * e.g * (0.75 + 0.25 * match),
		heat = 1 + math.max(0, 1 - m) * 2.2 + math.max(0, ex - 185) * 0.03 + (1 - match) * 0.3 + math.max(0, m - 1.25) * 0.3,
		lim = math.min(c.icap or 1e9, math.max(9500, pk * 1.2 + 500)), -- ignition rev limit
		cond = 1,
	}
end

function Engine.torque(P, rpm)
	local g = math.exp(-((rpm - P.pk) / P.w) ^ 2)
	local t = P.tmax * (0.3 + 0.7 * g) * P.fuelF
	t = t * (1 - (1 - P.restr) * math.min(1, rpm / P.pk))
	t = t * (1 - math.min(0.35, P.over * 0.3) * math.max(0, 1 - rpm / (P.pk * 0.9)))
	if rpm > P.lim then return 0 end
	return t * (P.cond or 1)
end

-- peak power in hp from the curve (same sampling as the web dyno)
function Engine.peakHp(P)
	local hb, at = 0, 0
	for r = 2000, 15000, 250 do
		local h = Engine.torque(P, r) * r / 9549 * 1.341
		if h > hb then hb, at = h, r end
	end
	return hb, at
end

function Engine.target(c) return 5200 + 780 * (14 - c.roller) + (c.cdt or 0) end

-- ---------- heat model ----------
-- Air-cooled: one lump (cylinder+head), the sensor is a CHT under the spark plug.
-- Liquid-cooled: cylinder and coolant as two lumps, the sensor is in the coolant.
Engine.TH = {
	jog = { C = 2500, a0 = 4, af = 5.3, av = 0.6 },
	dt = { C = 2500, a0 = 6, af = 0, av = 4.7 },
	rok = { C = 1500, G = 100, a0 = 2, Cw = 4200, r0 = 10, rv = 9.3 },
}
Engine.BAND = {
	air = { lab = "Topptemp (CHT)", b = { { 50, "kall, varmkör", Color3.fromRGB(74, 163, 255) }, { 200, "normal", Color3.fromRGB(107, 211, 107) }, { 230, "varm", Color3.fromRGB(255, 176, 32) }, { 1e9, "ÖVERHETTAD", Color3.fromRGB(255, 106, 74) } } },
	liquid = { lab = "Kylvätska", b = { { 50, "kall, varmkör", Color3.fromRGB(74, 163, 255) }, { 95, "normal", Color3.fromRGB(107, 211, 107) }, { 110, "varm", Color3.fromRGB(255, 176, 32) }, { 1e9, "KOKAR", Color3.fromRGB(255, 106, 74) } } },
}
Engine.T_LOSS, Engine.T_DMG, Engine.T_BOIL = 225, 240, 120

function Engine.newThermal() return { tc = Config.AMB, tw = Config.AMB, boil = false, dmg = 0 } end

-- s: thermal state, Q: heat input (W), rpm, v (m/s), cf: cooling factor from parts
function Engine.therm(mop, s, dt, Q, rpm, v, cf)
	local t, AMB = Engine.TH[mop.id], Config.AMB
	cf = cf or 1
	if mop.cool == "liquid" then
		local hr = (t.r0 + t.rv * cf * v ^ 0.8) * (s.boil and 0.35 or 1)
		local q = t.G * (s.boil and 0.4 or 1) * (s.tc - s.tw)
		s.tc = s.tc + (Q - q - t.a0 * (s.tc - AMB)) / t.C * dt
		s.tw = math.min(Engine.T_BOIL, s.tw + (q - hr * (s.tw - AMB)) / t.Cw * dt)
		if s.tw >= Engine.T_BOIL - 0.5 then s.boil = true elseif s.tw < 100 then s.boil = false end
	else
		local hA = t.a0 + cf * (t.af * (rpm / 1000) ^ 0.8 + t.av * v ^ 0.8)
		s.tc = s.tc + (Q - hA * (s.tc - AMB)) / t.C * dt
	end
	if s.tc > Engine.T_DMG then s.dmg = math.min(1, s.dmg + dt * (s.tc - Engine.T_DMG) / 900) end
end

function Engine.heatF(s) return 1 - math.min(0.45, math.max(0, (s.tc - Engine.T_LOSS) / 100)) end

function Engine.heatIn(P, torqueNm, rpm) return P.heat * (1.4 * torqueNm * rpm * math.pi / 30 + 300 * rpm / 1000) end

function Engine.tinfo(mop, s)
	local B = Engine.BAND[mop.cool]
	local v = mop.cool == "liquid" and s.tw or s.tc
	for _, b in ipairs(B.b) do
		if v < b[1] then return { lab = B.lab, v = v, band = b[2], col = b[3], tc = s.tc, dmg = s.dmg } end
	end
end

Engine.clamp = clamp
return Engine
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">RideSim</string><ProtectedString name="Source"><![CDATA[-- Riding physics without Roblox services (testable): engine, CVT/gears, temperature, wheelie and crash.
-- Ported from the web version's step(). Events (engine/crash/wheelie/dmg/dirty/say) go out via sim.emit.
local Config = require(script.Parent.Config)
local Engine = require(script.Parent.Engine)
local Economy = require(script.Parent.Economy)
local W = Config.WHEELIE
local RideSim = {}

function RideSim.new(emit)
	local R = { v = 0, rpm = 0, thr = 0, gear = 1, ratio = 2.9, h = 0, lean = 0, pitch = 0, pw = 0, on = false, crash = nil, wh = nil,
		t0 = nil, t60 = nil, clk = 0, pullT = 0, pull0 = false, acc = 0, thermal = {}, emit = emit or function() end, lastDmg = 0, lastDirty = -99 }
	for _, m in ipairs(Config.MOPEDS) do R.thermal[m.id] = Engine.newThermal() end
	return R
end

-- load the engine for the current moped from a profile
function RideSim.setProfile(R, p)
	R.mop = Config.BY_ID[p.cur]
	R.E = Economy.ecfg(p, p.cur)
	R.P = Economy.engine(p, p.cur)
	-- the client calculates damage; only a repair on the server (p.rep counter) may lower it
	local th = R.thermal[p.cur]
	if R.rep ~= (p.rep or 0) then R.rep = p.rep or 0; th.dmg = p.dmg[p.cur] or 0; R.lastDmg = th.dmg
	else th.dmg = math.max(th.dmg, p.dmg[p.cur] or 0) end
end

function RideSim.kick(R, tries, rand)
	rand = rand or math.random
	local P = R.P
	if R.on or R.v > 3 or R.crash or not P then return false end
	if R.thermal[R.mop.id].dmg >= 1 then R.emit("say", "Motorn har skurit. Reparera den i garaget."); return false end
	local p = math.max(0.08, 0.18 + 0.62 * P.fuelF - (P.m > 1.3 and 0.15 or 0))
	for _ = 1, tries or 1 do
		if rand() < p then R.on = true; R.rpm = 2600; R.emit("engine", true); R.emit("say", "Motorn startade!"); return true end
	end
	R.emit("say", "Kick... den startade inte" .. (P.m < 0.9 and " (för mager?)" or P.m > 1.15 and " (för fet?)" or ""))
	return false
end
function RideSim.stop(R) if R.on then R.on = false; R.emit("engine", false); R.emit("say", "Motorn stängdes av") end end

local function crash(R, why)
	if R.crash then return end
	R.crash = { t = 0, why = why, side = R.lean < 0 and -1 or 1 }
	R.on, R.wh = false, nil
	R.emit("engine", false)
	R.emit("crash", why)
	R.emit("say", "VURPA: " .. why)
end

-- estimate for the HUD during the wheelie (assumes a soft landing; the server calculates the real reward)
function RideSim.whValue(w)
	if w.t < W.minT or w.n == 0 then return 0, 0 end
	return Economy.wheelieValue(w.t, w.vs / w.t, math.sqrt(math.max(0, w.s2 / w.n - (w.s1 / w.n) ^ 2)), 0)
end

local function land(R, imp)
	local w = R.wh
	R.wh = nil
	if imp > 4.5 then crash(R, "för hård landning"); return end
	if w.t < W.minT then R.emit("say", string.format("Kort lyft (%.1f s), räknas inte", w.t)); return end
	R.emit("wheelie", w.t, w.vs / w.t, math.sqrt(math.max(0, w.s2 / w.n - (w.s1 / w.n) ^ 2)), imp)
end

-- moment balance about the rear axle
local function wheelie(R, dt, a, thr, brk, back)
	local mop = R.mop
	local h = W.h[mop.id]
	back = back and R.on and brk == 0
	local b = mop.wb * W.fr - (back and W.back or 0)
	local mass = mop.m + 75
	local I = mass * (h * h + b * b)
	if back and not R.pull0 then R.pull0 = true; R.pullT = thr > 0.5 and W.pullT or 0 end
	if not back then R.pull0 = false end
	local Mr = R.pullT > 0 and W.pull or 0
	R.pullT = math.max(0, R.pullT - dt)
	local n = 4
	local d = dt / n
	for _ = 1, n do
		local th = R.pitch
		local M = mass * a * (h * math.cos(th) + b * math.sin(th)) - mass * 9.81 * (b * math.cos(th) - h * math.sin(th)) + Mr - W.damp * I * R.pw
		if th <= 0 and M <= 0 then R.pitch, R.pw = 0, 0
		else
			R.pw = R.pw + M / I * d
			R.pitch = R.pitch + R.pw * d
			if R.pitch <= 0 then local imp = -R.pw; R.pitch, R.pw = 0, 0; if R.wh then land(R, imp) end end
		end
	end
	if R.pitch > math.atan2(b, h) + W.over then crash(R, "tippade bakåt i en stegring"); return end
	if R.pitch > 0.035 and not R.crash then
		if not R.wh then R.wh = { t = 0, all = 0, vs = 0, s1 = 0, s2 = 0, n = 0 } end
		local w = R.wh
		w.all = w.all + dt
		if R.v >= W.minV and R.on then w.t = w.t + dt; w.vs = w.vs + R.v * dt; w.s1 = w.s1 + R.pitch; w.s2 = w.s2 + R.pitch * R.pitch; w.n = w.n + 1 end
	end
end

local function heat(R, dt, Tq, v)
	for _, m in ipairs(Config.MOPEDS) do
		local active = m.id == R.mop.id
		local on = active and R.on
		local rpm = on and R.rpm or 0
		Engine.therm(m, R.thermal[m.id], dt, on and Engine.heatIn(R.P, Tq, rpm) or 0, rpm, active and v or 0, active and R.E.cf or 1)
	end
	local s = R.thermal[R.mop.id]
	if R.on and s.dmg >= 1 then R.on = false; R.emit("engine", false); R.emit("say", "Kolvskär! Motorn skar av överhettning. Reparera den i garaget.") end
	if math.abs(s.dmg - R.lastDmg) >= 0.01 then R.lastDmg = s.dmg; R.emit("dmg", s.dmg) end
	local band = Engine.tinfo(R.mop, s).band
	if (band == "varm" or band == "ÖVERHETTAD" or band == "KOKAR") and R.clk - R.lastDirty > 5 then R.lastDirty = R.clk; R.emit("dirty") end
end

-- input: { thr = 0/1, brk = 0/1, st = -1..1, back = bool }
function RideSim.step(R, dt, seated, input)
	local P, E, mop = R.P, R.E, R.mop
	R.thr = R.thr + (input.thr - R.thr) * math.min(1, dt * (2 + 8 * P.resp))
	local thr = R.thr
	R.clk = R.clk + dt
	if not seated then
		local goal = (not R.on) and 0 or (thr > 0.02 and 1800 + thr * (P.pk * 1.05 - 1800) or 1800)
		R.rpm = R.rpm + (goal - R.rpm) * math.min(1, dt * (R.on and 3 + 9 * P.resp or 4))
		heat(R, dt, R.on and Engine.torque(P, R.rpm) * (0.15 + 0.85 * thr) * Engine.heatF(R.thermal[mop.id]) * 0.25 or 0, 0)
		R.v, R.pitch, R.pw = 0, 0, 0
		return
	end
	if R.crash then
		local c = R.crash
		c.t = c.t + dt
		R.v = math.max(0, R.v - 7 * dt)
		R.pitch = math.max(0, R.pitch - 3 * dt)
		R.rpm = math.max(0, R.rpm - 4000 * dt)
		heat(R, dt, 0, R.v)
		if c.t > 2.5 then R.crash, R.lean, R.pitch, R.pw = nil, 0, 0, 0; R.emit("say", "Mopeden är uppe igen. K = starta") end
		return
	end
	local wheelRpm = R.v / (2 * math.pi * mop.wr) * 60
	local tot, des
	local tg = Engine.target(E) * (0.55 + 0.45 * math.max(thr, 0.2))
	if mop.cvt then
		R.ratio = math.min(2.9, math.max(E.rmin, tg / math.max(wheelRpm * mop.fd, 1)))
		tot = R.ratio * mop.fd
		des = math.max(wheelRpm * tot, thr > 0.05 and math.min(tg, E.slip * (0.55 + 0.45 * thr)) or 1800)
	else
		tot = Config.GEARS[R.gear] * mop.fd
		des = math.max(wheelRpm * tot, thr > 0.05 and 2200 + thr * (P.pk - 2200) or 1800)
	end
	if not R.on then des = 0 end
	R.rpm = R.rpm + (des - R.rpm) * math.min(1, dt * (R.on and 3 + 9 * P.resp or 3))
	R.rpm = math.min(R.rpm, P.lim * 1.03)
	local Tq = Engine.torque(P, R.rpm) * (0.15 + 0.85 * thr)
	if thr < 0.02 and not mop.cvt then Tq = -0.5 end
	Tq = Tq * Engine.heatF(R.thermal[mop.id])
	if not R.on then Tq = 0 end
	local mass = mop.m + 75
	local eff = mop.cvt and 0.85 * (1 - math.min(0.15, math.max(0, (P.hp - E.blim) * 0.03))) or 0.85 -- a weak belt slips
	local F = Tq * tot * eff / mop.wr
	local drag = 0.33 * R.v * R.v + 0.015 * mass * 9.8
	R.acc = (F - (R.v > 0 and drag or 0)) / mass
	local a = R.acc - input.brk * 6.5
	if R.v <= 0 and a < 0 then a = 0 end
	R.v = math.max(0, R.v + a * dt)
	heat(R, dt, math.max(0, Tq), R.v)
	R.h = R.h - input.st * (1 - R.pitch * 0.6) * 1.6 * math.min(1, R.v / 1.5) / (1 + R.v * 0.12) * dt
	R.lean = R.lean + ((input.st * math.min(R.v, 18) * 0.025) - R.lean) * math.min(1, dt * 5)
	wheelie(R, dt, a, thr, input.brk, input.back)
	if R.v < 0.1 and thr > 0.5 and R.on and R.t0 == nil then R.t0 = R.clk end
	if R.v < 0.1 and thr < 0.1 then R.t0 = nil end
	if R.t0 and R.v >= 16.67 then R.t60 = R.clk - R.t0; R.t0 = nil end
end

return RideSim
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX14"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX12"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Server: profiles (DataStore), API for the client, spawning the moped, distance measured by the server.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local PhysicsService = game:GetService("PhysicsService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Economy = require(Shared.Economy)
local Builder = require(Shared.Builder)

-- the rider does not collide with anything while seated: otherwise legs and feet drag on the ground and tip the moped over
pcall(function()
	PhysicsService:RegisterCollisionGroup("Rider")
	PhysicsService:CollisionGroupSetCollidable("Rider", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("Rider", "Rider", false)
end)
local function setRider(char, on)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then d.CollisionGroup = on and "Rider" or "Default" end
	end
end

local remotes = Instance.new("Folder"); remotes.Name = "Remotes"; remotes.Parent = RS
local Api = Instance.new("RemoteFunction"); Api.Name = "Api"; Api.Parent = remotes
local StateEv = Instance.new("RemoteEvent"); StateEv.Name = "State"; StateEv.Parent = remotes
local Report = Instance.new("RemoteEvent"); Report.Name = "Report"; Report.Parent = remotes

local store
do
	local ok, err = pcall(function() store = DataStoreService:GetDataStore("MoppeGarage_v1") end)
	if not ok then warn("DataStore är inte tillgänglig, inget sparas: " .. tostring(err)); store = nil end
end

local profiles, sessions = {}, {}
local function now() return os.time() end
local function push(plr, msg)
	local p = profiles[plr]
	if p then StateEv:FireClient(plr, Economy.public(p), msg, sessions[plr] and sessions[plr].saveOk) end
end

local function load(plr)
	local raw, ok, err = nil, false, nil
	if store then
		for attempt = 1, 3 do
			ok, err = pcall(function() raw = store:GetAsync("p_" .. plr.UserId) end)
			if ok then break end
			task.wait(attempt)
		end
	end
	profiles[plr] = Economy.load(raw)
	sessions[plr] = { saveOk = store ~= nil and ok, last = nil, seated = false, moped = nil, engineOn = false, distLog = {} }
	if store and not ok then warn("Kunde inte läsa sparningen för " .. plr.Name .. ": " .. tostring(err) .. ". Sparar inte den här sessionen så att inget skrivs över.") end
end
local function save(plr)
	local p, s = profiles[plr], sessions[plr]
	if not (p and s and store and s.saveOk) then return false end
	local data = Economy.public(p)
	local ok, err = pcall(function() store:SetAsync("p_" .. plr.UserId, data) end)
	if not ok then warn("Kunde inte spara " .. plr.Name .. ": " .. tostring(err)) end
	return ok
end

local function look(p, id)
	local c = p.cfgs[id]
	return { col = Color3.fromHex(c.col), seat = Color3.fromHex(c.seat), num = c.num, fin = c.fin, rim = Builder.C.alu }
end

-- spawn (or replace) the player's moped and put the character in the seat
local function spawnMoped(plr, atCf)
	local p, s = profiles[plr], sessions[plr]
	local id = p.cur
	if not p.own[id] then return false, "Du äger inte mopeden" end
	if s.moped then s.moped:Destroy(); s.moped = nil end
	local mop = Config.BY_ID[id]
	local model = Builder.moped(mop, Economy.ecfg(p, id), look(p, id))
	model.Name = "Moped_" .. plr.Name
	local spot = workspace:FindFirstChild("MoppeWorld") and workspace.MoppeWorld:FindFirstChild("Garage") and workspace.MoppeWorld.Garage:FindFirstChild("MopedSpot")
	-- the root sits (wr + 0.15) m above the ground: place it so the wheels end up exactly on the floor
	-- (too low makes the wheels start inside the floor; Roblox then pushes the moped out with a jolt and it tips)
	local lift = (mop.wr + 0.15) / Config.STUD + 0.05
	local groundY = spot and (spot.Position.Y - spot.Size.Y / 2 - 0.05) or 0
	local cf = atCf or CFrame.new(spot and spot.Position.X or 0, groundY + lift, spot and spot.Position.Z or 0)
	model:PivotTo(cf)
	-- constraints the client drives (the client owns the physics of its moped)
	local root = model.PrimaryPart
	local att = Instance.new("Attachment"); att.Name = "Drive"; att.Parent = root
	local lv = Instance.new("LinearVelocity")
	lv.Name = "Drive"; lv.Attachment0 = att; lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.new(1, 0, 0); lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	lv.RelativeTo = Enum.ActuatorRelativeTo.World; lv.MaxForce = 2e4; lv.PlaneVelocity = Vector2.new(0, 0); lv.Parent = root -- parked: stays put
	local ao = Instance.new("AlignOrientation")
	ao.Name = "Tilt"; ao.Mode = Enum.OrientationAlignmentMode.OneAttachment; ao.Attachment0 = att
	ao.Responsiveness = 40; ao.MaxTorque = 1e6; ao.RigidityEnabled = false; ao.CFrame = cf.Rotation; ao.Parent = root -- always upright, like on its kickstand
	local owner = Instance.new("ObjectValue"); owner.Name = "Owner"; owner.Value = plr; owner.Parent = model
	local mid = Instance.new("StringValue"); mid.Name = "MopedId"; mid.Value = id; mid.Parent = model
	model.Parent = workspace
	for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") then pcall(function() d:SetNetworkOwner(plr) end) end end
	local seatPart = model:FindFirstChild("Seat")
	local lastChar
	seatPart:GetPropertyChangedSignal("Occupant"):Connect(function()
		local hum = seatPart.Occupant
		if hum and hum.Parent then lastChar = hum.Parent; setRider(lastChar, true)
		elseif lastChar then setRider(lastChar, false); lastChar = nil end
	end)
	s.moped, s.last = model, nil
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then model.Seat:Sit(hum) end
	return true
end

-- API from the client. All changes are validated here; the client only displays.
local handlers = {}
handlers.state = function(plr) return true end
handlers.select = function(plr, id)
	local p = profiles[plr]
	if not Config.BY_ID[id] then return false, "Okänd moped" end
	p.cur = id
	return true
end
handlers.spawn = function(plr) return spawnMoped(plr) end
handlers.buy = function(plr, sku, qty, installNow)
	local p = profiles[plr]
	local ok, err, _, inst = Economy.buy(p, sku, qty, installNow and p.cur or nil, now())
	if ok and inst then local s = sessions[plr]; if s.moped then spawnMoped(plr, s.moped:GetPivot()) end end
	return ok, err or (inst and "Köpt och monterat" or "Köpt, ligger i förrådet")
end
handlers.install = function(plr, u)
	local p = profiles[plr]
	local ok, err = Economy.install(p, u, p.cur)
	if ok then local s = sessions[plr]; if s.moped then spawnMoped(plr, s.moped:GetPivot()) end end
	return ok, err
end
handlers.uninstall = function(plr, slot)
	local p = profiles[plr]
	local ok, err = Economy.uninstall(p, p.cur, slot)
	if ok then local s = sessions[plr]; if s.moped then spawnMoped(plr, s.moped:GetPivot()) end end
	return ok, err
end
handlers.sell = function(plr, u) return Economy.sell(profiles[plr], u, now()) end
handlers.tune = function(plr, key, value)
	local p = profiles[plr]
	local ok, err = Economy.tune(p, p.cur, key, value)
	if ok and (key == "col" or key == "seat" or key == "fin" or key == "num") then local s = sessions[plr]; if s.moped then spawnMoped(plr, s.moped:GetPivot()) end end
	return ok, err
end
handlers.repair = function(plr, emergency) local p = profiles[plr]; return Economy.repair(p, p.cur, emergency == true, now()) end
handlers.buyMoped = function(plr, id) return Economy.buyMoped(profiles[plr], id, now()) end
handlers.sellMoped = function(plr, id)
	local p, s = profiles[plr], sessions[plr]
	if s.moped and s.moped.MopedId.Value == id then s.moped:Destroy(); s.moped = nil end
	return Economy.sellMoped(p, id, now())
end
handlers.save = function(plr) return save(plr), "Sparat" end

Api.OnServerInvoke = function(plr, action, ...)
	local p = profiles[plr]
	if not p then return false, "Profilen laddas fortfarande" end
	local h = handlers[action]
	if type(action) ~= "string" or not h then return false, "Okänt anrop" end
	local ok, res, msg = pcall(h, plr, ...)
	if not ok then warn("Fel i " .. action .. ": " .. tostring(res)); return false, "Serverfel" end
	push(plr, msg or res)
	return res, msg
end

-- reports from the client: engine on/off, damage, crash, wheelie. Checked against what the server saw.
Report.OnServerEvent:Connect(function(plr, kind, a, b, c, d)
	local p, s = profiles[plr], sessions[plr]
	if not p then return end
	if kind == "engine" then s.engineOn = a == true
	elseif kind == "dmg" then if type(a) == "number" then p.dmg[p.cur] = math.clamp(a, 0, 1) end
	elseif kind == "dirty" then Economy.dirty(p)
	elseif kind == "crash" then Economy.crash(p, tostring(a):sub(1, 60), now()); push(plr)
	elseif kind == "wheelie" then
		-- distance the server itself saw during the wheelie (a = time in s)
		local seen, t0 = 0, os.clock() - (tonumber(a) or 0)
		for _, e in ipairs(s.distLog) do if e[1] >= t0 then seen = seen + e[2] end end
		local r, why = Economy.wheelie(p, a, b, c, d, now(), seen)
		push(plr, r > 0 and ("Stegring: +" .. r .. " kr") or why)
	end
end)

-- the server measures the distance from the moped's position (max Config.ECON.maxSpeed m/s, only while seated with the engine running)
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc = acc + dt
	if acc < 0.5 then return end
	local step = acc
	acc = 0
	for plr, s in pairs(sessions) do
		local p = profiles[plr]
		local m = s.moped
		local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		local seated = m and m.Parent and hum and hum.SeatPart == m:FindFirstChild("Seat")
		if seated and s.engineOn then
			local pos = m:GetPivot().Position
			if s.last then
				local d = Vector3.new(pos.X - s.last.X, 0, pos.Z - s.last.Z).Magnitude * Config.STUD
				if d / step <= Config.ECON.maxSpeed then
					local got = Economy.addDistance(p, d, now())
					p.stats.top = math.max(p.stats.top, d / step)
					table.insert(s.distLog, { os.clock(), d })
					if got > 0 then push(plr) end
				end
			end
			s.last = pos
		else
			s.last = nil
		end
		while #s.distLog > 0 and os.clock() - s.distLog[1][1] > 130 do table.remove(s.distLog, 1) end
	end
end)

local function onAdded(plr)
	if profiles[plr] then return end
	load(plr)
	plr.CharacterAdded:Connect(function() task.wait(1); push(plr) end)
	push(plr, store and (sessions[plr].saveOk and "Välkommen tillbaka" or "Sparningen kunde inte läsas, inget sparas den här gången") or "Sparning är avstängd (DataStore saknas i Studio)")
end
Players.PlayerAdded:Connect(onAdded)
for _, plr in ipairs(Players:GetPlayers()) do task.spawn(onAdded, plr) end -- players who joined before the script started
Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	local s = sessions[plr]
	if s and s.moped then s.moped:Destroy() end
	profiles[plr], sessions[plr] = nil, nil
end)
game:BindToClose(function() for plr in pairs(profiles) do save(plr) end end)
task.spawn(function() while true do task.wait(60); for plr in pairs(profiles) do save(plr) end end end)
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX13"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Builds the world when the server starts: Roblox Terrain (grass, hills, lake), a large garage,
-- road with curbs and streetlights, drag strip, ring track, Swedish houses, trees, light.
local Lighting = game:GetService("Lighting")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local S = 1 / Config.STUD
local function M(x) return x * S end -- metres -> studs

local world = Instance.new("Folder")
world.Name = "MoppeWorld"
world.Parent = workspace

local function part(name, size, cf, color, material, parent, shape)
	local p = Instance.new("Part")
	p.Name = name
	if shape == "cyl" then p.Shape = Enum.PartType.Cylinder elseif shape == "ball" then p.Shape = Enum.PartType.Ball end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or world
	return p
end
local function wedge(name, size, cf, color, material, parent)
	local w = Instance.new("WedgePart")
	w.Name, w.Size, w.CFrame, w.Color, w.Material, w.Anchored = name, size, cf, color, material or Enum.Material.SmoothPlastic, true
	w.Parent = parent or world
	return w
end
local function deco(p) p.CanCollide = false; p.CastShadow = true; return p end

-- ---------- light: Swedish summer afternoon ----------
Lighting.ClockTime = 15
Lighting.GeographicLatitude = 59
Lighting.Brightness = 2.4
Lighting.EnvironmentDiffuseScale = 1
Lighting.EnvironmentSpecularScale = 1
Lighting.OutdoorAmbient = Color3.fromRGB(118, 124, 134)
Lighting.Ambient = Color3.fromRGB(38, 40, 46)
Lighting.GlobalShadows = true
Lighting.ShadowSoftness = 0.25
local atm = Instance.new("Atmosphere")
atm.Density, atm.Offset, atm.Color, atm.Decay, atm.Glare, atm.Haze = 0.3, 0.12, Color3.fromRGB(199, 214, 230), Color3.fromRGB(106, 126, 148), 0.25, 1.4
atm.Parent = Lighting
local cc = Instance.new("ColorCorrectionEffect"); cc.Saturation, cc.Contrast, cc.TintColor = 0.06, 0.06, Color3.fromRGB(255, 252, 246); cc.Parent = Lighting
local bloom = Instance.new("BloomEffect"); bloom.Intensity, bloom.Size, bloom.Threshold = 0.35, 24, 1.3; bloom.Parent = Lighting
local rays = Instance.new("SunRaysEffect"); rays.Intensity, rays.Spread = 0.04, 0.6; rays.Parent = Lighting
local dof = Instance.new("DepthOfFieldEffect"); dof.FarIntensity, dof.FocusDistance, dof.InFocusRadius, dof.NearIntensity = 0.12, 60, 120, 0; dof.Parent = Lighting

-- ---------- terrain: grass, hills, lake with a sandy shore ----------
local base = workspace:FindFirstChild("Baseplate")
if base then base:Destroy() end
local T = workspace.Terrain
T.WaterColor = Color3.fromRGB(40, 78, 96)
T.WaterReflectance = 0.6
T.WaterTransparency = 0.4
T.WaterWaveSize = 0.08
T.WaterWaveSpeed = 6
T:FillBlock(CFrame.new(0, -8, M(-120)), Vector3.new(M(460), 16, M(460)), Enum.Material.Grass)
local hr = Random.new(3)
for i = 0, 27 do -- hills around the edges so the world does not end in a sharp edge
	local a = i / 28 * math.pi * 2
	local c = Vector3.new(math.cos(a) * M(215), -M(4), M(-120) + math.sin(a) * M(215))
	T:FillBall(c, M(28 + hr:NextNumber() * 18), hr:NextNumber() < 0.25 and Enum.Material.Rock or Enum.Material.Grass)
end
local lakeC = Vector3.new(-M(110), 0, -M(200))
T:FillCylinder(CFrame.new(lakeC + Vector3.new(0, -2, 0)), 4, M(34), Enum.Material.Sand)
T:FillCylinder(CFrame.new(lakeC + Vector3.new(0, -4, 0)), 8, M(30), Enum.Material.Water)

-- ---------- garage: 24 x 16 m, 5 m high, door towards -Z ----------
local G = Instance.new("Folder"); G.Name = "Garage"; G.Parent = world
local GW, GD, GH = M(24), M(16), M(5)
local brick, brickC = Enum.Material.Brick, Color3.fromRGB(139, 66, 50)
local steel = Color3.fromRGB(92, 98, 106)
part("Floor", Vector3.new(GW + 2, 1.2, GD + 2), CFrame.new(0, 0, 0), Color3.fromRGB(128, 131, 134), Enum.Material.Concrete, G)
local floorTop = 0.6
local function gp(name, size, x, y, z, color, mat, shape, rot) return part(name, size, CFrame.new(x, floorTop + y, z) * (rot or CFrame.new()), color, mat, G, shape) end
-- walls: back, sides with windows, front with door opening
gp("WallBack", Vector3.new(GW + 2, GH, 1), 0, GH / 2, GD / 2 + 0.5, brickC, brick)
for _, s in ipairs({ -1, 1 }) do
	local x = s * (GW / 2 + 0.5)
	gp("WallSideLow", Vector3.new(1, M(1.4), GD), x, M(0.7), 0, brickC, brick)
	gp("WallSideHigh", Vector3.new(1, GH - M(3), GD), x, M(3) + (GH - M(3)) / 2, 0, brickC, brick)
	for i = -1, 1 do
		local z = i * M(5)
		gp("WinPost", Vector3.new(1, M(1.6), M(0.3)), x, M(2.2), z - M(1.6), Color3.fromRGB(240, 240, 236), Enum.Material.WoodPlanks)
		gp("WinPost", Vector3.new(1, M(1.6), M(0.3)), x, M(2.2), z + M(1.6), Color3.fromRGB(240, 240, 236), Enum.Material.WoodPlanks)
		local gl = gp("Window", Vector3.new(0.4, M(1.6), M(3)), x, M(2.2), z, Color3.fromRGB(170, 200, 220), Enum.Material.Glass); gl.Transparency = 0.6
	end
	-- brick between the windows (windows at z = -5, 0, 5 m, 3.2 m wide incl. posts)
	for _, seg in ipairs({ { -8, -6.6 }, { -3.4, -1.6 }, { 1.6, 3.4 }, { 6.6, 8 } }) do
		gp("WallBetween", Vector3.new(1, M(1.6), M(seg[2] - seg[1])), x, M(2.2), M((seg[1] + seg[2]) / 2), brickC, brick)
	end
end
local door = M(6)
gp("WallFrontL", Vector3.new((GW + 2 - door) / 2, GH, 1), -(GW + 2 + door) / 4, GH / 2, -GD / 2 - 0.5, brickC, brick)
gp("WallFrontR", Vector3.new((GW + 2 - door) / 2, GH, 1), (GW + 2 + door) / 4, GH / 2, -GD / 2 - 0.5, brickC, brick)
gp("DoorTop", Vector3.new(door, M(1.2), 1), 0, GH - M(0.6), -GD / 2 - 0.5, brickC, brick)
gp("RollerDoor", Vector3.new(door, M(0.6), M(0.6)), 0, GH - M(0.9), -GD / 2 + M(0.2), Color3.fromRGB(190, 195, 200), Enum.Material.Metal, "cyl", CFrame.Angles(0, 0, 0))
-- roof and steel beams
gp("Roof", Vector3.new(GW + 3, 1, GD + 3), 0, GH + 0.5, 0, Color3.fromRGB(64, 66, 70), Enum.Material.CorrodedMetal)
for i = -2, 2 do gp("Beam", Vector3.new(GW, M(0.35), M(0.18)), 0, GH - M(0.2), i * M(3.2), steel, Enum.Material.Metal) end
-- sign above the door
local sign = gp("Sign", Vector3.new(M(5), M(0.8), 0.4), 0, GH + M(0.2), -GD / 2 - 1.2, Color3.fromRGB(25, 27, 30), Enum.Material.SmoothPlastic)
local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Front; sg.CanvasSize = Vector2.new(500, 80); sg.LightInfluence = 0; sg.Parent = sign
local st = Instance.new("TextLabel"); st.Size = UDim2.fromScale(1, 1); st.BackgroundTransparency = 1; st.Text = "MOPPE GARAGE"; st.TextScaled = true; st.Font = Enum.Font.GothamBlack; st.TextColor3 = Color3.fromRGB(255, 176, 32); st.Parent = sg
-- hanging industrial lamps
for _, x in ipairs({ -M(7), 0, M(7) }) do
	for _, z in ipairs({ -M(3.5), M(3.5) }) do
		deco(gp("LampWire", Vector3.new(M(1), 0.15, 0.15), x, GH - M(0.5), z, Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic, "cyl", CFrame.Angles(0, 0, math.pi / 2)))
		deco(gp("LampShade", Vector3.new(M(0.35), M(0.7), M(0.7)), x, GH - M(1.1), z, Color3.fromRGB(46, 70, 60), Enum.Material.Metal, "cyl", CFrame.Angles(0, 0, math.pi / 2)))
		local bulb = deco(gp("LampBulb", Vector3.new(M(0.5), 0.3, M(0.5)), x, GH - M(1.3), z, Color3.fromRGB(255, 244, 220), Enum.Material.Neon))
		local l = Instance.new("SpotLight"); l.Face = Enum.NormalId.Bottom; l.Angle = 120; l.Range = 40; l.Brightness = 1.6; l.Color = Color3.fromRGB(255, 240, 215); l.Shadows = true; l.Parent = bulb
	end
end
-- floor markings
for _, x in ipairs({ -M(2.4), M(2.4) }) do gp("Line", Vector3.new(0.3, 0.05, M(9)), x, 0.03, -M(2), Color3.fromRGB(216, 180, 30), Enum.Material.SmoothPlastic) end
-- workbench with pegboard, vise and tools along the back wall
local wood, red = Color3.fromRGB(138, 96, 58), Color3.fromRGB(176, 32, 28)
local bz = GD / 2 - M(0.5)
gp("Bench", Vector3.new(M(4), M(0.08), M(0.9)), -M(6), M(0.95), bz, wood, Enum.Material.Wood)
for _, x in ipairs({ -M(7.9), -M(4.1) }) do gp("BenchLeg", Vector3.new(M(0.08), M(0.95), M(0.8)), x, M(0.47), bz, steel, Enum.Material.Metal) end
gp("BenchShelf", Vector3.new(M(4), M(0.04), M(0.8)), -M(6), M(0.3), bz, steel, Enum.Material.Metal)
gp("Pegboard", Vector3.new(M(4), M(1.4), 0.3), -M(6), M(1.85), GD / 2 - 0.2, Color3.fromRGB(150, 132, 98), Enum.Material.WoodPlanks)
local tr = Random.new(5)
for i = 0, 11 do
	local t = gp("Tool", Vector3.new(M(0.05), M(0.22 + tr:NextNumber() * 0.25), 0.3), -M(7.7) + i * M(0.31), M(1.85) + (tr:NextNumber() - 0.5) * M(0.7), GD / 2 - 0.5, i % 3 == 0 and red or Color3.fromRGB(70, 74, 80), Enum.Material.Metal)
	t.CFrame = t.CFrame * CFrame.Angles(0, 0, (tr:NextNumber() - 0.5) * 0.7)
end
gp("Vise", Vector3.new(M(0.25), M(0.2), M(0.3)), -M(4.5), M(1.09), bz - M(0.2), Color3.fromRGB(40, 70, 130), Enum.Material.Metal)
-- tool chest
gp("ToolChest", Vector3.new(M(1.1), M(1), M(0.55)), -M(2.6), M(0.5), bz, red, Enum.Material.Metal)
for i = 0, 4 do gp("Drawer", Vector3.new(M(1), M(0.015), 0.2), -M(2.6), M(0.15) + i * M(0.18), bz - M(0.28), Color3.fromRGB(200, 200, 200), Enum.Material.Metal) end
-- shelving with boxes
for _, x in ipairs({ M(3.2), M(6.8) }) do for _, z in ipairs({ bz - M(0.25), bz + M(0.25) }) do gp("Upright", Vector3.new(M(0.06), M(2.6), M(0.06)), x, M(1.3), z, Color3.fromRGB(40, 90, 160), Enum.Material.Metal) end end
for j = 0, 3 do
	gp("Shelf", Vector3.new(M(3.7), M(0.04), M(0.6)), M(5), M(0.3) + j * M(0.75), bz, Color3.fromRGB(200, 120, 30), Enum.Material.Metal)
	for k = 0, 3 do
		if tr:NextNumber() < 0.75 then
			local w = M(0.5 + tr:NextNumber() * 0.3)
			gp("Box", Vector3.new(w, M(0.3 + tr:NextNumber() * 0.25), M(0.45)), M(3.6) + k * M(0.9), M(0.32) + j * M(0.75) + M(0.2), bz, Color3.fromRGB(176, 136, 90), Enum.Material.Fabric)
		end
	end
end
-- tyre stacks, compressor, oil drums
for s = 0, 1 do for i = 0, 4 do gp("Tyre", Vector3.new(M(0.2), M(0.65), M(0.65)), GW / 2 - M(0.8) - s * M(0.8), M(0.1) + i * M(0.2), GD / 2 - M(1.8), Color3.fromRGB(24, 24, 26), Enum.Material.SmoothPlastic, "cyl", CFrame.Angles(0, 0, math.pi / 2)) end end
gp("Compressor", Vector3.new(M(1.1), M(0.45), M(0.45)), GW / 2 - M(1), M(0.35), GD / 2 - M(3.6), red, Enum.Material.Metal, "cyl")
gp("CompMotor", Vector3.new(M(0.4), M(0.3), M(0.3)), GW / 2 - M(1), M(0.75), GD / 2 - M(3.6), Color3.fromRGB(40, 42, 46), Enum.Material.Metal)
for i, c in ipairs({ Color3.fromRGB(31, 95, 158), Color3.fromRGB(150, 30, 30) }) do gp("Drum", Vector3.new(M(0.9), M(0.6), M(0.6)), GW / 2 - M(0.6), M(0.45), -GD / 2 + M(1) + i * M(0.75), c, Enum.Material.Metal, "cyl", CFrame.Angles(0, 0, math.pi / 2)) end
-- moped lift (to the right of the moped spot)
gp("LiftTop", Vector3.new(M(0.9), M(0.12), M(2.4)), M(5), M(0.55), -M(2), Color3.fromRGB(150, 155, 160), Enum.Material.DiamondPlate)
gp("LiftBase", Vector3.new(M(0.5), M(0.5), M(1.6)), M(5), M(0.25), -M(2), Color3.fromRGB(200, 40, 30), Enum.Material.Metal)
local ramp = wedge("LiftRamp", Vector3.new(M(0.9), M(0.6), M(0.9)), CFrame.new(M(5), floorTop + M(0.3), -M(2) - M(1.65)) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(150, 155, 160), Enum.Material.DiamondPlate, G)
-- office corner: desk, screen, chair, sofa, posters, clock, fire extinguisher
local ox, oz = -GW / 2 + M(2.2), -GD / 2 + M(2.5)
gp("Desk", Vector3.new(M(1.6), M(0.06), M(0.8)), ox, M(0.75), oz, wood, Enum.Material.Wood)
for _, dx in ipairs({ -M(0.75), M(0.75) }) do gp("DeskLeg", Vector3.new(M(0.05), M(0.75), M(0.7)), ox + dx, M(0.37), oz, steel, Enum.Material.Metal) end
local screen = gp("Screen", Vector3.new(M(0.6), M(0.4), M(0.04)), ox, M(1.05), oz + M(0.2), Color3.fromRGB(60, 120, 170), Enum.Material.Neon); screen.Transparency = 0.2
gp("Chair", Vector3.new(M(0.5), M(0.08), M(0.5)), ox, M(0.48), oz - M(0.55), Color3.fromRGB(30, 30, 32), Enum.Material.Fabric)
gp("ChairBack", Vector3.new(M(0.5), M(0.5), M(0.06)), ox, M(0.75), oz - M(0.8), Color3.fromRGB(30, 30, 32), Enum.Material.Fabric)
gp("Sofa", Vector3.new(M(0.8), M(0.45), M(2)), -GW / 2 + M(0.6), M(0.22), oz + M(2.5), Color3.fromRGB(90, 60, 40), Enum.Material.Fabric)
gp("SofaBack", Vector3.new(M(0.25), M(0.5), M(2)), -GW / 2 + M(0.2), M(0.65), oz + M(2.5), Color3.fromRGB(90, 60, 40), Enum.Material.Fabric)
for i, c in ipairs({ Color3.fromRGB(200, 60, 40), Color3.fromRGB(40, 110, 180), Color3.fromRGB(230, 180, 40) }) do
	gp("Poster", Vector3.new(0.2, M(0.9), M(0.65)), -GW / 2 + 0.2, M(2.1), -GD / 2 + M(4) + i * M(1.1), c, Enum.Material.SmoothPlastic)
end
gp("Clock", Vector3.new(0.2, M(0.4), M(0.4)), 0, GH - M(1.6), GD / 2 + 0.05, Color3.fromRGB(240, 240, 236), Enum.Material.SmoothPlastic, "cyl", CFrame.Angles(0, math.pi / 2, 0))
gp("Extinguisher", Vector3.new(M(0.5), M(0.16), M(0.16)), -GW / 2 + M(0.3), M(0.6), -GD / 2 + M(0.8), Color3.fromRGB(200, 20, 20), Enum.Material.Metal, "cyl", CFrame.Angles(0, 0, math.pi / 2))
-- spawn points
local spawnPad = Instance.new("SpawnLocation")
spawnPad.Name = "Spawn"; spawnPad.Size = Vector3.new(6, 0.4, 6); spawnPad.CFrame = CFrame.new(-M(3), floorTop + 0.25, M(1)); spawnPad.Anchored = true
spawnPad.Transparency = 1; spawnPad.CanCollide = false; spawnPad.Neutral = true; spawnPad.Parent = G
local mopedPad = part("MopedSpot", Vector3.new(1, 0.1, 1), CFrame.new(0, floorTop + 0.1, -M(2)), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, G)
mopedPad.Transparency = 1; mopedPad.CanCollide = false

-- ---------- roads: driveway, drag strip with curbs, pavement and streetlights, ring track ----------
local asph, lineC, curbC = Color3.fromRGB(56, 59, 64), Color3.fromRGB(232, 232, 226), Color3.fromRGB(165, 165, 160)
local function road(name, size, cf) return part(name, size, cf, asph, Enum.Material.Asphalt) end
local yRoad = 0.2
road("Driveway", Vector3.new(M(7), 0.6, M(14)), CFrame.new(0, yRoad, -GD / 2 - M(7)))
local stripZ0, stripL = -GD / 2 - M(14), M(170)
local stripC = stripZ0 - stripL / 2
road("Strip", Vector3.new(M(10), 0.6, stripL), CFrame.new(0, yRoad, stripC))
for _, s in ipairs({ -1, 1 }) do
	part("EdgeLine", Vector3.new(0.4, 0.05, stripL), CFrame.new(s * M(4.6), yRoad + 0.32, stripC), lineC, Enum.Material.SmoothPlastic)
	part("Curb", Vector3.new(M(0.25), M(0.15), stripL), CFrame.new(s * M(5.1), yRoad + M(0.05), stripC), curbC, Enum.Material.Concrete)
end
part("Pavement", Vector3.new(M(2.5), 0.8, stripL), CFrame.new(M(6.5), yRoad + 0.1, stripC), Color3.fromRGB(150, 150, 146), Enum.Material.Pavement)
for i = 0, 20 do part("Dash", Vector3.new(0.35, 0.05, M(3)), CFrame.new(0, yRoad + 0.32, stripZ0 - M(4) - i * M(8)), lineC, Enum.Material.SmoothPlastic) end
part("StartLine", Vector3.new(M(10), 0.06, 0.6), CFrame.new(0, yRoad + 0.33, stripZ0 - M(6)), lineC, Enum.Material.SmoothPlastic)
-- streetlights along the pavement
for i = 0, 6 do
	local z = stripZ0 - M(10) - i * M(25)
	local px = M(7.4)
	part("Pole", Vector3.new(M(6), M(0.16), M(0.16)), CFrame.new(px, M(3), z) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(90, 94, 100), Enum.Material.Metal, world, "cyl")
	part("Arm", Vector3.new(M(1.6), M(0.1), M(0.1)), CFrame.new(px - M(0.8), M(5.95), z), Color3.fromRGB(90, 94, 100), Enum.Material.Metal)
	local lamp = part("StreetLamp", Vector3.new(M(0.6), M(0.12), M(0.3)), CFrame.new(px - M(1.5), M(5.88), z), Color3.fromRGB(255, 236, 200), Enum.Material.Neon)
	local l = Instance.new("SpotLight"); l.Face = Enum.NormalId.Bottom; l.Angle = 110; l.Range = 50; l.Brightness = 1.2; l.Color = Color3.fromRGB(255, 228, 180); l.Parent = lamp
end
-- ring track with red and white kerbs
local ringC = Vector3.new(M(80), 0, stripC)
local R1, R2, N = M(38), M(50), 72
for i = 0, N - 1 do
	local a = i / N * math.pi * 2
	local r = (R1 + R2) / 2
	local seg = 2 * math.pi * r / N
	road("Ring", Vector3.new(R2 - R1, 0.6, seg * 1.08), CFrame.new(ringC + Vector3.new(math.cos(a) * r, yRoad, math.sin(a) * r)) * CFrame.Angles(0, -a, 0))
	for _, rr in ipairs({ R1 - M(0.4), R2 + M(0.4) }) do
		part("Kerb", Vector3.new(M(0.8), 0.7, 2 * math.pi * rr / N * 1.02), CFrame.new(ringC + Vector3.new(math.cos(a) * rr, yRoad, math.sin(a) * rr)) * CFrame.Angles(0, -a, 0),
			i % 2 == 0 and Color3.fromRGB(200, 30, 30) or Color3.fromRGB(240, 240, 236), Enum.Material.SmoothPlastic)
	end
end
road("Connector", Vector3.new(M(80) - R2 + M(5), 0.6, M(8)), CFrame.new((M(80) - R2) / 2 + M(2), yRoad + 0.01, ringC.Z))

-- ---------- Swedish houses: panel with white corners, windows, gable roof, chimney, fence, mailbox ----------
local rnd = Random.new(7)
local white = Color3.fromRGB(242, 240, 234)
local function house(pos, rot, col, w, d)
	local h = Instance.new("Model"); h.Name = "House"; h.Parent = world
	local cf = CFrame.new(pos) * CFrame.Angles(0, rot, 0)
	local Hh = M(2.8)
	local function p(n, size, off, c, mat, shape) return part(n, size, cf * off, c, mat, h, shape) end
	p("Plinth", Vector3.new(M(w) + 0.4, 2, M(d) + 0.4), CFrame.new(0, 0.6, 0), Color3.fromRGB(85, 88, 92), Enum.Material.Concrete)
	p("Walls", Vector3.new(M(w), Hh, M(d)), CFrame.new(0, 1.6 + Hh / 2, 0), col, Enum.Material.WoodPlanks)
	for _, sx in ipairs({ -1, 1 }) do for _, sz in ipairs({ -1, 1 }) do p("Corner", Vector3.new(0.6, Hh, 0.6), CFrame.new(sx * M(w) / 2, 1.6 + Hh / 2, sz * M(d) / 2), white, Enum.Material.WoodPlanks) end end
	local rh = M(1.8)
	for _, s in ipairs({ -1, 1 }) do
		wedge("Roof", Vector3.new(M(w) + 1.6, rh, M(d) / 2 + 0.8), cf * CFrame.new(0, 1.6 + Hh + rh / 2, s * (M(d) / 4 + 0.4)) * CFrame.Angles(0, s > 0 and math.pi or 0, 0), Color3.fromRGB(46, 47, 51), Enum.Material.Slate, h)
	end
	p("Chimney", Vector3.new(M(0.6), M(1.6), M(0.6)), CFrame.new(M(w) * 0.25, 1.6 + Hh + M(1.3), M(d) * 0.15), Color3.fromRGB(120, 60, 45), Enum.Material.Brick)
	for i = 0, math.floor(w / 2.6) - 1 do
		local x = -M(w) / 2 + M(1.5) + i * M(2.6)
		for _, s in ipairs({ -1, 1 }) do
			p("WinFrame", Vector3.new(M(1), M(1.15), 0.3), CFrame.new(x, 1.6 + M(1.55), s * (M(d) / 2 + 0.1)), white, Enum.Material.WoodPlanks)
			local g = p("Glass", Vector3.new(M(0.82), M(0.95), 0.35), CFrame.new(x, 1.6 + M(1.55), s * (M(d) / 2 + 0.12)), Color3.fromRGB(40, 55, 70), Enum.Material.Glass)
			g.Reflectance = 0.35
			p("Mullion", Vector3.new(M(0.06), M(0.95), 0.4), CFrame.new(x, 1.6 + M(1.55), s * (M(d) / 2 + 0.14)), white, Enum.Material.WoodPlanks)
		end
	end
	p("Door", Vector3.new(M(1), M(2), 0.3), CFrame.new(M(w) / 2 - M(1.4), 1.6 + M(1), M(d) / 2 + 0.12), Color3.fromRGB(59, 42, 30), Enum.Material.Wood)
	p("Steps", Vector3.new(M(1.4), 1.6, M(0.8)), CFrame.new(M(w) / 2 - M(1.4), 0.8, M(d) / 2 + M(0.45)), Color3.fromRGB(120, 122, 124), Enum.Material.Concrete)
	-- picket fence in front and a mailbox
	local fz = M(d) / 2 + M(4)
	for i = -10, 10 do p("Picket", Vector3.new(M(0.08), M(0.9), M(0.03)), CFrame.new(i * M(0.5), M(0.45), fz), white, Enum.Material.WoodPlanks) end
	p("Rail", Vector3.new(M(10.5), M(0.07), M(0.03)), CFrame.new(0, M(0.65), fz - M(0.03)), white, Enum.Material.WoodPlanks)
	p("MailPost", Vector3.new(M(0.08), M(1), M(0.08)), CFrame.new(M(6), M(0.5), fz + M(0.5)), Color3.fromRGB(70, 70, 70), Enum.Material.Metal)
	p("Mailbox", Vector3.new(M(0.35), M(0.3), M(0.45)), CFrame.new(M(6), M(1.1), fz + M(0.5)), Color3.fromRGB(40, 90, 170), Enum.Material.Metal)
end
local function spruce(pos, hgt)
	part("Trunk", Vector3.new(M(1.6), M(0.4), M(0.4)), CFrame.new(pos + Vector3.new(0, M(0.8), 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(74, 51, 34), Enum.Material.Wood, world, "cyl")
	local col = Color3.fromRGB(26 + rnd:NextInteger(0, 10), 60 + rnd:NextInteger(0, 16), 34)
	local tiers = 6
	for i = 0, tiers - 1 do
		local f = i / (tiers - 1)
		local r = M(4.2 - 3.3 * f)
		part("Needles", Vector3.new(M(hgt * 0.16), r, r), CFrame.new(pos + Vector3.new(0, M(1.3 + f * hgt * 0.78), 0)) * CFrame.Angles(0, rnd:NextNumber() * 3, math.pi / 2), col, Enum.Material.Grass, world, "cyl")
	end
	part("Top", Vector3.new(M(0.5), M(0.5), M(0.5)), CFrame.new(pos + Vector3.new(0, M(1.3 + hgt * 0.92), 0)), col, Enum.Material.Grass, world, "ball")
end
local function birch(pos, hgt)
	part("Trunk", Vector3.new(M(hgt * 0.7), M(0.25), M(0.25)), CFrame.new(pos + Vector3.new(0, M(hgt * 0.35), 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(232, 228, 218), Enum.Material.SmoothPlastic, world, "cyl")
	for i = 0, 4 do
		local s = M(1.8 + rnd:NextNumber() * 1.2)
		part("Leaves", Vector3.new(s, s * 0.9, s), CFrame.new(pos + Vector3.new((rnd:NextNumber() - 0.5) * M(1.8), M(hgt * 0.6 + i * 0.55), (rnd:NextNumber() - 0.5) * M(1.8))), Color3.fromRGB(88 + rnd:NextInteger(0, 20), 140 + rnd:NextInteger(0, 20), 56), Enum.Material.LeafyGrass, world, "ball")
	end
end
local function blocked(p)
	if math.abs(p.X) < M(18) and p.Z > stripZ0 - stripL - M(10) and p.Z < GD then return true end -- garage + strip
	local d = (Vector3.new(p.X, 0, p.Z) - Vector3.new(ringC.X, 0, ringC.Z)).Magnitude
	if d > M(30) and d < M(60) then return true end
	if p.X > 0 and p.X < M(85) and math.abs(p.Z - ringC.Z) < M(10) then return true end
	if (Vector3.new(p.X, 0, p.Z) - lakeC).Magnitude < M(40) then return true end
	if (Vector3.new(p.X, 0, p.Z) - Vector3.new(0, 0, M(-120))).Magnitude > M(195) then return true end -- not in the hills
	return false
end
local colors = { Color3.fromRGB(138, 43, 31), Color3.fromRGB(214, 176, 74), Color3.fromRGB(234, 229, 216), Color3.fromRGB(138, 43, 31) }
local n = 0
for _ = 1, 600 do
	if n >= 16 then break end
	local p = Vector3.new(rnd:NextNumber(-M(190), M(190)), 0, rnd:NextNumber(-M(320), M(80)))
	if not blocked(p) and not blocked(p + Vector3.new(0, 0, M(8))) then n = n + 1; house(p, rnd:NextInteger(0, 3) * math.pi / 2, colors[n % 4 + 1], 8, 6) end
end
n = 0
for _ = 1, 1200 do
	if n >= 120 then break end
	local p = Vector3.new(rnd:NextNumber(-M(200), M(200)), 0, rnd:NextNumber(-M(330), M(90)))
	if not blocked(p) then
		n = n + 1
		if rnd:NextNumber() < 0.65 then spruce(p, 6 + rnd:NextNumber() * 6) else birch(p, 5 + rnd:NextNumber() * 4) end
	end
end
]]></ProtectedString></Properties></Item>
</Item>
<Item class="StarterPlayer" referent="RBX18"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX17"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX15"><Properties><string name="Name">Ride</string><ProtectedString name="Source"><![CDATA[-- Riding on the client: keys -> RideSim (the physics), RideSim -> the moped's constraints.
-- The client owns the moped's physics and drives it with LinearVelocity (speed in the ground plane) and
-- AlignOrientation (heading, lean, wheelie). Rewards are calculated and checked by the server.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local RideSim = require(Shared.RideSim)
local CS = require(Shared.ClientState)
local remotes = RS:WaitForChild("Remotes")
local Report, Api = remotes:WaitForChild("Report"), remotes:WaitForChild("Api")
local plr = Players.LocalPlayer
local S = 1 / Config.STUD

local R = RideSim.new(function(kind, ...)
	if kind == "say" then CS.toast:Fire((...))
	else Report:FireServer(kind, ...) end
end)
R.whValue = RideSim.whValue
CS.ride = R
CS.changed.Event:Connect(function() if CS.profile then RideSim.setProfile(R, CS.profile) end end)

local function myMoped()
	for _, m in ipairs(workspace:GetChildren()) do
		local o = m:FindFirstChild("Owner")
		if o and o.Value == plr and m:FindFirstChild("Seat") then return m end
	end
end
local function seatedOn(m)
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and m ~= nil and hum.SeatPart == m.Seat
end

local K = {}
local function key(k) return K[k] == true end
UIS.InputBegan:Connect(function(io, gp)
	if gp or io.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local k = io.KeyCode.Name
	K[k] = true
	if not R.mop then return end
	if k == "K" then RideSim.kick(R, 1)
	elseif k == "X" then RideSim.stop(R)
	elseif k == "E" and not R.mop.cvt then R.gear = math.min(4, R.gear + 1)
	elseif k == "Q" and not R.mop.cvt then R.gear = math.max(1, R.gear - 1)
	elseif k == "R" then
		R.v, R.crash, R.wh, R.pitch, R.pw, R.lean = 0, nil, nil, 0, 0, 0
		Report:FireServer("dirty")
		task.spawn(function() Api:InvokeServer("spawn") end)
	end
end)
UIS.InputEnded:Connect(function(io) K[io.KeyCode.Name] = false end)
UIS.WindowFocusReleased:Connect(function() K = {} end)

local wasSeated = false
local baseC0 = setmetatable({}, { __mode = "k" }) -- the spokes' starting position per weld
RunService.Heartbeat:Connect(function(dtReal)
	if not R.P then return end
	local m = myMoped()
	local seated = seatedOn(m)
	if seated and not wasSeated and not R.on then RideSim.kick(R, 3) end -- "Åk ut" starts the engine
	wasSeated = seated
	local input = {
		thr = (key("W") or key("Up")) and 1 or 0,
		brk = (key("S") or key("Down")) and 1 or 0,
		st = ((key("D") or key("Right")) and 1 or 0) - ((key("A") or key("Left")) and 1 or 0),
		back = key("LeftShift") or key("RightShift"),
	}
	-- physics in sub-steps of at most 1/60 s based on real time
	local real = math.min(0.25, dtReal)
	local n = math.max(1, math.ceil(real * 60))
	for _ = 1, n do RideSim.step(R, real / n, seated, input) end
	R.seated = seated
	if not m then return end
	local root = m.PrimaryPart
	local lv, ao = root and root:FindFirstChild("Drive"), root and root:FindFirstChild("Tilt")
	if not (lv and ao) then return end
	if seated then
		if not R.drive then R.drive = true; local _, y = root.CFrame:ToOrientation(); R.h = y end
		local vs = R.v * S
		lv.MaxForce = 4e5
		lv.PlaneVelocity = Vector2.new(-math.sin(R.h) * vs, -math.cos(R.h) * vs)
		ao.MaxTorque = 1e6
		local roll = R.crash and R.crash.side * math.min(1.45, R.crash.t * 2.4) or -R.lean
		ao.CFrame = CFrame.Angles(0, R.h, 0) * CFrame.Angles(R.pitch, 0, roll)
	else
		-- parked: upright with the current heading and standing still (never limp, it would tip over)
		R.drive = false
		local _, y = root.CFrame:ToOrientation()
		lv.MaxForce, lv.PlaneVelocity = 2e4, Vector2.new(0, 0)
		ao.MaxTorque, ao.CFrame = 1e6, CFrame.Angles(0, y, 0)
	end
	-- spinning wheels (local visual) and exhaust smoke after the throttle
	local refs = m:FindFirstChild("Refs")
	if refs then
		R.wheelA = ((R.wheelA or 0) + (seated and R.v or 0) / R.mop.wr * real) % (2 * math.pi)
		for _, o in ipairs(refs:GetChildren()) do
			local w = o:IsA("ObjectValue") and o.Value
			if w and w:IsA("Weld") then
				if not baseC0[w] then baseC0[w] = w.C0 end
				w.C0 = baseC0[w] * CFrame.Angles(-R.wheelA, 0, 0)
			end
		end
	end
	local exAtt = root:FindFirstChild("ExhaustAtt")
	local smoke = exAtt and exAtt:FindFirstChild("Smoke")
	if smoke then smoke.Rate = R.on and (6 + 40 * R.thr) or 0 end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX16"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Interface: HUD, garage panel (Garage / Förråd / Pengar) and the shop with 3D previews.
-- The client only displays and asks the server (Api); all purchases and changes are checked on the server.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Engine = require(Shared.Engine)
local Economy = require(Shared.Economy)
local Builder = require(Shared.Builder)
local CS = require(Shared.ClientState)
local remotes = RS:WaitForChild("Remotes")
local Api, StateEv = remotes:WaitForChild("Api"), remotes:WaitForChild("State")
local plr = Players.LocalPlayer

local COL = { bg = Color3.fromRGB(23, 29, 37), panel = Color3.fromRGB(30, 37, 47), input = Color3.fromRGB(42, 51, 64), line = Color3.fromRGB(56, 66, 80),
	tx = Color3.fromRGB(232, 236, 241), mu = Color3.fromRGB(150, 160, 175), ac = Color3.fromRGB(255, 176, 32), pos = Color3.fromRGB(90, 200, 110), neg = Color3.fromRGB(240, 100, 75) }

-- ---------- UI helpers ----------
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o, r) new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o); return o end
local function label(parent, text, size, color, bold, h)
	return new("TextLabel", { BackgroundTransparency = 1, Text = text, TextSize = size or 14, TextColor3 = color or COL.tx, Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Size = UDim2.new(1, 0, 0, h or (size or 14) + 6), AutomaticSize = Enum.AutomaticSize.Y }, parent)
end
local function button(parent, text, primary, w, cb)
	local b = new("TextButton", { Text = text, TextSize = 14, Font = Enum.Font.GothamBold, TextColor3 = primary and Color3.fromRGB(20, 20, 20) or COL.tx,
		BackgroundColor3 = primary and COL.ac or COL.input, Size = UDim2.new(w or 1, w and 0 or 0, 0, 32), AutoButtonColor = true }, parent)
	corner(b, 6)
	if cb then b.MouseButton1Click:Connect(cb) end
	return b
end
local function list(parent, pad)
	new("UIListLayout", { Padding = UDim.new(0, pad or 6), SortOrder = Enum.SortOrder.LayoutOrder }, parent)
end
local function row(parent, h)
	local f = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h or 32) }, parent)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center }, f)
	return f
end
local function kr(n) return Catalog.fmt(n) .. " kr" end
local function call(action, ...)
	local ok, msg = Api:InvokeServer(action, ...)
	if msg and msg ~= "" then CS.toast:Fire(tostring(msg)) end
	return ok
end

local gui = new("ScreenGui", { Name = "MoppeUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = false }, plr:WaitForChild("PlayerGui"))

-- ---------- HUD ----------
local hud = corner(new("Frame", { BackgroundColor3 = COL.bg, BackgroundTransparency = 0.15, Position = UDim2.new(0, 12, 1, -12), AnchorPoint = Vector2.new(0, 1),
	Size = UDim2.new(0, 260, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, gui), 10)
new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, hud)
list(hud, 2)
local hMoney = label(hud, "", 20, Color3.fromRGB(255, 209, 102), true)
local hToast = label(hud, "", 12, Color3.fromRGB(255, 209, 102))
local hSpeed = label(hud, "0 km/h", 30, COL.tx, true, 34)
local bar = corner(new("Frame", { BackgroundColor3 = Color3.fromRGB(60, 60, 60), Size = UDim2.new(1, 0, 0, 6) }, hud), 3)
local barFill = corner(new("Frame", { BackgroundColor3 = COL.ac, Size = UDim2.new(0, 0, 1, 0) }, bar), 3)
local hInfo = label(hud, "", 13, COL.tx)
hInfo.RichText = true
local tip = corner(new("TextLabel", { BackgroundColor3 = COL.bg, BackgroundTransparency = 0.2, TextColor3 = COL.tx, TextSize = 13, Font = Enum.Font.Gotham,
	Position = UDim2.new(0, 12, 0, 12), Size = UDim2.new(0, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.X, Text = "" }, gui), 8)
new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, tip)

local toastT = 0
CS.toast.Event:Connect(function(t) hToast.Text = t; toastT = os.clock() + 3 end)

-- ---------- panel ----------
local panel = corner(new("Frame", { BackgroundColor3 = COL.panel, Position = UDim2.new(1, -12, 0, 12), AnchorPoint = Vector2.new(1, 0), Size = UDim2.new(0, 340, 1, -24) }, gui), 10)
new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, panel)
local top = row(panel, 38)
local shopOpen
button(top, "Åk ut", true, 0.48, function() call("spawn") end).Size = UDim2.new(0.49, 0, 0, 36)
button(top, "Butik", true, 0.48, function() shopOpen() end).Size = UDim2.new(0.49, 0, 0, 36)
local mopRow = row(panel, 30); mopRow.Position = UDim2.new(0, 0, 0, 44)
local tabRow = row(panel, 30); tabRow.Position = UDim2.new(0, 0, 0, 80)
local body = new("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 118), Size = UDim2.new(1, 0, 1, -118), CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 5, BorderSizePixel = 0 }, panel)
list(body, 6)
local tab = "garage"

local function hpWith(p, val)
	local c = Economy.ecfg(p, p.cur)
	for k, v in pairs(val or {}) do c[k] = v end
	local P = Engine.calc(c)
	P.cond = 1 - 0.4 * (p.dmg[p.cur] or 0)
	return (Engine.peakHp(P))
end
local function effectText(p, pr)
	local inst = p.inst[p.cur] or {}
	local u = inst[pr.slot]
	if u and p.items[u] and p.items[u].s == pr.sku then return "✓ Monterad", COL.pos end
	if not Catalog.fits(pr, p.cur) then return "Passar inte din " .. Config.BY_ID[p.cur].n, COL.neg end
	if Catalog.ENGINE[pr.slot] then
		local d = hpWith(p, pr.val) - hpWith(p, nil)
		if math.abs(d) >= 0.05 then return string.format("%s%.1f hk (beräknat)", d > 0 and "+" or "−", math.abs(d)), d > 0 and COL.pos or COL.neg end
	end
	return pr.desc, COL.mu
end

local function clear(f) for _, c in ipairs(f:GetChildren()) do if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") then c:Destroy() end end end
local function h3(t) local l = label(body, t, 12, COL.ac, true); return l end

local function stepper(name, key, value, step, lo, hi, unit)
	local r = row(body, 34)
	local l = label(r, name, 14); l.Size = UDim2.new(0, 150, 0, 30); l.AutomaticSize = Enum.AutomaticSize.None
	button(r, "−", false, nil, function() call("tune", key, value - step) end).Size = UDim2.new(0, 34, 0, 30)
	local v = label(r, tostring(value) .. (unit or ""), 15, COL.tx, true); v.Size = UDim2.new(0, 70, 0, 30); v.AutomaticSize = Enum.AutomaticSize.None; v.TextXAlignment = Enum.TextXAlignment.Center
	button(r, "+", false, nil, function() call("tune", key, value + step) end).Size = UDim2.new(0, 34, 0, 30)
	if lo then local rng = label(body, "intervall " .. lo .. "–" .. hi .. (unit or ""), 11, COL.mu) end
end

local SWATCH = { "#e63946", "#1d6fe0", "#f4c20d", "#2a9d8f", "#111111", "#f2f2ee", "#8a2be2", "#ff7f11" }
local function render()
	local p = CS.profile
	if not p then return end
	clear(mopRow); clear(tabRow); clear(body)
	for _, m in ipairs(Config.MOPEDS) do
		local b = button(mopRow, m.n .. (p.own[m.id] and "" or " (ej ägd)"), p.cur == m.id, nil, function() call("select", m.id) end)
		b.Size = UDim2.new(0.32, 0, 0, 28); b.TextSize = 12
	end
	for _, t in ipairs({ { "garage", "Garage" }, { "inv", "Förråd" }, { "money", "Pengar" } }) do
		local b = button(tabRow, t[2], tab == t[1], nil, function() tab = t[1]; render() end); b.Size = UDim2.new(0.32, 0, 0, 28)
	end
	local id, mop = p.cur, Config.BY_ID[p.cur]
	local R = CS.ride
	if tab == "garage" then
		local P = Economy.engine(p, id)
		local E = Economy.ecfg(p, id)
		local th = R and R.thermal and R.thermal[id] or Engine.newThermal()
		local ti = Engine.tinfo(mop, th)
		label(body, string.format("<b>%.1f hk</b>   ·   %s <b>%d°C</b> (%s)   ·   skick <b>%d %%</b>", P.hp, ti.lab, math.floor(ti.v + 0.5), ti.band, math.floor((1 - (p.dmg[id] or 0)) * 100 + 0.5)), 14).RichText = true
		if (p.dmg[id] or 0) > 0 then
			local r = row(body, 34)
			button(r, "Reparera, " .. kr(Economy.repairCost(p, id)), true, nil, function() call("repair", false) end).Size = UDim2.new(0.62, 0, 0, 32)
			if p.money < Economy.repairCost(p, id) and p.dmg[id] > 0.5 then button(r, "Nödlagning", false, nil, function() call("repair", true) end).Size = UDim2.new(0.35, 0, 0, 32) end
		end
		h3("TRIMNING")
		stepper("Huvudmunstycke", "jet", E.jet, 1, E.jlo, E.jhi)
		stepper("Avgasportstiming", "port", p.cfgs[id].port, 0.5, -4, 8, "°")
		if mop.cvt then stepper("Rullvikt", "roller", E.roller, 0.5, E.rlo, E.rhi, " g") else label(body, "Växlad: Q och E byter växel.", 12, COL.mu) end
		-- one tip at a time, like the web version
		local tg = Engine.target(E)
		local _, pkAt = Engine.peakHp(P)
		local hint
		if mop.cvt and tg >= P.lim then hint = "Rullarna är för lätta för tändningens varvspärr. Höj rullvikten."
		elseif P.m < 0.93 then hint = "Blandningen är för mager: motorn blir varm. Höj munstycket."
		elseif P.m > 1.1 then hint = "Blandningen är för fet. Sänk munstycket."
		elseif Config.CARB[E.carb + 1] > E.maxd then hint = "Förgasaren stryps av insuget. Köp ett större insug."
		elseif mop.cvt and P.hp > E.blim then hint = "Remmen slirar. Köp en förstärkt rem."
		elseif mop.cvt and tg < pkAt - 1200 then hint = "Variatorn håller för lågt varv. Sänk rullvikten."
		elseif mop.cvt and tg > pkAt + 1200 then hint = "Variatorn håller för högt varv. Höj rullvikten." end
		label(body, hint and ("Tips: " .. hint) or "Inställningen ser bra ut.", 13, hint and COL.ac or COL.pos)
		h3("MONTERADE DELAR")
		for _, slot in ipairs(Catalog.SLOT_ORDER) do
			local u = (p.inst[id] or {})[slot]
			if Catalog.slotsOf(id)[slot] and Catalog.ENGINE[slot] then
				local pr = u and p.items[u] and Catalog.BY_SKU[p.items[u].s]
				label(body, Catalog.SLOTS[slot][1] .. ": " .. (pr and pr.name:gsub(" – .*$", "") or "–"), 12, COL.mu)
			end
		end
		h3("LACK OCH STARTNUMMER")
		for _, key in ipairs({ "col", "seat" }) do
			local r = row(body, 30)
			local l = label(r, key == "col" and "Kaross" or "Sadel", 13); l.Size = UDim2.new(0, 60, 0, 28); l.AutomaticSize = Enum.AutomaticSize.None
			for _, hx in ipairs(SWATCH) do
				local b = corner(new("TextButton", { Text = "", BackgroundColor3 = Color3.fromHex(hx), Size = UDim2.new(0, 26, 0, 26) }, r), 13)
				if p.cfgs[id][key] == hx then new("UIStroke", { Color = COL.ac, Thickness = 2 }, b) end
				b.MouseButton1Click:Connect(function() call("tune", key, hx) end)
			end
		end
		local fr = row(body, 32)
		for _, f in ipairs({ { "gloss", "Blank" }, { "matt", "Matt" }, { "metal", "Metallic" } }) do button(fr, f[2], p.cfgs[id].fin == f[1], nil, function() call("tune", "fin", f[1]) end).Size = UDim2.new(0.32, 0, 0, 30) end
		local nr = row(body, 32)
		local box = corner(new("TextBox", { Text = p.cfgs[id].num, PlaceholderText = "nr", TextSize = 14, Font = Enum.Font.GothamBold, TextColor3 = COL.tx, BackgroundColor3 = COL.input, Size = UDim2.new(0, 60, 0, 30) }, nr), 6)
		button(nr, "Sätt startnummer", false, nil, function() call("tune", "num", box.Text) end).Size = UDim2.new(0, 160, 0, 30)
	elseif tab == "inv" then
		h3("I FÖRRÅDET")
		local any = false
		for u, it in pairs(p.items) do
			if not Economy.installedOn(p, u) then
				any = true
				local pr = Catalog.BY_SKU[it.s]
				local why = Economy.canInstall(p, u, id)
				local f = corner(new("Frame", { BackgroundColor3 = COL.input, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, body), 8)
				new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, f)
				list(f, 4)
				label(f, pr.name, 13, COL.tx, true)
				label(f, (it.used and "begagnad" or "ny") .. (why and (" · " .. why) or ""), 11, why and COL.neg or COL.mu)
				local r = row(f, 30)
				if not why then button(r, "Montera", true, nil, function() call("install", u) end).Size = UDim2.new(0.45, 0, 0, 28) end
				button(r, "Sälj " .. kr(Economy.sellPrice(p, u)), false, nil, function() call("sell", u) end).Size = UDim2.new(0.5, 0, 0, 28)
			end
		end
		if not any then label(body, "Tomt. Köp delar i butiken.", 13, COL.mu) end
		h3("MONTERAT PÅ " .. string.upper(mop.n))
		for _, slot in ipairs(Catalog.SLOT_ORDER) do
			if Catalog.slotsOf(id)[slot] then
				local u = (p.inst[id] or {})[slot]
				local pr = u and p.items[u] and Catalog.BY_SKU[p.items[u].s]
				local r = row(body, 30)
				local l = label(r, Catalog.SLOTS[slot][1] .. ": " .. (pr and pr.name:gsub(" – .*$", "") or "ingen"), 12, COL.mu); l.Size = UDim2.new(0.7, 0, 0, 28); l.AutomaticSize = Enum.AutomaticSize.None
				if pr and Catalog.REMOVABLE[slot] then button(r, "Ta bort", false, nil, function() call("uninstall", slot) end).Size = UDim2.new(0.28, 0, 0, 26) end
			end
		end
		label(body, "Sälj: oanvänd del 70 %, begagnad 50 % av priset.", 11, COL.mu)
	else
		label(body, kr(p.money), 28, COL.tx, true, 34)
		h3("MOPEDER")
		local owned = 0
		for _, m in ipairs(Config.MOPEDS) do if p.own[m.id] then owned = owned + 1 end end
		for _, m in ipairs(Config.MOPEDS) do
			local r = row(body, 32)
			local l = label(r, m.n .. (p.own[m.id] and (" · säljvärde " .. kr(Economy.sellValue(p, m.id))) or (" · kostar " .. kr(m.price))), 12); l.Size = UDim2.new(0.7, 0, 0, 30); l.AutomaticSize = Enum.AutomaticSize.None
			if p.own[m.id] then
				if owned > 1 then button(r, "Sälj", false, nil, function() call("sellMoped", m.id) end).Size = UDim2.new(0.28, 0, 0, 28) end
			else button(r, "Köp", true, nil, function() call("buyMoped", m.id) end).Size = UDim2.new(0.28, 0, 0, 28) end
		end
		h3("SÅ TJÄNAR DU PENGAR")
		label(body, string.format("%d kr per %d m med motorn igång · %d kr per %d km utan vurpa eller överhettning · stegring upp till %d kr (minst %d km/h) · vurpa −%d kr",
			Config.ECON.distKr, Config.ECON.distM, Config.ECON.cleanKr, Config.ECON.cleanM / 1000, Config.WHEELIE.max, math.floor(Config.WHEELIE.minV * 3.6), Config.ECON.crashKr), 12, COL.mu)
		h3("STATISTIK")
		label(body, string.format("Körsträcka %.2f km · toppfart %d km/h · stegringar %d · längsta %.1f s · vurpor %d · intjänat %s",
			p.stats.dist / 1000, math.floor(p.stats.top * 3.6), p.stats.wn, p.stats.best, p.stats.crash, kr(p.stats.earned)), 12, COL.mu)
		h3("HÄNDELSER")
		for i = 1, math.min(12, #p.ledger) do local l = p.ledger[i]; label(body, (l.a > 0 and "+" or "−") .. kr(math.abs(l.a)) .. "  " .. l.x, 12, l.a > 0 and COL.pos or COL.neg) end
	end
end

-- ---------- shop ----------
local shop = new("Frame", { BackgroundColor3 = COL.bg, Size = UDim2.new(1, 0, 1, 0), Visible = false, ZIndex = 5 }, gui)
new("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), PaddingBottom = UDim.new(0, 14) }, shop)
local sTop = row(shop, 40)
local logo = label(sTop, "MOPPEDELAR", 20, COL.ac, true); logo.Size = UDim2.new(0, 150, 0, 36); logo.AutomaticSize = Enum.AutomaticSize.None
local search = corner(new("TextBox", { PlaceholderText = "Sök, t.ex. avgas, cylinder eller fälgar", Text = "", TextSize = 15, Font = Enum.Font.Gotham, TextColor3 = COL.tx,
	PlaceholderColor3 = COL.mu, BackgroundColor3 = COL.input, Size = UDim2.new(1, -330, 0, 36), ClearTextOnFocus = false }, sTop), 18)
button(sTop, "Stäng", false, nil, function() shop.Visible = false end).Size = UDim2.new(0, 90, 0, 34)
local chips = row(shop, 34); chips.Position = UDim2.new(0, 0, 0, 48)
local note = label(shop, "Demobutik i spelet: påhittade delar och priser, du betalar med spelpengar. Bilderna är 3D-förhandsvisningar av delarna.", 12, COL.mu)
note.Position = UDim2.new(0, 0, 0, 86)
local grid = new("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 112), Size = UDim2.new(1, 0, 1, -112), CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, BorderSizePixel = 0 }, shop)
new("UIGridLayout", { CellSize = UDim2.new(0, 210, 0, 300), CellPadding = UDim2.new(0, 12, 0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
local group = ""

local function preview(vp, pr)
	local model = Builder.preview(pr.slot, pr.val)
	model.Parent = vp
	local cam = new("Camera", { FieldOfView = 30 }, vp)
	vp.CurrentCamera = cam
	local cf, size = model:GetBoundingBox()
	local r = size.Magnitude / 2
	local dist = r / math.sin(math.rad(15)) * 1.05
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0.55, 0.42, 0.72).Unit * dist, cf.Position)
	vp.Ambient = Color3.fromRGB(150, 150, 160)
	vp.LightColor = Color3.fromRGB(255, 255, 255)
	vp.LightDirection = Vector3.new(-1, -1.5, -0.8)
end

local function renderShop()
	local p = CS.profile
	if not p then return end
	clear(chips)
	for _, g in ipairs({ { "", "Allt" }, { "Motor" }, { "Kraftöverföring" }, { "Utseende" } }) do
		local k = g[1]
		local b = button(chips, g[2] or g[1], group == k, nil, function() group = k; renderShop() end)
		b.Size = UDim2.new(0, 130, 0, 30)
	end
	clear(grid)
	local q = string.lower(search.Text)
	local cats
	for _, g in ipairs(Catalog.GROUPS) do if g[1] == group then cats = g[2] end end
	local order = 0
	for _, pr in ipairs(Catalog.PR) do
		local ok = Catalog.fits(pr, p.cur) and (not cats or Catalog.has(cats, pr.cat))
		if ok and q ~= "" then
			for word in q:gmatch("%S+") do
				if not (string.lower(pr.name):find(word, 1, true) or string.lower(pr.man):find(word, 1, true) or string.lower(pr.cat):find(word, 1, true)) then ok = false end
			end
		end
		if ok then
			order = order + 1
			local card = corner(new("Frame", { BackgroundColor3 = COL.panel, LayoutOrder = order }, grid), 12)
			new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, card)
			list(card, 3)
			local vp = corner(new("ViewportFrame", { BackgroundColor3 = COL.input, Size = UDim2.new(1, 0, 0, 120) }, card), 8)
			preview(vp, pr)
			label(card, pr.name:gsub(" – .*$", ""), 14, COL.tx, true)
			label(card, pr.man .. " · " .. pr.cat, 11, COL.mu)
			local et, ec = effectText(p, pr)
			label(card, et, 12, ec)
			label(card, kr(pr.price), 19, COL.tx, true, 24)
			local installed = et == "✓ Monterad"
			button(card, installed and "Köp extra" or "Köp och montera", true, nil, function() call("buy", pr.sku, 1, not installed) end)
			button(card, "Köp till förrådet", false, nil, function() call("buy", pr.sku, 1, false) end)
		end
	end
	if order == 0 then label(grid, "Inga delar hittades.", 14, COL.mu) end
end
shopOpen = function() shop.Visible = true; renderShop() end
search:GetPropertyChangedSignal("Text"):Connect(function() if shop.Visible then renderShop() end end)

-- ---------- updates ----------
StateEv.OnClientEvent:Connect(function(p, msg, saveOk)
	CS.profile = p
	CS.changed:Fire()
	if msg and msg ~= "" and msg ~= true then CS.toast:Fire(tostring(msg)) end
	render()
	if shop.Visible then renderShop() end
end)
task.spawn(function()
	for _ = 1, 20 do
		local ok = Api:InvokeServer("state")
		if ok then break end
		task.wait(1)
	end
end)

UIS.InputBegan:Connect(function(io, gp)
	if gp then return end
	if io.KeyCode == Enum.KeyCode.G then panel.Visible = not panel.Visible end
	if io.KeyCode == Enum.KeyCode.B then if shop.Visible then shop.Visible = false else shopOpen() end end
end)

local lastPanel = 0
RunService.RenderStepped:Connect(function()
	local p, R = CS.profile, CS.ride
	if not p then return end
	hMoney.Text = kr(p.money)
	if os.clock() > toastT then hToast.Text = "" end
	if not R or not R.P then return end
	hSpeed.Text = math.floor(R.v * 3.6 + 0.5) .. " km/h"
	barFill.Size = UDim2.new(math.clamp(R.rpm / R.P.lim, 0, 1), 0, 1, 0)
	local ti = Engine.tinfo(R.mop, R.thermal[R.mop.id])
	local lines = {}
	if R.crash then table.insert(lines, "<font color=\"#ff6a4a\"><b>VURPA</b></font> – " .. R.crash.why .. " · R = tillbaka till garaget")
	elseif not R.on then table.insert(lines, "<font color=\"#ff6a4a\"><b>Motorn är av</b></font> · tryck K") end
	if R.wh then
		local est, mult = R.whValue(R.wh)
		table.insert(lines, string.format("<font color=\"#ffd166\"><b>STEGRING %.1f s</b></font> · %d° · ×%.2f · ≈ +%d kr%s", R.wh.t, math.floor(math.deg(R.pitch)), mult or 0, est or 0, R.v < Config.WHEELIE.minV and " · för låg fart" or ""))
	end
	if R.on then table.insert(lines, math.floor(R.rpm) .. " rpm" .. (R.mop.cvt and "" or (" · växel " .. R.gear))) end
	local hex = string.format("#%02x%02x%02x", math.floor(ti.col.R * 255), math.floor(ti.col.G * 255), math.floor(ti.col.B * 255))
	table.insert(lines, string.format("%s <b>%d°C</b> <font color=\"%s\">%s</font>", ti.lab, math.floor(ti.v + 0.5), hex, ti.band))
	if R.t60 then table.insert(lines, string.format("0–60 km/h: %.2f s", R.t60)) end
	hInfo.Text = table.concat(lines, "\n")
	tip.Text = R.seated and "W gas · S broms · A/D styr · Shift stegring · K starta · X stäng av · Q/E växla (DT) · R garaget · Mellanslag kliv av"
		or "Åk ut = sätt dig på mopeden · G panel · B butik · K starta motorn"
	if R.seated and panel.Visible and R.v > 1 then panel.Visible = false end
	-- the temperature in the panel is updated twice per second
	if tab == "garage" and panel.Visible and not UIS:GetFocusedTextBox() and os.clock() - lastPanel > 0.5 then lastPanel = os.clock(); render() end
end)
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</roblox>
