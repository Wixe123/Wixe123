<Item class="Lighting" referent="RBX2"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><float name="ClockTime">14.5</float><float name="Brightness">2.2</float><bool name="GlobalShadows">true</bool></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX15"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX14"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Game-wide constants. 1 stud = 0.3 m for vehicles and parts.
local Config = {}

Config.STUD = 0.3
Config.START_MONEY = 4000
Config.MAX_PLAYERS = 6
Config.REACH = 16 -- studs a player may be from what they work on
Config.PAINT_DRY = 20 -- seconds
Config.PORT_MIN_TIME = 6 -- a porting session must take at least this long (server check)
Config.PAINT_MIN_TIME = 3
Config.SELL_FACTOR = 0.5 -- used parts sell for half the price
Config.SAVE_KEY = "MoppeMekaniker_v3"

-- plots: garages along Garagegatan; the street runs along x at z = STREET_Z
Config.PLOT_SPACING = 56
Config.STREET_Z = -34
function Config.plotOrigin(i)
	return (i - (Config.MAX_PLAYERS + 1) / 2) * Config.PLOT_SPACING
end

-- UI palette (dark panels, blue accent, green money), like the reference pictures
Config.UI = {
	panel = { 18, 20, 26 }, panel2 = { 30, 33, 42 }, line = { 60, 66, 80 },
	text = { 236, 239, 244 }, dim = { 150, 158, 172 },
	accent = { 43, 124, 230 }, accent2 = { 74, 152, 255 },
	green = { 46, 204, 113 }, red = { 231, 76, 60 }, yellow = { 241, 196, 15 }, orange = { 243, 156, 18 },
}

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">EngineDef</string><ProtectedString name="Source"><![CDATA[-- The two-stroke engine as sockets: where every part sits on the engine and what must be mounted first.
-- Engine space (studs): origin at the crank centre, +X = right side of the moped, +Y = up, -Z = forward.
-- The cylinder lies horizontally and points forward; the CVT runs back along the left side to the rear axle.
local Parts = require(script.Parent.Parts)
local EngineDef = {}

EngineDef.REAR_AXLE_Z = 1.75 -- rear pulley / rear wheel axle behind the crank

-- id, kind, pos {x,y,z}, rot {x,y,z} in degrees, req = sockets that must be mounted first
EngineDef.SOCKETS = {
	{ id = "vevhus", kind = "vevhus", pos = { 0, 0, 0.05 }, req = {} },
	{ id = "vevlager", kind = "vevlager", pos = { 0, 0, 0 }, req = { "vevhus" } },
	{ id = "vevaxel", kind = "vevaxel", pos = { 0, 0, 0 }, req = { "vevlager" } },
	{ id = "packbox", kind = "packbox", pos = { 0, 0, 0 }, req = { "vevaxel" } },
	{ id = "nallager", kind = "nallager", pos = { 0, 0, -0.62 }, req = { "vevaxel" } },
	{ id = "kolv", kind = "kolv", pos = { 0, 0, -0.66 }, req = { "nallager" } },
	{ id = "kolvbult", kind = "kolvbult", pos = { 0, 0, -0.62 }, req = { "kolv" } },
	{ id = "kolvringar", kind = "kolvringar", pos = { 0, 0, -0.76 }, req = { "kolv" } },
	{ id = "fotpackning", kind = "fotpackning", pos = { 0, 0, -0.47 }, req = { "vevaxel" } },
	{ id = "cylinder", kind = "cylinder", pos = { 0, 0, -0.78 }, req = { "kolvbult", "kolvringar", "fotpackning" } },
	{ id = "topplock", kind = "topplock", pos = { 0, 0, -1.17 }, req = { "cylinder" } },
	{ id = "tandstift", kind = "tandstift", pos = { 0, 0.1, -1.31 }, req = { "topplock" } },
	{ id = "reed", kind = "reed", pos = { 0, 0.5, 0.12 }, req = { "vevhus" } },
	{ id = "insug", kind = "insug", pos = { 0, 0.66, 0.2 }, req = { "reed" } },
	{ id = "forgasare", kind = "forgasare", pos = { 0, 0.82, 0.34 }, req = { "insug" } },
	{ id = "luftfilter", kind = "luftfilter", pos = { 0, 0.88, 0.78 }, req = { "forgasare" } },
	{ id = "slang", kind = "slang", pos = { 0.12, 1.0, 0.36 }, req = { "forgasare" } },
	{ id = "stator", kind = "stator", pos = { 0.56, 0, 0 }, req = { "packbox" } },
	{ id = "svanghjul", kind = "svanghjul", pos = { 0.66, 0, 0 }, req = { "stator" } },
	{ id = "cdi", kind = "cdi", pos = { 0.45, 0.5, 0.55 }, req = { "vevhus" } },
	{ id = "spole", kind = "spole", pos = { 0.42, 0.42, -0.55 }, req = { "vevhus" } },
	{ id = "tandkabel", kind = "tandkabel", pos = { 0.22, 0.32, -0.95 }, req = { "spole", "tandstift" } },
	{ id = "variator", kind = "variator", pos = { -0.66, 0, 0 }, req = { "packbox" } },
	{ id = "vikter", kind = "vikter", pos = { -0.6, 0, 0 }, req = { "variator" } },
	{ id = "flakt", kind = "flakt", pos = { -0.78, 0, 0 }, req = { "vikter" } },
	{ id = "remskiva", kind = "remskiva", pos = { -0.66, 0, 1.75 }, req = { "vevhus" } },
	{ id = "koppling", kind = "koppling", pos = { -0.72, 0, 1.75 }, req = { "remskiva" } },
	{ id = "rem", kind = "rem", pos = { -0.68, 0, 0.88 }, req = { "variator", "koppling" } },
	{ id = "klocka", kind = "klocka", pos = { -0.8, 0, 1.75 }, req = { "rem" } },
}
EngineDef.BY_ID = {}
EngineDef.ORDER = {}
for i, s in ipairs(EngineDef.SOCKETS) do
	EngineDef.BY_ID[s.id] = s
	EngineDef.ORDER[s.id] = i
	s.name = Parts.kindName(s.kind)
	s.grp = Parts.KINDS[s.kind].grp
end
EngineDef.GROUPS = { "Motorblock", "Transmission", "Insug", "Tändning" }

local function itemSku(items, uid) local it = items[uid]; return it and it.sku end
local function stat(items, map, sock, key)
	local uid = map[sock]
	local p = uid and Parts.get(itemSku(items, uid))
	return p and p.stats[key]
end

-- can part (sku) go into socket sock on engine map? returns ok, reason
function EngineDef.canMount(map, sock, sku, items)
	local s = EngineDef.BY_ID[sock]
	if not s then return false, "Okänd plats" end
	local p = Parts.get(sku)
	if not p then return false, "Okänd del" end
	if p.kind ~= s.kind then return false, p.name .. " passar inte där" end
	if map[sock] then return false, s.name .. " sitter redan på" end
	for _, r in ipairs(s.req) do
		if not map[r] then return false, "Montera " .. EngineDef.BY_ID[r].name:lower() .. " först" end
	end
	-- piston, rings and cylinder must have the same bore
	local bore = p.stats.bore
	if bore then
		for _, other in ipairs({ "kolv", "kolvringar", "cylinder" }) do
			if other ~= sock and map[other] then
				local ob = stat(items, map, other, "bore")
				if ob and math.abs(ob - bore) > 0.01 then
					return false, string.format("%s är %s mm men %s är %s mm", p.name, tostring(bore), EngineDef.BY_ID[other].name:lower(), tostring(ob))
				end
			end
		end
	end
	return true
end

-- can the part in sock be removed? (nothing mounted may depend on it)
function EngineDef.canRemove(map, sock)
	if not map[sock] then return false, "Inget monterat där" end
	for _, s in ipairs(EngineDef.SOCKETS) do
		if map[s.id] then
			for _, r in ipairs(s.req) do
				if r == sock then return false, "Ta bort " .. s.name:lower() .. " först" end
			end
		end
	end
	return true
end

-- sockets that are empty, in mounting order
function EngineDef.missing(map)
	local r = {}
	for _, s in ipairs(EngineDef.SOCKETS) do if not map[s.id] then r[#r + 1] = s.id end end
	return r
end
function EngineDef.complete(map) return #EngineDef.missing(map) == 0 end
function EngineDef.isEmpty(map) return next(map) == nil end
-- the next sockets that can be mounted now (all requirements met)
function EngineDef.nextUp(map)
	local r = {}
	for _, s in ipairs(EngineDef.SOCKETS) do
		if not map[s.id] then
			local ok = true
			for _, q in ipairs(s.req) do if not map[q] then ok = false end end
			if ok then r[#r + 1] = s.id end
		end
	end
	return r
end
function EngineDef.socketForKind(kind)
	for _, s in ipairs(EngineDef.SOCKETS) do if s.kind == kind then return s.id end end
end

return EngineDef
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">GarageBuilder</string><ProtectedString name="Source"><![CDATA[-- One player's garage. Built around origin (floor centre, the roller door faces -Z towards the street).
-- Returns the anchor points the server uses (where the moped, engine, shelves, bench and boxes go).
local Models = require(script.Parent.Models)
local GarageBuilder = {}

local V3, CF, C3 = Vector3.new, CFrame.new, Color3.fromRGB
local M = Enum.Material
local rad = math.rad

GarageBuilder.W, GarageBuilder.D, GarageBuilder.H = 44, 32, 14
GarageBuilder.FLOOR = 0.2 -- floor top height
local FLOOR = GarageBuilder.FLOOR

-- local anchor points (garage space)
GarageBuilder.LIFT = CF(-7, FLOOR + 1.05, 1)
GarageBuilder.STAND = CF(9, FLOOR + 3.6, 2.5) * CFrame.Angles(0, rad(90), 0)
GarageBuilder.PORT = CF(17.5, FLOOR + 3.55, 12.4)
GarageBuilder.BOOTH = CF(17, FLOOR + 3.2, -9.5)
GarageBuilder.COMPUTER = CF(10.5, FLOOR + 4.25, 15.05)
GarageBuilder.SPAWN = CF(0, FLOOR + 3, -9)
GarageBuilder.EXIT = CF(0, 0, -24) -- where the moped is put when riding out (on the driveway)

local function sign(parent, part, face, text, textColor, bg, font)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0.2
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = bg and 0 or 1
	if bg then l.BackgroundColor3 = bg end
	l.Text = text
	l.TextColor3 = textColor
	l.TextScaled = true
	l.Font = font or Enum.Font.GothamBlack
	l.Parent = sg
	sg.Parent = part
	return l
end
GarageBuilder.sign = sign

function GarageBuilder.build(parent, origin, plotIndex)
	local model = Instance.new("Model")
	model.Name = "Garage" .. plotIndex
	local mk = Models.maker(model)
	local function at(x, y, z) return origin * CF(x, y, z) end
	local function box(name, size, cf, color, mat, collide)
		local p = mk.box(name, size, cf, color, mat)
		p.CanCollide = collide ~= false
		return p
	end
	local W, D, H = GarageBuilder.W, GarageBuilder.D, GarageBuilder.H
	local hw, hd = W / 2, D / 2
	local refs = { benchSlots = {}, shelfSlots = {}, floorSlots = {}, toolSlots = {}, deliverySlots = {} }

	---------------------------------------------------------------- shell
	local floor = box("Golv", V3(W, 0.4, D), at(0, FLOOR - 0.2, 0), C3(122, 122, 118), M.Concrete)
	floor:SetAttribute("Interact", "floor")
	-- oil stains and a drain
	for i, s in ipairs({ { -6, 3, 2.2 }, { -9, -2, 1.4 }, { 8, 1, 1.6 }, { 3, 9, 1.0 }, { -2, -8, 1.2 } }) do
		local st = mk.cyl("Fläck", 0.02, s[3], at(s[1], FLOOR + 0.01, s[2]) * CFrame.Angles(0, 0, rad(90)), C3(70, 66, 60), M.SmoothPlastic)
		st.Transparency = 0.55 + i * 0.04
	end
	box("Brunn", V3(1.4, 0.03, 1.4), at(0, FLOOR + 0.01, 6), C3(60, 60, 62), M.DiamondPlate, false)
	-- yellow work-area lines around the lift and stand
	local yellow = C3(240, 196, 30)
	for _, r in ipairs({ { -7, 1, 7, 12.5 }, { 9, 2.5, 7.5, 8 } }) do
		local x, z, w, d = r[1], r[2], r[3], r[4]
		box("Linje", V3(w, 0.02, 0.22), at(x, FLOOR + 0.01, z - d / 2), yellow, M.SmoothPlastic, false)
		box("Linje", V3(w, 0.02, 0.22), at(x, FLOOR + 0.01, z + d / 2), yellow, M.SmoothPlastic, false)
		box("Linje", V3(0.22, 0.02, d), at(x - w / 2, FLOOR + 0.01, z), yellow, M.SmoothPlastic, false)
		box("Linje", V3(0.22, 0.02, d), at(x + w / 2, FLOOR + 0.01, z), yellow, M.SmoothPlastic, false)
	end
	box("Gummimatta", V3(5, 0.04, 4.5), at(9, FLOOR + 0.02, 2.5), C3(30, 30, 32), M.Rubber, false)
	-- walls: brick inside, corrugated metal outside, dark band at the bottom
	local brick, outer, band = C3(214, 208, 198), C3(84, 96, 112), C3(52, 62, 78)
	local function wall(cx, cz, sx, sz, inward)
		box("Vägg", V3(sx, H, sz), at(cx, FLOOR + H / 2, cz), outer, M.Metal)
		local ix, iz = inward[1] * 0.35, inward[2] * 0.35
		local isx, isz = sx == 1 and 0.3 or sx, sz == 1 and 0.3 or sz
		box("Vägg", V3(isx, H - 4, isz), at(cx + ix, FLOOR + 2 + H / 2, cz + iz), brick, M.Brick)
		box("Sockel", V3(isx, 4, isz), at(cx + ix, FLOOR + 2, cz + iz), band, M.Concrete)
	end
	wall(0, hd + 0.5, W + 2, 1, { 0, -1 })
	wall(-hw - 0.5, 0, 1, D, { 1, 0 })
	wall(hw + 0.5, 0, 1, D, { -1, 0 })
	-- front wall with the door opening (x -7..7, height 10) and two windows
	local doorW, doorH = 14, 10
	local sideW = (W - doorW) / 2
	for _, s in ipairs({ -1, 1 }) do
		local cx = s * (doorW / 2 + sideW / 2)
		-- below and above the window, and the pieces beside it
		box("Vägg", V3(sideW, 4.5, 1), at(cx, FLOOR + 2.25, -hd - 0.5), outer, M.Metal)
		box("Vägg", V3(sideW, H - 9, 1), at(cx, FLOOR + 9 + (H - 9) / 2, -hd - 0.5), outer, M.Metal)
		box("Vägg", V3(3, 4.5, 1), at(cx - s * (sideW / 2 - 1.5), FLOOR + 6.75, -hd - 0.5), outer, M.Metal)
		box("Vägg", V3(sideW - 11, 4.5, 1), at(cx + s * (sideW / 2 - (sideW - 11) / 2), FLOOR + 6.75, -hd - 0.5), outer, M.Metal)
		local wx = cx - s * (sideW / 2 - 3 - 4)
		local glass = box("Fönster", V3(8, 4.5, 0.2), at(wx, FLOOR + 6.75, -hd - 0.5), C3(170, 200, 220), M.Glass)
		glass.Transparency = 0.6
		box("Karm", V3(8.3, 0.25, 1.1), at(wx, FLOOR + 9.05, -hd - 0.5), C3(240, 240, 240), M.SmoothPlastic)
		box("Karm", V3(8.3, 0.35, 1.3), at(wx, FLOOR + 4.45, -hd - 0.5), C3(240, 240, 240), M.SmoothPlastic)
		box("Karm", V3(0.2, 4.5, 1.05), at(wx, FLOOR + 6.75, -hd - 0.5), C3(240, 240, 240), M.SmoothPlastic)
		-- inner brick on the front wall
		box("Vägg", V3(sideW, 4.5, 0.3), at(cx, FLOOR + 2.25, -hd + 0.15), band, M.Concrete)
	end
	box("Vägg", V3(doorW, H - doorH, 1), at(0, FLOOR + doorH + (H - doorH) / 2, -hd - 0.5), outer, M.Metal)
	-- roller door rolled up, rails
	mk.cyl("Rulle", doorW + 0.6, 0.75, at(0, FLOOR + doorH + 0.8, -hd + 0.6), C3(170, 175, 180), M.Metal)
	for _, s in ipairs({ -1, 1 }) do
		box("Skena", V3(0.3, doorH, 0.4), at(s * (doorW / 2 + 0.15), FLOOR + doorH / 2, -hd + 0.2), C3(150, 150, 150), M.Metal)
		box("Dörrkarm", V3(0.5, doorH + 0.5, 1.2), at(s * (doorW / 2 + 0.25), FLOOR + (doorH + 0.5) / 2, -hd - 0.5), C3(240, 196, 30), M.SmoothPlastic)
	end
	box("Dörrkarm", V3(doorW + 1, 0.5, 1.2), at(0, FLOOR + doorH + 0.25, -hd - 0.5), C3(240, 196, 30), M.SmoothPlastic)
	-- roof and ceiling
	box("Tak", V3(W + 3, 0.8, D + 3), at(0, FLOOR + H + 0.4, 0), C3(70, 74, 80), M.Metal)
	box("Innertak", V3(W, 0.1, D), at(0, FLOOR + H - 0.05, 0), C3(236, 236, 232), M.SmoothPlastic)
	for i = -2, 2 do box("Balk", V3(W, 0.7, 0.4), at(0, FLOOR + H - 0.45, i * 6.5), C3(110, 116, 124), M.Metal) end
	-- fluorescent lights
	for _, x in ipairs({ -12, 0, 12 }) do
		for _, z in ipairs({ -6, 7 }) do
			box("Armatur", V3(0.9, 0.25, 6.5), at(x, FLOOR + H - 0.95, z), C3(235, 235, 235), M.SmoothPlastic, false)
			local tube = box("Lysrör", V3(0.35, 0.12, 6.1), at(x, FLOOR + H - 1.12, z), C3(255, 252, 240), M.Neon, false)
			local l = Instance.new("SurfaceLight")
			l.Face = Enum.NormalId.Bottom
			l.Range = 26
			l.Angle = 120
			l.Brightness = 1.6
			l.Color = C3(255, 246, 230)
			l.Shadows = true
			l.Parent = tube
		end
	end

	---------------------------------------------------------------- workbench, pegboard and tools (back wall)
	local wood, blue, chrome = C3(150, 112, 72), C3(28, 88, 170), C3(205, 210, 215)
	local benchX0, benchX1, benchZ = -19, 1, hd - 1.4
	local bw = benchX1 - benchX0
	local bcx = (benchX0 + benchX1) / 2
	local top = box("Arbetsbänk", V3(bw, 0.35, 2.6), at(bcx, FLOOR + 3.0, benchZ), wood, M.WoodPlanks)
	top:SetAttribute("Interact", "bench")
	for i = 0, 4 do
		local x = benchX0 + 2 + i * 4
		box("Skåp", V3(3.8, 2.75, 2.3), at(x, FLOOR + 1.45, benchZ + 0.1), blue, M.Metal)
		for j = 0, 2 do
			box("Låda", V3(3.5, 0.75, 0.06), at(x, FLOOR + 0.55 + j * 0.88, benchZ - 1.07), C3(36, 100, 185), M.Metal, false)
			box("Handtag", V3(1.4, 0.1, 0.12), at(x, FLOOR + 0.8 + j * 0.88, benchZ - 1.13), chrome, M.Metal, false)
		end
	end
	for i = 1, 8 do
		local x = benchX0 + 1.5 + (i - 1) * (bw - 3) / 7
		refs.benchSlots[i] = at(x, FLOOR + 3.2, benchZ - 0.2)
	end
	-- pegboard with tools
	box("Verktygstavla", V3(bw, 5.2, 0.15), at(bcx, FLOOR + 6.3, hd - 0.2), C3(196, 172, 128), M.Plaster)
	for i = 0, bw * 2 - 1 do
		for j = 0, 9 do
			if (i + j) % 2 == 0 then box("Hål", V3(0.08, 0.08, 0.02), at(benchX0 + 0.25 + i * 0.5, FLOOR + 3.95 + j * 0.5, hd - 0.28), C3(90, 76, 56), M.SmoothPlastic, false) end
		end
	end
	-- wrenches in a row (sizes), screwdrivers, hammer, pliers
	for i = 0, 9 do
		local len = 1.0 + i * 0.12
		local x = benchX0 + 1 + i * 0.45
		box("Nyckel", V3(0.12, len, 0.05), at(x, FLOOR + 7.2 - len / 2, hd - 0.33), chrome, M.Metal, false)
		box("Nyckel", V3(0.26, 0.2, 0.05), at(x, FLOOR + 7.25, hd - 0.33), chrome, M.Metal, false)
	end
	local cols = { C3(220, 40, 40), C3(240, 196, 30), C3(30, 90, 200), C3(30, 160, 80), C3(220, 40, 40), C3(30, 30, 30) }
	for i = 1, 6 do
		local x = benchX0 + 6 + i * 0.5
		box("Mejsel", V3(0.16, 0.6, 0.16), at(x, FLOOR + 6.8, hd - 0.36), cols[i], M.SmoothPlastic, false)
		box("Mejsel", V3(0.05, 0.9, 0.05), at(x, FLOOR + 6.05, hd - 0.36), chrome, M.Metal, false)
	end
	box("Hammare", V3(0.15, 1.3, 0.12), at(benchX0 + 10.5, FLOOR + 6.3, hd - 0.35), wood, M.Wood, false)
	box("Hammare", V3(0.7, 0.25, 0.2), at(benchX0 + 10.5, FLOOR + 7.0, hd - 0.38), C3(60, 60, 64), M.Metal, false)
	for i = 0, 2 do
		box("Tång", V3(0.12, 1.0, 0.06), at(benchX0 + 12 + i * 0.6 - 0.08, FLOOR + 6.3, hd - 0.34) * CFrame.Angles(0, 0, rad(6)), C3(200, 40, 40), M.SmoothPlastic, false)
		box("Tång", V3(0.12, 1.0, 0.06), at(benchX0 + 12 + i * 0.6 + 0.08, FLOOR + 6.3, hd - 0.34) * CFrame.Angles(0, 0, rad(-6)), C3(200, 40, 40), M.SmoothPlastic, false)
	end
	-- socket set case and a cordless screwdriver on the board (where the player's tools hang)
	for i = 1, 4 do refs.toolSlots[i] = at(benchX0 + 14 + (i - 1) * 1.4, FLOOR + 6.2, hd - 0.6) end
	-- shelf above the pegboard with cans and boxes
	box("Hylla", V3(bw, 0.2, 1.4), at(bcx, FLOOR + 9.3, hd - 0.8), C3(120, 120, 124), M.Metal)
	local canCols = { C3(200, 30, 30), C3(30, 100, 200), C3(240, 196, 30), C3(40, 140, 60), C3(230, 230, 230) }
	for i = 0, 17 do
		local x = benchX0 + 0.8 + i * 1.08
		if i % 4 == 3 then box("Kartong", V3(0.95, 0.8, 1.0), at(x, FLOOR + 9.8, hd - 0.8), C3(176, 138, 92), M.Cardboard, false)
		else mk.cyl("Burk", 0.9, 0.3, at(x, FLOOR + 9.85, hd - 0.8) * CFrame.Angles(0, 0, rad(90)), canCols[i % 5 + 1], M.Metal).CanCollide = false end
	end
	-- banner (made-up brand)
	local banner = box("Banderoll", V3(12, 2.6, 0.08), at(bcx, FLOOR + 11.6, hd - 0.12), C3(22, 52, 150), M.Fabric, false)
	sign(model, banner, Enum.NormalId.Front, "VIPPA  MOPEDER", C3(255, 255, 255))

	---------------------------------------------------------------- red tool chest and computer desk
	local red = C3(196, 30, 30)
	box("Verktygsvagn", V3(4.2, 3.6, 2.2), at(4.6, FLOOR + 2.0, hd - 1.6), red, M.Metal)
	box("Verktygslåda", V3(4.2, 2.0, 1.9), at(4.6, FLOOR + 4.8, hd - 1.5), red, M.Metal)
	for j = 0, 5 do box("Låda", V3(3.9, 0.04, 0.05), at(4.6, FLOOR + 0.8 + j * 0.55, hd - 2.73), C3(30, 30, 30), M.Metal, false) end
	for j = 0, 2 do box("Handtag", V3(3.6, 0.08, 0.1), at(4.6, FLOOR + 4.2 + j * 0.55, hd - 2.5), chrome, M.Metal, false) end
	for _, s in ipairs({ -1, 1 }) do mk.cyl("Hjul", 0.25, 0.22, at(4.6 + s * 1.8, FLOOR + 0.22, hd - 2.4), C3(20, 20, 20), M.Rubber) end
	-- desk
	box("Skrivbord", V3(5.5, 0.25, 2.6), at(10.5, FLOOR + 3.0, hd - 1.5), C3(60, 62, 68), M.Metal)
	for _, s in ipairs({ -1, 1 }) do box("Ben", V3(0.2, 2.9, 2.4), at(10.5 + s * 2.6, FLOOR + 1.45, hd - 1.5), C3(40, 40, 44), M.Metal) end
	box("Dator", V3(0.9, 2.0, 2.0), at(12.4, FLOOR + 1.0, hd - 1.6), C3(26, 26, 30), M.SmoothPlastic)
	box("Skärmfot", V3(0.8, 0.08, 0.6), at(10.5, FLOOR + 3.17, hd - 0.9), C3(30, 30, 34), M.Metal)
	box("Skärmarm", V3(0.15, 0.9, 0.15), at(10.5, FLOOR + 3.6, hd - 0.85), C3(30, 30, 34), M.Metal)
	local monitor = box("Skärm", V3(3.0, 1.75, 0.14), GarageBuilder.COMPUTER and origin * GarageBuilder.COMPUTER, C3(16, 16, 18), M.SmoothPlastic)
	monitor:SetAttribute("Interact", "computer")
	refs.screen = monitor
	box("Tangentbord", V3(1.9, 0.08, 0.65), at(10.3, FLOOR + 3.17, hd - 2.0), C3(30, 30, 34), M.SmoothPlastic, false)
	box("Mus", V3(0.22, 0.08, 0.35), at(11.8, FLOOR + 3.17, hd - 2.0), C3(30, 30, 34), M.SmoothPlastic, false)
	-- office chair
	local chair = C3(26, 26, 28)
	box("Stol", V3(1.6, 0.3, 1.6), at(10.5, FLOOR + 2.0, hd - 3.6), chair, M.Fabric)
	box("Stol", V3(1.6, 1.8, 0.25), at(10.5, FLOOR + 3.0, hd - 2.9), chair, M.Fabric)
	box("Stol", V3(0.2, 1.7, 0.2), at(10.5, FLOOR + 1.0, hd - 3.6), C3(120, 120, 120), M.Metal, false)
	box("Stol", V3(1.8, 0.15, 0.2), at(10.5, FLOOR + 0.2, hd - 3.6), C3(60, 60, 60), M.Metal, false)
	box("Stol", V3(0.2, 0.15, 1.8), at(10.5, FLOOR + 0.2, hd - 3.6), C3(60, 60, 60), M.Metal, false)

	---------------------------------------------------------------- porting bench with vise and lamp
	local px, pz = 17.5, hd - 3.2
	box("Portningsbänk", V3(6, 0.4, 3), at(px, FLOOR + 2.9, pz), C3(80, 84, 90), M.DiamondPlate)
	for _, s in ipairs({ -1, 1 }) do for _, t in ipairs({ -1, 1 }) do box("Ben", V3(0.3, 2.7, 0.3), at(px + s * 2.7, FLOOR + 1.35, pz + t * 1.3), C3(60, 60, 64), M.Metal) end end
	local pb = box("Skruvstäd", V3(1.3, 0.6, 1.0), at(px, FLOOR + 3.4, pz - 0.6), C3(30, 70, 140), M.Metal)
	pb:SetAttribute("Interact", "portbench")
	box("Käft", V3(1.2, 0.5, 0.2), at(px, FLOOR + 3.85, pz - 1.0), C3(70, 74, 80), M.Metal, false)
	box("Käft", V3(1.2, 0.5, 0.2), at(px, FLOOR + 3.85, pz - 0.1), C3(70, 74, 80), M.Metal, false)
	mk.cyl("Skruv", 1.3, 0.07, at(px, FLOOR + 3.4, pz + 0.5) * CFrame.Angles(0, rad(90), 0), C3(180, 180, 180), M.Metal)
	box("Lampfot", V3(0.5, 0.15, 0.5), at(px + 2.2, FLOOR + 3.15, pz + 0.8), C3(30, 30, 30), M.Metal, false)
	mk.tube("Lamparm", at(px + 2.2, FLOOR + 3.2, pz + 0.8).Position, at(px + 1.4, FLOOR + 5.6, pz - 0.2).Position, 0.06, C3(30, 30, 30), M.Metal)
	local shade = mk.cyl("Lampskärm", 0.5, 0.35, at(px + 1.2, FLOOR + 5.5, pz - 0.4) * CFrame.Angles(0, 0, rad(-60)), C3(240, 196, 30), M.Metal)
	local pl = Instance.new("SpotLight")
	pl.Face = Enum.NormalId.Left
	pl.Range = 10
	pl.Angle = 70
	pl.Brightness = 2
	pl.Parent = shade
	refs.portTool = at(px + 1.6, FLOOR + 3.2, pz + 0.6)
	local ps = box("Skylt", V3(4, 0.8, 0.1), at(px, FLOOR + 7.5, hd - 0.3), C3(20, 20, 24), M.SmoothPlastic, false)
	sign(model, ps, Enum.NormalId.Front, "PORTNING", C3(240, 196, 30))

	---------------------------------------------------------------- paint booth (front right corner)
	local bx0, bx1, bz0, bz1 = 12, hw, -hd, -4
	local bcx2, bcz = (bx0 + bx1) / 2, (bz0 + bz1) / 2
	local white = C3(232, 234, 236)
	box("Lackbox", V3(0.3, 11, bz1 - bz0), at(bx0 + 0.15, FLOOR + 5.5, bcz), white, M.SmoothPlastic)
	box("Lackbox", V3(bx1 - bx0, 0.3, bz1 - bz0), at(bcx2, FLOOR + 11, bcz), white, M.SmoothPlastic)
	local curtain = box("Draperi", V3(bx1 - bx0 - 4, 9.5, 0.08), at(bcx2 + 2, FLOOR + 6.2, bz1), C3(160, 200, 230), M.SmoothPlastic, false)
	curtain.Transparency = 0.65
	box("Lackbox", V3(4, 11, 0.3), at(bx0 + 2, FLOOR + 5.5, bz1), white, M.SmoothPlastic)
	box("Galler", V3(bx1 - bx0 - 0.6, 0.06, bz1 - bz0 - 0.6), at(bcx2, FLOOR + 0.04, bcz), C3(50, 52, 56), M.DiamondPlate, false)
	for _, x in ipairs({ bx0 + 2.5, bx1 - 2.5 }) do
		local lp = box("Lackljus", V3(1.2, 0.15, 8), at(x, FLOOR + 10.8, bcz), C3(255, 255, 250), M.Neon, false)
		local sl = Instance.new("SurfaceLight")
		sl.Face = Enum.NormalId.Bottom
		sl.Range = 14
		sl.Brightness = 1.4
		sl.Angle = 120
		sl.Parent = lp
	end
	-- extraction fan on the side wall
	mk.cyl("Fläkthus", 0.6, 1.4, at(bx1 - 0.4, FLOOR + 7, bcz), C3(150, 150, 150), M.Metal)
	mk.ring("Fläkt", at(bx1 - 0.75, FLOOR + 7, bcz), 1.4, 0.06, 6, C3(60, 60, 60), M.Metal)
	-- panel stand
	local stand = box("Lackstativ", V3(0.25, 3.2, 0.25), at(17, FLOOR + 1.6, -9.5), C3(40, 40, 44), M.Metal)
	stand:SetAttribute("Interact", "booth")
	box("Lackstativ", V3(2.4, 0.2, 2.4), at(17, FLOOR + 0.1, -9.5), C3(40, 40, 44), M.Metal)
	box("Lackstativ", V3(2.2, 0.15, 0.15), at(17, FLOOR + 3.0, -9.5), C3(40, 40, 44), M.Metal)
	local bsign = box("Skylt", V3(5, 1, 0.1), at(bcx2 + 2, FLOOR + 10.4, bz1 - 0.1), C3(20, 20, 24), M.SmoothPlastic, false)
	sign(model, bsign, Enum.NormalId.Back, "LACKBOX", C3(255, 255, 255))
	-- compressor next to the booth
	mk.cyl("Kompressor", 3, 0.8, at(10.5, FLOOR + 0.85, -13) , red, M.Metal)
	box("Kompressor", V3(1.2, 0.8, 1), at(10.5, FLOOR + 2, -13), C3(40, 40, 40), M.Metal)

	---------------------------------------------------------------- storage shelves (left wall), 24 slots
	local orange, board = C3(232, 120, 30), C3(150, 152, 156)
	for u, zc in ipairs({ -3.5, 6.5 }) do
		for _, dz in ipairs({ -4, 4 }) do
			for _, dx in ipairs({ -1, 1 }) do
				box("Hyllställ", V3(0.25, 10, 0.25), at(-hw + 1.6 + dx * 1.1, FLOOR + 5, zc + dz), orange, M.Metal)
			end
		end
		for lv = 0, 3 do
			local y = FLOOR + 0.6 + lv * 2.6
			local sh = box("Hyllplan", V3(2.5, 0.15, 8.2), at(-hw + 1.6, y, zc), board, M.Metal)
			sh:SetAttribute("Interact", "shelf")
			for k = 0, 2 do
				refs.shelfSlots[#refs.shelfSlots + 1] = at(-hw + 1.6, y + 0.1, zc - 2.7 + k * 2.7)
			end
		end
		-- static stock on the top
		for k = 0, 3 do box("Kartong", V3(1.6, 1.1, 1.6), at(-hw + 1.6, FLOOR + 10.65, zc - 3 + k * 2), C3(176, 138, 92), M.Cardboard, false) end
	end
	for i = 1, 12 do refs.floorSlots[i] = at(-14 + ((i - 1) % 6) * 2.4, FLOOR, -11 + math.floor((i - 1) / 6) * 2.4) end

	---------------------------------------------------------------- moped lift and engine stand
	local lift = GarageBuilder.LIFT
	box("Lyft", V3(2.8, 0.3, 9), at(lift.X, FLOOR + 0.15, lift.Z), C3(170, 30, 30), M.Metal)
	for _, s in ipairs({ -1, 1 }) do
		box("Saxarm", V3(0.2, 0.2, 5.4), at(lift.X + s * 0.9, FLOOR + 0.6, lift.Z) * CFrame.Angles(rad(8), 0, 0), C3(60, 60, 60), M.Metal, false)
		box("Saxarm", V3(0.2, 0.2, 5.4), at(lift.X + s * 0.9, FLOOR + 0.6, lift.Z) * CFrame.Angles(rad(-8), 0, 0), C3(60, 60, 60), M.Metal, false)
	end
	local lt = box("Lyftbord", V3(2.6, 0.3, 8.6), at(lift.X, FLOOR + 0.9, lift.Z), C3(200, 36, 36), M.Metal)
	lt:SetAttribute("Interact", "lift")
	box("Gummi", V3(1.0, 0.04, 8.4), at(lift.X, FLOOR + 1.06, lift.Z), C3(25, 25, 27), M.Rubber, false)
	box("Hjulfäste", V3(1.0, 0.8, 0.3), at(lift.X, FLOOR + 1.4, lift.Z - 4.0), C3(60, 60, 60), M.Metal)
	local st = GarageBuilder.STAND
	local sx, sz = st.X, st.Z
	box("Stativfot", V3(0.4, 0.3, 4), at(sx - 1.3, FLOOR + 0.15, sz), C3(190, 30, 30), M.Metal)
	box("Stativfot", V3(0.4, 0.3, 4), at(sx + 1.3, FLOOR + 0.15, sz), C3(190, 30, 30), M.Metal)
	box("Stativfot", V3(3, 0.3, 0.4), at(sx, FLOOR + 0.15, sz + 1), C3(190, 30, 30), M.Metal)
	for _, s in ipairs({ -1, 1 }) do for _, t in ipairs({ -1.8, 1.8 }) do mk.cyl("Hjul", 0.2, 0.16, at(sx + s * 1.3, FLOOR + 0.16, sz + t), C3(20, 20, 20), M.Rubber) end end
	local post = box("Motorstativ", V3(0.4, 3.2, 0.4), at(sx, FLOOR + 1.9, sz + 1), C3(190, 30, 30), M.Metal)
	post:SetAttribute("Interact", "stand")
	box("Arm", V3(0.3, 0.3, 1.3), at(sx, FLOOR + 3.4, sz + 0.5), C3(190, 30, 30), M.Metal)
	mk.cyl("Fäste", 0.15, 0.5, at(sx, st.Y, sz - 0.15) * CFrame.Angles(0, rad(90), 0), C3(80, 80, 84), M.Metal)

	---------------------------------------------------------------- decor
	for i = 0, 2 do mk.cyl("Däck", 0.7, 1.2, at(hw - 2, FLOOR + 0.35 + i * 0.72, 5) * CFrame.Angles(0, 0, rad(90)), C3(24, 24, 26), M.Rubber).CanCollide = true end
	mk.cyl("Oljefat", 2.8, 0.9, at(hw - 2, FLOOR + 1.4, 1.5) * CFrame.Angles(0, 0, rad(90)), C3(30, 80, 160), M.Metal).CanCollide = true
	mk.cyl("Brandsläckare", 1.4, 0.3, at(-8, FLOOR + 2.2, -hd + 0.45) * CFrame.Angles(0, 0, rad(90)), red, M.SmoothPlastic)
	mk.cyl("Klocka", 0.1, 0.7, at(0, FLOOR + 11.5, hd - 0.3) * CFrame.Angles(0, rad(90), 0), C3(245, 245, 245), M.SmoothPlastic)
	local poster = box("Affisch", V3(0.05, 3.2, 2.4), at(hw - 0.2, FLOOR + 7, 9), C3(20, 20, 24), M.SmoothPlastic, false)
	sign(model, poster, Enum.NormalId.Left, "FARTEK\nRACING", C3(220, 40, 40))
	local poster2 = box("Affisch", V3(0.05, 3.2, 2.4), at(hw - 0.2, FLOOR + 7, 13), C3(240, 196, 30), M.SmoothPlastic, false)
	sign(model, poster2, Enum.NormalId.Left, "NORDTRIM\nSPORT", C3(20, 20, 24))

	---------------------------------------------------------------- outside: sign, driveway, delivery spot
	local nameBoard = box("Namnskylt", V3(16, 2.4, 0.3), at(0, FLOOR + H - 1.6, -hd - 1.15), C3(20, 22, 28), M.SmoothPlastic, false)
	refs.nameLabel = sign(model, nameBoard, Enum.NormalId.Front, "LEDIGT GARAGE", C3(255, 255, 255))
	local numBoard = box("Nummer", V3(2, 2, 0.3), at(-hw + 2, FLOOR + H - 1.6, -hd - 1.15), C3(240, 196, 30), M.SmoothPlastic, false)
	sign(model, numBoard, Enum.NormalId.Front, tostring(plotIndex), C3(20, 20, 20))
	for _, s in ipairs({ -1, 1 }) do
		local lamp = box("Vägglampa", V3(0.8, 0.5, 0.6), at(s * 9.5, FLOOR + 10.5, -hd - 1.3), C3(255, 240, 200), M.Neon, false)
		local l = Instance.new("SpotLight")
		l.Face = Enum.NormalId.Bottom
		l.Range = 18
		l.Brightness = 1.2
		l.Angle = 100
		l.Parent = lamp
	end
	box("Uppfart", V3(16, 0.2, 10), at(0, -0.04, -hd - 5), C3(70, 70, 72), M.Asphalt)
	box("Leveransplats", V3(5, 0.03, 4), at(12, 0.08, -hd - 4.5), C3(240, 196, 30), M.SmoothPlastic, false).Transparency = 0.3
	for i = 1, 4 do refs.deliverySlots[i] = at(10.8 + ((i - 1) % 2) * 2.4, 0.1, -hd - 3.6 - math.floor((i - 1) / 2) * 2.0) end
	-- invisible wall above the roof edge so nobody climbs onto the roof by accident: not needed (roof is high)
	model.Parent = parent
	refs.model = model
	return refs
end

return GarageBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Map</string><ProtectedString name="Source"><![CDATA[-- The world layout: roads (also drawn on the minimap), places and job destinations. Ground top is y = 0.
local Config = require(script.Parent.Config)
local Map = {}

local SZ = Config.STREET_Z
Map.ROAD_Y = 0.12 -- road surface height
-- straight road segments: a, b = {x, z}; w = width; name for the minimap
Map.ROADS = {
	{ a = { -330, SZ }, b = { 330, SZ }, w = 16, n = "Garagegatan" },
	{ a = { 0, SZ - 8 }, b = { 0, -530 }, w = 16, n = "Storgatan" },
	{ a = { -330, -290 }, b = { 330, -290 }, w = 14, n = "Industrivägen" },
	{ a = { -330, SZ - 8 }, b = { -330, -282 }, w = 12, n = "Västra vägen" },
	{ a = { 330, SZ - 8 }, b = { 330, -282 }, w = 12, n = "Östra vägen" },
	{ a = { 330, SZ + 8 }, b = { 330, 200 }, w = 11, n = "Landsvägen" },
	{ a = { 330, 200 }, b = { 520, 390 }, w = 11, n = "Landsvägen" },
	{ a = { 520, 390 }, b = { 520, 470 }, w = 11, n = "Gårdsvägen" },
	{ a = { -230, SZ + 8 }, b = { -230, 120 }, w = 12, n = "Banvägen" },
	{ a = { -330, 330 }, b = { 60, 330 }, w = 16, n = "Dragstrip", drag = true },
	{ a = { -230, 120 }, b = { -230, 322 }, w = 12, n = "Banvägen" },
}
-- the test track: an oval made of segments
Map.TRACK = { cx = -110, cz = 210, len = 150, r = 55, w = 14 }
do
	local t = Map.TRACK
	local pts = {}
	local n = 14
	for i = 0, n do local a = math.pi / 2 + i / n * math.pi; pts[#pts + 1] = { t.cx - t.len / 2 + math.cos(a) * t.r, t.cz - math.sin(a) * t.r } end
	for i = 0, n do local a = -math.pi / 2 + i / n * math.pi; pts[#pts + 1] = { t.cx + t.len / 2 + math.cos(a) * t.r, t.cz - math.sin(a) * t.r } end
	pts[#pts + 1] = pts[1]
	for i = 1, #pts - 1 do Map.ROADS[#Map.ROADS + 1] = { a = pts[i], b = pts[i + 1], w = t.w, n = "Testbanan", track = true } end
	Map.ROADS[#Map.ROADS + 1] = { a = { -230, 210 }, b = { t.cx - t.len / 2 - t.r, 210 }, w = 12, n = "Testbanan" }
end

-- job destinations (x, z) and other named places
Map.PLACES = {
	norr = { x = 0, z = -545, n = "Verkstad Norr" },
	hamn = { x = -360, z = -330, n = "Hamnens lager" },
	macken = { x = 42, z = -130, n = "Macken" },
	gard = { x = 520, z = 485, n = "Lindgårdens gård" },
	ind = { x = 240, z = -318, n = "Industriverkstaden" },
}
Map.DELIVER_RADIUS = 14

-- distance from a point to the nearest road centreline, and that road
function Map.nearestRoad(x, z)
	local best, bestR = math.huge, nil
	for _, r in ipairs(Map.ROADS) do
		local ax, az, bx, bz = r.a[1], r.a[2], r.b[1], r.b[2]
		local dx, dz = bx - ax, bz - az
		local l2 = dx * dx + dz * dz
		local t = l2 > 0 and math.max(0, math.min(1, ((x - ax) * dx + (z - az) * dz) / l2)) or 0
		local px, pz = ax + dx * t, az + dz * t
		local d = math.sqrt((x - px) ^ 2 + (z - pz) ^ 2)
		if d < best then best, bestR = d, r end
	end
	return best, bestR
end
function Map.onRoad(x, z) local d, r = Map.nearestRoad(x, z); return d <= r.w / 2 + 0.5 end

return Map
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Models</string><ProtectedString name="Source"><![CDATA[-- 3D models built from Roblox parts: every engine part, every chassis part, panels, the whole moped,
-- tools, the first-person hand and the delivery box. Each part kind has one builder; it is used on the engine,
-- on the moped, on the shelf, in the hand and as the product picture in the shop.
local Parts = require(script.Parent.Parts)
local EngineDef = require(script.Parent.EngineDef)
local MopedDef = require(script.Parent.MopedDef)
local Paint = require(script.Parent.Paint)
local Models = {}

local V3, CF, C3 = Vector3.new, CFrame.new, Color3.fromRGB
local rad = math.rad
local ALU, CAST, STEEL, CHROME = C3(176, 180, 186), C3(128, 131, 137), C3(84, 86, 92), C3(214, 218, 224)
local BLACK, RUBBER, DARK = C3(30, 30, 33), C3(22, 22, 24), C3(48, 50, 54)
local COPPER, BRASS, CERAMIC = C3(184, 112, 50), C3(190, 160, 80), C3(236, 232, 222)
Models.COLORS = { ALU = ALU, CAST = CAST, STEEL = STEEL, CHROME = CHROME, BLACK = BLACK, RUBBER = RUBBER }
local M = Enum.Material

---------------------------------------------------------------- builder
-- mk(parent): helpers that create anchored, non-colliding parts in world space
function Models.maker(parent)
	local mk = { parent = parent, parts = {} }
	local function base(cls, name, size, cf, color, mat)
		local p = Instance.new(cls)
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CastShadow = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Size = size
		p.CFrame = cf
		p.Color = color or ALU
		p.Material = mat or M.SmoothPlastic
		p.Parent = parent
		mk.parts[#mk.parts + 1] = p
		return p
	end
	function mk.box(name, size, cf, color, mat) return base("Part", name, size, cf, color, mat) end
	function mk.wedge(name, size, cf, color, mat) return base("WedgePart", name, size, cf, color, mat) end
	-- cylinder along the X axis of cf
	function mk.cyl(name, len, radius, cf, color, mat)
		local p = base("Part", name, V3(len, radius * 2, radius * 2), cf, color, mat)
		p.Shape = Enum.PartType.Cylinder
		return p
	end
	function mk.ball(name, d, cf, color, mat)
		local p = base("Part", name, V3(d, d, d), cf, color, mat)
		p.Shape = Enum.PartType.Ball
		return p
	end
	-- straight tube between two world points
	function mk.tube(name, a, b, radius, color, mat)
		local len = (b - a).Magnitude
		if len < 1e-3 then return nil end
		local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0)
		return mk.cyl(name, len, radius, cf, color, mat)
	end
	-- tube through several points (bends get a ball joint)
	function mk.path(name, pts, radius, color, mat)
		for i = 1, #pts - 1 do
			mk.tube(name, pts[i], pts[i + 1], radius, color, mat)
			if i > 1 then mk.ball(name, radius * 2, CF(pts[i]), color, mat) end
		end
	end
	-- a disc facing X with spokes/fins around it
	function mk.ring(name, cf, radius, thick, n, color, mat)
		for i = 1, n do
			local a = (i - 1) / n * math.pi * 2
			mk.box(name, V3(thick, radius * 0.5, radius * 0.08), cf * CFrame.Angles(a, 0, 0) * CF(0, radius * 0.72, 0), color, mat)
		end
	end
	return mk
end
local function brandColor(part)
	local r, g, b = Parts.brandColor(part.brand)
	return C3(r, g, b)
end

---------------------------------------------------------------- engine part builders
-- each builder: (mk, cf, part, item) where cf is the socket frame in world space
local B = {}
local AX_Z = CFrame.Angles(0, math.pi / 2, 0) -- cylinder along Z
local AX_Y = CFrame.Angles(0, 0, math.pi / 2) -- cylinder along Y

B.vevhus = function(mk, cf, part)
	local c = part.brand == "Origo" and CAST or ALU
	mk.cyl("Vevhus", 0.86, 0.44, cf, c, M.Metal)
	mk.box("Vevhus", V3(0.86, 0.72, 0.55), cf * CF(0, -0.02, 0.32), c, M.Metal)
	mk.box("Vevhus", V3(0.74, 0.74, 0.1), cf * CF(0, 0, -0.44), c, M.Metal) -- cylinder base face
	mk.box("Vevhus", V3(0.86, 0.12, 0.7), cf * CF(0, 0.4, 0.1), c, M.Metal)
	-- inner CVT wall and rear axle boss on the left side
	mk.box("Vevhus", V3(0.07, 0.62, 1.9), cf * CF(-0.5, 0, 0.82), c, M.Metal)
	mk.cyl("Vevhus", 0.07, 0.36, cf * CF(-0.5, 0, 1.7), c, M.Metal)
	mk.cyl("Vevhus", 0.07, 0.34, cf * CF(-0.5, 0, -0.05), c, M.Metal)
	mk.cyl("Vevhus", 0.25, 0.14, cf * CF(-0.36, 0, 1.7), c, M.Metal)
	-- bolts along the joint
	for i = 0, 5 do mk.cyl("Bult", 0.9, 0.03, cf * CF(0, 0.34 * math.cos(i), 0.34 * math.sin(i) + 0.12), STEEL, M.Metal) end
	if part.brand ~= "Origo" then mk.box("Dekal", V3(0.02, 0.12, 0.4), cf * CF(0.44, 0.15, 0.32), brandColor(part)) end
end
B.vevlager = function(mk, cf)
	for _, x in ipairs({ -0.33, 0.33 }) do
		mk.cyl("Lager", 0.08, 0.2, cf * CF(x, 0, 0), CHROME, M.Metal)
		mk.cyl("Lager", 0.085, 0.1, cf * CF(x, 0, 0), STEEL, M.Metal)
	end
end
B.vevaxel = function(mk, cf, part)
	mk.cyl("Axel", 1.62, 0.055, cf, STEEL, M.Metal)
	for _, x in ipairs({ -0.12, 0.12 }) do
		mk.cyl("Vevskiva", 0.1, 0.32, cf * CF(x, 0, 0), part.brand == "Origo" and STEEL or CHROME, M.Metal)
	end
	mk.cyl("Vevtapp", 0.24, 0.05, cf * CF(0, 0, -0.2), STEEL, M.Metal)
	mk.box("Vevstake", V3(0.09, 0.08, 0.46), cf * CF(0, 0, -0.42), CHROME, M.Metal)
	mk.cyl("Lilländen", 0.1, 0.07, cf * CF(0, 0, -0.62), CHROME, M.Metal)
	-- splines at the ends
	mk.cyl("Spline", 0.18, 0.065, cf * CF(-0.72, 0, 0), DARK, M.DiamondPlate)
	mk.cyl("Spline", 0.18, 0.065, cf * CF(0.72, 0, 0), DARK, M.DiamondPlate)
end
B.packbox = function(mk, cf)
	for _, x in ipairs({ -0.42, 0.42 }) do mk.cyl("Packbox", 0.05, 0.12, cf * CF(x, 0, 0), RUBBER, M.Rubber) end
end
B.nallager = function(mk, cf, part)
	mk.cyl("Nållager", 0.13, 0.065, cf, part.brand == "Origo" and BRASS or CHROME, M.Metal)
end
local function boreR(part) return (part.stats.bore or 40) / 40 * 0.19 end
B.kolv = function(mk, cf, part)
	local r = boreR(part)
	mk.cyl("Kolv", 0.28, r, cf * AX_Z, ALU, M.Metal)
	mk.cyl("Kolvtopp", 0.02, r * 0.96, cf * CF(0, 0, -0.145) * AX_Z, C3(150, 150, 150), M.Metal)
	mk.cyl("Bulthål", 0.02, 0.05, cf * CF(r + 0.002, 0, 0.04), STEEL, M.Metal)
end
B.kolvbult = function(mk, cf)
	mk.cyl("Kolvbult", 0.34, 0.038, cf, CHROME, M.Metal)
end
B.kolvringar = function(mk, cf, part)
	local r = boreR(part) + 0.006
	mk.cyl("Ring", 0.018, r, cf * AX_Z, DARK, M.Metal)
	mk.cyl("Ring", 0.018, r, cf * CF(0, 0, -0.04) * AX_Z, DARK, M.Metal)
end
B.fotpackning = function(mk, cf, part)
	mk.box("Packning", V3(0.62, 0.62, 0.015), cf, part.brand == "Origo" and C3(196, 170, 120) or C3(120, 120, 128), M.Fabric)
end
B.cylinder = function(mk, cf, part)
	local lvl = part.stats.lvl or 0
	local body = (lvl == 0 and CAST) or (lvl == 1 and DARK) or ALU
	local w = 0.56 + 0.03 * lvl
	mk.box("Cylinder", V3(w, w, 0.6), cf, body, M.Metal)
	for i = 0, 6 do
		mk.box("Fläns", V3(w + 0.22, w + 0.22, 0.035), cf * CF(0, 0, -0.26 + i * 0.085), body, M.Metal)
	end
	mk.cyl("Avgasport", 0.18, 0.1, cf * CF(0, -w / 2 - 0.06, -0.05) * AX_Y, body, M.Metal)
	mk.box("Fot", V3(0.66, 0.66, 0.05), cf * CF(0, 0, 0.29), body, M.Metal)
	if lvl > 0 then
		mk.box("Dekal", V3(0.02, 0.1, 0.42), cf * CF(w / 2 + 0.115, 0, 0), brandColor(part))
		mk.box("Dekal", V3(0.02, 0.1, 0.42), cf * CF(-w / 2 - 0.115, 0, 0), brandColor(part))
	end
end
B.topplock = function(mk, cf, part)
	local c = part.brand == "Origo" and CAST or C3(60, 60, 64)
	mk.box("Topplock", V3(0.6, 0.6, 0.1), cf, c, M.Metal)
	for i = 0, 2 do mk.box("Fläns", V3(0.74, 0.74, 0.025), cf * CF(0, 0, -0.06 - i * 0.045), c, M.Metal) end
	mk.cyl("Tändstiftsfäste", 0.1, 0.07, cf * CF(0, 0.1, -0.13) * AX_Z, c, M.Metal)
	if part.brand ~= "Origo" then mk.box("Dekal", V3(0.3, 0.06, 0.012), cf * CF(0, -0.15, -0.155), brandColor(part)) end
end
B.tandstift = function(mk, cf, part)
	mk.cyl("Gänga", 0.06, 0.03, cf * CF(0, 0, 0.02) * AX_Z, CHROME, M.Metal)
	mk.cyl("Sexkant", 0.05, 0.05, cf * CF(0, 0, -0.03) * AX_Z, CHROME, M.Metal)
	mk.cyl("Isolator", 0.12, 0.032, cf * CF(0, 0, -0.11) * AX_Z, CERAMIC, M.SmoothPlastic)
	mk.cyl("Topp", 0.03, 0.018, cf * CF(0, 0, -0.18) * AX_Z, STEEL, M.Metal)
	if part.brand ~= "Origo" then mk.cyl("Ring", 0.012, 0.034, cf * CF(0, 0, -0.08) * AX_Z, brandColor(part)) end
end
B.reed = function(mk, cf, part)
	mk.box("Reedhus", V3(0.38, 0.1, 0.32), cf, DARK, M.Metal)
	local c = (part.stats.lvl or 0) > 0 and C3(30, 30, 30) or C3(90, 90, 70)
	mk.wedge("Blad", V3(0.3, 0.1, 0.24), cf * CF(0, 0.09, 0), c, part.brand == "Fartek" and M.Fabric or M.SmoothPlastic)
	if part.brand ~= "Origo" then mk.box("Dekal", V3(0.38, 0.02, 0.06), cf * CF(0, 0.06, -0.14), brandColor(part)) end
end
B.insug = function(mk, cf, part)
	mk.cyl("Insug", 0.22, 0.1 + 0.015 * (part.stats.lvl or 0), cf * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(0, 0, -0.35), part.brand == "Origo" and RUBBER or brandColor(part), M.Rubber)
	mk.box("Fläns", V3(0.3, 0.03, 0.24), cf * CF(0, -0.1, -0.02), DARK, M.Metal)
end
B.forgasare = function(mk, cf, part)
	local s = (part.stats.mm or 12) / 12
	mk.cyl("Förgasare", 0.32, 0.1 * s ^ 0.5, cf * AX_Z, ALU, M.Metal)
	mk.box("Flottörhus", V3(0.18, 0.14, 0.18), cf * CF(0, -0.13, 0), ALU, M.Metal)
	mk.cyl("Spjällhus", 0.18, 0.06, cf * CF(0, 0.12, 0) * AX_Y, ALU, M.Metal)
	mk.cyl("Lock", 0.03, 0.065, cf * CF(0, 0.22, 0) * AX_Y, part.brand == "Origo" and BLACK or brandColor(part), M.SmoothPlastic)
	mk.cyl("Choke", 0.08, 0.02, cf * CF(0.12, 0.03, 0.04), BLACK)
end
B.luftfilter = function(mk, cf, part)
	local lvl = part.stats.lvl or 0
	if lvl == 0 then
		mk.box("Filterlåda", V3(0.46, 0.34, 0.5), cf, BLACK, M.Plastic)
		mk.box("Lock", V3(0.48, 0.06, 0.52), cf * CF(0, 0.19, 0), DARK, M.Plastic)
	else
		mk.cyl("Filter", 0.32, 0.17, cf * AX_Z, brandColor(part), M.Fabric)
		mk.cyl("Topp", 0.03, 0.12, cf * CF(0, 0, 0.17) * AX_Z, lvl == 2 and CHROME or BLACK, M.Metal)
		mk.cyl("Klämma", 0.05, 0.1, cf * CF(0, 0, -0.17) * AX_Z, CHROME, M.Metal)
	end
end
B.slang = function(mk, cf, part)
	local col = part.brand == "Bruksmek" and C3(230, 200, 120) or BLACK
	local a = cf.Position
	local p = mk.tube("Slang", a, a + V3(0.06, 0.2, 0.25), 0.025, col, M.Rubber)
	if p and part.brand == "Bruksmek" then p.Transparency = 0.35 end
end
B.stator = function(mk, cf)
	mk.cyl("Stator", 0.08, 0.27, cf, COPPER, M.Metal)
	mk.cyl("Platta", 0.03, 0.29, cf * CF(-0.04, 0, 0), DARK, M.Metal)
end
B.svanghjul = function(mk, cf, part)
	local c = part.brand == "Origo" and STEEL or ALU
	mk.cyl("Svänghjul", 0.12, 0.36, cf, c, M.Metal)
	mk.ring("Fläkt", cf * CF(0.07, 0, 0), 0.36, 0.04, 8, c, M.Metal)
	mk.cyl("Mutter", 0.05, 0.06, cf * CF(0.09, 0, 0), CHROME, M.Metal)
end
B.cdi = function(mk, cf, part)
	mk.box("CDI", V3(0.24, 0.1, 0.34), cf, BLACK, M.Plastic)
	mk.box("Etikett", V3(0.18, 0.012, 0.2), cf * CF(0, 0.055, 0), part.brand == "Origo" and C3(200, 200, 200) or brandColor(part))
	mk.cyl("Kontakt", 0.06, 0.03, cf * CF(0, 0, -0.19) * AX_Z, DARK)
end
B.spole = function(mk, cf, part)
	mk.box("Spole", V3(0.16, 0.2, 0.16), cf, BLACK, M.Plastic)
	mk.cyl("Lindning", 0.12, 0.07, cf * CF(0, 0.02, 0) * AX_Y, part.brand == "Origo" and DARK or brandColor(part), M.Plastic)
end
B.tandkabel = function(mk, cf, part)
	local a = cf.Position
	-- from the coil to the spark plug, both found relative to this socket
	local coil = a + (cf:VectorToWorldSpace(V3(0.2, 0.1, 0.4)))
	local plug = a + (cf:VectorToWorldSpace(V3(-0.22, -0.04, -0.52)))
	local mid = (coil + plug) / 2 + cf:VectorToWorldSpace(V3(0.12, 0.12, 0))
	mk.path("Tändkabel", { coil, mid, plug }, 0.022, part.brand == "Origo" and BLACK or C3(200, 40, 40), M.Rubber)
	mk.cyl("Tändhatt", 0.1, 0.035, CFrame.lookAt(plug, plug + cf:VectorToWorldSpace(V3(-0.1, 0, -0.2))) * CFrame.Angles(0, math.pi / 2, 0), BLACK, M.Rubber)
end
B.variator = function(mk, cf, part)
	mk.cyl("Variator", 0.1, 0.4, cf, part.brand == "Origo" and STEEL or ALU, M.Metal)
	mk.cyl("Nav", 0.16, 0.12, cf * CF(-0.04, 0, 0), STEEL, M.Metal)
	if part.brand ~= "Origo" then mk.ring("Spår", cf * CF(-0.055, 0, 0), 0.4, 0.01, 6, brandColor(part)) end
end
B.vikter = function(mk, cf, part)
	local c = part.brand == "Origo" and BLACK or brandColor(part)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		mk.cyl("Rulle", 0.08, 0.05, cf * CF(0, math.cos(a) * 0.24, math.sin(a) * 0.24) * CFrame.Angles(a, 0, 0) * AX_Z, c, M.Plastic)
	end
end
B.flakt = function(mk, cf, part)
	mk.cyl("Fläkt", 0.03, 0.4, cf, part.brand == "Origo" and DARK or brandColor(part), M.Plastic)
	mk.ring("Skovel", cf * CF(-0.03, 0, 0), 0.4, 0.05, 10, DARK, M.Plastic)
end
B.remskiva = function(mk, cf)
	mk.cyl("Remskiva", 0.1, 0.32, cf, STEEL, M.Metal)
	mk.cyl("Fjäder", 0.14, 0.12, cf * CF(0.05, 0, 0), C3(200, 170, 40), M.Metal)
end
B.koppling = function(mk, cf, part)
	mk.cyl("Koppling", 0.05, 0.28, cf, STEEL, M.Metal)
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2
		mk.box("Belägg", V3(0.06, 0.08, 0.26), cf * CFrame.Angles(a, 0, 0) * CF(0, 0.22, 0), part.brand == "Origo" and C3(110, 90, 70) or brandColor(part), M.Fabric)
	end
end
B.rem = function(mk, cf, part)
	local c = part.brand == "Origo" and RUBBER or C3(40, 40, 30)
	mk.box("Rem", V3(0.09, 0.05, 1.72), cf * CF(0, 0.3, 0), c, M.Rubber)
	mk.box("Rem", V3(0.09, 0.05, 1.72), cf * CF(0, -0.27, 0), c, M.Rubber)
end
B.klocka = function(mk, cf, part)
	mk.cyl("Klocka", 0.12, 0.35, cf, part.brand == "Origo" and STEEL or ALU, M.Metal)
	mk.cyl("Nav", 0.06, 0.1, cf * CF(-0.08, 0, 0), STEEL, M.Metal)
	if part.brand ~= "Origo" then mk.ring("Hål", cf * CF(-0.061, 0, 0), 0.35, 0.01, 8, C3(40, 40, 40)) end
end

---------------------------------------------------------------- chassis builders
-- ctx: { cf = moped root CFrame (ground, between axles), def = model def }
local C = {}
local function mp(ctx, x, y, z) return ctx.cf * V3(x, y, z) end
local function frontAxle(ctx) return V3(0, ctx.def.r, -ctx.def.wb / 2) end
local function rearAxle(ctx) return V3(0, ctx.def.r, ctx.def.wb / 2) end
function Models.engineCF(ctx)
	local ra = rearAxle(ctx)
	return ctx.cf * CF(ra.X, ra.Y + 0.22, ra.Z - EngineDef.REAR_AXLE_Z)
end
local function headTop(ctx)
	local h = ctx.def.head
	return V3(h[1], h[2], h[3])
end

C.ram = function(mk, ctx)
	local d = ctx.def
	local col = C3(26, 26, 28)
	local h = headTop(ctx)
	local rake = rad(d.rake)
	local up = V3(0, math.cos(rake), math.sin(rake))
	mk.tube("Styrhuvud", ctx.cf * (h - up * 0.4), ctx.cf * (h + up * 0.35), 0.12, col, M.Metal)
	local floorY = d.floorY - 0.2
	local pts = {
		h - up * 0.3, V3(0, floorY + 0.15, -1.35), V3(0, floorY, -1.0), V3(0, floorY, 0.15), V3(0, d.seat[2] - 0.45, 1.25), V3(0, d.seat[2] - 0.35, d.tailZ - 0.2),
	}
	for _, x in ipairs({ -0.28, 0.28 }) do
		local w = {}
		for i, p in ipairs(pts) do w[i] = ctx.cf * (i == 1 and p or (p + V3(x, 0, 0))) end
		mk.path("Ram", w, 0.07, col, M.Metal)
	end
	for _, z in ipairs({ -1.0, 0.15, 1.25 }) do
		local y = z > 1 and d.seat[2] - 0.45 or floorY
		mk.tube("Tvärbalk", mp(ctx, -0.28, y, z), mp(ctx, 0.28, y, z), 0.05, col, M.Metal)
	end
	-- engine hanger and stand
	mk.tube("Motorfäste", mp(ctx, 0, floorY, 0.15), Models.engineCF(ctx) * V3(0, 0.3, -0.2), 0.06, col, M.Metal)
	mk.box("Fäste", V3(0.7, 0.06, 0.3), ctx.cf * CF(0, d.seat[2] - 0.42, d.tailZ - 0.3), col, M.Metal)
	-- side stand
	mk.tube("Stöd", mp(ctx, -0.3, 0.9, 0.3), mp(ctx, -0.55, 0.05, 0.5), 0.04, col, M.Metal)
end
C.gaffel = function(mk, ctx, part)
	local d = ctx.def
	local h, fa = headTop(ctx), frontAxle(ctx)
	local usd = part.brand ~= "Origo"
	for _, x in ipairs({ -0.27, 0.27 }) do
		local top, bot = V3(x, h.Y - 0.25, h.Z + 0.05), V3(x, fa.Y, fa.Z)
		local mid = top:Lerp(bot, 0.55)
		mk.tube("Gaffelben", ctx.cf * top, ctx.cf * mid, usd and 0.085 or 0.06, usd and C3(200, 160, 40) or CHROME, M.Metal)
		mk.tube("Gaffelben", ctx.cf * mid, ctx.cf * bot, usd and 0.06 or 0.085, usd and CHROME or DARK, M.Metal)
	end
	mk.box("Krona", V3(0.7, 0.1, 0.22), ctx.cf * CF(0, h.Y - 0.2, h.Z + 0.03), DARK, M.Metal)
	mk.tube("Axel", mp(ctx, -0.32, fa.Y, fa.Z), mp(ctx, 0.32, fa.Y, fa.Z), 0.035, STEEL, M.Metal)
end
local function wheel(mk, ctx, part, axle, name)
	local d = ctx.def
	local cf = ctx.cf * CF(axle)
	mk.cyl(name, 0.4, d.r, cf, RUBBER, M.Rubber)
	mk.cyl(name, 0.34, d.r - 0.05, cf, C3(34, 34, 36), M.Rubber)
	local rimC = part.brand == "Origo" and C3(40, 40, 44) or brandColor(part)
	mk.cyl(name .. "Fälg", 0.42, d.r * 0.66, cf, rimC, M.Metal)
	mk.cyl(name .. "Nav", 0.46, 0.14, cf, ALU, M.Metal)
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		mk.box(name .. "Eker", V3(0.12, d.r * 0.5, 0.07), cf * CFrame.Angles(a, 0, 0) * CF(0, d.r * 0.38, 0), rimC, M.Metal)
	end
	-- tread blocks so the rotation can be seen
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		mk.box(name .. "Mönster", V3(0.36, 0.03, 0.12), cf * CFrame.Angles(a, 0, 0) * CF(0, d.r + 0.005, 0), RUBBER, M.Rubber)
	end
end
C.framhjul = function(mk, ctx, part) wheel(mk, ctx, part, frontAxle(ctx), "Framhjul") end
C.bakhjul = function(mk, ctx, part) wheel(mk, ctx, part, rearAxle(ctx), "Bakhjul") end
C.frambroms = function(mk, ctx, part)
	local fa = frontAxle(ctx)
	local cf = ctx.cf * CF(fa)
	mk.cyl("Bromsskiva", 0.03, ctx.def.r * 0.55, cf * CF(-0.24, 0, 0), CHROME, M.Metal)
	mk.box("Bromsok", V3(0.12, 0.22, 0.3), cf * CF(-0.27, 0.12, 0.3) * CFrame.Angles(0.5, 0, 0), part.brand == "Origo" and DARK or brandColor(part), M.Metal)
	mk.tube("Bromsslang", ctx.cf * (fa + V3(-0.3, 0.3, 0.3)), ctx.cf * (headTop(ctx) + V3(-0.4, 0.6, 0.15)), 0.025, BLACK, M.Rubber)
end
C.bakbroms = function(mk, ctx, part)
	local ra = rearAxle(ctx)
	local cf = ctx.cf * CF(ra)
	if part.brand == "Origo" then
		mk.cyl("Trumma", 0.12, ctx.def.r * 0.45, cf * CF(0.26, 0, 0), ALU, M.Metal)
		mk.box("Bromsarm", V3(0.05, 0.08, 0.3), cf * CF(0.33, 0.15, -0.1), STEEL, M.Metal)
	else
		mk.cyl("Bromsskiva", 0.03, ctx.def.r * 0.5, cf * CF(0.24, 0, 0), CHROME, M.Metal)
		mk.box("Bromsok", V3(0.12, 0.2, 0.28), cf * CF(0.27, 0.12, -0.28), brandColor(part), M.Metal)
	end
end
C.dampare = function(mk, ctx, part)
	local ra = rearAxle(ctx)
	local d = ctx.def
	local a = ctx.cf * V3(-0.5, ra.Y + 0.15, ra.Z - 0.1)
	local b = ctx.cf * V3(-0.42, d.seat[2] - 0.5, ra.Z - 0.55)
	mk.tube("Dämpare", a, b, 0.06, DARK, M.Metal)
	mk.tube("Fjäder", a:Lerp(b, 0.15), a:Lerp(b, 0.85), 0.1, part.brand == "Origo" and C3(40, 40, 44) or brandColor(part), M.Metal)
	for i = 1, 6 do mk.cyl("Varv", 0.03, 0.105, CFrame.lookAt(a:Lerp(b, 0.15 + i * 0.1), b) * CFrame.Angles(0, math.pi / 2, 0), part.brand == "Origo" and DARK or brandColor(part), M.Metal) end
end
C.styre = function(mk, ctx, part)
	local d = ctx.def
	local h = headTop(ctx)
	local y, z = d.barY, h.Z + 0.22
	mk.tube("Styrstam", ctx.cf * (h + V3(0, 0.2, 0.08)), mp(ctx, 0, y, z), 0.07, DARK, M.Metal)
	local w = part.brand == "Origo" and 0.78 or 0.88
	mk.tube("Styre", mp(ctx, -w, y + 0.05, z + 0.1), mp(ctx, w, y + 0.05, z + 0.1), 0.05, part.brand == "Origo" and DARK or CHROME, M.Metal)
	for _, s in ipairs({ -1, 1 }) do
		mk.cyl("Handtag", 0.36, 0.075, ctx.cf * CF(s * (w - 0.12), y + 0.05, z + 0.1), RUBBER, M.Rubber)
		mk.tube("Handtag", mp(ctx, s * (w - 0.35), y + 0.1, z), mp(ctx, s * (w - 0.05), y + 0.08, z - 0.25), 0.025, ALU, M.Metal)
		mk.tube("Spegelarm", mp(ctx, s * (w - 0.4), y + 0.1, z + 0.05), mp(ctx, s * (w - 0.25), y + 0.48, z - 0.02), 0.02, DARK, M.Metal)
		mk.cyl("Spegel", 0.04, 0.11, ctx.cf * CF(s * (w - 0.24), y + 0.54, z - 0.02) * AX_Z, BLACK)
	end
	mk.box("Mätare", V3(0.42, 0.2, 0.08), ctx.cf * CF(0, y + 0.2, z - 0.05) * CFrame.Angles(rad(30), 0, 0), BLACK)
end
C.tank = function(mk, ctx)
	local t = ctx.def.tank
	mk.box("Tank", V3(0.66, 0.42, 1.15), ctx.cf * CF(t[1], t[2], t[3]), C3(36, 36, 38), M.Plastic)
	mk.cyl("Tanklock", 0.06, 0.12, ctx.cf * CF(t[1], t[2] + 0.23, t[3] - 0.4) * AX_Y, CHROME, M.Metal)
end
C.sadel = function(mk, ctx, part)
	local s, len = ctx.def.seat, ctx.def.seatLen
	local c = C3(24, 24, 26)
	mk.box("Sadel", V3(0.74, 0.22, len - 0.4), ctx.cf * CF(s[1], s[2], s[3] + 0.15), c, M.Leather)
	mk.wedge("Sadel", V3(0.74, 0.22, 0.4), ctx.cf * CF(s[1], s[2], s[3] - len / 2 + 0.15) * CFrame.Angles(0, math.pi, 0), c, M.Leather)
	mk.box("Sadelbotten", V3(0.7, 0.08, len - 0.1), ctx.cf * CF(s[1], s[2] - 0.14, s[3]), DARK, M.Plastic)
	if part.brand ~= "Origo" then
		mk.box("Söm", V3(0.02, 0.23, len - 0.45), ctx.cf * CF(-0.2, s[2] + 0.005, s[3] + 0.15), brandColor(part), M.Fabric)
		mk.box("Söm", V3(0.02, 0.23, len - 0.45), ctx.cf * CF(0.2, s[2] + 0.005, s[3] + 0.15), brandColor(part), M.Fabric)
	end
	mk.box("Handtag", V3(0.6, 0.06, 0.12), ctx.cf * CF(0, s[2] - 0.05, s[3] + len / 2 + 0.05), DARK, M.Metal)
end
C.avgas = function(mk, ctx, part)
	local e = Models.engineCF(ctx)
	local lvl = part.stats.lvl or 0
	local col = part.brand == "Origo" and C3(50, 50, 52) or (lvl >= 2 and CHROME or C3(70, 70, 74))
	local r = 0.1 + 0.05 * lvl
	local port = e * V3(0, -0.4, -0.85)
	local p1 = e * V3(0.1, -0.62, -0.75)
	local belly0 = e * V3(0.38, -0.62, -0.35)
	local belly1 = e * V3(0.5, -0.5, 0.75)
	local cone = e * V3(0.55, -0.25, 1.15)
	local sil0 = e * V3(0.58, -0.1, 1.25)
	local sil1 = e * V3(0.6, 0.2, 2.2)
	mk.path("Krök", { port, p1, belly0 }, 0.07, col, M.Metal)
	mk.tube("Kammare", belly0, belly1, r + 0.04, col, M.Metal)
	mk.tube("Kon", belly1, cone, r, col, M.Metal)
	mk.tube("Ljuddämpare", sil0, sil1, part.brand == "Origo" and 0.15 or 0.13, part.brand == "Origo" and C3(40, 40, 42) or (lvl >= 2 and C3(30, 30, 32) or ALU), lvl >= 2 and M.Fabric or M.Metal)
	mk.cyl("Ändrör", 0.15, 0.05, CFrame.lookAt(sil1, sil1 + (sil1 - sil0)) * CFrame.Angles(0, math.pi / 2, 0) * CF(0.05, 0, 0), CHROME, M.Metal)
	if part.brand ~= "Origo" then
		mk.box("Dekal", V3(0.02, 0.1, 0.4), CFrame.lookAt(sil0:Lerp(sil1, 0.5), sil1) * CF(0.14, 0, 0), brandColor(part))
	end
end
-- panel from MopedDef prims, painted
function Models.paintPart(p, paint)
	if not paint then
		p.Color = C3(232, 232, 228)
		p.Material = M.SmoothPlastic
		p.Reflectance = 0.02
		return
	end
	local fin = Paint.FIN[paint.f] or Paint.FIN.blank
	p.Color = C3(paint.c[1], paint.c[2], paint.c[3])
	p.Material = M[fin.mat]
	local g = paint.g or 0.6
	p.Reflectance = fin.refl[1] + (fin.refl[2] - fin.refl[1]) * g
	-- poor paint looks blotchy: slightly darker and rougher
	if (paint.q or 1) < 0.5 then p.Material = M.Plastic; p.Color = p.Color:Lerp(C3(90, 90, 90), 0.15) end
end
C.kapa = function(mk, ctx, part, item)
	local def = MopedDef.MODELS[part.stats.fits]
	local pdef = def and def.panelById[part.stats.panel]
	if not pdef then return end
	for _, pr in ipairs(pdef.prims) do
		local shape, size, pos, rot = pr[1], pr[2], pr[3], pr[4] or { 0, 0, 0 }
		local cf = ctx.cf * CF(pos[1], pos[2], pos[3]) * CFrame.fromOrientation(rad(rot[1]), rad(rot[2]), rad(rot[3]))
		local p
		if shape == "wedge" then p = mk.wedge(pdef.n, V3(size[1], size[2], size[3]), cf)
		elseif shape == "ball" then p = mk.ball(pdef.n, size[1], cf)
		elseif shape == "cyl" then p = mk.cyl(pdef.n, size[1], size[2] / 2, cf)
		elseif shape == "ell" then
			p = mk.box(pdef.n, V3(size[1], size[2], size[3]), cf)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		else p = mk.box(pdef.n, V3(size[1], size[2], size[3]), cf) end
		Models.paintPart(p, item and item.paint)
		p:SetAttribute("Panel", pdef.id)
	end
end

---------------------------------------------------------------- tools
function Models.tool(parent, kind, cf, pro)
	local mk = Models.maker(parent)
	if kind == "slip" then
		local body = pro and C3(200, 40, 40) or C3(60, 110, 200)
		mk.cyl("Kropp", 0.9, 0.11, cf, body, M.SmoothPlastic)
		mk.cyl("Grepp", 0.35, 0.115, cf * CF(0.15, 0, 0), RUBBER, M.Rubber)
		mk.cyl("Hals", 0.18, 0.06, cf * CF(-0.52, 0, 0), ALU, M.Metal)
		mk.cyl("Spindel", 0.16, 0.012, cf * CF(-0.69, 0, 0), CHROME, M.Metal)
		mk.ball("Fräs", 0.06, cf * CF(-0.78, 0, 0), C3(160, 160, 160), M.Metal)
		mk.cyl("Sladd", 0.4, 0.025, cf * CF(0.65, 0, 0), BLACK)
	elseif kind == "spruta" then
		local body = pro and C3(230, 230, 230) or C3(90, 90, 96)
		mk.box("Kropp", V3(0.14, 0.2, 0.36), cf, body, M.Metal)
		mk.cyl("Munstycke", 0.12, 0.04, cf * CF(0, 0.03, -0.24) * AX_Z, CHROME, M.Metal)
		mk.box("Handtag", V3(0.1, 0.42, 0.12), cf * CF(0, -0.26, 0.08) * CFrame.Angles(rad(-15), 0, 0), RUBBER, M.Rubber)
		mk.cyl("Kopp", 0.3, 0.12, cf * CF(0, 0.26, 0) * AX_Y, C3(220, 220, 220), M.SmoothPlastic).Transparency = 0.3
		mk.box("Avtryckare", V3(0.04, 0.14, 0.04), cf * CF(0, -0.1, -0.08), STEEL, M.Metal)
	else -- skiftnyckel / skruvdragare
		mk.box("Skaft", V3(0.08, 0.04, 0.7), cf, CHROME, M.Metal)
		mk.box("Huvud", V3(0.16, 0.05, 0.14), cf * CF(0, 0, -0.38), CHROME, M.Metal)
	end
	return mk
end
-- first-person hand holding something (built around cf = palm); returns the model
function Models.hand(parent, cf, glove)
	local model = Instance.new("Model")
	model.Name = "Hand"
	local mk = Models.maker(model)
	local skin = glove and C3(30, 30, 34) or C3(234, 190, 155)
	local sleeve = C3(28, 30, 36)
	local palm = mk.box("Handflata", V3(0.32, 0.12, 0.36), cf, skin, glove and M.Fabric or M.SmoothPlastic)
	mk.cyl("Handled", 0.3, 0.13, cf * CF(0, -0.02, 0.32) * AX_Z, skin, M.SmoothPlastic)
	mk.cyl("Ärm", 1.4, 0.19, cf * CF(0, -0.05, 1.12) * AX_Z, sleeve, M.Fabric)
	mk.cyl("Mudd", 0.12, 0.2, cf * CF(0, -0.05, 0.44) * AX_Z, C3(20, 20, 22), M.Fabric)
	for i = 0, 3 do
		local x = -0.12 + i * 0.08
		mk.box("Finger", V3(0.065, 0.075, 0.18), cf * CF(x, 0.02, -0.25) * CFrame.Angles(rad(-35), 0, 0), skin, M.SmoothPlastic)
		mk.box("Finger", V3(0.06, 0.07, 0.14), cf * CF(x, -0.06, -0.36) * CFrame.Angles(rad(-75), 0, 0), skin, M.SmoothPlastic)
	end
	mk.box("Tumme", V3(0.07, 0.08, 0.2), cf * CF(0.19, -0.03, -0.08) * CFrame.Angles(rad(-20), rad(35), 0), skin, M.SmoothPlastic)
	model.PrimaryPart = palm
	model.Parent = parent
	return model
end
function Models.box(parent, cf, size, open)
	local model = Instance.new("Model")
	model.Name = "Paket"
	local mk = Models.maker(model)
	local cardboard = C3(176, 138, 92)
	size = size or V3(2.2, 1.4, 1.6)
	local base = mk.box("Låda", V3(size.X, 0.08, size.Z), cf * CF(0, -size.Y / 2 + 0.04, 0), cardboard, M.Cardboard)
	for _, s in ipairs({ -1, 1 }) do
		mk.box("Låda", V3(0.06, size.Y, size.Z), cf * CF(s * (size.X / 2 - 0.03), 0, 0), cardboard, M.Cardboard)
		mk.box("Låda", V3(size.X, size.Y, 0.06), cf * CF(0, 0, s * (size.Z / 2 - 0.03)), cardboard, M.Cardboard)
	end
	if open then
		mk.box("Flik", V3(size.X / 2, 0.04, size.Z), cf * CF(-size.X * 0.75, size.Y / 2 - 0.1, 0) * CFrame.Angles(0, 0, rad(-25)), cardboard, M.Cardboard)
		mk.box("Flik", V3(size.X / 2, 0.04, size.Z), cf * CF(size.X * 0.75, size.Y / 2 - 0.1, 0) * CFrame.Angles(0, 0, rad(25)), cardboard, M.Cardboard)
	else
		mk.box("Lock", V3(size.X, 0.05, size.Z), cf * CF(0, size.Y / 2, 0), cardboard, M.Cardboard)
		mk.box("Tejp", V3(0.3, 0.06, size.Z + 0.02), cf * CF(0, size.Y / 2 + 0.005, 0), C3(200, 180, 120), M.SmoothPlastic)
		mk.box("Etikett", V3(0.7, 0.02, 0.5), cf * CF(size.X * 0.2, size.Y / 2 + 0.03, size.Z * 0.15), C3(245, 245, 245), M.SmoothPlastic)
	end
	model.PrimaryPart = base
	model.Parent = parent
	return model
end

---------------------------------------------------------------- assembling
-- build one part (by sku) into model parent at the place it has on an engine (engineCF) or a moped (ctx)
local DEFAULT_CTX
local function defaultCtx(fits)
	local def = MopedDef.MODELS[fits or "citi"]
	return { cf = CFrame.new(), def = def }
end
function Models.buildInto(parent, sku, item, engineCF, ctx)
	local part = Parts.get(sku)
	if not part then return nil end
	local mk = Models.maker(parent)
	if B[part.kind] then
		local sock = EngineDef.BY_ID[EngineDef.socketForKind(part.kind)]
		local pos = sock.pos
		B[part.kind](mk, (engineCF or CFrame.new()) * CF(pos[1], pos[2], pos[3]), part, item)
	elseif C[part.kind] then
		C[part.kind](mk, ctx or defaultCtx(part.stats.fits), part, item)
	elseif part.kind == "verktyg" then
		Models.tool(parent, part.stats.tool, CFrame.new(), part.price > 1000)
	end
	return mk
end
-- a loose part as its own Model, pivot at the centre of its bounding box, PrimaryPart "Main" (invisible handle)
function Models.item(sku, item)
	local model = Instance.new("Model")
	model.Name = sku
	Models.buildInto(model, sku, item)
	local cf, size = model:GetBoundingBox()
	local main = Instance.new("Part")
	main.Name = "Main"
	main.Anchored = true
	main.CanCollide = false
	main.CanTouch = false
	main.Transparency = 1
	main.Size = Vector3.new(math.max(size.X, 0.2), math.max(size.Y, 0.2), math.max(size.Z, 0.2))
	main.CFrame = CFrame.new(cf.Position)
	main.Parent = model
	model.PrimaryPart = main
	model:SetAttribute("Sku", sku)
	return model, main.Size
end
-- the engine: one sub-model per socket (Name = socket id, attribute Sock)
function Models.engine(parent, engineCF, map, items)
	local model = Instance.new("Model")
	model.Name = "Motor"
	for _, s in ipairs(EngineDef.SOCKETS) do
		local id = map[s.id]
		local it = id and items[id]
		if it then
			local sub = Instance.new("Model")
			sub.Name = s.id
			sub:SetAttribute("Sock", s.id)
			sub:SetAttribute("Item", id)
			Models.buildInto(sub, it.sku, it, engineCF)
			sub.Parent = model
		end
	end
	model.Parent = parent
	return model
end
-- the whole moped: Root (invisible, PrimaryPart), Seat, chassis slots, panels, engine
function Models.moped(parent, m, items, rootCF)
	local def = MopedDef.MODELS[m.model]
	local model = Instance.new("Model")
	model.Name = "Moped"
	model:SetAttribute("Model", m.model)
	local ctx = { cf = rootCF, def = def }
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1.1, 0.5, def.wb + 1.2)
	root.CFrame = rootCF * CF(0, def.r, 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.Parent = model
	model.PrimaryPart = root
	for slot, id in pairs(m.slots) do
		local it = items[id]
		if it then
			local sub = Instance.new("Model")
			sub.Name = slot
			sub:SetAttribute("Slot", slot)
			sub:SetAttribute("Item", id)
			Models.buildInto(sub, it.sku, it, nil, ctx)
			sub.Parent = model
		end
	end
	if m.engine then
		local eng = Models.engine(model, Models.engineCF(ctx), m.engine, items)
		eng.Name = "motor"
		eng:SetAttribute("Slot", "motor")
	end
	-- bolts and brackets where a panel is missing, so it is clear something is off
	for _, p in ipairs(def.panels) do
		if not m.slots["pan:" .. p.id] then
			local pr = p.prims[1]
			local mk = Models.maker(model)
			local pos = ctx.cf * V3(pr[3][1], pr[3][2], pr[3][3])
			for i = -1, 1, 2 do mk.cyl("Skruv", 0.08, 0.04, CFrame.new(pos + ctx.cf:VectorToWorldSpace(V3(0, 0.15 * i, 0))) * ctx.cf.Rotation, CHROME, M.Metal) end
		end
	end
	-- lights (only if the front panel / tail are on)
	local mk = Models.maker(model)
	for _, l in ipairs(def.lights) do
		local lamp = mk.box("Strålkastare", V3(0.32, 0.18, 0.06), ctx.cf * CF(l[1], l[2], l[3] - 0.05), C3(255, 250, 230), M.Neon)
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Range = 40
		spot.Angle = 50
		spot.Brightness = 3
		spot.Enabled = false
		spot.Parent = lamp
	end
	mk.box("Baklykta", V3(0.4, 0.12, 0.05), ctx.cf * CF(0, def.seat[2] - 0.25, def.tailZ + 0.12), C3(200, 20, 20), M.Neon)
	-- seat used for riding (invisible, on top of the saddle)
	local seat = Instance.new("Seat")
	seat.Name = "Seat"
	seat.Size = Vector3.new(0.9, 0.2, 1.2)
	seat.CFrame = rootCF * CF(0, def.seat[2] + 0.12, def.seat[3] - 0.1)
	seat.Transparency = 1
	seat.Anchored = true
	seat.CanCollide = false
	seat.CanTouch = false
	seat.Disabled = true
	seat.Parent = model
	-- exhaust smoke
	local att = Instance.new("Attachment")
	att.Name = "Avgasrök"
	att.Position = root.CFrame:PointToObjectSpace(Models.engineCF(ctx) * V3(0.6, 0.2, 2.25))
	att.Parent = root
	local smoke = Instance.new("ParticleEmitter")
	smoke.Name = "Rök"
	smoke.Rate = 0
	smoke.Lifetime = NumberRange.new(0.6, 1.2)
	smoke.Speed = NumberRange.new(1, 2)
	smoke.Size = NumberSequence.new(0.2, 1.1)
	smoke.Transparency = NumberSequence.new(0.6, 1)
	smoke.Color = ColorSequence.new(C3(220, 220, 225))
	smoke.Parent = att
	model.Parent = parent
	return model
end

return Models
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">MopedDef</string><ProtectedString name="Source"><![CDATA[-- Moped models, their chassis slots and their panels (kåpor).
-- Moped space (studs): origin on the ground midway between the axles, -Z = forward, +X = right.
local Parts = require(script.Parent.Parts)
local EngineDef = require(script.Parent.EngineDef)
local MopedDef = {}

-- chassis slots: id, kind, req (slots that must be mounted first). "motor" holds the engine assembly.
MopedDef.SLOTS = {
	{ id = "ram", kind = "ram", n = "Ram", req = {} },
	{ id = "gaffel", kind = "gaffel", n = "Framgaffel", req = { "ram" } },
	{ id = "framhjul", kind = "framhjul", n = "Framhjul", req = { "gaffel" } },
	{ id = "frambroms", kind = "frambroms", n = "Frambroms", req = { "framhjul" } },
	{ id = "styre", kind = "styre", n = "Styre", req = { "gaffel" } },
	{ id = "dampare", kind = "dampare", n = "Bakdämpare", req = { "ram" } },
	{ id = "motor", kind = "motor", n = "Motor", req = { "ram", "dampare" } },
	{ id = "bakhjul", kind = "bakhjul", n = "Bakhjul", req = { "motor" } },
	{ id = "bakbroms", kind = "bakbroms", n = "Bakbroms", req = { "bakhjul" } },
	{ id = "avgas", kind = "avgas", n = "Avgassystem", req = { "motor" } },
	{ id = "tank", kind = "tank", n = "Tank", req = { "ram" } },
	{ id = "sadel", kind = "sadel", n = "Sadel", req = { "tank" } },
}
MopedDef.SLOT = {}
for _, s in ipairs(MopedDef.SLOTS) do MopedDef.SLOT[s.id] = s end

-- shapes: { shape, size {x,y,z}, pos {x,y,z}, rot {x,y,z} degrees }
local function P(id, n, price, req, prims) return { id = id, n = n, price = price, req = req, prims = prims } end
local function mirror(prims)
	local r = {}
	for i, p in ipairs(prims) do
		r[i] = { p[1], p[2], { -p[3][1], p[3][2], p[3][3] }, p[4] and { p[4][1], -p[4][2], -p[4][3] } or nil }
	end
	return r
end

MopedDef.MODELS = {}
MopedDef.ORDER = { "citi", "sprint", "klassik" }

-- Vippa Citi 50: small city scooter, the starter moped
local citiSideL = {
	{ "box", { 0.42, 0.85, 2.3 }, { -0.3, 2.2, 1.25 } },
	{ "wedge", { 0.42, 0.5, 0.7 }, { -0.3, 1.53, 0.25 } },
}
MopedDef.MODELS.citi = {
	id = "citi", n = "Vippa Citi 50", price = 8000, color = { 200, 30, 40 },
	wb = 4.2, r = 0.8, head = { 0, 2.6, -1.7 }, rake = 24, barY = 3.45, seat = { 0, 2.74, 1.0 }, seatLen = 1.9, tank = { 0, 2.15, 1.0 },
	floorY = 1.35, tailZ = 2.6, lights = { { 0, 2.62, -2.2 } },
	panels = {
		P("front", "Frontkåpa", 790, { "gaffel" }, {
			{ "box", { 1.05, 1.75, 0.42 }, { 0, 2.12, -1.98 }, { 14, 0, 0 } },
			{ "box", { 0.95, 0.45, 0.4 }, { 0, 1.3, -1.86 } },
		}),
		P("ben", "Benskydd", 590, { "ram" }, { { "box", { 0.95, 1.45, 0.08 }, { 0, 2.05, -1.72 }, { 14, 0, 0 } } }),
		P("fot", "Fotplatta", 490, { "ram" }, { { "box", { 0.95, 0.18, 1.62 }, { 0, 1.26, -0.86 } } }),
		P("sidaV", "Sidokåpa vänster", 690, { "tank" }, citiSideL),
		P("sidaH", "Sidokåpa höger", 690, { "tank" }, mirror(citiSideL)),
		P("bak", "Bakkåpa", 590, { "tank" }, { { "wedge", { 0.84, 0.42, 0.6 }, { 0, 2.42, 2.66 }, { 0, 180, 0 } } }),
		P("skarm", "Framskärm", 390, { "gaffel" }, {
			{ "box", { 0.42, 0.1, 0.8 }, { 0, 1.7, -2.1 } },
			{ "box", { 0.42, 0.1, 0.45 }, { 0, 1.55, -2.62 }, { -35, 0, 0 } },
		}),
		P("styrkapa", "Styrkåpa", 490, { "styre" }, { { "box", { 1.0, 0.32, 0.55 }, { 0, 3.42, -1.62 }, { 10, 0, 0 } } }),
	},
}

-- Vippa Sprint 50: sporty scooter with a big pointed front and a high tail
local sprintSideL = {
	{ "box", { 0.45, 0.9, 2.45 }, { -0.32, 2.3, 1.35 } },
	{ "wedge", { 0.45, 0.55, 0.8 }, { -0.32, 1.58, 0.25 } },
	{ "wedge", { 0.45, 0.4, 0.95 }, { -0.32, 2.95, 2.4 } },
}
local sprintFlankL = { { "box", { 0.12, 1.25, 0.85 }, { -0.6, 2.25, -1.98 }, { 16, -12, 0 } } }
MopedDef.MODELS.sprint = {
	id = "sprint", n = "Vippa Sprint 50", price = 12500, color = { 25, 70, 200 },
	wb = 4.5, r = 0.85, head = { 0, 2.75, -1.85 }, rake = 25, barY = 3.6, seat = { 0, 2.88, 1.05 }, seatLen = 2.1, tank = { 0, 2.25, 1.05 },
	floorY = 1.4, tailZ = 2.9, lights = { { -0.28, 2.42, -2.46 }, { 0.28, 2.42, -2.46 } },
	panels = {
		P("front", "Frontkåpa", 990, { "gaffel" }, {
			{ "box", { 1.15, 1.55, 0.5 }, { 0, 2.35, -2.15 }, { 18, 0, 0 } },
			{ "wedge", { 0.95, 0.42, 0.65 }, { 0, 1.72, -2.5 }, { 0, 180, 0 } },
			{ "box", { 1.1, 0.12, 0.62 }, { 0, 3.12, -2.0 }, { 28, 0, 0 } },
		}),
		P("flankV", "Frontflank vänster", 590, { "gaffel" }, sprintFlankL),
		P("flankH", "Frontflank höger", 590, { "gaffel" }, mirror(sprintFlankL)),
		P("ben", "Benskydd", 690, { "ram" }, { { "box", { 1.05, 1.4, 0.08 }, { 0, 2.15, -1.84 }, { 16, 0, 0 } } }),
		P("fot", "Fotplatta", 490, { "ram" }, { { "box", { 0.95, 0.18, 1.6 }, { 0, 1.31, -0.92 } } }),
		P("tunnel", "Tunnelkåpa", 490, { "ram" }, { { "box", { 0.45, 0.3, 1.4 }, { 0, 1.5, -0.92 } } }),
		P("sidaV", "Sidokåpa vänster", 790, { "tank" }, sprintSideL),
		P("sidaH", "Sidokåpa höger", 790, { "tank" }, mirror(sprintSideL)),
		P("bak", "Bakkåpa", 690, { "tank" }, { { "box", { 0.82, 0.35, 0.3 }, { 0, 2.78, 2.98 } } }),
		P("skarm", "Framskärm", 390, { "gaffel" }, {
			{ "box", { 0.42, 0.1, 0.9 }, { 0, 1.8, -2.3 } },
			{ "box", { 0.42, 0.1, 0.45 }, { 0, 1.66, -2.86 }, { -30, 0, 0 } },
		}),
		P("styrkapa", "Styrkåpa", 590, { "styre" }, { { "wedge", { 1.0, 0.35, 0.6 }, { 0, 3.55, -1.75 }, { 0, 180, 0 } } }),
		P("under", "Underkåpa", 390, { "ram" }, { { "box", { 0.8, 0.12, 1.3 }, { 0, 1.1, -0.92 } } }),
		P("spoiler", "Bakspoiler", 490, { "tank" }, { { "box", { 0.72, 0.08, 0.45 }, { 0, 3.22, 2.92 }, { -12, 0, 0 } } }),
	},
}

-- Vippa Klassik 50: round retro scooter
local klassikSideL = { { "ell", { 0.72, 1.05, 2.0 }, { -0.3, 2.08, 1.45 } } }
MopedDef.MODELS.klassik = {
	id = "klassik", n = "Vippa Klassik 50", price = 10500, color = { 120, 200, 190 },
	wb = 4.3, r = 0.8, head = { 0, 2.7, -1.8 }, rake = 22, barY = 3.5, seat = { 0, 2.78, 1.1 }, seatLen = 1.8, tank = { 0, 2.2, 1.1 },
	floorY = 1.35, tailZ = 2.55, lights = { { 0, 3.6, -1.98 } },
	panels = {
		P("front", "Frontsköld", 890, { "gaffel" }, {
			{ "box", { 1.2, 1.85, 0.14 }, { 0, 2.15, -1.95 }, { 12, 0, 0 } },
			{ "ell", { 0.42, 0.62, 0.3 }, { 0, 2.55, -2.12 } },
		}),
		P("fot", "Fotplatta", 490, { "ram" }, { { "box", { 1.0, 0.15, 1.6 }, { 0, 1.28, -0.9 } } }),
		P("sidaV", "Sidokåpa vänster", 790, { "tank" }, klassikSideL),
		P("sidaH", "Sidokåpa höger", 790, { "tank" }, mirror(klassikSideL)),
		P("bak", "Bakkåpa", 590, { "tank" }, { { "ell", { 0.75, 0.55, 0.9 }, { 0, 2.45, 2.3 } } }),
		P("skarm", "Framskärm", 490, { "gaffel" }, { { "ell", { 0.55, 0.55, 1.15 }, { 0, 1.62, -2.12 } } }),
		P("styrkapa", "Styrkåpa", 590, { "styre" }, {
			{ "box", { 0.95, 0.3, 0.5 }, { 0, 3.42, -1.68 }, { 8, 0, 0 } },
			{ "ell", { 0.42, 0.42, 0.3 }, { 0, 3.6, -1.86 } },
		}),
	},
}

-- register frames and panels as parts in the catalog
for _, id in ipairs(MopedDef.ORDER) do
	local m = MopedDef.MODELS[id]
	m.panelById = {}
	for _, p in ipairs(m.panels) do
		m.panelById[p.id] = p
		Parts.add("kapa", id .. "_" .. p.id, "Vippa", p.n .. " " .. m.n:gsub("^Vippa ", ""):gsub(" 50$", ""), p.price, 4, { fits = id, panel = p.id }, "Originalkåpa i plast, olackerad.")
	end
end

-- all slot ids for a model: chassis slots + "pan:<id>"
function MopedDef.slotIds(model)
	local r = {}
	for _, s in ipairs(MopedDef.SLOTS) do r[#r + 1] = s.id end
	for _, p in ipairs(MopedDef.MODELS[model].panels) do r[#r + 1] = "pan:" .. p.id end
	return r
end
function MopedDef.slotInfo(model, slot)
	if slot:sub(1, 4) == "pan:" then
		local p = MopedDef.MODELS[model].panelById[slot:sub(5)]
		if p then return { id = slot, kind = "kapa", n = p.n, req = p.req, panel = p } end
		return nil
	end
	return MopedDef.SLOT[slot]
end
function MopedDef.slotName(model, slot) local i = MopedDef.slotInfo(model, slot); return i and i.n or slot end

-- m = { model=, slots = {slot=uid}, engine = {sock=uid} or nil }
function MopedDef.canMount(m, slot, sku)
	local info = MopedDef.slotInfo(m.model, slot)
	if not info then return false, "Okänd plats" end
	if slot == "motor" then return false, "Motorn monteras från motorstativet" end
	local p = Parts.get(sku)
	if not p then return false, "Okänd del" end
	if p.kind ~= info.kind then return false, p.name .. " passar inte där" end
	if p.stats.fits and p.stats.fits ~= m.model then return false, p.name .. " passar inte " .. MopedDef.MODELS[m.model].n end
	if p.stats.panel and "pan:" .. p.stats.panel ~= slot then return false, p.name .. " sitter inte där" end
	if m.slots[slot] then return false, info.n .. " sitter redan på" end
	for _, r in ipairs(info.req) do
		local filled = (r == "motor") and m.engine ~= nil or m.slots[r] ~= nil
		if not filled then return false, "Montera " .. MopedDef.slotName(m.model, r):lower() .. " först" end
	end
	return true
end
local function filled(m, slot) if slot == "motor" then return m.engine ~= nil end return m.slots[slot] ~= nil end
MopedDef.filled = filled
function MopedDef.canRemove(m, slot)
	if not filled(m, slot) then return false, "Inget monterat där" end
	for _, id in ipairs(MopedDef.slotIds(m.model)) do
		if filled(m, id) then
			local info = MopedDef.slotInfo(m.model, id)
			for _, r in ipairs(info.req) do
				if r == slot then return false, "Ta bort " .. info.n:lower() .. " först" end
			end
		end
	end
	return true
end
-- engine assembly from the stand into the moped
function MopedDef.canMountEngine(m, engineMap)
	if m.engine then return false, "Mopeden har redan en motor" end
	if not EngineDef.complete(engineMap) then return false, "Motorn är inte färdigbyggd" end
	for _, r in ipairs(MopedDef.SLOT.motor.req) do
		if not m.slots[r] then return false, "Montera " .. MopedDef.SLOT[r].n:lower() .. " först" end
	end
	return true
end
-- what is missing before the moped can be ridden (panels are optional)
function MopedDef.missing(m)
	local r = {}
	for _, s in ipairs(MopedDef.SLOTS) do
		if not filled(m, s.id) then r[#r + 1] = s.n end
	end
	if m.engine then
		local em = EngineDef.missing(m.engine)
		if #em > 0 then r[#r + 1] = "Motordelar (" .. #em .. ")" end
	end
	return r
end
function MopedDef.canRide(m) return #MopedDef.missing(m) == 0 end
function MopedDef.missingPanels(m)
	local r = {}
	for _, p in ipairs(MopedDef.MODELS[m.model].panels) do if not m.slots["pan:" .. p.id] then r[#r + 1] = p.n end end
	return r
end

return MopedDef
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Paint</string><ProtectedString name="Source"><![CDATA[-- Paint booth: colour library, finishes and spray coverage. Quality from coverage, evenness and runs.
local Paint = {}

Paint.LIBRARY = {
	{ n = "Gloss Black", c = { 18, 18, 20 } }, { n = "Midnight Blue", c = { 22, 34, 84 } }, { n = "Racing Red", c = { 200, 22, 30 } },
	{ n = "Pearl White", c = { 238, 236, 228 } }, { n = "Nardo Grey", c = { 128, 130, 128 } }, { n = "Candy Purple", c = { 120, 30, 170 } },
	{ n = "Neon Green", c = { 70, 230, 60 } }, { n = "Chrome Silver", c = { 196, 200, 206 } }, { n = "Metallic Gold", c = { 205, 160, 60 } },
	{ n = "Sky Blue", c = { 70, 150, 230 } }, { n = "Sunset Orange", c = { 245, 120, 30 } }, { n = "Mint", c = { 140, 215, 190 } },
	{ n = "Bubblegum", c = { 240, 120, 180 } }, { n = "Olive", c = { 100, 110, 50 } }, { n = "Sand", c = { 214, 196, 150 } }, { n = "Yellow", c = { 245, 205, 30 } },
}
-- finishes: Roblox material + reflectance range (gloss slider picks within it)
Paint.FINISH = {
	{ id = "blank", n = "Blank", mat = "SmoothPlastic", refl = { 0.02, 0.18 } },
	{ id = "matt", n = "Matt", mat = "Plastic", refl = { 0, 0.02 } },
	{ id = "metallic", n = "Metallic", mat = "Metal", refl = { 0.05, 0.3 } },
	{ id = "parlemor", n = "Pärlemor", mat = "SmoothPlastic", refl = { 0.15, 0.35 } },
	{ id = "krom", n = "Krom", mat = "Foil", refl = { 0.35, 0.6 } },
}
Paint.FIN = {}
for _, f in ipairs(Paint.FINISH) do Paint.FIN[f.id] = f end

Paint.COLS, Paint.ROWS = 10, 6

function Paint.validHex(s)
	if type(s) ~= "string" then return nil end
	s = s:gsub("^#", "")
	if not s:match("^%x%x%x%x%x%x$") then return nil end
	return { tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16) }
end
function Paint.hex(c) return string.format("#%02X%02X%02X", c[1], c[2], c[3]) end
function Paint.validColor(c)
	if type(c) ~= "table" then return nil end
	local r = {}
	for i = 1, 3 do
		local v = tonumber(c[i])
		if not v then return nil end
		r[i] = math.floor(math.max(0, math.min(255, v)) + 0.5)
	end
	return r
end

function Paint.new()
	local s = { cells = {}, t = 0 }
	for i = 1, Paint.COLS * Paint.ROWS do s.cells[i] = 0 end
	return s
end
-- spray at (u,v) 0..1 over the panel for dt seconds; dist = gun distance factor (1 = ideal); even from the gun
function Paint.spray(s, u, v, dt, dist, even)
	even = even or 0
	dist = dist or 1
	local radius = 1.6 * dist
	local rate = 2.0 / (dist * dist) * dt
	local cx, cy = u * Paint.COLS + 0.5, v * Paint.ROWS + 0.5
	for row = 1, Paint.ROWS do
		for col = 1, Paint.COLS do
			local d = math.sqrt((col - cx) ^ 2 + (row - cy) ^ 2)
			if d < radius then
				local i = (row - 1) * Paint.COLS + col
				local f = 1 - d / radius
				f = f * (1 - 0.4 * even) + 0.4 * even * (d < radius * 0.8 and 0.7 or 0.2)
				s.cells[i] = s.cells[i] + rate * f
			end
		end
	end
	s.t = s.t + dt
end
function Paint.coverage(s)
	local c = 0
	for _, x in ipairs(s.cells) do if x >= 0.8 then c = c + 1 end end
	return c / #s.cells
end
function Paint.result(s)
	if type(s) ~= "table" or type(s.cells) ~= "table" then return nil end
	local n = Paint.COLS * Paint.ROWS
	local cover, runs, sum = 0, 0, 0
	local vals = {}
	for i = 1, n do
		local x = math.max(0, math.min(4, tonumber(s.cells[i]) or 0))
		vals[i] = x
		sum = sum + math.min(x, 1.6)
		if x >= 0.8 then cover = cover + 1 end
		if x > 1.8 then runs = runs + 1 end
	end
	local mean = sum / n
	local var = 0
	for i = 1, n do var = var + (math.min(vals[i], 1.6) - mean) ^ 2 end
	local even = math.max(0, 1 - math.sqrt(var / n) * 1.5)
	cover, runs = cover / n, runs / n
	local q = math.max(0, math.min(1, cover * 0.55 + even * 0.45 - runs * 1.2))
	local label = q >= 0.9 and "Perfekt" or (q >= 0.75 and "Bra" or (q >= 0.5 and "OK" or "Fläckig"))
	return { cover = cover, even = even, runs = runs, q = q, label = label }
end

return Paint
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Parts</string><ProtectedString name="Source"><![CDATA[-- Every part and tool that exists, with shop data and the stats Performance uses.
-- All brands are made up (real brand names and logos could get the game taken down from Roblox).
local Parts = {}

-- kinds: what a part is, where it belongs and which shop category it is sold under
Parts.KINDS = {
	-- motorblock
	vevhus = { n = "Vevhus", grp = "Motorblock", cat = "Vevpartier" },
	vevlager = { n = "Vevlager", grp = "Motorblock", cat = "Motordelar" },
	vevaxel = { n = "Vevaxel", grp = "Motorblock", cat = "Vevpartier" },
	packbox = { n = "Packboxar", grp = "Motorblock", cat = "Motordelar" },
	nallager = { n = "Nållager", grp = "Motorblock", cat = "Motordelar" },
	kolv = { n = "Kolv", grp = "Motorblock", cat = "Cylindrar" },
	kolvbult = { n = "Kolvbult", grp = "Motorblock", cat = "Motordelar" },
	kolvringar = { n = "Kolvringar", grp = "Motorblock", cat = "Cylindrar" },
	fotpackning = { n = "Cylinderfotspackning", grp = "Motorblock", cat = "Motordelar" },
	cylinder = { n = "Cylinder", grp = "Motorblock", cat = "Cylindrar" },
	topplock = { n = "Topplock", grp = "Motorblock", cat = "Cylindrar" },
	tandstift = { n = "Tändstift", grp = "Motorblock", cat = "Tändsystem" },
	-- transmission
	variator = { n = "Variator", grp = "Transmission", cat = "Variatorer" },
	vikter = { n = "Variatorvikter", grp = "Transmission", cat = "Variatorer" },
	flakt = { n = "Fläkt", grp = "Transmission", cat = "Variatorer" },
	rem = { n = "Rem", grp = "Transmission", cat = "Variatorer" },
	koppling = { n = "Koppling", grp = "Transmission", cat = "Kopplingar" },
	klocka = { n = "Kopplingsklocka", grp = "Transmission", cat = "Kopplingar" },
	remskiva = { n = "Bakre remskiva", grp = "Transmission", cat = "Kopplingar" },
	-- bränsle och insug
	reed = { n = "Reedventil", grp = "Insug", cat = "Insug" },
	insug = { n = "Insug", grp = "Insug", cat = "Insug" },
	forgasare = { n = "Förgasare", grp = "Insug", cat = "Förgasare" },
	luftfilter = { n = "Luftfilter", grp = "Insug", cat = "Luftfilter" },
	slang = { n = "Bränsleslang", grp = "Insug", cat = "Förgasare" },
	-- tändning
	cdi = { n = "CDI", grp = "Tändning", cat = "Tändsystem" },
	spole = { n = "Tändspole", grp = "Tändning", cat = "Tändsystem" },
	svanghjul = { n = "Svänghjul", grp = "Tändning", cat = "Tändsystem" },
	stator = { n = "Stator", grp = "Tändning", cat = "Tändsystem" },
	tandkabel = { n = "Tändkabel", grp = "Tändning", cat = "Tändsystem" },
	-- chassi
	ram = { n = "Ram", grp = "Chassi", cat = "Chassi" },
	gaffel = { n = "Framgaffel", grp = "Chassi", cat = "Chassi" },
	framhjul = { n = "Framhjul", grp = "Chassi", cat = "Chassi" },
	bakhjul = { n = "Bakhjul", grp = "Chassi", cat = "Chassi" },
	frambroms = { n = "Frambroms", grp = "Chassi", cat = "Chassi" },
	bakbroms = { n = "Bakbroms", grp = "Chassi", cat = "Chassi" },
	dampare = { n = "Bakdämpare", grp = "Chassi", cat = "Chassi" },
	styre = { n = "Styre", grp = "Chassi", cat = "Chassi" },
	tank = { n = "Tank", grp = "Chassi", cat = "Chassi" },
	sadel = { n = "Sadel", grp = "Chassi", cat = "Chassi" },
	avgas = { n = "Avgassystem", grp = "Chassi", cat = "Avgassystem" },
	kapa = { n = "Kåpa", grp = "Kåpor", cat = "Styling" },
	verktyg = { n = "Verktyg", grp = "Verktyg", cat = "Verktyg" },
}

Parts.CATEGORIES = { "Cylindrar", "Förgasare", "Avgassystem", "Variatorer", "Kopplingar", "Vevpartier", "Tändsystem", "Insug", "Luftfilter", "Motordelar", "Chassi", "Styling", "Verktyg" }

Parts.BRANDS = {
	Origo = { color = { 190, 194, 200 }, about = "Originaldelar" },
	Fartek = { color = { 205, 38, 38 }, about = "Racing" },
	Nordtrim = { color = { 240, 196, 25 }, about = "Sport" },
	Snabbo = { color = { 245, 120, 20 }, about = "Racing" },
	Kylstad = { color = { 40, 110, 210 }, about = "Kyla och tändning" },
	["Gasström"] = { color = { 40, 160, 90 }, about = "Förgasare" },
	Bruksmek = { color = { 110, 115, 125 }, about = "Prisvärt" },
	Vippa = { color = { 30, 90, 200 }, about = "Mopedtillverkare" },
}

Parts.ITEMS = {}
Parts.LIST = {}
Parts.LIST_INDEX = {}
local function add(kind, code, brand, name, price, stock, stats, desc)
	local sku = kind .. "_" .. code
	assert(Parts.KINDS[kind], kind)
	assert(not Parts.ITEMS[sku], sku)
	local it = { sku = sku, kind = kind, brand = brand, name = name, price = price, stock = stock, stats = stats or {}, desc = desc or "" }
	Parts.ITEMS[sku] = it
	Parts.LIST[#Parts.LIST + 1] = it
	Parts.LIST_INDEX[sku] = #Parts.LIST
	return it
end
Parts.add = add

-- motorblock -------------------------------------------------------------
add("vevhus", "origo", "Origo", "Vevhus original", 650, 6, { lvl = 0 }, "Delat vevhus i gjuten aluminium för liggande motor.")
add("vevhus", "fartek", "Fartek", "Vevhus Racing", 1490, 2, { lvl = 2, hp = 1.03 }, "Bearbetade överströmningskanaler som matchar racingcylindrar.")
add("vevlager", "origo", "Origo", "Vevlager 6204", 149, 12, {}, "Två kullager till vevaxeln.")
add("vevlager", "nordtrim", "Nordtrim", "Vevlager C4 högvarv", 249, 6, { rpm = 300 }, "Lager med större glapp som tål högre varv.")
add("vevaxel", "origo", "Origo", "Vevaxel 39,2 mm", 690, 5, { stroke = 39.2 }, "Original vevaxel med vevstake.")
add("vevaxel", "fartek", "Fartek", "Vevaxel Racing 39,2 mm", 1290, 3, { stroke = 39.2, hp = 1.04, rpm = 500, lvl = 2 }, "Balanserad vevaxel för högre varv.")
add("vevaxel", "snabbo", "Snabbo", "Långslagsvevaxel 44 mm", 1590, 0, { stroke = 44, hp = 1.09, rpm = -400, lvl = 2 }, "Längre slag ger mer slagvolym och vridmoment.")
add("packbox", "origo", "Origo", "Packboxar (par)", 79, 20, {}, "Tätar vevhuset mot vevaxeln.")
add("packbox", "fartek", "Fartek", "Packboxar Viton (par)", 129, 8, {}, "Värmetåliga packboxar.")
add("nallager", "origo", "Origo", "Nållager 10x14x13", 69, 15, {}, "Lager för kolvbulten i vevstaken.")
add("nallager", "nordtrim", "Nordtrim", "Nållager Silver", 119, 6, { rpm = 150 }, "Försilvrad bur för högre varv.")
add("kolv", "40", "Origo", "Kolv 40 mm", 349, 8, { bore = 40 }, "Kolv till 50 cc cylinder.")
add("kolv", "47", "Nordtrim", "Kolv 47 mm", 499, 5, { bore = 47 }, "Kolv till Nordtrim 70 cc.")
add("kolv", "476", "Fartek", "Kolv 47,6 mm", 590, 4, { bore = 47.6 }, "Smidd kolv till Fartek 70 cc.")
add("kolv", "50", "Snabbo", "Kolv 50 mm", 690, 2, { bore = 50 }, "Kolv till Snabbo 80 cc.")
add("kolvringar", "40", "Origo", "Kolvringar 40 mm", 129, 10, { bore = 40 }, "Två ringar.")
add("kolvringar", "47", "Nordtrim", "Kolvringar 47 mm", 159, 6, { bore = 47 }, "Två ringar.")
add("kolvringar", "476", "Fartek", "Kolvringar 47,6 mm", 189, 6, { bore = 47.6 }, "Två krom-ringar.")
add("kolvringar", "50", "Snabbo", "Kolvringar 50 mm", 199, 3, { bore = 50 }, "Två ringar.")
add("kolvbult", "origo", "Origo", "Kolvbult 10 mm", 59, 15, {}, "Håller kolven på vevstaken.")
add("kolvbult", "fartek", "Fartek", "Kolvbult lätt 10 mm", 129, 6, { rpm = 200 }, "Urborrad, lättare bult.")
add("fotpackning", "origo", "Origo", "Fotpackning 0,5 mm", 39, 25, {}, "Packning mellan vevhus och cylinder.")
add("fotpackning", "fartek", "Fartek", "Fotpackning 0,3 mm", 59, 10, { hp = 1.02 }, "Tunnare packning ger lite högre kompression.")
add("cylinder", "origo50", "Origo", "Cylinder 50 cc", 1290, 4, { cc = 49.3, bore = 40, hp = 3.6, rpm = 6800, lvl = 0, heat = 1.0 }, "Originalcylinder i gjutjärn. Lugn och tålig.")
add("cylinder", "nordtrim70", "Nordtrim", "Cylinder 70 cc Sport", 1990, 4, { cc = 68, bore = 47, hp = 6.9, rpm = 8600, lvl = 1, heat = 1.15 }, "Gjutjärnscylinder för gatan. Bra första trimning.")
add("cylinder", "fartek70", "Fartek", "Cylinder 70 cc Racing", 3290, 2, { cc = 69.7, bore = 47.6, hp = 9.6, rpm = 10400, lvl = 2, heat = 1.3 }, "Aluminium med nikasilbeläggning och fem överströmningskanaler.")
add("cylinder", "snabbo80", "Snabbo", "Cylinder 80 cc Big Bore", 4490, 0, { cc = 77, bore = 50, hp = 12.2, rpm = 10900, lvl = 3, heat = 1.45 }, "Störst slagvolym. Kräver stor förgasare och racingavgas.")
add("topplock", "origo", "Origo", "Topplock original", 290, 6, { comp = 1.0 }, "Luftkylt topplock.")
