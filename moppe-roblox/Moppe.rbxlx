<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="Workspace" referent="RBX1"><Properties><string name="Name">Workspace</string></Properties></Item>
<Item class="Lighting" referent="RBX2"><Properties><string name="Name">Lighting</string></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX17"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX16"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Assembly</string><ProtectedString name="Source"><![CDATA[-- Assembly rules: engine sockets (on the engine stand) and moped mounting points (chassis + panels).
-- Each socket has a position (metres, engine space: x right, y up, z forward, origin = crankshaft centre),
-- the part kind that fits and which sockets must already be fitted. The same rules apply in reverse for removal.
-- Everything works on maps socket -> sku, so it can be tested without Roblox.
local Config = require(script.Parent.Config)
local Catalog = require(script.Parent.Catalog)
local Panels = require(script.Parent.Panels)
local Assembly = {}

local function S(id, kind, pos, req, only, rot) return { id = id, kind = kind, pos = pos, req = req or {}, only = only, rot = rot } end
-- only = "cvt" | "dt" | "fan" (scooters with a cooling fan)
Assembly.ENGINE = {
	S("case", "case", { 0, 0, 0 }),
	S("bearings", "bearing", { 0, 0, 0 }, { "case" }),
	S("gearbox", "gearbox", { 0, -0.08, -0.1 }, { "case" }, "dt"),
	S("crank", "crank", { 0, 0, 0 }, { "bearings" }),
	S("seals", "seal", { 0, 0, 0 }, { "crank" }),
	S("needle", "needle", { 0, 0.075, 0 }, { "crank" }),
	S("piston", "piston", { 0, 0.15, 0 }, { "needle" }),
	S("pin", "pin", { 0, 0.15, 0 }, { "piston" }),
	S("rings", "rings", { 0, 0.175, 0 }, { "piston" }),
	S("gasket", "gasket", { 0, 0.205, 0 }, { "pin", "rings" }),
	S("cyl", "cyl", { 0, 0.28, 0 }, { "gasket" }),
	S("head", "head", { 0, 0.37, 0 }, { "cyl" }),
	S("plug", "plug", { 0, 0.425, 0 }, { "head" }),
	S("reed", "reed", { 0, 0.06, -0.15 }, { "case" }),
	S("intake", "intake", { 0, 0.07, -0.21 }, { "reed" }),
	S("carb", "carb", { 0, 0.08, -0.29 }, { "intake" }),
	S("filter", "filter", { 0, 0.1, -0.4 }, { "carb" }),
	S("hose", "hose", { 0.07, 0.13, -0.29 }, { "carb" }),
	S("stator", "stator", { -0.16, 0, 0 }, { "seals" }),
	S("flywheel", "flywheel", { -0.2, 0, 0 }, { "stator" }),
	S("fan", "fan", { -0.25, 0, 0 }, { "flywheel" }, "fan"),
	S("coil", "coil", { -0.08, 0.24, -0.1 }, { "case" }),
	S("cdi", "cdi", { -0.12, 0.1, -0.22 }, { "coil" }),
	S("cable", "cable", { -0.04, 0.34, -0.04 }, { "coil", "plug" }),
	S("weights", "weights", { 0.18, 0, 0 }, { "seals" }, "cvt"),
	S("var", "var", { 0.2, 0, 0 }, { "weights" }, "cvt"),
	S("contra", "contra", { 0.2, 0, -0.36 }, { "case" }, "cvt"),
	S("pulley", "pulley", { 0.2, 0, -0.36 }, { "contra" }, "cvt"),
	S("belt", "belt", { 0.22, 0, -0.18 }, { "var", "pulley" }, "cvt"),
	S("clutch", "clutch", { 0.24, 0, -0.36 }, { "pulley" }, "cvt"),
	S("bell", "bell", { 0.27, 0, -0.36 }, { "clutch", "belt" }, "cvt"),
	S("plates", "plates", { 0.18, -0.02, -0.05 }, { "gearbox", "seals" }, "dt"),
	S("sprocket", "sprocket", { -0.12, -0.06, -0.18 }, { "gearbox" }, "dt"),
}
-- DT: the crankshaft goes in after the gearbox (both sit in the case halves)
Assembly.DT_EXTRA_REQ = { crank = { "gearbox" } }

-- chassis: positions in moped space are drawn by Builder; here only order and kind
Assembly.CHASSIS = {
	S("frame", "frame"), S("fork", "fork", nil, { "frame" }), S("wheelF", "wheel", nil, { "fork" }), S("brakeF", "brake", nil, { "wheelF" }),
	S("shock", "shock", nil, { "frame" }), S("engine", "engine", nil, { "frame", "shock" }),
	S("wheelR", "wheel", nil, { "engine" }), S("brakeR", "brake", nil, { "wheelR" }),
	S("bars", "bars", nil, { "fork" }), S("seat", "seat", nil, { "frame" }), S("tank", "tank", nil, { "frame" }, "dt"),
	S("exh", "exh", nil, { "engine" }), S("radiator", "radiator", nil, { "frame" }, "rok"),
}
-- panels needing more than the frame
local PANEL_REQ = { grips = { "bars" }, barcover = { "bars" }, dash = { "bars", "pan:barcover" }, lightcover = { "frame" }, headset = { "bars" },
	rearside_l = { "pan:side_l" }, rearside_r = { "pan:side_r" }, tankcover = { "tank" }, lampmask = { "fork" }, fender_f = { "fork" }, fender_r = { "frame" } }

local function applies(s, mop)
	if not s.only then return true end
	if s.only == "cvt" then return mop.cvt end
	if s.only == "dt" then return not mop.cvt end
	if s.only == "fan" then return mop.id ~= "dt" end
	return s.only == mop.id
end

function Assembly.engineSockets(mopId)
	local mop, out = Config.BY_ID[mopId], {}
	for _, s in ipairs(Assembly.ENGINE) do
		if applies(s, mop) then
			local req = s.req
			if not mop.cvt and Assembly.DT_EXTRA_REQ[s.id] then req = {}; for _, r in ipairs(s.req) do table.insert(req, r) end; for _, r in ipairs(Assembly.DT_EXTRA_REQ[s.id]) do table.insert(req, r) end end
			table.insert(out, { id = s.id, kind = s.kind, pos = s.pos, req = req })
		end
	end
	return out
end
function Assembly.chassisSlots(mopId)
	local mop, out = Config.BY_ID[mopId], {}
	for _, s in ipairs(Assembly.CHASSIS) do if applies(s, mop) then table.insert(out, { id = s.id, kind = s.kind, req = s.req }) end end
	for _, pd in ipairs(Panels[mopId]) do table.insert(out, { id = "pan:" .. pd.id, kind = "panel", panel = pd.id, req = PANEL_REQ[pd.id] or { "frame" }, optional = true }) end
	return out
end
local function find(list, id) for _, s in ipairs(list) do if s.id == id then return s end end end
Assembly.find = find
local function label(list, id)
	if id:sub(1, 4) == "pan:" then local pd = nil; for _, s in ipairs(list) do if s.id == id then pd = s end end; return pd and pd.panel and ("kåpan " .. id:sub(5)) or id end
	if id == "engine" then return "motorn" end
	local s = find(list, id)
	return s and string.lower(Catalog.KIND[s.kind][1]) or id
end
local SLOT_NAME = { wheelF = "framhjulet", wheelR = "bakhjulet", brakeF = "frambromsen", brakeR = "bakbromsen", exh = "avgassystemet", engine = "motorn", bearings = "vevlagren", seals = "packboxarna" }
local function nameOf(list, id, mopId)
	if SLOT_NAME[id] then return SLOT_NAME[id] end
	if id:sub(1, 4) == "pan:" then local pd = Panels.find(mopId, id:sub(5)); return pd and string.lower(pd.n) or id end
	return label(list, id)
end

-- which sockets does a product fit (usually one)?
function Assembly.socketsFor(list, prod)
	local out = {}
	for _, s in ipairs(list) do
		if s.kind == prod.kind and (s.kind ~= "panel" or s.panel == prod.val.panel) then table.insert(out, s.id) end
	end
	return out
end

-- can product sku go in socket id? map = socket -> sku (fitted). Returns nil if OK, otherwise a reason in Swedish.
function Assembly.canMount(list, map, mopId, socketId, sku)
	local s = find(list, socketId)
	local prod = Catalog.BY_SKU[sku]
	if not s or not prod then return "Okänd del eller plats" end
	if prod.kind ~= s.kind or (s.kind == "panel" and prod.val.panel ~= s.panel) then return "Delen hör inte hemma här" end
	if not Catalog.fits(prod, mopId) then return "Delen passar inte " .. Config.BY_ID[mopId].n end
	if map[socketId] then return "Platsen är redan upptagen" end
	for _, r in ipairs(s.req) do
		if not map[r] then return "Montera " .. nameOf(list, r, mopId) .. " först" end
	end
	-- the piston and rings must match the cylinder (and each other)
	if s.kind == "cyl" or s.kind == "rings" then
		local pis = map.piston and Catalog.BY_SKU[map.piston]
		local bore = s.kind == "cyl" and Config.KITS[prod.val.kit + 1].cc or prod.val.bore
		if pis and pis.val.bore ~= bore then return "Kolven (" .. pis.val.bore .. " cc) passar inte " .. (s.kind == "cyl" and "cylindern" or "ringarna") .. " (" .. bore .. " cc)" end
	end
	return nil
end
-- can socket id be removed? (nothing else fitted may depend on it)
function Assembly.canRemove(list, map, mopId, socketId)
	if not map[socketId] then return "Inget monterat här" end
	for _, s in ipairs(list) do
		if map[s.id] then for _, r in ipairs(s.req) do if r == socketId then return "Ta bort " .. nameOf(list, s.id, mopId) .. " först" end end end
	end
	return nil
end
-- required sockets missing (panels are optional)
function Assembly.missing(list, map)
	local out = {}
	for _, s in ipairs(list) do if not s.optional and not map[s.id] then table.insert(out, s.id) end end
	return out
end
function Assembly.names(list, ids, mopId)
	local o = {}
	for _, id in ipairs(ids) do table.insert(o, nameOf(list, id, mopId)) end
	return o
end

-- effective engine configuration from fitted parts (+ porting result and the jet setting)
function Assembly.ecfg(engMap, chMap, jet, port)
	local c = { kit = 0, exh = 0, carb = 1, maxd = 19, fcap = 1, icap = 11000, cf = 1, rmin = 0.85, roller = 9, slip = 7500, cdt = 0, blim = 7, crankf = 1, reedf = 1, port = 0, jet = jet or 85 }
	local function take(sku) local p = sku and Catalog.BY_SKU[sku]; if p then for k, v in pairs(p.val) do c[k] = v end end end
	for _, sku in pairs(engMap or {}) do take(sku) end
	for slot, sku in pairs(chMap or {}) do if slot == "exh" or slot == "radiator" then take(sku) end end
	if port then c.port = port.deg or 0; c.portq = port.q end
	c.tmf = c.crankf * c.reedf * (c.portq and (0.9 + 0.2 * c.portq) or 1) -- careful porting gives up to +10 %, a poor job loses power
	c.jet = math.min(160, math.max(40, c.jet))
	return c
end

return Assembly
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Builder</string><ProtectedString name="Source"><![CDATA[-- 3D models built from Roblox parts: every part (as a loose item), the engine with parts at their mount points,
-- the moped from what is actually mounted, a hand with tools (first person). Sizes in metres -> studs.
-- Coordinates: x right, y up, z forward (z is flipped to Roblox's -Z = forward).
local Config = require(script.Parent.Config)
local Catalog = require(script.Parent.Catalog)
local Panels = require(script.Parent.Panels)
local Assembly = require(script.Parent.Assembly)
local Builder = {}
local S = 1 / Config.STUD
Builder.S = S

local MAT = { paint = Enum.Material.SmoothPlastic, metal = Enum.Material.Metal, plastic = Enum.Material.SmoothPlastic, neon = Enum.Material.Neon,
	glass = Enum.Material.Glass, alu = Enum.Material.DiamondPlate, fabric = Enum.Material.Fabric, rust = Enum.Material.CorrodedMetal }
local C = {
	tire = Color3.fromRGB(22, 23, 25), dark = Color3.fromRGB(35, 37, 41), black = Color3.fromRGB(18, 18, 20), chrome = Color3.fromRGB(235, 238, 242),
	alu = Color3.fromRGB(190, 195, 202), cast = Color3.fromRGB(150, 155, 162), white = Color3.fromRGB(240, 240, 236), lamp = Color3.fromRGB(255, 238, 190),
	red = Color3.fromRGB(190, 25, 35), carbon = Color3.fromRGB(30, 32, 36), gold = Color3.fromRGB(212, 168, 58), brass = Color3.fromRGB(205, 165, 75),
	copper = Color3.fromRGB(184, 115, 51), yellow = Color3.fromRGB(240, 196, 25), skin = Color3.fromRGB(234, 192, 160), glove = Color3.fromRGB(40, 42, 46),
}
Builder.C, Builder.MAT = C, MAT

local function hexColor(h) if type(h) == "string" and h:match("^#%x%x%x%x%x%x$") then return Color3.fromHex(h) end return C.cast end

-- part factory: parts in model, optionally welded to root
local function maker(model, root)
	local K = {}
	function K.part(name, shape, sizeM, cf, color, material, refl)
		local p = Instance.new("Part")
		p.Name = name
		if shape == "cyl" then p.Shape = Enum.PartType.Cylinder elseif shape == "ball" then p.Shape = Enum.PartType.Ball end
		p.Size = Vector3.new(math.max(0.02, sizeM.X * S), math.max(0.02, sizeM.Y * S), math.max(0.02, sizeM.Z * S))
		p.CFrame = cf
		p.Color = color
		p.Material = material or MAT.plastic
		p.Reflectance = refl or 0
		p.CanCollide, p.CanTouch, p.Massless, p.Anchored = false, false, true, false
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = model
		if root then local w = Instance.new("WeldConstraint"); w.Part0, w.Part1 = root, p; w.Parent = p end
		return p
	end
	function K.wedge(name, sizeM, cf, color, material, refl)
		local w = Instance.new("WedgePart")
		w.Name, w.Size, w.CFrame, w.Color, w.Material, w.Reflectance = name, Vector3.new(sizeM.X * S, sizeM.Y * S, sizeM.Z * S), cf, color, material or MAT.plastic, refl or 0
		w.CanCollide, w.CanTouch, w.Massless, w.Anchored = false, false, true, false
		w.Parent = model
		if root then local wc = Instance.new("WeldConstraint"); wc.Part0, wc.Part1 = root, w; wc.Parent = w end
		return w
	end
	function K.at(x, y, z) return CFrame.new(x * S, y * S, -z * S) end
	function K.tube(name, a, b, r, color, material, refl)
		local A, B = Vector3.new(a[1] * S, a[2] * S, -a[3] * S), Vector3.new(b[1] * S, b[2] * S, -b[3] * S)
		local len = (B - A).Magnitude / S
		if len < 0.001 then return nil end
		return K.part(name, "cyl", Vector3.new(len, r * 2, r * 2), CFrame.lookAt((A + B) / 2, B) * CFrame.Angles(0, math.pi / 2, 0), color, material, refl)
	end
	-- cylinder along an axis: "x" (default), "y" (vertical) or "z"
	function K.cyl(name, len, dia, x, y, z, axis, color, material, refl)
		local rot = axis == "y" and CFrame.Angles(0, 0, math.pi / 2) or axis == "z" and CFrame.Angles(0, math.pi / 2, 0) or CFrame.new()
		return K.part(name, "cyl", Vector3.new(len, dia, dia), K.at(x, y, z) * rot, color, material, refl)
	end
	function K.box(name, w, h, d, x, y, z, color, material, refl, rx, ry, rz)
		return K.part(name, "box", Vector3.new(w, h, d), K.at(x, y, z) * CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0)), color, material, refl)
	end
	function K.spin(name, sizeM, cf, color, material, refl)
		local p = K.part(name, "box", sizeM, cf, color, material, refl)
		for _, c in ipairs(p:GetChildren()) do if c:IsA("WeldConstraint") then c:Destroy() end end
		local w = Instance.new("Weld"); w.Name = "SpinWeld"; w.Part0, w.Part1 = root, p; w.C0 = root.CFrame:Inverse() * p.CFrame; w.Parent = p
		return w
	end
	function K.attach(name, x, y, z)
		local a = Instance.new("Attachment"); a.Name = name
		a.Position = root.CFrame:PointToObjectSpace(Vector3.new(x * S, y * S, -z * S)); a.Parent = root
		return a
	end
	return K
end
Builder.maker = maker

-- paint on a panel: colour + finish -> Roblox material/reflectance. Poor paint quality = duller surface.
function Builder.paintLook(paint, look)
	local L = Panels.LOOK[look or "std"] or {}
	if L.fixed == "carbon" then return C.carbon, MAT.paint, 0.18, 0 end
	if L.fixed == "chrome" then return C.chrome, MAT.metal, 0.5, 0 end
	if L.fixed == "clear" then return Color3.fromRGB(60, 66, 74), MAT.glass, 0.2, 0.45 end
	paint = paint or { col = "#bdbdbd", fin = "gloss", q = 1 }
	local q = paint.q or 1
	local col, f = hexColor(paint.col), paint.fin
	if f == "matt" then return col, MAT.plastic, 0, 0 end
	if f == "metal" then return col, MAT.metal, 0.12 * q, 0 end
	if f == "pearl" then return col:Lerp(Color3.new(1, 1, 1), 0.08), MAT.paint, 0.22 * q, 0 end
	if f == "chrome" then return col:Lerp(C.chrome, 0.5), MAT.metal, 0.45 * q, 0 end
	return col, MAT.paint, 0.14 * q, 0
end

local function rimLook(rims)
	if rims == "pol" then return C.chrome, MAT.metal, 0.45 end
	if rims == "gold" then return C.gold, MAT.metal, 0.25 end
	return C.alu, MAT.metal, 0.1
end

-- ---------- engine parts (centred around their mount point) ----------
local function enginePart(K, kind, v, x, y, z, item)
	local function c(name, len, dia, dx, dy, dz, axis, col, mat, refl) return K.cyl(name, len, dia, x + dx, y + dy, z + dz, axis, col, mat, refl) end
	local function b(name, w, h, d, dx, dy, dz, col, mat, refl) return K.box(name, w, h, d, x + dx, y + dy, z + dz, col, mat, refl) end
	if kind == "case" then
		b("CaseTop", 0.24, 0.12, 0.3, 0, 0.02, -0.03, C.cast, MAT.metal, 0.05)
		K.part("CaseBottom", "ball", Vector3.new(0.26, 0.16, 0.32), K.at(x, y - 0.05, z - 0.03), C.cast, MAT.metal, 0.05)
		b("CaseBolts", 0.245, 0.01, 0.2, 0, 0.08, -0.03, C.chrome, MAT.metal, 0.3)
	elseif kind == "bearing" then for _, s in ipairs({ -1, 1 }) do c("Bearing", 0.02, 0.06, s * 0.11, 0, 0, "x", C.chrome, MAT.metal, 0.4) end
	elseif kind == "seal" then for _, s in ipairs({ -1, 1 }) do c("Seal", 0.01, 0.045, s * 0.135, 0, 0, "x", C.black, MAT.plastic) end
	elseif kind == "crank" then
		c("Shaft", 0.46, 0.022, 0, 0, 0, "x", C.chrome, MAT.metal, 0.35)
		for _, s in ipairs({ -1, 1 }) do c("Web", 0.025, 0.15, s * 0.035, 0, 0, "x", v.crankf and v.crankf > 1 and C.gold or C.cast, MAT.metal, 0.2) end
		b("Conrod", 0.018, 0.1, 0.025, 0, 0.04, 0, C.chrome, MAT.metal, 0.3)
	elseif kind == "needle" then c("Needle", 0.024, 0.026, 0, 0, 0, "x", C.brass, MAT.metal, 0.3)
	elseif kind == "piston" then
		local d = v.bore and v.bore > 50 and 0.047 or 0.04
		c("Piston", 0.045, d, 0, 0, 0, "y", C.alu, MAT.metal, 0.25)
		c("Crown", 0.004, d * 0.95, 0, 0.024, 0, "y", C.cast, MAT.metal)
	elseif kind == "pin" then c("Pin", 0.046, 0.012, 0, 0, 0, "x", C.chrome, MAT.metal, 0.4)
	elseif kind == "rings" then
		local d = v.bore and v.bore > 50 and 0.048 or 0.041
		c("Ring1", 0.003, d, 0, 0.004, 0, "y", C.dark, MAT.metal); c("Ring2", 0.003, d, 0, -0.004, 0, "y", C.dark, MAT.metal)
	elseif kind == "gasket" then b("Gasket", 0.1, 0.003, 0.1, 0, 0, 0, Color3.fromRGB(120, 90, 60), MAT.fabric)
	elseif kind == "cyl" then
		local t = v.kit or 0
		local col = ({ C.cast, Color3.fromRGB(205, 210, 216), Color3.fromRGB(42, 44, 48) })[t + 1]
		c("Barrel", 0.13, 0.085, 0, 0, 0, "y", col, MAT.metal, 0.08)
		for i = 0, 6 do b("Fin", 0.15, 0.007, 0.15, 0, -0.055 + i * 0.018, 0, col, MAT.metal, 0.08) end
		b("ExPort", 0.04, 0.035, 0.05, 0, -0.02, 0.07, col, MAT.metal, 0.08)
		b("InPort", 0.04, 0.035, 0.04, 0, -0.03, -0.065, col, MAT.metal, 0.08)
		if item and item.port then b("PortGlint", 0.03, 0.025, 0.002, 0, -0.02, 0.097, Color3.fromRGB(230, 235, 240), MAT.metal, 0.6) end
	elseif kind == "head" then
		local big = v.cf and v.cf > 1
		b("Head", 0.14, 0.035, 0.14, 0, 0, 0, C.alu, MAT.metal, 0.12)
		for i = 0, (big and 4 or 2) do b("HeadFin", big and 0.17 or 0.14, 0.005, 0.14, 0, 0.022 + i * 0.012, 0, C.alu, MAT.metal, 0.12) end
	elseif kind == "plug" then c("Insulator", 0.035, 0.016, 0, 0.015, 0, "y", C.white, MAT.plastic); c("PlugNut", 0.015, 0.02, 0, -0.008, 0, "y", C.chrome, MAT.metal, 0.3)
	elseif kind == "reed" then b("Reed", 0.05, 0.05, 0.035, 0, 0, 0, v.reedf and v.reedf > 1 and C.carbon or C.dark, MAT.plastic, 0.05)
	elseif kind == "intake" then c("Intake", 0.07, (v.maxd or 19) > 19 and 0.045 or 0.035, 0, 0, 0, "z", C.black, MAT.plastic)
	elseif kind == "carb" then
		local d = (Config.CARB[(v.carb or 0) + 1] or 17.5) / 17.5
		b("CarbBody", 0.05 * d, 0.05 * d, 0.05 * d, 0, 0, 0, C.alu, MAT.metal, 0.12)
		c("Bell", 0.04, 0.035 * d, 0, 0, -0.04, "z", C.alu, MAT.metal, 0.12)
		c("Bowl", 0.03, 0.035 * d, 0, -0.035, 0, "y", C.alu, MAT.metal, 0.12)
		c("Slide", 0.03, 0.022, 0, 0.035, 0, "y", C.chrome, MAT.metal, 0.3)
	elseif kind == "filter" then
		if (v.fcap or 1) > 1 then c("Cone", 0.1, 0.08, 0, 0, -0.02, "z", C.red, MAT.fabric) else b("Airbox", 0.12, 0.08, 0.1, 0, 0, -0.02, C.black, MAT.plastic) end
	elseif kind == "hose" then K.tube("Hose", { x, y, z }, { x + 0.02, y + 0.1, z - 0.06 }, 0.004, Color3.fromRGB(220, 200, 120), MAT.glass, 0.1)
	elseif kind == "stator" then c("Stator", 0.02, 0.1, 0, 0, 0, "x", C.copper, MAT.metal, 0.2)
	elseif kind == "flywheel" then c("Flywheel", 0.03, 0.125, 0, 0, 0, "x", C.dark, MAT.metal, 0.1)
	elseif kind == "fan" then
		c("FanDisc", 0.012, 0.13, 0, 0, 0, "x", C.black, MAT.plastic)
		for i = 0, 7 do local a = i * math.pi / 4; K.part("Blade", "box", Vector3.new(0.02, 0.05, 0.008), K.at(x - 0.012, y + math.sin(a) * 0.04, z + math.cos(a) * 0.04) * CFrame.Angles(-a, 0, 0), C.black, MAT.plastic) end
	elseif kind == "coil" then b("Coil", 0.03, 0.045, 0.05, 0, 0, 0, C.black, MAT.plastic)
	elseif kind == "cdi" then b("Cdi", 0.06, 0.02, 0.045, 0, 0, 0, (v.icap or 11000) > 11000 and C.red or C.black, MAT.plastic)
	elseif kind == "cable" then K.tube("Cable", { x, y - 0.06, z - 0.06 }, { x, y + 0.06, z + 0.04 }, 0.004, C.black, MAT.plastic); c("Cap", 0.025, 0.018, 0, 0.065, 0.045, "y", C.red, MAT.plastic)
	elseif kind == "weights" then
		local col = (v.roller or 9) <= 7 and C.white or (v.roller or 9) >= 11 and C.brass or C.black
		for i = 0, 5 do local a = i * math.pi / 3; c("Roller", 0.013, 0.016, 0, math.sin(a) * 0.035, math.cos(a) * 0.035, "x", col, MAT.plastic) end
	elseif kind == "var" then
		local col = (v.rmin or 0.85) < 0.75 and C.gold or (v.rmin or 0.85) < 0.8 and Color3.fromRGB(58, 111, 216) or C.alu
		c("Variator", 0.02, 0.115, 0, 0, 0, "x", col, MAT.metal, 0.2); c("VarHub", 0.03, 0.03, 0.01, 0, 0, "x", C.chrome, MAT.metal, 0.4)
	elseif kind == "contra" then
		local col = (v.cdt or 0) >= 800 and C.red or (v.cdt or 0) >= 400 and C.yellow or C.dark
		for i = 0, 6 do c("Coil", 0.004, 0.05, -0.02 + i * 0.007, 0, 0, "x", col, MAT.metal, 0.1) end
	elseif kind == "pulley" then c("Pulley", 0.03, 0.1, 0, 0, 0, "x", C.alu, MAT.metal, 0.15)
	elseif kind == "belt" then
		for i = 0, 19 do local a = i / 20 * math.pi * 2; K.part("BeltSeg", "box", Vector3.new(0.018, 0.012, 0.035), K.at(x, y + math.sin(a) * 0.05, z + math.cos(a) * 0.2) * CFrame.Angles(-a, 0, 0), (v.blim or 7) > 7 and Color3.fromRGB(232, 118, 44) or C.black, MAT.plastic) end
	elseif kind == "clutch" then
		c("ClutchPlate", 0.02, 0.1, 0, 0, 0, "x", C.dark, MAT.metal)
		for i = 0, 2 do local a = i * 2 * math.pi / 3; b("Shoe", 0.02, 0.025, 0.04, 0.005, math.sin(a) * 0.035, math.cos(a) * 0.035, (v.slip or 7500) > 8000 and C.red or Color3.fromRGB(110, 90, 70), MAT.fabric) end
	elseif kind == "bell" then c("Bell", 0.03, 0.115, 0, 0, 0, "x", C.cast, MAT.metal, 0.2)
	elseif kind == "gearbox" then b("Gearbox", 0.12, 0.08, 0.12, 0, 0, 0, C.dark, MAT.metal)
	elseif kind == "plates" then for i = 0, 3 do c("Plate", 0.006, 0.1, i * 0.008, 0, 0, "x", i % 2 == 0 and C.dark or Color3.fromRGB(110, 90, 70), MAT.metal) end
	elseif kind == "sprocket" then c("Sprocket", 0.008, 0.05, 0, 0, 0, "x", C.dark, MAT.metal)
	end
end
Builder.enginePart = enginePart

-- the engine with all mounted parts. map: socket -> {sku, item}. Parts get the attributes Sock/Item (for interaction).
function Builder.engine(parent, originCF, mopId, map, anchored)
	local model = Instance.new("Model"); model.Name = "Engine"
	local root = Instance.new("Part"); root.Name = "EngineRoot"; root.Size = Vector3.new(0.2, 0.2, 0.2); root.Transparency = 1; root.CanCollide = false; root.CanQuery = false
	root.Anchored = anchored ~= false; root.CFrame = originCF; root.Parent = model
	model.PrimaryPart = root
	for _, s in ipairs(Assembly.engineSockets(mopId)) do
		local e = map[s.id]
		if e then
			local pr = Catalog.BY_SKU[e.sku]
			local sub = Instance.new("Model"); sub.Name = "Sock_" .. s.id; sub.Parent = model
			sub:SetAttribute("Sock", s.id); if e.item then sub:SetAttribute("Item", e.item) end
			local K = maker(sub, nil)
			enginePart(K, pr.kind, pr.val, s.pos[1], s.pos[2], s.pos[3], e.data)
			-- place first, weld afterwards (a WeldConstraint locks the offset when it is created)
			for _, p in ipairs(sub:GetDescendants()) do
				if p:IsA("BasePart") then
					p.CFrame = originCF * p.CFrame
					p.CanQuery = true
					p.Anchored = anchored ~= false
					if anchored == false then local w = Instance.new("WeldConstraint"); w.Part0, w.Part1 = root, p; w.Parent = p end
				end
			end
		end
	end
	model.Parent = parent
	return model
end
-- world CFrame for a socket on an engine
function Builder.socketCF(originCF, sock) return originCF * CFrame.new(sock.pos[1] * S, sock.pos[2] * S, -sock.pos[3] * S) end

-- ---------- one loose part (on a shelf, the bench, in the hand, in the shop) ----------
-- returns a Model with a PrimaryPart "Main" (centre) and size info. item: {s, paint, port}
function Builder.item(sku, item)
	local pr = Catalog.BY_SKU[sku]
	local model = Instance.new("Model"); model.Name = pr and pr.name or sku
	local K = maker(model, nil)
	local v, kind = pr and pr.val or {}, pr and pr.kind or "?"
	if Catalog.KIND[kind] and Catalog.KIND[kind][2] ~= "Chassi" and kind ~= "panel" and kind ~= "tool" and kind ~= "exh" and kind ~= "radiator" then
		enginePart(K, kind, v, 0, 0, 0, item)
	elseif kind == "panel" then
		local mopId = pr.fits[1]
		local pd = Panels.find(mopId, v.panel)
		local col, mat, refl, tr = Builder.paintLook(item and item.paint, v.look)
		local L = Panels.LOOK[v.look] or {}
		local sc = L.scale or { 1, 1, 1 }
		local size = Vector3.new(pd.size[1] * sc[1], pd.size[2] * sc[2], pd.size[3] * sc[3])
		local p
		if pd.shape == "wedge" then p = K.wedge("Panel", size, CFrame.new(), col, mat, refl)
		else p = K.part("Panel", pd.shape == "ball" and "ball" or "box", size, CFrame.new(), col, mat, refl) end
		p.Transparency = tr
	elseif kind == "wheel" then
		local rc, rm, rr = rimLook(v.rims)
		K.cyl("Tyre", 0.11, 0.34, 0, 0, 0, "x", C.tire, MAT.plastic); K.cyl("Rim", 0.115, 0.22, 0, 0, 0, "x", rc, rm, rr)
	elseif kind == "brake" then K.cyl("Disc", 0.006, 0.2, 0, 0, 0, "x", C.alu, MAT.metal, 0.3); K.box("Caliper", 0.04, 0.05, 0.06, 0.02, 0.08, 0, C.red, MAT.metal)
	elseif kind == "fork" then for _, s in ipairs({ -1, 1 }) do K.cyl("Leg", 0.55, 0.035, s * 0.07, 0, 0, "y", v.upside and C.gold or C.alu, MAT.metal, 0.3) end; K.box("Yoke", 0.2, 0.03, 0.06, 0, 0.25, 0, C.dark, MAT.metal)
	elseif kind == "shock" then K.cyl("Body", 0.3, 0.03, 0, 0, 0, "y", C.dark, MAT.metal); for i = 0, 6 do K.cyl("Spring", 0.006, 0.05, 0, -0.1 + i * 0.03, 0, "y", pr.color == "red" and C.red or C.yellow, MAT.metal) end
	elseif kind == "bars" then K.tube("Bar", { -0.33, v.bars == "high" and 0.06 or 0, 0 }, { 0.33, v.bars == "high" and 0.06 or 0, 0 }, 0.012, C.dark, MAT.metal); for _, s in ipairs({ -1, 1 }) do K.cyl("Grip", 0.1, 0.034, s * 0.3, v.bars == "high" and 0.06 or 0, 0, "x", C.black, MAT.plastic) end
	elseif kind == "seat" then K.box("Seat", 0.28, 0.1, 0.6, 0, 0, 0, C.black, MAT.fabric)
	elseif kind == "tank" then K.box("Tank", 0.24, 0.15, 0.4, 0, 0, 0, C.cast, MAT.metal)
	elseif kind == "frame" then K.tube("Main", { 0, 0.3, 0.4 }, { 0, -0.1, 0 }, 0.025, C.dark, MAT.metal); K.tube("Back", { 0, -0.1, 0 }, { 0, 0.15, -0.6 }, 0.025, C.dark, MAT.metal)
	elseif kind == "exh" then
		local e = Config.EXH[(v.exh or 0) + 1]
		if (v.exh or 0) == 0 then K.cyl("Can", 0.5, 0.11, 0, 0, 0, "z", e.col, MAT.metal, 0.2) else
			local L = 0.8 + e.l * 0.3
			K.cyl("Header", L * 0.3, 0.04, 0, 0, L * 0.35, "z", e.col, MAT.metal, 0.3); K.cyl("Belly", L * 0.4, 0.09 + e.l * 0.03, 0, 0, 0, "z", e.col, MAT.metal, 0.3)
			K.cyl("Stinger", L * 0.3, 0.035, 0, 0, -L * 0.35, "z", e.col, MAT.metal, 0.3)
		end
	elseif kind == "radiator" then K.box("Core", (v.cf or 1) > 1 and 0.32 or 0.26, 0.2, 0.03, 0, 0, 0, C.alu, MAT.alu, 0.1)
	elseif kind == "tool" then Builder.toolModel(K, v.tool, v)
	else K.box("Box", 0.1, 0.1, 0.1, 0, 0, 0, C.dark, MAT.plastic) end
	local cf, size = model:GetBoundingBox()
	local main = Instance.new("Part"); main.Name = "Main"; main.Size = size + Vector3.new(0.05, 0.05, 0.05); main.CFrame = cf; main.Transparency = 1
	main.CanCollide, main.Massless = false, true; main.Parent = model
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= main then local w = Instance.new("WeldConstraint"); w.Part0, w.Part1 = main, p; w.Parent = p end
	end
	model.PrimaryPart = main
	return model
end

-- tools: grinder, spray gun, wrench set
function Builder.toolModel(K, tool, v)
	if tool == "grinder" then
		K.cyl("Body", 0.16, 0.045, 0, 0, 0, "z", (v and v.steady or 0.6) >= 1 and C.red or Color3.fromRGB(40, 110, 190), MAT.plastic)
		K.cyl("Collet", 0.03, 0.02, 0, 0, 0.095, "z", C.chrome, MAT.metal, 0.4)
		K.cyl("Bit", 0.025, 0.008, 0, 0, 0.12, "z", Color3.fromRGB(150, 150, 150), MAT.metal, 0.2)
		K.cyl("Cord", 0.06, 0.01, 0, 0, -0.11, "z", C.black, MAT.plastic)
	elseif tool == "spray" then
		K.box("GunBody", 0.03, 0.05, 0.12, 0, 0, 0, (v and v.even or 0.7) >= 1 and C.alu or C.cast, MAT.metal, 0.2)
		K.cyl("Cup", 0.08, 0.06, 0, 0.065, -0.02, "y", C.alu, MAT.metal, 0.2)
		K.cyl("Nozzle", 0.03, 0.015, 0, 0.005, 0.07, "z", C.chrome, MAT.metal, 0.4)
		K.box("Handle", 0.025, 0.09, 0.03, 0, -0.06, -0.03, C.black, MAT.plastic, 0, -15, 0, 0)
	else
		K.box("Case", 0.3, 0.06, 0.18, 0, 0, 0, C.red, MAT.plastic)
		for i = 0, 6 do K.cyl("Socket", 0.03, 0.015 + i * 0.002, -0.11 + i * 0.035, 0.035, 0.03, "y", C.chrome, MAT.metal, 0.4) end
	end
end

-- first-person hand (glove) with a tool in its grip. Returns the model; PrimaryPart = Grip (where the tool sits).
function Builder.hand(tool, v)
	local model = Instance.new("Model"); model.Name = "Hand"
	local grip = Instance.new("Part"); grip.Name = "Grip"; grip.Size = Vector3.new(0.1, 0.1, 0.1); grip.Transparency = 1; grip.CanCollide = false; grip.CanQuery = false; grip.Anchored = true
	grip.CFrame = CFrame.new(); grip.Parent = model
	local K = maker(model, grip)
	K.box("Palm", 0.085, 0.03, 0.1, 0, 0, -0.06, C.glove, MAT.fabric)
	for i = 0, 3 do
		local x = -0.03 + i * 0.02
		K.box("Finger" .. i, 0.017, 0.017, 0.05, x, 0.012, -0.005, C.glove, MAT.fabric, 0, 25, 0, 0)
		K.box("Tip" .. i, 0.016, 0.016, 0.03, x, 0.025, 0.02, C.glove, MAT.fabric, 0, 70, 0, 0)
	end
	K.box("Thumb", 0.02, 0.02, 0.05, -0.05, -0.005, -0.03, C.glove, MAT.fabric, 0, 0, 30, -20)
	K.cyl("Wrist", 0.08, 0.06, 0, -0.01, -0.13, "z", C.glove, MAT.fabric)
	K.cyl("Sleeve", 0.2, 0.075, 0, -0.015, -0.27, "z", Color3.fromRGB(30, 60, 110), MAT.fabric)
	if tool then Builder.toolModel(K, tool, v) end
	for _, p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then p.CanQuery = false; p.CastShadow = false end end
	model.PrimaryPart = grip
	return model
end

-- ---------- moped from mounted parts ----------
-- view: { mopId, ch = {slot -> {sku, item, data}}, eng = {socket -> {...}} or nil (engine on the stand), num }
function Builder.moped(view)
	local mop = Config.BY_ID[view.mopId]
	local model = Instance.new("Model"); model.Name = "Moped_" .. mop.id
	local wr, wb, z0 = mop.wr, mop.wb, mop.wb / 2
	local s = wb / 1.2
	local root = Instance.new("Part"); root.Name = "Root"; root.Size = Vector3.new(0.35 * S, 0.3 * S, wb * 0.8 * S); root.CFrame = CFrame.new(0, (wr + 0.15) * S, 0)
	root.Transparency = 1; root.CanCollide = false; root.CanQuery = false
	root.CustomPhysicalProperties = PhysicalProperties.new(10, 0.3, 0, 1, 1); root.Parent = model
	model.PrimaryPart = root
	local K = maker(model, root)
	local ch = view.ch
	local isDt = mop.id == "dt"
	local function tag(inst, sock) inst:SetAttribute("Sock", sock); if ch[sock] and ch[sock].item then inst:SetAttribute("Item", ch[sock].item) end end
	local function group(sock) local g = Instance.new("Model"); g.Name = "Slot_" .. sock; g.Parent = model; tag(g, sock); return g end
	local function into(g, fn) local before = {}; for _, c in ipairs(model:GetChildren()) do before[c] = true end; fn(); for _, c in ipairs(model:GetChildren()) do if not before[c] and c:IsA("BasePart") then c.Parent = g; c.CanQuery = true end end end
	-- frame
	if ch.frame then into(group("frame"), function()
		if isDt then
			K.tube("Frame1", { 0, 0.98, 0.43 }, { 0, 0.84, -0.25 }, 0.024, C.dark, MAT.metal, 0.1); K.tube("Frame2", { 0, 0.82, 0.47 }, { 0, 0.3, 0.1 }, 0.022, C.dark, MAT.metal, 0.1)
			for _, x in ipairs({ -1, 1 }) do K.tube("Rail", { x * 0.08, 0.82, -0.25 }, { x * 0.1, 0.74, -0.75 }, 0.014, C.dark, MAT.metal, 0.1) end
		else
			K.tube("Spine", { 0, 0.85, 0.42 * s }, { 0, 0.24, 0.3 * s }, 0.025, C.dark, MAT.metal); K.tube("Floor", { 0, 0.24, 0.3 * s }, { 0, 0.24, -0.15 * s }, 0.025, C.dark, MAT.metal)
			K.tube("Rear", { 0, 0.24, -0.15 * s }, { 0, 0.55, -0.62 * s }, 0.025, C.dark, MAT.metal)
			K.box("RearBody", 0.26, 0.22, 0.55 * s, 0, 0.48, -0.33 * s, Color3.fromRGB(45, 47, 52), MAT.plastic)
		end
	end) end
	-- fork + front wheel + brake
	if ch.fork then into(group("fork"), function()
		for _, x in ipairs({ -1, 1 }) do
			if isDt then K.tube("ForkUp", { x * 0.075, 1.02, 0.4 }, { x * 0.075, 0.62, 0.56 }, 0.022, C.chrome, MAT.metal, 0.4); K.tube("ForkLo", { x * 0.075, 0.66, 0.545 }, { x * 0.075, wr, z0 }, 0.028, C.black, MAT.plastic)
			else K.tube("Fork", { x * 0.07, wr, z0 }, { x * 0.07, 0.75, 0.42 * s }, 0.022, C.dark, MAT.metal, 0.1) end
		end
	end) end
	local spins = {}
	local function wheel(sock, z, width)
		local w = ch[sock]
		if not w then return nil end
		local g = group(sock)
		local rc, rm, rr = rimLook(Catalog.BY_SKU[w.sku].val.rims)
		local tyre
		into(g, function()
			tyre = K.cyl(sock .. "Tyre", width, wr * 2, 0, wr, z, "x", C.tire, MAT.plastic)
			K.cyl(sock .. "Rim", width * 1.05, wr * 1.25, 0, wr, z, "x", rc, rm, rr)
			K.cyl(sock .. "Hub", width * 1.2, wr * 0.35, 0, wr, z, "x", C.alu, MAT.metal, 0.2)
		end)
		tyre.CanCollide = true; tyre.CanQuery = true; tyre.Massless = false
		tyre.CustomPhysicalProperties = PhysicalProperties.new(3, 0.05, 0, 1, 1)
		for i = 0, 2 do
			local sw = K.spin(sock .. "Spoke", Vector3.new(width * 1.1, wr * 1.2, 0.025), K.at(0, wr, z) * CFrame.Angles(i * math.pi / 3, 0, 0), rc, rm, rr)
			sw.Part1.Parent = g
			table.insert(spins, sw)
		end
		return tyre
	end
	local fw = wheel("wheelF", z0, isDt and 0.09 or 0.11)
	local rw = wheel("wheelR", -z0, isDt and 0.1 or 0.12)
	for _, b in ipairs({ { "brakeF", z0 }, { "brakeR", -z0 } }) do
		if ch[b[1]] then into(group(b[1]), function() K.cyl("Disc", 0.006, 0.19, 0.06, wr, b[2], "x", C.alu, MAT.metal, 0.3); K.box("Caliper", 0.03, 0.05, 0.06, 0.075, wr + 0.08, b[2] - 0.04, C.red, MAT.metal) end) end
	end
	if ch.shock then into(group("shock"), function()
		if isDt then for _, x in ipairs({ -1, 1 }) do K.tube("Shock", { x * 0.09, 0.3, -0.5 }, { x * 0.1, 0.78, -0.52 }, 0.022, ch.shock.sku == "P-shock-gas" and C.red or C.yellow, MAT.metal, 0.1) end
		else K.tube("Shock", { 0.12, 0.55, -0.6 * s }, { 0.12, 0.28, -0.72 * s }, 0.025, ch.shock.sku == "P-shock-gas" and C.red or C.yellow, MAT.metal, 0.1) end
	end) end
	if ch.bars then into(group("bars"), function()
		local hb = Catalog.BY_SKU[ch.bars.sku].val.bars == "high"
		local by = isDt and (1.08 + (hb and 0.07 or 0)) or 1.07
		local bz = isDt and 0.38 or 0.38 * s
		local bw = hb and 0.74 or 0.64
		K.tube("Bar", { -bw / 2, by, bz }, { bw / 2, by, bz }, 0.012, hb and C.alu or C.chrome, MAT.metal, 0.3)
		for _, x in ipairs({ -1, 1 }) do K.cyl("Grip", 0.1, 0.034, x * (bw / 2 - 0.04), by, bz, "x", C.black, MAT.plastic) end
		for _, x in ipairs({ -1, 1 }) do K.tube("Mirror", { x * bw * 0.4, by, bz }, { x * bw * 0.44, by + 0.22, bz - 0.03 }, 0.006, C.black, MAT.metal); K.part("MirrorHead", "ball", Vector3.new(0.1, 0.07, 0.04), K.at(x * bw * 0.45, by + 0.25, bz - 0.04), C.black, MAT.metal) end
	end) end
	if ch.seat then into(group("seat"), function() K.box("Seat", isDt and 0.22 or 0.28, isDt and 0.08 or 0.1, isDt and 0.62 or 0.6 * s, 0, isDt and 0.9 or 0.72, isDt and -0.36 or -0.3 * s, C.black, MAT.fabric, 0, 3) end) end
	if ch.tank then into(group("tank"), function() K.box("Tank", 0.24, 0.13, 0.4, 0, 0.88, 0.13, C.cast, MAT.metal, 0.05, -9) end) end
	if ch.radiator then into(group("radiator"), function() K.box("Radiator", 0.3, 0.22, 0.03, 0, 0.62, 0.36 * s, C.alu, MAT.alu, 0.1, 15) end) end
	if ch.exh then into(group("exh"), function()
		local e = Config.EXH[(Catalog.BY_SKU[ch.exh.sku].val.exh or 0) + 1]
		if isDt then
			local R = 0.035 + e.l * 0.035
			K.tube("ExhA", { 0, 0.47, 0.22 }, { 0.02, 0.3, 0.32 }, 0.022, e.col, MAT.metal, 0.3); K.tube("ExhB", { 0.02, 0.3, 0.32 }, { 0.1, 0.2, 0.15 }, R * 0.8, e.col, MAT.metal, 0.3)
			K.tube("ExhC", { 0.1, 0.2, 0.15 }, { 0.15, 0.4, -0.3 }, R, e.col, MAT.metal, 0.3); K.tube("ExhD", { 0.15, 0.4, -0.3 }, { 0.15, 0.6, -0.55 }, R * 0.6, e.col, MAT.metal, 0.3)
			K.tube("Silencer", { 0.15, 0.6, -0.55 }, { 0.15, 0.7, -0.8 }, 0.03, C.black, MAT.metal)
		else
			local L = 0.7 + e.l * 0.5
			K.tube("Exhaust", { 0.19, 0.15, 0.04 }, { 0.2, 0.22, 0.04 - L }, 0.05 + e.l * 0.02, e.col, MAT.metal, 0.3)
		end
	end) end
	-- engine (when it sits in the moped)
	if view.eng then
		local eo = isDt and K.at(0, 0.32, 0.02) or K.at(0.04, 0.26, -0.38 * s)
		local eng = Builder.engine(model, root.CFrame * eo, mop.id, view.eng, false)
		local er = eng.PrimaryPart
		er.Anchored, er.Massless = false, true
		local ew = Instance.new("WeldConstraint"); ew.Part0, ew.Part1 = root, er; ew.Parent = er
		eng:SetAttribute("Sock", "engine")
	end
	-- body panels: each its own part with its own colour
	for _, pd in ipairs(Panels[mop.id]) do
		local e = ch["pan:" .. pd.id]
		if e then
			local pr = Catalog.BY_SKU[e.sku]
			local L = Panels.LOOK[pr.val.look] or {}
			local sc = L.scale or { 1, 1, 1 }
			local col, mat, refl, tr = Builder.paintLook(e.data and e.data.paint, pr.val.look)
			local rot = pd.rot or { 0, 0, 0 }
			local cf = K.at(pd.pos[1], pd.pos[2], pd.pos[3]) * CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
			local size = Vector3.new(pd.size[1] * sc[1], pd.size[2] * sc[2], pd.size[3] * sc[3])
			local p = pd.shape == "wedge" and K.wedge("Panel_" .. pd.id, size, cf, col, mat, refl) or K.part("Panel_" .. pd.id, pd.shape == "ball" and "ball" or "box", size, cf, col, mat, refl)
			p.Transparency = tr; p.CanQuery = true
			tag(p, "pan:" .. pd.id)
		else
			-- visible fixing points where the panel is missing
			for _, dx in ipairs({ -0.3, 0.3 }) do
				K.cyl("Bolt", 0.012, 0.012, pd.pos[1] + (pd.size[1] > 0.1 and dx * pd.size[1] or 0), pd.pos[2], pd.pos[3] + (pd.size[1] <= 0.1 and dx * pd.size[3] or 0), "x", C.chrome, MAT.metal, 0.4)
			end
		end
	end
	-- lights, smoke and references for the client (only when the frame is there)
	if ch.frame then
		local hl = K.attach("HeadlightAtt", 0, isDt and 0.9 or 0.98, isDt and 0.6 or 0.7 * s)
		local spot = Instance.new("SpotLight"); spot.Name = "Headlight"; spot.Face = Enum.NormalId.Front; spot.Angle = 55; spot.Range = 45; spot.Brightness = 2.4; spot.Color = Color3.fromRGB(255, 240, 210); spot.Shadows = true; spot.Parent = hl
		K.part("Lamp", "ball", Vector3.new(0.1, 0.08, 0.05), K.at(0, isDt and 0.9 or 0.98, isDt and 0.58 or 0.6 * s), C.lamp, MAT.neon)
		local tl = K.attach("TailAtt", 0, isDt and 0.92 or 0.55, isDt and -1.1 or -0.7 * s)
		local pl = Instance.new("PointLight"); pl.Color = Color3.fromRGB(255, 40, 40); pl.Range = 6; pl.Brightness = 1.2; pl.Parent = tl
		K.box("TailLight", 0.12, 0.05, 0.03, 0, isDt and 0.92 or 0.55, isDt and -1.08 or -0.68 * s, C.red, MAT.neon)
	end
	local ex = isDt and K.attach("ExhaustAtt", 0.15, 0.72, -0.85) or K.attach("ExhaustAtt", 0.2, 0.22, -0.9)
	local pe = Instance.new("ParticleEmitter"); pe.Name = "Smoke"; pe.Texture = "rbxasset://textures/particles/smoke_main.dds"; pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.6, 1.4); pe.Speed = NumberRange.new(2, 4); pe.SpreadAngle = Vector2.new(12, 12); pe.EmissionDirection = Enum.NormalId.Back
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 2.2) }); pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	pe.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205)); pe.Parent = ex
	if ch.seat then
		local seat = Instance.new("Seat"); seat.Name = "Seat"; seat.Size = Vector3.new(0.3 * S, 0.1 * S, 0.4 * S)
		seat.CFrame = CFrame.new(0, (isDt and 0.95 or 0.77) * S, (isDt and 0.36 or 0.3 * s) * S); seat.Transparency = 1; seat.CanCollide = false; seat.Massless = true; seat.Parent = model
		local sw = Instance.new("WeldConstraint"); sw.Part0, sw.Part1 = root, seat; sw.Parent = seat
	end
	local refs = Instance.new("Folder"); refs.Name = "Refs"; refs.Parent = model
	for i, w in ipairs(spins) do local o = Instance.new("ObjectValue"); o.Name = "Spin" .. i; o.Value = w; o.Parent = refs end
	if fw then local o = Instance.new("ObjectValue"); o.Name = "FW"; o.Value = fw; o.Parent = refs end
	if rw then local o = Instance.new("ObjectValue"); o.Name = "RW"; o.Value = rw; o.Parent = refs end
	model:SetAttribute("Moped", mop.id)
	return model
end

return Builder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Catalog</string><ProtectedString name="Source"><![CDATA[-- Parts catalogue for Moppelagret.se (the in-game web shop). Made-up brands and game prices – no real
-- trademarks or logos. Each product has a kind that decides where it fits (engine socket or moped slot).
local Config = require(script.Parent.Config)
local Catalog = {}

Catalog.CATS = { "Cylindrar", "Vevpartier", "Motordelar", "Förgasare", "Insug", "Luftfilter", "Avgassystem", "Variatorer", "Kopplingar", "Tändsystem", "Chassi", "Kåpor", "Styling", "Verktyg" }
Catalog.BRANDS = { "Fartek", "Nordtrim", "Vippa", "Bruksmek", "Kylstad", "Snabbo", "Origo" } -- Origo = original part

-- kinds: what sort of part it is and in which category it is sold
Catalog.KIND = {
	case = { "Vevhus", "Motordelar" }, crank = { "Vevaxel", "Vevpartier" }, bearing = { "Vevlager", "Motordelar" }, seal = { "Packbox", "Motordelar" },
	needle = { "Nållager", "Motordelar" }, piston = { "Kolv", "Cylindrar" }, rings = { "Kolvringar", "Cylindrar" }, pin = { "Kolvbult", "Cylindrar" },
	gasket = { "Cylinderfotspackning", "Motordelar" }, cyl = { "Cylinder", "Cylindrar" }, head = { "Topplock", "Cylindrar" }, plug = { "Tändstift", "Tändsystem" },
	reed = { "Reedventil", "Insug" }, intake = { "Insug", "Insug" }, carb = { "Förgasare", "Förgasare" }, filter = { "Luftfilter", "Luftfilter" }, hose = { "Bränsleslang", "Insug" },
	stator = { "Stator", "Tändsystem" }, flywheel = { "Svänghjul", "Tändsystem" }, fan = { "Fläkt", "Motordelar" }, coil = { "Tändspole", "Tändsystem" }, cdi = { "CDI", "Tändsystem" }, cable = { "Tändkabel", "Tändsystem" },
	weights = { "Variatorvikter", "Variatorer" }, var = { "Variator", "Variatorer" }, contra = { "Kontrafjäder", "Kopplingar" }, pulley = { "Bakre remskiva", "Kopplingar" },
	belt = { "Rem", "Variatorer" }, clutch = { "Koppling", "Kopplingar" }, bell = { "Kopplingsklocka", "Kopplingar" },
	gearbox = { "Växellåda", "Motordelar" }, plates = { "Kopplingslameller", "Kopplingar" }, sprocket = { "Drev", "Kopplingar" },
	frame = { "Ram", "Chassi" }, fork = { "Framgaffel", "Chassi" }, shock = { "Bakdämpare", "Chassi" }, wheel = { "Hjul", "Chassi" }, brake = { "Broms", "Chassi" },
	bars = { "Styre", "Chassi" }, seat = { "Sadel", "Chassi" }, tank = { "Tank", "Chassi" }, exh = { "Avgassystem", "Avgassystem" }, radiator = { "Kylare", "Chassi" },
	panel = { "Kåpa", "Kåpor" }, tool = { "Verktyg", "Verktyg" },
}

local PR, BY, OEM = {}, {}, { jog = {}, rok = {}, dt = {} }
Catalog.PR, Catalog.BY_SKU = PR, BY
local ALL, CVT = { "jog", "rok", "dt" }, { "jog", "rok" }
local function has(t, x) for _, v in ipairs(t) do if v == x then return true end end return false end
Catalog.has = has
local function fmt(n)
	local s = tostring(math.floor(n))
	return (s:reverse():gsub("(%d%d%d)", "%1 "):reverse():gsub("^ ", ""))
end
Catalog.fmt = fmt

-- stock is fixed per product (shown in the shop): "I lager", "Få kvar" or "Beställningsvara" (+2 min delivery)
local STOCK = { "I lager", "I lager", "I lager", "Få kvar", "Beställningsvara" }
local n = 0
local function add(kind, v, name, man, price, val, fits, desc, oemFor, extra)
	n = n + 1
	local sku = "P-" .. kind .. "-" .. v
	local p = { sku = sku, kind = kind, name = name, man = man, cat = Catalog.KIND[kind][2], price = price, val = val or {}, fits = fits, desc = desc,
		stock = STOCK[(n * 7) % #STOCK + 1] }
	for k, x in pairs(extra or {}) do p[k] = x end
	table.insert(PR, p)
	BY[sku] = p
	for _, f in ipairs(oemFor or {}) do OEM[f][kind] = OEM[f][kind] or sku end
	return p
end

-- ---------- engine ----------
add("case", "std", "Vevhus original", "Origo", 1400, {}, ALL, "Motorns grund. Allt annat monteras på vevhuset.", ALL)
add("crank", "std", "Vevaxel original", "Origo", 900, { crankf = 1 }, ALL, "Originalvevaxel med vevstake.", ALL)
add("crank", "race", "Vevaxel race (långslag)", "Fartek", 1650, { crankf = 1.05 }, ALL, "Tål högre varv. +5 % vridmoment i spelet.", {})
add("bearing", "std", "Vevlager 6204 (par)", "Origo", 180, {}, ALL, "Två kullager till vevaxeln.", ALL)
add("bearing", "c3", "Vevlager C3 (par)", "Nordtrim", 260, {}, ALL, "Lager med större glapp för varma motorer.", {})
add("seal", "std", "Packboxar (par)", "Origo", 90, {}, ALL, "Tätar vevhuset mot vevaxeln.", ALL)
add("needle", "std", "Nållager vevstake", "Origo", 110, {}, ALL, "Lagret i vevstakens lilla ände.", ALL)
add("gasket", "std", "Cylinderfotspackning", "Origo", 40, {}, ALL, "Tätar mellan cylinder och vevhus.", ALL)
add("plug", "std", "Tändstift standard", "Origo", 60, {}, ALL, "Normalt värmetal.", ALL)
add("plug", "cold", "Tändstift kallt", "Snabbo", 90, {}, ALL, "Kallare stift för trimmade motorer.", {})
-- cylinder kits: cylinder + piston + rings + pin in the same set
for i, k in ipairs(Config.KITS) do
	local v = ({ "std", "sport", "race" })[i]
	local man = ({ "Origo", "Fartek", "Nordtrim" })[i]
	local price = ({ 1200, 1900, 2900 })[i]
	add("cyl", v, "Cylinder " .. k.n, man, price, { kit = i - 1 }, ALL, k.cc .. " cc. Kan portas på portningsbänken.", i == 1 and ALL or {}, { hasPort = true })
	add("piston", v, "Kolv " .. k.cc .. " cc" .. (i > 1 and " (" .. v .. ")" or ""), man, math.floor(price * 0.2), { bore = k.cc }, ALL, "Måste passa cylindern.", i == 1 and ALL or {})
	add("rings", v, "Kolvringar " .. k.cc .. " cc", man, 120, { bore = k.cc }, ALL, "Två ringar till kolven.", i == 1 and ALL or {})
end
add("pin", "std", "Kolvbult 12 mm", "Origo", 60, {}, ALL, "Håller kolven på vevstaken.", ALL)
add("head", "std", "Topplock original", "Origo", 500, { cf = 1 }, ALL, "Originaltopplock.", ALL)
add("head", "fins", "Topplock storflänsat", "Kylstad", 900, { cf = 1.25 }, { "jog", "dt" }, "25 % bättre luftkylning.", {})
-- intake and fuel
add("reed", "std", "Reedventil original", "Origo", 300, { reedf = 1 }, ALL, "Backventil i insuget.", ALL)
add("reed", "carbon", "Reedventil kolfiber", "Snabbo", 650, { reedf = 1.03 }, ALL, "Snabbare blad: +3 % vridmoment i spelet.", {})
add("intake", "std", "Insug original (upp till 19 mm)", "Origo", 200, { maxd = 19 }, ALL, "Förgasare över 19 mm stryps.", ALL)
add("intake", "big", "Insug stort (upp till 24 mm)", "Nordtrim", 450, { maxd = 24 }, ALL, "Fullt flöde upp till 24 mm.", {})
for i, d in ipairs(Config.CARB) do
	add("carb", tostring(d), "Förgasare " .. d .. " mm", i > 3 and "Fartek" or "Vippa", ({ 500, 700, 900, 1300, 1700 })[i], { carb = i - 1 }, ALL, "Mer luft vid höga varv.", ({ { "jog" }, { "rok", "dt" } })[i])
end
add("filter", "std", "Luftfilter original", "Origo", 150, { fcap = 1 }, ALL, "Originalfilter.", ALL)
add("filter", "sport", "Luftfilter sport", "Vippa", 350, { fcap = 1.12 }, ALL, "12 % mer luft, blandningen blir magrare.", {})
add("hose", "std", "Bränsleslang 5 mm", "Origo", 40, {}, ALL, "Från kranen till förgasaren.", ALL)
-- ignition
add("stator", "std", "Stator", "Origo", 450, {}, ALL, "Laddspolar och tändpuls.", ALL)
add("flywheel", "std", "Svänghjul original", "Origo", 600, {}, ALL, "Svänghjul med magneter.", ALL)
add("fan", "std", "Fläkt", "Origo", 120, {}, { "jog", "rok" }, "Kyler motorn (sitter på svänghjulet).", { "jog", "rok" })
add("coil", "std", "Tändspole", "Origo", 300, {}, ALL, "Ger högspänning till stiftet.", ALL)
add("cdi", "std", "CDI original (spärr 11 000)", "Origo", 600, { icap = 11000 }, ALL, "Varvspärr 11 000 rpm.", ALL)
add("cdi", "sport", "CDI sport (spärr 14 000)", "Fartek", 1300, { icap = 14000 }, ALL, "Varvspärr 14 000 rpm.", {})
add("cable", "std", "Tändkabel med hatt", "Origo", 80, {}, ALL, "Från spolen till tändstiftet.", ALL)
-- transmission (CVT)
for i, g in ipairs({ 5, 6, 7, 8, 9, 10, 11, 12 }) do
	add("weights", tostring(g), "Variatorvikter " .. g .. " g (6 st)", "Vippa", 120, { roller = g }, CVT, "Lättare vikter = högre varv.", g == 10 and { "jog" } or g == 9 and { "rok" } or {})
end
add("var", "std", "Variator original", "Origo", 600, { rmin = 0.85 }, CVT, "Högsta utväxling 0,85:1.", CVT)
add("var", "sport", "Variator sport", "Nordtrim", 1100, { rmin = 0.78 }, CVT, "Högsta utväxling 0,78:1, högre toppfart.", {})
add("var", "race", "Variator race", "Fartek", 1600, { rmin = 0.72 }, CVT, "Högsta utväxling 0,72:1.", {})
add("contra", "std", "Kontrafjäder original", "Origo", 150, { cdt = 0 }, CVT, "Originalfjäder.", CVT)
add("contra", "15", "Kontrafjäder +15 %", "Nordtrim", 200, { cdt = 400 }, CVT, "Variatorn håller 400 rpm högre.", {})
add("contra", "30", "Kontrafjäder +30 %", "Nordtrim", 250, { cdt = 800 }, CVT, "Variatorn håller 800 rpm högre.", {})
add("pulley", "std", "Bakre remskiva", "Origo", 500, {}, CVT, "Sekundärsidan av variatorn.", CVT)
add("belt", "std", "Rem original", "Origo", 300, { blim = 7 }, CVT, "Slirar över ca 7 hk.", CVT)
add("belt", "kevlar", "Rem förstärkt", "Bruksmek", 550, { blim = 15 }, CVT, "Slirar över ca 15 hk.", {})
add("clutch", "std", "Koppling original", "Origo", 450, { slip = 7500 }, CVT, "Slirar till ca 7 500 rpm.", CVT)
add("clutch", "sport", "Koppling sport", "Fartek", 750, { slip = 9000 }, CVT, "Slirar till ca 9 000 rpm.", {})
add("clutch", "race", "Koppling race", "Fartek", 950, { slip = 10500 }, CVT, "Slirar till ca 10 500 rpm.", {})
add("bell", "std", "Kopplingsklocka", "Origo", 350, {}, CVT, "Kopplingen griper mot klockan.", CVT)
-- transmission (geared DT)
add("gearbox", "std", "Växellåda 4 växlar", "Origo", 1800, {}, { "dt" }, "Sitter i vevhuset.", { "dt" })
add("plates", "std", "Kopplingslameller", "Origo", 400, { slip = 0 }, { "dt" }, "Våtkoppling.", { "dt" })
add("sprocket", "std", "Drev 12 tänder", "Origo", 150, {}, { "dt" }, "Driver kedjan.", { "dt" })
-- ---------- moped (chassis) ----------
add("frame", "std", "Ram", "Origo", 2500, {}, ALL, "Mopedens stomme.", ALL)
add("fork", "std", "Framgaffel original", "Origo", 1200, {}, ALL, "", ALL)
add("fork", "upside", "Framgaffel upside-down", "Snabbo", 2600, {}, ALL, "Stelare framvagn.", {})
add("shock", "std", "Bakdämpare original", "Origo", 500, {}, ALL, "", ALL)
add("shock", "gas", "Bakdämpare gas, röd fjäder", "Snabbo", 950, {}, ALL, "Syns med röd fjäder.", {}, { color = "red" })
add("wheel", "std", "Hjul original", "Origo", 900, { rims = "std" }, ALL, "Fälg med däck.", ALL)
add("wheel", "pol", "Hjul polerade", "Bruksmek", 1400, { rims = "pol" }, ALL, "Spegelblanka fälgar.", {})
add("wheel", "gold", "Hjul guld", "Nordtrim", 1300, { rims = "gold" }, ALL, "Guldfärgade fälgar.", {})
add("brake", "std", "Skivbroms", "Origo", 400, {}, ALL, "Skiva och ok.", ALL)
add("bars", "std", "Styre original", "Origo", 300, { bars = "std" }, ALL, "", ALL)
add("bars", "high", "Crossstyre högt", "Nordtrim", 550, { bars = "high" }, { "dt" }, "", {})
add("seat", "std", "Sadel original", "Origo", 600, {}, ALL, "", ALL)
add("tank", "std", "Tank", "Origo", 900, {}, { "dt" }, "", { "dt" })
for i, e in ipairs(Config.EXH) do
	add("exh", tostring(i - 1), "Avgassystem " .. e.n, ({ "Origo", "Bruksmek", "Fartek", "Nordtrim", "Fartek" })[i], ({ 900, 1400, 1900, 2400, 3200 })[i], { exh = i - 1 }, ALL,
		"Inställt för ca " .. e.t .. " varv.", i == 1 and ALL or {})
end
add("radiator", "std", "Kylare original", "Origo", 700, { cf = 1 }, { "rok" }, "Kyler kylvätskan.", { "rok" })
add("radiator", "big", "Kylare stor", "Kylstad", 1300, { cf = 1.25 }, { "rok" }, "25 % bättre kylning.", {})
-- ---------- tools ----------
add("tool", "basic", "Hylsnyckelsats och skruvdragare", "Bruksmek", 0, { tool = "basic" }, ALL, "Behövs för att montera. Följer med garaget.", {})
add("tool", "grinder", "Rak slipmaskin", "Bruksmek", 900, { tool = "grinder", steady = 0.6 }, ALL, "Behövs för att porta cylindrar.", {})
add("tool", "grinderpro", "Rak slipmaskin proffs", "Fartek", 2400, { tool = "grinder", steady = 1 }, ALL, "Lugnare verktyg: mer precision vid portning.", {})
add("tool", "spray", "Sprutpistol", "Bruksmek", 700, { tool = "spray", even = 0.7 }, ALL, "Behövs för att lackera.", {})
add("tool", "spraypro", "Sprutpistol HVLP", "Vippa", 1900, { tool = "spray", even = 1 }, ALL, "Jämnare sprutbild: bättre lack.", {})

-- ---------- body panels: one product per panel and variant, per model (see Panels.lua) ----------
local Panels = require(script.Parent.Panels)
for _, m in ipairs(Config.MOPEDS) do
	for _, pd in ipairs(Panels[m.id]) do
		add("panel", m.id .. "-" .. pd.id, pd.n .. " – " .. m.n, "Origo", pd.price, { panel = pd.id, look = "std" }, { m.id }, "Originalkåpa.", { m.id }, { panel = pd.id })
		for _, alt in ipairs(pd.alts or {}) do
			add("panel", m.id .. "-" .. pd.id .. "-" .. alt[1], pd.n .. " " .. alt[2] .. " – " .. m.n, alt[3], alt[4], { panel = pd.id, look = alt[1] }, { m.id }, alt[5], {}, { panel = pd.id })
		end
	end
end
-- OEM panels are keyed by panel id (several panels share kind "panel")
Catalog.OEM_PANEL = {}
for _, m in ipairs(Config.MOPEDS) do
	Catalog.OEM_PANEL[m.id] = {}
	for _, pd in ipairs(Panels[m.id]) do Catalog.OEM_PANEL[m.id][pd.id] = "P-panel-" .. m.id .. "-" .. pd.id end
end
Catalog.OEM = OEM

function Catalog.fits(p, mopId) return p ~= nil and has(p.fits, mopId) end
return Catalog
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">ClientState</string><ProtectedString name="Source"><![CDATA[-- Shared state between the client's scripts. Used only on the client.
local function ev() return Instance.new("BindableEvent") end
local ClientState = {
	profile = nil, -- latest profile from the server (incl. _plot, _carry, _out)
	ride = nil, -- riding state (Ride.client)
	mode = nil, -- active work mode: nil | "engine" | "shop" | "port" | "paint" | "styling"
	changed = ev(), toast = ev(),
	openShop = ev(), -- arg: filter (kind/panel) or nil
	openPort = ev(), openPaint = ev(), openStyling = ev(), modeEnded = ev(),
}
function ClientState.setMode(m) ClientState.mode = m end
return ClientState
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Moppe Garage (Roblox): all data in one place. Same values as the web version (moppe/index.html).
-- Numbers are game tuning values, not measured data.
local Config = {}

Config.KITS = {
	{ n = "Original 50 cc", cc = 50, ex = 178, q = 1 },
	{ n = "Sport 70 cc", cc = 70, ex = 184, q = 1.05 },
	{ n = "Race 70 cc", cc = 70, ex = 192, q = 1.08 },
}
Config.EXH = {
	{ n = "Original", t = 7000, w = 3600, g = 0.85, col = Color3.fromRGB(119, 119, 119), l = 0.5 },
	{ n = "Touring", t = 8000, w = 4000, g = 0.92, col = Color3.fromRGB(153, 153, 153), l = 0.6 },
	{ n = "Sport", t = 9500, w = 3300, g = 1, col = Color3.fromRGB(204, 204, 204), l = 0.7 },
	{ n = "Mellankammare", t = 10500, w = 2800, g = 1.04, col = Color3.fromRGB(216, 216, 224), l = 0.85 },
	{ n = "Race-kammare", t = 12000, w = 2100, g = 1.1, col = Color3.fromRGB(176, 160, 144), l = 1 },
}
Config.CARB = { 12, 17.5, 19, 21, 24 }
Config.GEARS = { 3.0, 1.95, 1.45, 1.12 }

-- wb = wheelbase (m), wr = wheel radius (m), fd = final drive. Roblox: 1 stud = 0.28 m (STUD below)
Config.MOPEDS = {
	{ id = "jog", n = "Jogga 50", cvt = true, cool = "air", fan = true, fam = "V-AC", m = 85, wb = 1.2, wr = 0.17, fd = 9.4, price = 6000,
		d = { jet = 58, port = 0, roller = 10, col = Color3.fromRGB(230, 57, 70), seat = Color3.fromRGB(34, 34, 34), num = "7" } },
	{ id = "rok", n = "Aerox 50", cvt = true, cool = "liquid", fan = false, fam = "H-LC", m = 98, wb = 1.3, wr = 0.26, fd = 13, price = 9000,
		d = { jet = 85, port = 0, roller = 9, col = Color3.fromRGB(29, 111, 224), seat = Color3.fromRGB(34, 34, 34), num = "27" } },
	{ id = "dt", n = "Enduro DT 50", cvt = false, cool = "air", fan = false, fam = "G-AC", m = 80, wb = 1.3, wr = 0.22, fd = 12.8, price = 8000,
		d = { jet = 85, port = 0, roller = 9, col = Color3.fromRGB(244, 194, 13), seat = Color3.fromRGB(34, 34, 34), num = "3" } },
}
Config.BY_ID = {}
for _, m in ipairs(Config.MOPEDS) do Config.BY_ID[m.id] = m end

Config.FAM = { ["V-AC"] = "Vertikal luftkyld skotermotor", ["H-LC"] = "Horisontell vätskekyld skotermotor", ["G-AC"] = "Växlad luftkyld motor" }

-- player garages (metres): 6 plots in a row along an industrial street, doors towards -Z
Config.PLOTS = {}
for i = 1, 6 do Config.PLOTS[i] = { x = (i - 3.5) * 32, z = 0 } end
Config.STREET_Z = -16 -- the street in front of the garages
Config.PAINT_DRY = 20 -- seconds before freshly painted parts can be fitted
Config.STUD = 0.28 -- meter per stud (Roblox character ≈ 5 studs ≈ 1.4–1.8 m)
Config.AMB = 15 -- outside temperature, °C (assumed)

-- economy (in-game kronor, not real prices)
Config.ECON = {
	start = 4000,
	distKr = 5, distM = 100, -- 5 kr per 100 m with the engine running
	cleanKr = 40, cleanM = 2000, -- 40 kr per 2 km without crash/overheating
	crashKr = 50,
	mopSell = 0.6,
	maxSpeed = 40, -- m/s, faster movement than this is not paid (anti-cheat)
}
-- wheelie: rewards with diminishing returns, cap per minute
Config.WHEELIE = { h = { jog = 0.55, rok = 0.55, dt = 0.65 }, fr = 0.45, back = 0.2, pull = 400, pullT = 0.3, damp = 2.5, over = 0.14,
	minV = 8 / 3.6, minT = 0.5, max = 200, tau = 5, rate = 400 }

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Delivery</string><ProtectedString name="Source"><![CDATA[-- Delivery times for Moppelagret.se. Small orders about 1 minute, medium 3–5 minutes, large 10 minutes.
-- Backordered items (stock "Beställningsvara") add 2 minutes.
local Catalog = require(script.Parent.Catalog)
local Delivery = {}
function Delivery.seconds(lines)
	local n, back = 0, false
	for _, l in ipairs(lines) do
		n = n + l.q
		local p = Catalog.BY_SKU[l.sku]
		if p and p.stock == "Beställningsvara" then back = true end
	end
	local t
	if n <= 2 then t = 60 elseif n <= 6 then t = 180 + (n - 3) * 30 else t = 600 end
	if back then t = t + 120 end
	return t
end
return Delivery
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[-- Player profile, parts as physical items and the economy (server authoritative, testable without Roblox).
-- Each item has a location: shelf | bench | floor | box:<order> | eng:<moped> (+ sock) | ch:<moped> (+ sock) | booth | portbench | tool.
-- Money only changes via book(), and can never go below 0.
local Config = require(script.Parent.Config)
local Catalog = require(script.Parent.Catalog)
local Assembly = require(script.Parent.Assembly)
local Engine = require(script.Parent.Engine)
local Panels = require(script.Parent.Panels)
local Delivery = require(script.Parent.Delivery)
local Paint = require(script.Parent.Paint)
local Economy = {}
local E = Config.ECON

local function num(x, d, lo, hi) if type(x) ~= "number" or x ~= x or x == math.huge or x == -math.huge then return d end return math.min(hi, math.max(lo, x)) end
local function hex(c) return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
Economy.hex = hex

local function newItem(p, sku, loc, src)
	p.uid = p.uid + 1
	local u = "i" .. p.uid
	p.items[u] = { s = sku, loc = loc, used = false, src = src or "shop" }
	return u
end
Economy.newItem = newItem

local function defaultPaint(m, pd)
	local col = pd.role == "body" and hex(m.d.col) or pd.role == "white" and "#f2f2ee" or "#1a1a1c"
	return { col = col, fin = pd.role == "dark" and "matt" or "gloss", q = 1 }
end

-- a complete original moped: all engine parts, chassis and panels with factory paint
function Economy.buildOEM(p, id)
	local m = Config.BY_ID[id]
	local mp = { own = true, jet = m.d.jet, dmg = 0, eng = {}, ch = {}, engAt = "moped" }
	p.mopeds[id] = mp
	for _, s in ipairs(Assembly.engineSockets(id)) do
		local sku = Catalog.OEM[id][s.kind]
		if sku then local u = newItem(p, sku, "eng:" .. id, "oem"); p.items[u].sock = s.id; mp.eng[s.id] = u end
	end
	for _, s in ipairs(Assembly.chassisSlots(id)) do
		local sku = s.kind == "panel" and Catalog.OEM_PANEL[id][s.panel] or (s.kind ~= "engine" and Catalog.OEM[id][s.kind])
		if sku then
			local u = newItem(p, sku, "ch:" .. id, "oem")
			p.items[u].sock = s.id
			if s.kind == "panel" then p.items[u].paint = defaultPaint(m, Panels.find(id, s.panel)) end
			mp.ch[s.id] = u
		end
	end
	mp.ch.engine = "engine" -- the engine is a unit, not an item
end

function Economy.new()
	local p = { v = 2, money = E.start, uid = 0, items = {}, mopeds = {}, stand = nil, cur = "jog", orders = {}, oid = 0, designs = {},
		stats = { dist = 0, top = 0, wn = 0, best = 0, crash = 0, earned = 0, built = 0, ported = 0, painted = 0 }, paid = 0, clean = 0, cleanPaid = 0, rep = 0, ledger = {} }
	Economy.buildOEM(p, "jog")
	newItem(p, "P-tool-basic", "tool", "start")
	newItem(p, "P-tool-grinder", "tool", "start")
	newItem(p, "P-tool-spray", "tool", "start")
	return p
end

function Economy.book(p, a, text, now)
	a = math.floor(a + 0.5)
	if a == 0 then return 0 end
	p.money = p.money + a
	if a > 0 then p.stats.earned = p.stats.earned + a end
	table.insert(p.ledger, 1, { a = a, x = text, t = now or 0 })
	while #p.ledger > 40 do table.remove(p.ledger) end
	return a
end
function Economy.spend(p, a, text, now)
	a = math.floor(a + 0.5)
	if a < 0 or a > p.money then return false end
	Economy.book(p, -a, text, now)
	return true
end
function Economy.fine(p, a, text, now) return -Economy.book(p, -math.min(math.floor(a + 0.5), p.money), text, now) end

-- maps socket -> sku for the assembly rules
local function skuMap(p, t)
	local o = {}
	for k, u in pairs(t) do if u == "engine" then o[k] = "engine" elseif p.items[u] then o[k] = p.items[u].s end end
	return o
end
Economy.skuMap = skuMap
function Economy.engineMissing(p, id) local mp = p.mopeds[id]; return Assembly.missing(Assembly.engineSockets(id), skuMap(p, mp.eng)) end
function Economy.mopedMissing(p, id)
	local mp = p.mopeds[id]
	local miss = Assembly.missing(Assembly.chassisSlots(id), skuMap(p, mp.ch))
	if mp.engAt ~= "moped" then local has = false; for _, x in ipairs(miss) do if x == "engine" then has = true end end; if not has then table.insert(miss, "engine") end end
	if #Economy.engineMissing(p, id) > 0 then table.insert(miss, "motordelar") end
	return miss
end
function Economy.canRide(p, id) return p.mopeds[id] and p.mopeds[id].own and #Economy.mopedMissing(p, id) == 0 end

function Economy.ecfg(p, id)
	local mp = p.mopeds[id]
	local cyl = mp.eng.cyl and p.items[mp.eng.cyl]
	return Assembly.ecfg(skuMap(p, mp.eng), skuMap(p, mp.ch), mp.jet, cyl and cyl.port)
end
function Economy.engine(p, id)
	local P = Engine.calc(Economy.ecfg(p, id))
	P.cond = 1 - 0.4 * (p.mopeds[id].dmg or 0)
	P.hp = Engine.peakHp(P)
	return P
end

local function hasTool(p, kind)
	local best = nil
	for _, it in pairs(p.items) do
		local pr = Catalog.BY_SKU[it.s]
		if it.loc == "tool" and pr and pr.val.tool == kind then if not best or (pr.val.steady or pr.val.even or 0) > (best.val.steady or best.val.even or 0) then best = pr end end
	end
	return best
end
Economy.hasTool = hasTool

-- ---------- moving parts in the garage ----------
local FREE = { shelf = true, bench = true, floor = true, booth = true, portbench = true }
function Economy.move(p, u, loc)
	local it = p.items[u]
	if not it then return false, "Okänd del" end
	if not FREE[loc] then return false, "Kan inte läggas där" end
	if not (FREE[it.loc] or it.loc:sub(1, 4) == "box:") then return false, "Delen sitter monterad" end
	local pr = Catalog.BY_SKU[it.s]
	if loc == "booth" then
		if pr.kind ~= "panel" then return false, "Bara kåpor kan lackeras" end
		for _, o in pairs(p.items) do if o.loc == "booth" and o ~= it then return false, "Lackboxen är upptagen" end end
	end
	if loc == "portbench" then
		if not pr.hasPort then return false, "Bara cylindrar kan portas" end
		for _, o in pairs(p.items) do if o.loc == "portbench" and o ~= it then return false, "Portningsbänken är upptagen" end end
	end
	it.loc = loc
	it.sock = nil
	return true
end

-- engine parts: only when the engine is on the engine stand
function Economy.mountEngine(p, u, sock)
	local id = p.stand
	if not id then return false, "Ingen motor i motorstativet" end
	local it = p.items[u]
	if not it or not (FREE[it.loc] or it.loc:sub(1, 4) == "box:") then return false, "Delen är inte ledig" end
	if (it.dry or 0) > 0 then return false, "Lacken torkar" end
	if not hasTool(p, "basic") then return false, "Du behöver verktyg" end
	local list = Assembly.engineSockets(id)
	local why = Assembly.canMount(list, skuMap(p, p.mopeds[id].eng), id, sock, it.s)
	if why then return false, why end
	p.mopeds[id].eng[sock] = u
	it.loc, it.sock, it.used = "eng:" .. id, sock, true
	if #Economy.engineMissing(p, id) == 0 then p.stats.built = p.stats.built + 1 end
	return true
end
function Economy.unmountEngine(p, sock, toLoc)
	local id = p.stand
	if not id then return false, "Ingen motor i motorstativet" end
	local mp = p.mopeds[id]
	local why = Assembly.canRemove(Assembly.engineSockets(id), skuMap(p, mp.eng), id, sock)
	if why then return false, why end
	local u = mp.eng[sock]
	mp.eng[sock] = nil
	p.items[u].loc, p.items[u].sock = toLoc or "bench", nil
	return true, nil, u
end
-- moped parts and panels: when the moped is in the garage
function Economy.mountMoped(p, u, id, sock)
	local mp = p.mopeds[id]
	if not mp or not mp.own then return false, "Du äger inte mopeden" end
	local it = p.items[u]
	if not it or not (FREE[it.loc] or it.loc:sub(1, 4) == "box:") then return false, "Delen är inte ledig" end
	if (it.dry or 0) > 0 then return false, "Lacken torkar fortfarande" end
	local why = Assembly.canMount(Assembly.chassisSlots(id), skuMap(p, mp.ch), id, sock, it.s)
	if why then return false, why end
	mp.ch[sock] = u
	it.loc, it.sock, it.used = "ch:" .. id, sock, true
	return true
end
function Economy.unmountMoped(p, id, sock, toLoc)
	local mp = p.mopeds[id]
	if not mp or not mp.own then return false, "Du äger inte mopeden" end
	if sock == "engine" then return false, "Motorn lyfts ur med \"Lyft ur motorn\"" end
	local why = Assembly.canRemove(Assembly.chassisSlots(id), skuMap(p, mp.ch), id, sock)
	if why then return false, why end
	local u = mp.ch[sock]
	mp.ch[sock] = nil
	p.items[u].loc, p.items[u].sock = toLoc or "bench", nil
	return true, nil, u
end
-- the whole engine between the moped and the engine stand
function Economy.engineToStand(p, id)
	local mp = p.mopeds[id]
	if not mp or not mp.own then return false, "Du äger inte mopeden" end
	if p.stand then return false, "Motorstativet är upptaget" end
	if mp.engAt ~= "moped" then return false, "Motorn sitter inte i mopeden" end
	local why = Assembly.canRemove(Assembly.chassisSlots(id), skuMap(p, mp.ch), id, "engine")
	if why then return false, why end
	mp.ch.engine = nil
	mp.engAt = "stand"
	p.stand = id
	return true
end
function Economy.engineToMoped(p)
	local id = p.stand
	if not id then return false, "Ingen motor i stativet" end
	local mp = p.mopeds[id]
	local miss = Economy.engineMissing(p, id)
	if #miss > 0 then return false, "Motorn är inte färdig: " .. table.concat(Assembly.names(Assembly.engineSockets(id), miss, id), ", ") end
	local list = Assembly.chassisSlots(id)
	for _, r in ipairs(Assembly.find(list, "engine").req) do
		if not mp.ch[r] then return false, "Montera " .. Assembly.names(list, { r }, id)[1] .. " på mopeden först" end
	end
	mp.ch.engine = "engine"
	mp.engAt = "moped"
	p.stand = nil
	return true
end

-- ---------- shop: orders, delivery, boxes ----------
function Economy.order(p, lines, now)
	if type(lines) ~= "table" or #lines == 0 then return false, "Kundvagnen är tom" end
	local clean, tot = {}, 0
	for _, l in ipairs(lines) do
		local pr = type(l) == "table" and Catalog.BY_SKU[l.sku]
		local q = type(l) == "table" and math.floor(num(l.q, 1, 1, 10)) or 0
		if not pr then return false, "En produkt finns inte" end
		if pr.kind == "tool" then for _, it in pairs(p.items) do if it.s == pr.sku then return false, "Du har redan " .. pr.name end end end
		tot = tot + pr.price * q
		table.insert(clean, { sku = pr.sku, q = q })
	end
	if #clean > 12 then return false, "Högst 12 olika produkter per beställning" end
	if tot > p.money then return false, "Du har inte råd (" .. Catalog.fmt(tot) .. " kr, du har " .. Catalog.fmt(p.money) .. " kr). Inga pengar drogs." end
	Economy.spend(p, tot, "Beställning hos Moppelagret.se", now)
	p.oid = p.oid + 1
	local o = { id = p.oid, lines = clean, total = tot, t0 = now, eta = now + Delivery.seconds(clean), state = "transit" }
	table.insert(p.orders, 1, o)
	while #p.orders > 20 do table.remove(p.orders) end
	return true, nil, o
end
-- the server calls this regularly: orders whose time is up become a box outside the garage door
function Economy.tick(p, now)
	local arrived = {}
	for _, o in ipairs(p.orders) do
		if o.state == "transit" and now >= o.eta then
			o.state = "arrived"
			for _, l in ipairs(o.lines) do
				local pr = Catalog.BY_SKU[l.sku]
				for _ = 1, l.q do newItem(p, l.sku, pr.kind == "tool" and "tool" or ("box:" .. o.id), "shop") end
			end
			table.insert(arrived, o)
		end
	end
	return arrived
end
-- open the box: the parts are laid out on the floor next to it
function Economy.openBox(p, oid)
	local o
	for _, x in ipairs(p.orders) do if x.id == oid then o = x end end
	if not o or o.state ~= "arrived" then return false, "Ingen låda att öppna" end
	o.state = "opened"
	for _, it in pairs(p.items) do if it.loc == "box:" .. oid then it.loc = "floor" end end
	return true
end

-- ---------- porting and paint ----------
function Economy.applyPort(p, u, res)
	local it = p.items[u]
	if not it or it.loc ~= "portbench" then return false, "Cylindern ligger inte på portningsbänken" end
	if not hasTool(p, "grinder") then return false, "Du behöver en slipmaskin" end
	if it.port then return false, "Cylindern är redan portad" end
	local q, deg = num(res.q, 0, 0, 1), num(res.deg, 0, 0, 4)
	it.port = { q = q, deg = math.floor(deg * 10 + 0.5) / 10, label = tostring(res.label or "") }
	p.stats.ported = p.stats.ported + 1
	return true
end
function Economy.applyPaint(p, u, col, fin, q, now)
	local it = p.items[u]
	if not it or it.loc ~= "booth" then return false, "Kåpan ligger inte i lackboxen" end
	if not hasTool(p, "spray") then return false, "Du behöver en sprutpistol" end
	local pr = Catalog.BY_SKU[it.s]
	if Panels.LOOK[pr.val.look] and Panels.LOOK[pr.val.look].fixed then return false, "Den här kåpan kan inte lackeras" end
	if not Paint.validHex(col) or not Paint.FINISH[fin] then return false, "Ogiltig färg" end
	local cost = 40 + (fin == "pearl" and 60 or fin == "chrome" and 120 or fin == "metal" and 30 or 0)
	if not Economy.spend(p, cost, "Lack, " .. Paint.FINISH[fin], now) then return false, "Du har inte råd med lacken" end
	it.paint = { col = col, fin = fin, q = num(q, 0, 0, 1) }
	it.dry = (now or 0) + Config.PAINT_DRY
	p.stats.painted = p.stats.painted + 1
	return true
end
function Economy.dryTick(p, now) for _, it in pairs(p.items) do if it.dry and now >= it.dry then it.dry = nil end end end

-- designs: the paint of all fitted panels under a name, can be put back later
function Economy.saveDesign(p, id, name)
	name = tostring(name or ""):sub(1, 30)
	if name == "" then return false, "Ge designen ett namn" end
	local d = { moped = id, panels = {} }
	for sock, u in pairs(p.mopeds[id].ch) do
		local it = p.items[u]
		if it and it.paint then d.panels[sock] = { col = it.paint.col, fin = it.paint.fin } end
	end
	p.designs[name] = d
	local n = 0
	for _ in pairs(p.designs) do n = n + 1 end
	if n > 12 then p.designs[name] = nil; return false, "Högst 12 designer" end
	return true
end
function Economy.applyDesign(p, name)
	local d = p.designs[name]
	if not d or not p.mopeds[d.moped] then return false, "Okänd design" end
	for sock, pt in pairs(d.panels) do
		local u = p.mopeds[d.moped].ch[sock]
		local it = u and p.items[u]
		if it and it.paint then it.paint.col, it.paint.fin = pt.col, pt.fin end
	end
	return true
end

-- ---------- buy/sell ----------
function Economy.sellPrice(p, u)
	local it = p.items[u]
	local pr = it and Catalog.BY_SKU[it.s]
	if not pr or pr.kind == "tool" then return 0 end
	return math.floor(pr.price * (it.used and 0.5 or 0.7) + 0.5)
end
function Economy.sell(p, u, now)
	local it = p.items[u]
	if not it then return false, "Okänd del" end
	if not FREE[it.loc] then return false, "Delen sitter monterad" end
	local v = Economy.sellPrice(p, u)
	if v <= 0 then return false, "Verktyg går inte att sälja" end
	local name = Catalog.BY_SKU[it.s].name
	p.items[u] = nil
	Economy.book(p, v, "Sålde " .. name, now)
	return true
end
function Economy.buyMoped(p, id, now)
	local m = Config.BY_ID[id]
	if not m then return false, "Okänd moped" end
	if p.mopeds[id] and p.mopeds[id].own then return false, "Du äger redan mopeden" end
	if not Economy.spend(p, m.price, "Köpte " .. m.n, now) then return false, "Du har inte råd" end
	Economy.buildOEM(p, id)
	return true
end
function Economy.sellValue(p, id)
	local mp = p.mopeds[id]
	local v = 0
	for _, t in ipairs({ mp.eng, mp.ch }) do for _, u in pairs(t) do local pr = p.items[u] and Catalog.BY_SKU[p.items[u].s]; if pr then v = v + pr.price * 0.45 end end end
	return math.floor(v * (1 - 0.5 * (mp.dmg or 0)) + 0.5)
end
function Economy.sellMoped(p, id, now)
	local mp = p.mopeds[id]
	if not mp or not mp.own then return false, "Du äger inte mopeden" end
	local owned = 0
	for _, m in pairs(p.mopeds) do if m.own then owned = owned + 1 end end
	if owned < 2 then return false, "Du måste ha minst en moped" end
	if p.stand == id then return false, "Montera tillbaka motorn först" end
	local v = Economy.sellValue(p, id)
	for _, t in ipairs({ mp.eng, mp.ch }) do for _, u in pairs(t) do p.items[u] = nil end end
	p.mopeds[id] = nil
	if p.cur == id then for k, m in pairs(p.mopeds) do if m.own then p.cur = k; break end end end
	Economy.book(p, v, "Sålde " .. Config.BY_ID[id].n, now)
	return true
end
function Economy.repairCost(p, id) local d = p.mopeds[id].dmg or 0; if d >= 1 then return 1500 end return math.floor(100 + 900 * d + 0.5) end
function Economy.repair(p, id, emergency, now)
	local mp = p.mopeds[id]
	local d = mp and mp.dmg or 0
	if d <= 0 then return false, "Motorn är hel" end
	if emergency then
		if d <= 0.5 or p.money >= Economy.repairCost(p, id) then return false, "Nödlagning behövs inte" end
		mp.dmg = 0.5
	else
		if not Economy.spend(p, Economy.repairCost(p, id), "Reparation, " .. Config.BY_ID[id].n, now) then return false, "Du har inte råd" end
		mp.dmg = 0
	end
	p.rep = p.rep + 1
	return true
end
function Economy.setJet(p, id, jet) local mp = p.mopeds[id]; if not mp then return false end; mp.jet = math.floor(num(jet, mp.jet, 40, 160) + 0.5); return true end

-- ---------- riding rewards (same rules as before) ----------
function Economy.addDistance(p, meters, now)
	if meters <= 0 then return 0 end
	p.stats.dist = p.stats.dist + meters
	p.clean = p.clean + meters
	local got = 0
	local b = math.floor(p.stats.dist / E.distM)
	if b > p.paid then got = got + Economy.book(p, (b - p.paid) * E.distKr, "Körsträcka", now); p.paid = b end
	local c = math.floor(p.clean / E.cleanM)
	if c > p.cleanPaid then got = got + Economy.book(p, (c - p.cleanPaid) * E.cleanKr, "Ren körning 2 km", now); p.cleanPaid = c end
	return got
end
function Economy.dirty(p) p.clean = 0; p.cleanPaid = 0 end
function Economy.crash(p, why, now) p.stats.crash = p.stats.crash + 1; Economy.dirty(p); return Economy.fine(p, E.crashKr, "Vurpa: " .. tostring(why or ""), now) end
function Economy.wheelieValue(t, vAvg, sd, imp)
	local W = Config.WHEELIE
	if t < W.minT then return 0, 0 end
	local base = W.max * (1 - math.exp(-t / W.tau))
	local mult = math.min(1.5, math.max(0.5, vAvg * 3.6 / 30)) * (1 - math.min(0.5, sd / 0.15))
	local q = imp < 1 and 1 or imp < 2.5 and 0.7 or 0.4
	return math.floor(base * mult * q + 0.5), mult
end
function Economy.wheelie(p, t, vAvg, sd, imp, now, seenDist)
	local W = Config.WHEELIE
	t, vAvg, sd, imp = num(t, 0, 0, 120), num(vAvg, 0, 0, E.maxSpeed), num(sd, 0, 0, 3), num(imp, 0, 0, 50)
	if t < W.minT then return 0, "För kort" end
	if seenDist and seenDist < t * W.minV * 0.5 then return 0, "Servern såg inte att du rörde dig" end
	local r = Economy.wheelieValue(t, vAvg, sd, imp)
	p._wh = p._wh or {}
	local keep, used = {}, 0
	for _, x in ipairs(p._wh) do if now - x[1] < 60 then table.insert(keep, x); used = used + x[2] end end
	p._wh = keep
	r = math.min(r, math.max(0, W.rate - used))
	p.stats.wn = p.stats.wn + 1
	p.stats.best = math.max(p.stats.best, t)
	if r > 0 then table.insert(p._wh, { now, r }); Economy.book(p, r, string.format("Stegring %.1f s", t), now) end
	return r
end

-- ---------- load/save ----------
-- stored data is never trusted: unknown parts are removed, locations and sockets are rebuilt from the mopeds' maps
function Economy.load(raw)
	if type(raw) ~= "table" or raw.v ~= 2 then return Economy.new() end
	local p = Economy.new()
	p.items, p.mopeds, p.uid = {}, {}, math.floor(num(raw.uid, 0, 0, 1e9))
	p.money = math.floor(num(raw.money, E.start, 0, 1e9))
	if type(raw.items) == "table" then
		for u, it in pairs(raw.items) do
			if type(u) == "string" and type(it) == "table" and Catalog.BY_SKU[it.s] and type(it.loc) == "string" then
				local o = { s = it.s, loc = it.loc, used = it.used == true, src = tostring(it.src or "") }
				if type(it.port) == "table" then o.port = { q = num(it.port.q, 0, 0, 1), deg = num(it.port.deg, 0, 0, 4), label = tostring(it.port.label or "") } end
				if type(it.paint) == "table" and Paint.validHex(it.paint.col) and Paint.FINISH[it.paint.fin] then o.paint = { col = it.paint.col, fin = it.paint.fin, q = num(it.paint.q, 1, 0, 1) } end
				if Catalog.BY_SKU[it.s].kind == "panel" and not o.paint then o.paint = { col = "#bdbdbd", fin = "gloss", q = 1 } end
				p.items[u] = o
			end
		end
	end
	local anyOwn = false
	if type(raw.mopeds) == "table" then
		for _, m in ipairs(Config.MOPEDS) do
			local r = raw.mopeds[m.id]
			if type(r) == "table" and r.own == true then
				anyOwn = true
				local mp = { own = true, jet = math.floor(num(r.jet, m.d.jet, 40, 160)), dmg = num(r.dmg, 0, 0, 1), eng = {}, ch = {}, engAt = r.engAt == "stand" and "stand" or "moped" }
				p.mopeds[m.id] = mp
				local function take(src, dst, list, prefix)
					if type(src) ~= "table" then return end
					for _, s in ipairs(list) do
						local u = src[s.id]
						local it = type(u) == "string" and p.items[u]
						if it and Catalog.BY_SKU[it.s].kind == s.kind and (s.kind ~= "panel" or Catalog.BY_SKU[it.s].val.panel == s.panel) and Catalog.fits(Catalog.BY_SKU[it.s], m.id) then
							dst[s.id] = u; it.loc = prefix .. m.id; it.sock = s.id
						end
					end
				end
				take(r.eng, mp.eng, Assembly.engineSockets(m.id), "eng:")
				take(r.ch, mp.ch, Assembly.chassisSlots(m.id), "ch:")
				if mp.engAt == "moped" then mp.ch.engine = "engine" end
			end
		end
	end
	-- parts whose location points to a mount that no longer exists end up on the bench
	for u, it in pairs(p.items) do
		local kind, mid = it.loc:match("^(%a+):(.+)$")
		if kind == "eng" or kind == "ch" then
			local mp = p.mopeds[mid]
			local map = mp and (kind == "eng" and mp.eng or mp.ch)
			if not (map and it.sock and map[it.sock] == u) then it.loc, it.sock = "bench", nil end
		elseif kind ~= "box" and not (FREE[it.loc] or it.loc == "tool") then it.loc, it.sock = "bench", nil end
	end
	if not anyOwn then Economy.buildOEM(p, "jog") end
	if type(raw.stand) == "string" and p.mopeds[raw.stand] and p.mopeds[raw.stand].engAt == "stand" then p.stand = raw.stand end
	for id, mp in pairs(p.mopeds) do if mp.engAt == "stand" and p.stand ~= id then mp.engAt = "moped"; mp.ch.engine = "engine" end end
	if type(raw.cur) == "string" and p.mopeds[raw.cur] then p.cur = raw.cur else for k in pairs(p.mopeds) do p.cur = k; break end end
	if type(raw.orders) == "table" then
		for i = 1, math.min(20, #raw.orders) do
			local o = raw.orders[i]
			if type(o) == "table" and type(o.lines) == "table" and (o.state == "transit" or o.state == "arrived" or o.state == "opened") then
				local lines = {}
				for _, l in ipairs(o.lines) do if type(l) == "table" and Catalog.BY_SKU[l.sku] then table.insert(lines, { sku = l.sku, q = math.floor(num(l.q, 1, 1, 10)) }) end end
				table.insert(p.orders, { id = math.floor(num(o.id, 0, 0, 1e9)), lines = lines, total = num(o.total, 0, 0, 1e9), t0 = num(o.t0, 0, 0, 1e12), eta = num(o.eta, 0, 0, 1e12), state = o.state })
			end
		end
	end
	p.oid = math.floor(num(raw.oid, 0, 0, 1e9))
	if type(raw.designs) == "table" then
		for name, d in pairs(raw.designs) do
			if type(name) == "string" and type(d) == "table" and p.mopeds[d.moped] and type(d.panels) == "table" then
				local pans = {}
				for sock, pt in pairs(d.panels) do if type(pt) == "table" and Paint.validHex(pt.col) and Paint.FINISH[pt.fin] then pans[sock] = { col = pt.col, fin = pt.fin } end end
				p.designs[name:sub(1, 30)] = { moped = d.moped, panels = pans }
			end
		end
	end
	if type(raw.stats) == "table" then for k in pairs(p.stats) do p.stats[k] = num(raw.stats[k], 0, 0, 1e12) end end
	p.paid = math.floor(num(raw.paid, 0, 0, 1e12)); p.clean = num(raw.clean, 0, 0, 1e9); p.cleanPaid = math.floor(num(raw.cleanPaid, 0, 0, 1e9)); p.rep = math.floor(num(raw.rep, 0, 0, 1e9))
	if type(raw.ledger) == "table" then for i = 1, math.min(#raw.ledger, 40) do local l = raw.ledger[i]; if type(l) == "table" and type(l.x) == "string" and type(l.a) == "number" then table.insert(p.ledger, { a = l.a, x = l.x, t = num(l.t, 0, 0, 1e12) }) end end end
	-- the basic tools always exist
	if not hasTool(p, "basic") then newItem(p, "P-tool-basic", "tool", "start") end
	return p
end
function Economy.public(p)
	local o = {}
	for k, v in pairs(p) do if k:sub(1, 1) ~= "_" then o[k] = v end end
	return o
end
return Economy
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Engine</string><ProtectedString name="Source"><![CDATA[-- Engine model, ported line by line from the web version (calc/torque/target/therm in moppe/index.html).
local Config = require(script.Parent.Config)
local Engine = {}

local function clamp(x, a, b) if x < a then return a elseif x > b then return b end return x end

-- c: effective config (tuning values + values from installed parts, see Catalog.ecfg)
function Engine.calc(c)
	local k, e = Config.KITS[c.kit + 1], Config.EXH[c.exh + 1]
	local D, dia = k.cc / 50, Config.CARB[c.carb + 1]
	local fdia, fc = math.min(dia, c.maxd or 99), c.fcap or 1 -- the intake throttles flow, a sport filter adds air
	local ex = k.ex + c.port
	local portPk = 7000 + (ex - 175) * 233
	local pk = 0.4 * portPk + 0.6 * e.t
	local match = math.exp(-((portPk - e.t) / 2800) ^ 2)
	local opt = dia * 5 * math.sqrt(D) * (0.85 + pk / 60000)
	local m = c.jet / opt / math.sqrt(fc)
	local fuelF
	if m < 1 then fuelF = 1 - 3 * (1 - m) ^ 2 else fuelF = 1 - 0.8 * (m - 1) ^ 2 end
	fuelF = math.max(0.45, fuelF)
	local cap, need = (fdia / 17.5) ^ 2 * fc, D * pk / 12000
	local restr = math.min(1, math.sqrt(cap / need))
	return {
		ex = ex, portPk = portPk, pk = pk, w = e.w, match = match, m = m, fuelF = fuelF,
		resp = fuelF * (0.55 + 0.45 * match) * (0.7 + 0.3 * restr), restr = restr, over = math.max(0, cap / need - 1.6),
		tmax = 4.2 * D * k.q * e.g * (0.75 + 0.25 * match) * (c.tmf or 1), -- tmf: crankshaft, reed valve and porting quality
		heat = 1 + math.max(0, 1 - m) * 2.2 + math.max(0, ex - 185) * 0.03 + (1 - match) * 0.3 + math.max(0, m - 1.25) * 0.3,
		lim = math.min(c.icap or 1e9, math.max(9500, pk * 1.2 + 500)), -- ignition rev limit
		cond = 1,
	}
end

function Engine.torque(P, rpm)
	local g = math.exp(-((rpm - P.pk) / P.w) ^ 2)
	local t = P.tmax * (0.3 + 0.7 * g) * P.fuelF
	t = t * (1 - (1 - P.restr) * math.min(1, rpm / P.pk))
	t = t * (1 - math.min(0.35, P.over * 0.3) * math.max(0, 1 - rpm / (P.pk * 0.9)))
	if rpm > P.lim then return 0 end
	return t * (P.cond or 1)
end

-- peak power in hp from the curve (same sampling as the web dyno)
function Engine.peakHp(P)
	local hb, at = 0, 0
	for r = 2000, 15000, 250 do
		local h = Engine.torque(P, r) * r / 9549 * 1.341
		if h > hb then hb, at = h, r end
	end
	return hb, at
end

function Engine.target(c) return 5200 + 780 * (14 - c.roller) + (c.cdt or 0) end

-- ---------- heat model ----------
-- Air-cooled: one lump (cylinder+head), the sensor is a CHT under the spark plug.
-- Liquid-cooled: cylinder and coolant as two lumps, the sensor is in the coolant.
Engine.TH = {
	jog = { C = 2500, a0 = 4, af = 5.3, av = 0.6 },
	dt = { C = 2500, a0 = 6, af = 0, av = 4.7 },
	rok = { C = 1500, G = 100, a0 = 2, Cw = 4200, r0 = 10, rv = 9.3 },
}
Engine.BAND = {
	air = { lab = "Topptemp (CHT)", b = { { 50, "kall, varmkör", Color3.fromRGB(74, 163, 255) }, { 200, "normal", Color3.fromRGB(107, 211, 107) }, { 230, "varm", Color3.fromRGB(255, 176, 32) }, { 1e9, "ÖVERHETTAD", Color3.fromRGB(255, 106, 74) } } },
	liquid = { lab = "Kylvätska", b = { { 50, "kall, varmkör", Color3.fromRGB(74, 163, 255) }, { 95, "normal", Color3.fromRGB(107, 211, 107) }, { 110, "varm", Color3.fromRGB(255, 176, 32) }, { 1e9, "KOKAR", Color3.fromRGB(255, 106, 74) } } },
}
Engine.T_LOSS, Engine.T_DMG, Engine.T_BOIL = 225, 240, 120

function Engine.newThermal() return { tc = Config.AMB, tw = Config.AMB, boil = false, dmg = 0 } end

-- s: thermal state, Q: heat input (W), rpm, v (m/s), cf: cooling factor from parts
function Engine.therm(mop, s, dt, Q, rpm, v, cf)
	local t, AMB = Engine.TH[mop.id], Config.AMB
	cf = cf or 1
	if mop.cool == "liquid" then
		local hr = (t.r0 + t.rv * cf * v ^ 0.8) * (s.boil and 0.35 or 1)
		local q = t.G * (s.boil and 0.4 or 1) * (s.tc - s.tw)
		s.tc = s.tc + (Q - q - t.a0 * (s.tc - AMB)) / t.C * dt
		s.tw = math.min(Engine.T_BOIL, s.tw + (q - hr * (s.tw - AMB)) / t.Cw * dt)
		if s.tw >= Engine.T_BOIL - 0.5 then s.boil = true elseif s.tw < 100 then s.boil = false end
	else
		local hA = t.a0 + cf * (t.af * (rpm / 1000) ^ 0.8 + t.av * v ^ 0.8)
		s.tc = s.tc + (Q - hA * (s.tc - AMB)) / t.C * dt
	end
	if s.tc > Engine.T_DMG then s.dmg = math.min(1, s.dmg + dt * (s.tc - Engine.T_DMG) / 900) end
end

function Engine.heatF(s) return 1 - math.min(0.45, math.max(0, (s.tc - Engine.T_LOSS) / 100)) end

function Engine.heatIn(P, torqueNm, rpm) return P.heat * (1.4 * torqueNm * rpm * math.pi / 30 + 300 * rpm / 1000) end

function Engine.tinfo(mop, s)
	local B = Engine.BAND[mop.cool]
	local v = mop.cool == "liquid" and s.tw or s.tc
	for _, b in ipairs(B.b) do
		if v < b[1] then return { lab = B.lab, v = v, band = b[2], col = b[3], tc = s.tc, dmg = s.dmg } end
	end
end

Engine.clamp = clamp
return Engine
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">GarageBuilder</string><ProtectedString name="Source"><![CDATA[-- A garage (template). Built once per player plot. Returns references to all work stations.
-- Garage space in metres: x -12..12, z -8..8, door at z = -8 (forward = -Z in Roblox).
local Config = require(script.Parent.Config)
local S = 1 / Config.STUD
local GarageBuilder = {}

-- the work stations' points (used by both the server and the client so they always agree)
function GarageBuilder.anchors(origin)
	local function at(x, y, z) return origin * CFrame.new(x * S, y * S, -z * S) end
	return {
		origin = origin,
		moped = at(0, 0, -2),
		stand = at(-2.2, 1.15, 4.6) * CFrame.Angles(0, math.rad(90), 0),
		booth = at(8.8, 1.25, 5),
		portbench = at(2.2, 1.2, 7.15),
		delivery = at(4.5, 0.3, -10),
		computer = at(-10.2, 1.08, -5.3),
		spawn = at(-3, 1, 0),
	}
end
function GarageBuilder.plotOrigin(i) local pl = Config.PLOTS[i]; return CFrame.new(pl.x * S, 0, -pl.z * S) end

function GarageBuilder.build(parent, origin, plotIdx)
	local G = Instance.new("Model"); G.Name = "Garage" .. plotIdx; G.Parent = parent
	local function M(x) return x * S end
	local function at(x, y, z) return origin * CFrame.new(M(x), M(y), -M(z)) end
	local function part(name, size, cf, color, material, shape)
		local p = Instance.new("Part"); p.Name = name
		if shape == "cyl" then p.Shape = Enum.PartType.Cylinder elseif shape == "ball" then p.Shape = Enum.PartType.Ball end
		p.Size, p.CFrame, p.Color, p.Material, p.Anchored = size, cf, color, material or Enum.Material.SmoothPlastic, true
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = G
		return p
	end
	local function box(name, w, h, d, x, y, z, color, mat) return part(name, Vector3.new(M(w), M(h), M(d)), at(x, y, z), color, mat) end
	local function interact(p, kind, hint) p:SetAttribute("Interact", kind); p:SetAttribute("Plot", plotIdx); if hint then p:SetAttribute("Hint", hint) end; return p end
	local brick, brickC, steel = Enum.Material.Brick, Color3.fromRGB(139, 66, 50), Color3.fromRGB(92, 98, 106)
	local white, wood, red = Color3.fromRGB(240, 240, 236), Color3.fromRGB(138, 96, 58), Color3.fromRGB(176, 32, 28)
	local W, D, H = 24, 16, 5
	-- floor, walls, roof
	local floor = box("Floor", W + 0.6, 0.3, D + 0.6, 0, -0.15, 0, Color3.fromRGB(128, 131, 134), Enum.Material.Concrete)
	interact(floor, "floor", "Lägg på golvet")
	box("WallBack", W + 0.6, H, 0.3, 0, H / 2, D / 2 + 0.15, brickC, brick)
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * (W / 2 + 0.15)
		box("WallLow", 0.3, 1.4, D, x, 0.7, 0, brickC, brick)
		box("WallHigh", 0.3, 2, D, x, 4, 0, brickC, brick)
		for _, seg in ipairs({ { -8, -6.6 }, { -3.4, -1.6 }, { 1.6, 3.4 }, { 6.6, 8 } }) do box("WallMid", 0.3, 1.6, seg[2] - seg[1], x, 2.2, (seg[1] + seg[2]) / 2, brickC, brick) end
		for _, z in ipairs({ -5, 0, 5 }) do
			local g = box("Window", 0.12, 1.6, 3.2, x, 2.2, z, Color3.fromRGB(170, 200, 220), Enum.Material.Glass); g.Transparency = 0.6
		end
	end
	box("WallFrontL", (W + 0.6 - 6) / 2, H, 0.3, -(W + 6.6) / 4, H / 2, -D / 2 - 0.15, brickC, brick)
	box("WallFrontR", (W + 0.6 - 6) / 2, H, 0.3, (W + 6.6) / 4, H / 2, -D / 2 - 0.15, brickC, brick)
	box("DoorTop", 6, 1.2, 0.3, 0, H - 0.6, -D / 2 - 0.15, brickC, brick)
	part("RollerDoor", Vector3.new(M(6), M(0.6), M(0.6)), at(0, H - 0.9, -D / 2 + 0.3), Color3.fromRGB(190, 195, 200), Enum.Material.Metal, "cyl")
	box("Roof", W + 1, 0.3, D + 1, 0, H + 0.15, 0, Color3.fromRGB(64, 66, 70), Enum.Material.CorrodedMetal)
	for i = -2, 2 do box("Beam", W, 0.35, 0.18, 0, H - 0.2, i * 3.2, steel, Enum.Material.Metal) end
	-- sign with the owner's name
	local sign = box("Sign", 6, 0.8, 0.15, 0, H + 0.2, -D / 2 - 0.4, Color3.fromRGB(25, 27, 30))
	local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Front; sg.CanvasSize = Vector2.new(600, 80); sg.LightInfluence = 0; sg.Parent = sign
	local st = Instance.new("TextLabel"); st.Name = "Owner"; st.Size = UDim2.fromScale(1, 1); st.BackgroundTransparency = 1; st.Text = "LEDIGT GARAGE"; st.TextScaled = true
	st.Font = Enum.Font.GothamBlack; st.TextColor3 = Color3.fromRGB(255, 176, 32); st.Parent = sg
	-- lamps
	for _, x in ipairs({ -7, 0, 7 }) do
		for _, z in ipairs({ -3.5, 3.5 }) do
			local shade = part("LampShade", Vector3.new(M(0.3), M(0.7), M(0.7)), at(x, H - 1.1, z) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(46, 70, 60), Enum.Material.Metal, "cyl")
			shade.CanCollide = false
			local bulb = box("LampBulb", 0.5, 0.05, 0.5, x, H - 1.28, z, Color3.fromRGB(255, 244, 220), Enum.Material.Neon); bulb.CanCollide = false
			local l = Instance.new("SpotLight"); l.Face = Enum.NormalId.Bottom; l.Angle = 120; l.Range = 40; l.Brightness = 1.5; l.Color = Color3.fromRGB(255, 240, 215); l.Shadows = true; l.Parent = bulb
		end
	end
	-- dirt and wear: oil stains on the floor
	local rnd = Random.new(plotIdx * 13)
	for _ = 1, 7 do
		local s = 0.4 + rnd:NextNumber() * 0.9
		local o = part("OilStain", Vector3.new(M(0.02), M(s), M(s)), at(rnd:NextNumber() * 18 - 9, 0.012, rnd:NextNumber() * 12 - 7) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(40, 38, 36), Enum.Material.SmoothPlastic, "cyl")
		o.Transparency = 0.45; o.CanCollide = false; o.CanQuery = false
	end
	box("MopedMat", 1.4, 0.01, 2.8, 0, 0.005, -2, Color3.fromRGB(30, 30, 32), Enum.Material.Fabric).CanQuery = false
	local refs = GarageBuilder.anchors(origin)
	refs.model, refs.sign = G, st
	-- moped spot (the current moped) and parking spots for the others
	refs.parking = { at(-8.5, 0, -4) * CFrame.Angles(0, math.rad(90), 0), at(-8.5, 0, 0.5) * CFrame.Angles(0, math.rad(90), 0) }
	-- workbench along the back wall with pegboard and tools
	local bench = box("Bench", 5.6, 0.08, 0.9, -6, 0.95, 7.3, wood, Enum.Material.Wood)
	interact(bench, "bench", "Lägg på arbetsbänken")
	for _, x in ipairs({ -8.7, -3.3 }) do box("BenchLeg", 0.08, 0.95, 0.8, x, 0.47, 7.3, steel, Enum.Material.Metal) end
	box("BenchShelf", 5.6, 0.04, 0.8, -6, 0.3, 7.3, steel, Enum.Material.Metal)
	box("Pegboard", 5.6, 1.4, 0.05, -6, 1.85, 7.95, Color3.fromRGB(150, 132, 98), Enum.Material.WoodPlanks)
	for i = 0, 15 do
		local t = box("WallTool", 0.05, 0.22 + rnd:NextNumber() * 0.25, 0.03, -8.5 + i * 0.33, 1.85 + (rnd:NextNumber() - 0.5) * 0.7, 7.9, i % 3 == 0 and red or Color3.fromRGB(70, 74, 80), Enum.Material.Metal)
		t.CFrame = t.CFrame * CFrame.Angles(0, 0, (rnd:NextNumber() - 0.5) * 0.7)
	end
	refs.benchSlots = {}
	for i = 0, 7 do table.insert(refs.benchSlots, at(-8.4 + i * 0.68, 1.05, 7.2)) end
	-- engine stand (red) with a mount plate
	box("StandBase", 0.7, 0.06, 0.7, -2.2, 0.03, 4.6, red, Enum.Material.Metal)
	part("StandPost", Vector3.new(M(0.8), M(0.08), M(0.08)), at(-2.2, 0.45, 4.6) * CFrame.Angles(0, 0, math.pi / 2), red, Enum.Material.Metal, "cyl")
	local standPlate = box("StandPlate", 0.06, 0.2, 0.2, -2.2, 0.85, 4.6, Color3.fromRGB(80, 80, 85), Enum.Material.Metal)
	interact(standPlate, "stand", "Motorstativ: bygg motorn")
	local standZone = box("StandZone", 1.2, 1.2, 1.2, -2.2, 1.2, 4.6, Color3.new(1, 1, 1)); standZone.Transparency = 1; standZone.CanCollide = false
	interact(standZone, "stand", "Motorstativ: bygg motorn")
	refs.standTray = {}
	for i = 0, 7 do table.insert(refs.standTray, at(-3.4 + (i % 4) * 0.28, 0.82, 3.5 + math.floor(i / 4) * 0.3)) end
	box("TrayTable", 1.3, 0.05, 0.75, -2.98, 0.75, 3.65, steel, Enum.Material.Metal)
	-- porting bench with vise and lamp
	local pb = box("PortBench", 1.4, 0.08, 0.7, 2.2, 0.95, 7.3, Color3.fromRGB(70, 74, 80), Enum.Material.DiamondPlate)
	interact(pb, "portbench", "Portningsbänk: porta cylindern")
	box("PortLeg", 1.3, 0.9, 0.6, 2.2, 0.45, 7.3, steel, Enum.Material.Metal)
	box("Vise", 0.25, 0.18, 0.3, 2.2, 1.08, 7.15, Color3.fromRGB(40, 70, 130), Enum.Material.Metal)
	local pl = box("PortLamp", 0.3, 0.05, 0.3, 2.2, 1.9, 7.1, Color3.fromRGB(255, 250, 235), Enum.Material.Neon)
	local plL = Instance.new("SpotLight"); plL.Face = Enum.NormalId.Bottom; plL.Angle = 60; plL.Range = 8; plL.Brightness = 2.5; plL.Parent = pl
	-- paint booth: glass walls, extractor fan, panel stand
	local bx, bz = 8.8, 5
	for _, side in ipairs({ { 3.4, 0.05, bx, bz - 1.7 }, { 0.05, 3.4, bx - 1.7, bz }, { 0.05, 3.4, bx + 1.7, bz } }) do
		local g = box("BoothGlass", side[1], 2.6, side[2], side[3], 1.3, side[4], Color3.fromRGB(200, 220, 230), Enum.Material.Glass); g.Transparency = 0.7
	end
	box("BoothFloor", 3.4, 0.03, 3.4, bx, 0.015, bz, Color3.fromRGB(70, 90, 80), Enum.Material.Fabric)
	box("BoothFan", 1.2, 1.2, 0.2, bx, 2.2, bz + 1.7, Color3.fromRGB(60, 60, 64), Enum.Material.DiamondPlate)
	box("BoothLight", 3, 0.05, 0.3, bx, 2.65, bz, Color3.fromRGB(255, 252, 240), Enum.Material.Neon)
	part("BoothStand", Vector3.new(M(1), M(0.06), M(0.06)), at(bx, 0.5, bz) * CFrame.Angles(0, 0, math.pi / 2), steel, Enum.Material.Metal, "cyl")
	local bs = box("BoothRack", 0.8, 0.05, 0.05, bx, 1.0, bz, steel, Enum.Material.Metal)
	interact(bs, "booth", "Lackbox: lackera kåpan")
	local bzn = box("BoothZone", 2.8, 2.2, 2.8, bx, 1.2, bz, Color3.new(1, 1, 1)); bzn.Transparency = 1; bzn.CanCollide = false
	interact(bzn, "booth", "Lackbox: lackera kåpan")
	-- shelving along the right wall
	refs.shelfSlots = {}
	for j = 0, 3 do
		local s = box("Shelf", 0.6, 0.04, 4.2, W / 2 - 0.5, 0.3 + j * 0.62, -2, Color3.fromRGB(200, 120, 30), Enum.Material.Metal)
		interact(s, "shelf", "Lägg på hyllan")
		if j < 3 then for k = 0, 5 do table.insert(refs.shelfSlots, at(W / 2 - 0.5, 0.42 + j * 0.62, -3.75 + k * 0.7)) end end
	end
	for _, z in ipairs({ -4.1, 0.1 }) do for _, x in ipairs({ W / 2 - 0.78, W / 2 - 0.22 }) do box("Upright", 0.05, 2.2, 0.05, x, 1.1, z, Color3.fromRGB(40, 90, 160), Enum.Material.Metal) end end
	-- computer desk (left front)
	box("Desk", 1.6, 0.06, 0.8, -10.2, 0.75, -5.5, wood, Enum.Material.Wood)
	for _, dx in ipairs({ -0.75, 0.75 }) do box("DeskLeg", 0.05, 0.75, 0.7, -10.2 + dx, 0.37, -5.5, steel, Enum.Material.Metal) end
	local screen = box("Screen", 0.62, 0.42, 0.04, -10.2, 1.08, -5.3, Color3.fromRGB(70, 140, 200), Enum.Material.Neon)
	interact(screen, "computer", "Dator: Moppelagret.se")
	box("Keyboard", 0.45, 0.02, 0.15, -10.2, 0.79, -5.65, Color3.fromRGB(30, 30, 32))
	box("Chair", 0.5, 0.08, 0.5, -10.2, 0.48, -6.1, Color3.fromRGB(30, 30, 32), Enum.Material.Fabric)
	-- moped lift (decor), tyres, compressor, drums, extinguisher
	box("LiftTop", 0.9, 0.12, 2.4, 5, 0.55, -3, Color3.fromRGB(150, 155, 160), Enum.Material.DiamondPlate)
	box("LiftBase", 0.5, 0.5, 1.6, 5, 0.25, -3, red, Enum.Material.Metal)
	for sidx = 0, 1 do for i = 0, 4 do part("Tyre", Vector3.new(M(0.2), M(0.65), M(0.65)), at(W / 2 - 0.8 - sidx * 0.8, 0.1 + i * 0.2, -6.3) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(24, 24, 26), Enum.Material.SmoothPlastic, "cyl") end end
	part("Compressor", Vector3.new(M(1.1), M(0.45), M(0.45)), at(-W / 2 + 1, 0.35, 6.4), red, Enum.Material.Metal, "cyl")
	for i, c in ipairs({ Color3.fromRGB(31, 95, 158), Color3.fromRGB(150, 30, 30) }) do part("Drum", Vector3.new(M(0.9), M(0.6), M(0.6)), at(-W / 2 + 0.6, 0.45, 2 + i * 0.75) * CFrame.Angles(0, 0, math.pi / 2), c, Enum.Material.Metal, "cyl") end
	part("Extinguisher", Vector3.new(M(0.5), M(0.16), M(0.16)), at(-W / 2 + 0.3, 0.6, -6.8) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(200, 20, 20), Enum.Material.Metal, "cyl")
	-- delivery: outside the door, with floor spots around for unpacked parts
	refs.floorSlots = {}
	for i = 0, 11 do table.insert(refs.floorSlots, at(2.6 + (i % 4) * 0.6, 0.12, -11 - math.floor(i / 4) * 0.6)) end
	-- spawn point inside
	return refs
end

return GarageBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Paint</string><ProtectedString name="Source"><![CDATA[-- Paint: colour library, paint types and spray quality. The panel's sprayed side is split into a grid; the spray
-- gun adds paint with a soft edge. Quality comes from coverage, evenness and runs (too much paint in one place).
local Paint = {}

Paint.LIBRARY = {
	{ "Gloss Black", "#0e0e10", "gloss" }, { "Midnight Blue", "#16234a", "metal" }, { "Racing Red", "#c8102e", "gloss" }, { "Pearl White", "#f4f1ea", "pearl" },
	{ "Nardo Grey", "#7c7f80", "gloss" }, { "Candy Purple", "#5a1a7a", "pearl" }, { "Neon Green", "#39ff14", "gloss" }, { "Chrome Silver", "#d9dde2", "chrome" },
	{ "Metallic Gold", "#c9a227", "metal" }, { "Sky Blue", "#4aa3ff", "gloss" }, { "Orange", "#ff7f11", "gloss" }, { "Matt Black", "#1a1a1a", "matt" },
}
Paint.FINISH = { gloss = "Blank", matt = "Matt", metal = "Metallic", pearl = "Pärlemor", chrome = "Krom" }
Paint.GW, Paint.GH = 8, 5
Paint.RADIUS = 0.32 -- spray width in u/v units (the panel is -1..1 in both directions)
Paint.RATE = 0.9

function Paint.new(even)
	local s = { g = {}, t = 0, even = even or 0.7 }
	for i = 1, Paint.GW * Paint.GH do s.g[i] = 0 end
	return s
end
function Paint.cellCenter(i)
	local x, y = (i - 1) % Paint.GW, math.floor((i - 1) / Paint.GW)
	return -1 + (x + 0.5) * 2 / Paint.GW, -1 + (y + 0.5) * 2 / Paint.GH
end
-- spray at (u, v) for dt seconds; a better gun (even) gives a softer, wider spray pattern
function Paint.spray(s, u, v, dt)
	s.t = s.t + dt
	local r = Paint.RADIUS * (0.85 + 0.3 * s.even)
	for i = 1, Paint.GW * Paint.GH do
		local cu, cv = Paint.cellCenter(i)
		local d = math.sqrt((cu - u) ^ 2 + (cv - v) ^ 2)
		if d < r then
			local w = 1 - (d / r) ^ (1 + s.even)
			s.g[i] = s.g[i] + Paint.RATE * w * dt
		end
	end
end
function Paint.result(s)
	local n, cov, runs, sum = Paint.GW * Paint.GH, 0, 0, 0
	for _, w in ipairs(s.g) do if w >= 0.8 then cov = cov + 1 end; if w > 1.7 then runs = runs + 1 end; sum = sum + math.min(1.8, w) end
	local mean = sum / n
	local var = 0
	for _, w in ipairs(s.g) do var = var + (math.min(1.8, w) - mean) ^ 2 end
	local evenness = math.max(0, 1 - math.sqrt(var / n) / 0.45)
	local coverage, runShare = cov / n, runs / n
	local q = math.max(0, math.min(1, coverage * (0.6 * evenness + 0.4 * (1 - runShare * 2))))
	local label = q > 0.8 and "Utmärkt" or q > 0.6 and "Bra" or q > 0.35 and "Okej" or "Fläckig"
	return { coverage = coverage, evenness = evenness, runs = runShare, q = q, label = label }
end
function Paint.validHex(h) return type(h) == "string" and h:match("^#%x%x%x%x%x%x$") ~= nil end
return Paint
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[-- Body panels per moped model. Each panel is its own part (own item, own paint) and can be removed individually.
-- Geometry in metres in the moped's space (x right, y up, z forward). shape: box | wedge | ball. role decides the
-- default colour (body = body colour, dark = black matt, white = white). alts = alternative panels in the shop:
-- { look, name, brand, price, description }. A new model = a new list here (+ engine/chassis positions in Config).
local Panels = {}

local function alts(price, extra)
	local a = { { "carbon", "kolfiberlook", "Snabbo", math.floor(price * 1.6), "Kolfiberlook, kan inte lackeras." } }
	for _, e in ipairs(extra or {}) do table.insert(a, e) end
	return a
end

Panels.jog = {
	{ id = "front", n = "Frontkåpa", role = "body", price = 600, shape = "box", size = { 0.4, 0.62, 0.12 }, pos = { 0, 0.6, 0.42 }, rot = { 10, 0, 0 },
		alts = alts(600, { { "sport", "sport", "Fartek", 850, "Spetsigare form." } }) },
	{ id = "headset", n = "Styrkåpa", role = "body", price = 350, shape = "box", size = { 0.3, 0.18, 0.22 }, pos = { 0, 1.0, 0.45 }, alts = alts(350) },
	{ id = "lightcover", n = "Kåpa runt lyktan", role = "body", price = 250, shape = "ball", size = { 0.22, 0.17, 0.08 }, pos = { 0, 0.98, 0.55 },
		alts = { { "clear", "tonad genomskinlig", "Vippa", 300, "Genomskinlig, rökfärgad." } } },
	{ id = "floor", n = "Fotplatta", role = "dark", price = 300, shape = "box", size = { 0.38, 0.05, 0.55 }, pos = { 0, 0.25, 0.08 }, alts = alts(300) },
	{ id = "side_l", n = "Sidokåpa vänster", role = "body", price = 450, shape = "box", size = { 0.03, 0.28, 0.6 }, pos = { -0.17, 0.5, -0.33 }, alts = alts(450) },
	{ id = "side_r", n = "Sidokåpa höger", role = "body", price = 450, shape = "box", size = { 0.03, 0.28, 0.6 }, pos = { 0.17, 0.5, -0.33 }, alts = alts(450) },
	{ id = "rear", n = "Bakkåpa", role = "body", price = 500, shape = "box", size = { 0.3, 0.12, 0.62 }, pos = { 0, 0.62, -0.33 }, alts = alts(500) },
	{ id = "fender_f", n = "Framskärm", role = "body", price = 300, shape = "box", size = { 0.14, 0.03, 0.34 }, pos = { 0, 0.38, 0.6 }, rot = { -5, 0, 0 },
		alts = alts(300, { { "chrome", "krom", "Bruksmek", 750, "Förkromad." } }) },
	{ id = "fender_r", n = "Bakre stänkskärm", role = "dark", price = 200, shape = "box", size = { 0.12, 0.02, 0.3 }, pos = { 0, 0.36, -0.75 }, rot = { 20, 0, 0 }, alts = alts(200) },
	{ id = "under", n = "Underkåpa", role = "dark", price = 250, shape = "box", size = { 0.3, 0.05, 0.4 }, pos = { 0, 0.17, -0.05 } },
}

Panels.rok = {
	{ id = "front", n = "Frontkåpa", role = "body", price = 900, shape = "wedge", size = { 0.36, 0.3, 0.45 }, pos = { 0, 0.95, 0.56 }, rot = { 0, 180, 0 },
		alts = alts(900, { { "sport", "sport", "Fartek", 1300, "Aggressivare front." } }) },
	{ id = "lightcover", n = "Framkåpa runt lyktan", role = "body", price = 450, shape = "box", size = { 0.34, 0.12, 0.2 }, pos = { 0, 0.86, 0.66 },
		alts = { { "clear", "tonad genomskinlig", "Vippa", 520, "Genomskinlig, rökfärgad." } } },
	{ id = "legshield", n = "Benskydd", role = "body", price = 650, shape = "box", size = { 0.4, 0.6, 0.12 }, pos = { 0, 0.6, 0.46 }, rot = { 18, 0, 0 }, alts = alts(650) },
	{ id = "side_l", n = "Sidokåpa vänster", role = "body", price = 600, shape = "box", size = { 0.03, 0.22, 0.65 }, pos = { -0.17, 0.55, -0.36 }, alts = alts(600) },
	{ id = "side_r", n = "Sidokåpa höger", role = "body", price = 600, shape = "box", size = { 0.03, 0.22, 0.65 }, pos = { 0.17, 0.55, -0.36 }, alts = alts(600) },
	{ id = "rearside_l", n = "Bakre sidokåpa vänster", role = "body", price = 400, shape = "wedge", size = { 0.03, 0.14, 0.3 }, pos = { -0.16, 0.62, -0.78 }, alts = alts(400) },
	{ id = "rearside_r", n = "Bakre sidokåpa höger", role = "body", price = 400, shape = "wedge", size = { 0.03, 0.14, 0.3 }, pos = { 0.16, 0.62, -0.78 }, alts = alts(400) },
	{ id = "under", n = "Underkåpa", role = "dark", price = 350, shape = "box", size = { 0.32, 0.05, 0.5 }, pos = { 0, 0.19, -0.1 } },
	{ id = "foot_l", n = "Fotplatta vänster", role = "dark", price = 250, shape = "box", size = { 0.14, 0.03, 0.52 }, pos = { -0.1, 0.27, 0.08 }, alts = alts(250) },
	{ id = "foot_r", n = "Fotplatta höger", role = "dark", price = 250, shape = "box", size = { 0.14, 0.03, 0.52 }, pos = { 0.1, 0.27, 0.08 }, alts = alts(250) },
	{ id = "fender_r", n = "Bakre stänkskärm", role = "dark", price = 300, shape = "box", size = { 0.12, 0.02, 0.3 }, pos = { 0, 0.44, -0.92 }, rot = { 20, 0, 0 },
		alts = alts(300, { { "short", "kort custom", "Snabbo", 450, "Kortare custom-stänkskärm." } }) },
	{ id = "fender_f", n = "Framskärm", role = "body", price = 350, shape = "box", size = { 0.13, 0.03, 0.32 }, pos = { 0, 0.56, 0.65 }, rot = { -5, 0, 0 }, alts = alts(350) },
	{ id = "grips", n = "Handtagskåpa", role = "dark", price = 300, shape = "box", size = { 0.55, 0.05, 0.12 }, pos = { 0, 1.05, 0.42 }, alts = alts(300) },
	{ id = "barcover", n = "Styrkåpa", role = "body", price = 400, shape = "box", size = { 0.3, 0.1, 0.18 }, pos = { 0, 1.1, 0.4 }, alts = alts(400) },
	{ id = "dash", n = "Kåpa runt instrumentpanelen", role = "dark", price = 300, shape = "box", size = { 0.22, 0.06, 0.12 }, pos = { 0, 1.16, 0.34 } },
}

Panels.dt = {
	{ id = "tankcover", n = "Tankkåpa", role = "body", price = 700, shape = "box", size = { 0.27, 0.12, 0.42 }, pos = { 0, 0.97, 0.12 }, rot = { -9, 0, 0 }, alts = alts(700) },
	{ id = "side_l", n = "Sidoskydd vänster", role = "white", price = 300, shape = "box", size = { 0.012, 0.17, 0.22 }, pos = { -0.115, 0.74, -0.3 }, alts = alts(300) },
	{ id = "side_r", n = "Sidoskydd höger", role = "white", price = 300, shape = "box", size = { 0.012, 0.17, 0.22 }, pos = { 0.115, 0.74, -0.3 }, alts = alts(300) },
	{ id = "fender_f", n = "Framskärm", role = "white", price = 350, shape = "box", size = { 0.11, 0.02, 0.42 }, pos = { 0, 0.5, 0.7 }, rot = { -8, 0, 0 }, alts = alts(350) },
	{ id = "fender_r", n = "Bakskärm", role = "white", price = 400, shape = "box", size = { 0.13, 0.02, 0.5 }, pos = { 0, 0.88, -0.86 }, rot = { 12, 0, 0 },
		alts = alts(400, { { "short", "kort custom", "Snabbo", 550, "Kortare bakskärm." } }) },
	{ id = "lampmask", n = "Lyktmask", role = "white", price = 350, shape = "box", size = { 0.22, 0.24, 0.04 }, pos = { 0, 0.9, 0.55 }, rot = { -25, 0, 0 }, alts = alts(350) },
}

-- look -> how the panel is drawn (carbon: fixed carbon colour, clear: smoked transparent, chrome: chrome, sport/short: different size)
Panels.LOOK = {
	std = {}, carbon = { fixed = "carbon" }, clear = { fixed = "clear" }, chrome = { fixed = "chrome" },
	sport = { scale = { 1.08, 0.92, 1.12 } }, short = { scale = { 1, 1, 0.65 } },
}
function Panels.find(mopId, panelId)
	for _, p in ipairs(Panels[mopId] or {}) do if p.id == panelId then return p end end
	return nil
end
return Panels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Porting</string><ProtectedString name="Source"><![CDATA[-- Cylinder porting: the marked areas (ports) are split into cells. The tool tip removes material in the cells it
-- touches while the player holds the button. Quality comes from evenness, precision (time outside the areas)
-- and over-porting. Coordinates u, v in [-1, 1] on the cylinder's work view (seen from above, exhaust towards +v).
local Porting = {}

Porting.ZONES = {
	{ id = "exhaust", n = "Avgasport", u = { -0.18, 0.18 }, v = { 0.52, 0.86 }, color = Color3.fromRGB(255, 120, 40) },
	{ id = "transfer_l", n = "Överströmning vänster", u = { -0.86, -0.6 }, v = { -0.22, 0.3 }, color = Color3.fromRGB(60, 170, 255) },
	{ id = "transfer_r", n = "Överströmning höger", u = { 0.6, 0.86 }, v = { -0.22, 0.3 }, color = Color3.fromRGB(60, 170, 255) },
	{ id = "boost", n = "Boostport", u = { -0.14, 0.14 }, v = { -0.86, -0.6 }, color = Color3.fromRGB(120, 255, 140) },
}
Porting.CU, Porting.CV = 4, 3 -- cells per zone
Porting.RADIUS = 0.07 -- the tool tip's reach
Porting.RATE = 0.55 -- work per second at full contact (1 = finished cell)

function Porting.new(steady, training)
	local s = { cells = {}, on = 0, off = 0, t = 0, steady = steady or 0.6, training = training == true }
	for _, z in ipairs(Porting.ZONES) do
		s.cells[z.id] = {}
		for i = 1, Porting.CU * Porting.CV do s.cells[z.id][i] = 0 end
	end
	return s
end

local function cellCenter(z, i)
	local cu, cv = (i - 1) % Porting.CU, math.floor((i - 1) / Porting.CU)
	return z.u[1] + (cu + 0.5) / Porting.CU * (z.u[2] - z.u[1]), z.v[1] + (cv + 0.5) / Porting.CV * (z.v[2] - z.v[1])
end
Porting.cellCenter = cellCenter

-- one time step: the tool is at (u, v), grinding = button held. Returns the zone the tool is in (or nil).
function Porting.grind(s, u, v, dt, grinding)
	if not grinding then return nil end
	s.t = s.t + dt
	local hit = nil
	for _, z in ipairs(Porting.ZONES) do
		if u >= z.u[1] - Porting.RADIUS and u <= z.u[2] + Porting.RADIUS and v >= z.v[1] - Porting.RADIUS and v <= z.v[2] + Porting.RADIUS then
			hit = z
			for i = 1, Porting.CU * Porting.CV do
				local cu, cv = cellCenter(z, i)
				local d = math.sqrt((cu - u) ^ 2 + (cv - v) ^ 2)
				local cellR = math.max((z.u[2] - z.u[1]) / Porting.CU, (z.v[2] - z.v[1]) / Porting.CV) * 0.6
				if d < Porting.RADIUS + cellR then
					local w = 1 - d / (Porting.RADIUS + cellR)
					s.cells[z.id][i] = s.cells[z.id][i] + Porting.RATE * w * dt
				end
			end
		end
	end
	if hit then s.on = s.on + dt else s.off = s.off + dt end
	return hit
end

function Porting.zoneProgress(s, zid)
	local t = 0
	for _, w in ipairs(s.cells[zid]) do t = t + math.min(1, w) end
	return t / (Porting.CU * Porting.CV)
end

-- result: coverage (0..1), evenness, precision, over (share of cells over 1.4), q (0..1), deg (raised timing)
function Porting.result(s)
	local all, sum, over = {}, 0, 0
	for _, z in ipairs(Porting.ZONES) do for _, w in ipairs(s.cells[z.id]) do table.insert(all, w); sum = sum + math.min(1, w); if w > 1.4 then over = over + 1 end end end
	local nCells = #all
	local coverage = sum / nCells
	local mean = 0
	for _, w in ipairs(all) do mean = mean + math.min(1.6, w) end
	mean = mean / nCells
	local var = 0
	for _, w in ipairs(all) do var = var + (math.min(1.6, w) - mean) ^ 2 end
	local sd = math.sqrt(var / nCells)
	local evenness = math.max(0, 1 - sd / 0.5)
	local precision = (s.on + s.off) > 0 and s.on / (s.on + s.off) or 0
	local overShare = over / nCells
	local q = math.max(0, math.min(1, (0.4 * evenness + 0.4 * precision + 0.2 * (1 - overShare)) * coverage * (0.85 + 0.15 * s.steady)))
	local deg = 4 * coverage * (1 - 0.5 * overShare)
	local label = q > 0.8 and "Utmärkt" or q > 0.6 and "Bra" or q > 0.35 and "Okej" or "Dålig"
	return { coverage = coverage, evenness = evenness, precision = precision, over = overShare, q = q, deg = deg, label = label }
end

return Porting
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">RideSim</string><ProtectedString name="Source"><![CDATA[-- Riding physics without Roblox services (testable): engine, CVT/gears, temperature, wheelie and crash.
-- Ported from the web version's step(). Events (engine/crash/wheelie/dmg/dirty/say) go out via sim.emit.
local Config = require(script.Parent.Config)
local Engine = require(script.Parent.Engine)
local Economy = require(script.Parent.Economy)
local W = Config.WHEELIE
local RideSim = {}

function RideSim.new(emit)
	local R = { v = 0, rpm = 0, thr = 0, gear = 1, ratio = 2.9, h = 0, lean = 0, pitch = 0, pw = 0, on = false, crash = nil, wh = nil,
		t0 = nil, t60 = nil, clk = 0, pullT = 0, pull0 = false, acc = 0, thermal = {}, emit = emit or function() end, lastDmg = 0, lastDirty = -99 }
	for _, m in ipairs(Config.MOPEDS) do R.thermal[m.id] = Engine.newThermal() end
	return R
end

-- load the engine for the current moped from a profile
function RideSim.setProfile(R, p)
	R.mop = Config.BY_ID[p.cur]
	R.E = Economy.ecfg(p, p.cur)
	R.P = Economy.engine(p, p.cur)
	-- the client calculates damage; only a repair on the server (p.rep counter) may lower it
	local th = R.thermal[p.cur]
	local dmg = p.mopeds[p.cur] and p.mopeds[p.cur].dmg or 0
	if R.rep ~= (p.rep or 0) then R.rep = p.rep or 0; th.dmg = dmg; R.lastDmg = th.dmg
	else th.dmg = math.max(th.dmg, dmg) end
end

function RideSim.kick(R, tries, rand)
	rand = rand or math.random
	local P = R.P
	if R.on or R.v > 3 or R.crash or not P then return false end
	if R.thermal[R.mop.id].dmg >= 1 then R.emit("say", "Motorn har skurit. Reparera den i garaget."); return false end
	local p = math.max(0.08, 0.18 + 0.62 * P.fuelF - (P.m > 1.3 and 0.15 or 0))
	for _ = 1, tries or 1 do
		if rand() < p then R.on = true; R.rpm = 2600; R.emit("engine", true); R.emit("say", "Motorn startade!"); return true end
	end
	R.emit("say", "Kick... den startade inte" .. (P.m < 0.9 and " (för mager?)" or P.m > 1.15 and " (för fet?)" or ""))
	return false
end
function RideSim.stop(R) if R.on then R.on = false; R.emit("engine", false); R.emit("say", "Motorn stängdes av") end end

local function crash(R, why)
	if R.crash then return end
	R.crash = { t = 0, why = why, side = R.lean < 0 and -1 or 1 }
	R.on, R.wh = false, nil
	R.emit("engine", false)
	R.emit("crash", why)
	R.emit("say", "VURPA: " .. why)
end

-- estimate for the HUD during the wheelie (assumes a soft landing; the server calculates the real reward)
function RideSim.whValue(w)
	if w.t < W.minT or w.n == 0 then return 0, 0 end
	return Economy.wheelieValue(w.t, w.vs / w.t, math.sqrt(math.max(0, w.s2 / w.n - (w.s1 / w.n) ^ 2)), 0)
end

local function land(R, imp)
	local w = R.wh
	R.wh = nil
	if imp > 4.5 then crash(R, "för hård landning"); return end
	if w.t < W.minT then R.emit("say", string.format("Kort lyft (%.1f s), räknas inte", w.t)); return end
	R.emit("wheelie", w.t, w.vs / w.t, math.sqrt(math.max(0, w.s2 / w.n - (w.s1 / w.n) ^ 2)), imp)
end

-- moment balance about the rear axle
local function wheelie(R, dt, a, thr, brk, back)
	local mop = R.mop
	local h = W.h[mop.id]
	back = back and R.on and brk == 0
	local b = mop.wb * W.fr - (back and W.back or 0)
	local mass = mop.m + 75
	local I = mass * (h * h + b * b)
	if back and not R.pull0 then R.pull0 = true; R.pullT = thr > 0.5 and W.pullT or 0 end
	if not back then R.pull0 = false end
	local Mr = R.pullT > 0 and W.pull or 0
	R.pullT = math.max(0, R.pullT - dt)
	local n = 4
	local d = dt / n
	for _ = 1, n do
		local th = R.pitch
		local M = mass * a * (h * math.cos(th) + b * math.sin(th)) - mass * 9.81 * (b * math.cos(th) - h * math.sin(th)) + Mr - W.damp * I * R.pw
		if th <= 0 and M <= 0 then R.pitch, R.pw = 0, 0
		else
			R.pw = R.pw + M / I * d
			R.pitch = R.pitch + R.pw * d
			if R.pitch <= 0 then local imp = -R.pw; R.pitch, R.pw = 0, 0; if R.wh then land(R, imp) end end
		end
	end
	if R.pitch > math.atan2(b, h) + W.over then crash(R, "tippade bakåt i en stegring"); return end
	if R.pitch > 0.035 and not R.crash then
		if not R.wh then R.wh = { t = 0, all = 0, vs = 0, s1 = 0, s2 = 0, n = 0 } end
		local w = R.wh
		w.all = w.all + dt
		if R.v >= W.minV and R.on then w.t = w.t + dt; w.vs = w.vs + R.v * dt; w.s1 = w.s1 + R.pitch; w.s2 = w.s2 + R.pitch * R.pitch; w.n = w.n + 1 end
	end
end

local function heat(R, dt, Tq, v)
	for _, m in ipairs(Config.MOPEDS) do
		local active = m.id == R.mop.id
		local on = active and R.on
		local rpm = on and R.rpm or 0
		Engine.therm(m, R.thermal[m.id], dt, on and Engine.heatIn(R.P, Tq, rpm) or 0, rpm, active and v or 0, active and R.E.cf or 1)
	end
	local s = R.thermal[R.mop.id]
	if R.on and s.dmg >= 1 then R.on = false; R.emit("engine", false); R.emit("say", "Kolvskär! Motorn skar av överhettning. Reparera den i garaget.") end
	if math.abs(s.dmg - R.lastDmg) >= 0.01 then R.lastDmg = s.dmg; R.emit("dmg", s.dmg) end
	local band = Engine.tinfo(R.mop, s).band
	if (band == "varm" or band == "ÖVERHETTAD" or band == "KOKAR") and R.clk - R.lastDirty > 5 then R.lastDirty = R.clk; R.emit("dirty") end
end

-- input: { thr = 0/1, brk = 0/1, st = -1..1, back = bool }
function RideSim.step(R, dt, seated, input)
	local P, E, mop = R.P, R.E, R.mop
	R.thr = R.thr + (input.thr - R.thr) * math.min(1, dt * (2 + 8 * P.resp))
	local thr = R.thr
	R.clk = R.clk + dt
	if not seated then
		local goal = (not R.on) and 0 or (thr > 0.02 and 1800 + thr * (P.pk * 1.05 - 1800) or 1800)
		R.rpm = R.rpm + (goal - R.rpm) * math.min(1, dt * (R.on and 3 + 9 * P.resp or 4))
		heat(R, dt, R.on and Engine.torque(P, R.rpm) * (0.15 + 0.85 * thr) * Engine.heatF(R.thermal[mop.id]) * 0.25 or 0, 0)
		R.v, R.pitch, R.pw = 0, 0, 0
		return
	end
	if R.crash then
		local c = R.crash
		c.t = c.t + dt
		R.v = math.max(0, R.v - 7 * dt)
		R.pitch = math.max(0, R.pitch - 3 * dt)
		R.rpm = math.max(0, R.rpm - 4000 * dt)
		heat(R, dt, 0, R.v)
		if c.t > 2.5 then R.crash, R.lean, R.pitch, R.pw = nil, 0, 0, 0; R.emit("say", "Mopeden är uppe igen. K = starta") end
		return
	end
	local wheelRpm = R.v / (2 * math.pi * mop.wr) * 60
	local tot, des
	local tg = Engine.target(E) * (0.55 + 0.45 * math.max(thr, 0.2))
	if mop.cvt then
		R.ratio = math.min(2.9, math.max(E.rmin, tg / math.max(wheelRpm * mop.fd, 1)))
		tot = R.ratio * mop.fd
		des = math.max(wheelRpm * tot, thr > 0.05 and math.min(tg, E.slip * (0.55 + 0.45 * thr)) or 1800)
	else
		tot = Config.GEARS[R.gear] * mop.fd
		des = math.max(wheelRpm * tot, thr > 0.05 and 2200 + thr * (P.pk - 2200) or 1800)
	end
	if not R.on then des = 0 end
	R.rpm = R.rpm + (des - R.rpm) * math.min(1, dt * (R.on and 3 + 9 * P.resp or 3))
	R.rpm = math.min(R.rpm, P.lim * 1.03)
	local Tq = Engine.torque(P, R.rpm) * (0.15 + 0.85 * thr)
	if thr < 0.02 and not mop.cvt then Tq = -0.5 end
	Tq = Tq * Engine.heatF(R.thermal[mop.id])
	if not R.on then Tq = 0 end
	local mass = mop.m + 75
	local eff = mop.cvt and 0.85 * (1 - math.min(0.15, math.max(0, (P.hp - E.blim) * 0.03))) or 0.85 -- a weak belt slips
	local F = Tq * tot * eff / mop.wr
	local drag = 0.33 * R.v * R.v + 0.015 * mass * 9.8
	R.acc = (F - (R.v > 0 and drag or 0)) / mass
	local a = R.acc - input.brk * 6.5
	if R.v <= 0 and a < 0 then a = 0 end
	R.v = math.max(0, R.v + a * dt)
	heat(R, dt, math.max(0, Tq), R.v)
	R.h = R.h - input.st * (1 - R.pitch * 0.6) * 1.6 * math.min(1, R.v / 1.5) / (1 + R.v * 0.12) * dt
	R.lean = R.lean + ((input.st * math.min(R.v, 18) * 0.025) - R.lean) * math.min(1, dt * 5)
	wheelie(R, dt, a, thr, input.brk, input.back)
	if R.v < 0.1 and thr > 0.5 and R.on and R.t0 == nil then R.t0 = R.clk end
	if R.v < 0.1 and thr < 0.1 then R.t0 = nil end
	if R.t0 and R.v >= 16.67 then R.t60 = R.clk - R.t0; R.t0 = nil end
end

return RideSim
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX20"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX18"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Server: profiles, player garages, physical parts, engine/moped assembly, shop and delivery, porting, paint, riding.
-- Everything the client does is checked here (rules in Economy/Assembly + distance to the player + own garage).
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local PhysicsService = game:GetService("PhysicsService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Economy = require(Shared.Economy)
local Builder = require(Shared.Builder)
local GarageBuilder = require(Shared.GarageBuilder)
local S = 1 / Config.STUD
local REACH = 14 -- studs: how far from an object the player may act

pcall(function()
	PhysicsService:RegisterCollisionGroup("Rider")
	PhysicsService:CollisionGroupSetCollidable("Rider", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("Rider", "Rider", false)
end)
local function setRider(char, on) for _, d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then d.CollisionGroup = on and "Rider" or "Default" end end end

local remotes = Instance.new("Folder"); remotes.Name = "Remotes"; remotes.Parent = RS
local Api = Instance.new("RemoteFunction"); Api.Name = "Api"; Api.Parent = remotes
local StateEv = Instance.new("RemoteEvent"); StateEv.Name = "State"; StateEv.Parent = remotes
local Report = Instance.new("RemoteEvent"); Report.Name = "Report"; Report.Parent = remotes

local store
pcall(function() store = DataStoreService:GetDataStore("MoppeMekaniker_v2") end)
if not store then warn("DataStore är inte tillgänglig: inget sparas") end

-- ---------- garages ----------
local plotsFolder = Instance.new("Folder"); plotsFolder.Name = "Garages"; plotsFolder.Parent = workspace
local PLOTS = {}
for i, pl in ipairs(Config.PLOTS) do
	local origin = CFrame.new(pl.x * S, 0, -pl.z * S)
	local refs = GarageBuilder.build(plotsFolder, origin, i)
	local dyn = Instance.new("Folder"); dyn.Name = "Dynamic"; dyn.Parent = refs.model
	refs.dyn = dyn
	PLOTS[i] = { refs = refs, owner = nil }
end

local profiles, sessions = {}, {}
local function now() return os.time() end
local function public(plr)
	local s = sessions[plr]
	local o = Economy.public(profiles[plr])
	o._plot, o._carry, o._out = s.plot, s.carry, s.out
	return o
end
local function push(plr, msg)
	if profiles[plr] then StateEv:FireClient(plr, public(plr), msg) end
end

-- ---------- drawing a garage's contents ----------
local function M2(x) return x * S end
local function hand(char) return char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")) end
local function anchorAt(model, cf)
	model:PivotTo(cf)
	for _, p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then p.Anchored = true; p.CanQuery = true end end
end
local function itemModel(plr, u)
	local it = profiles[plr].items[u]
	local m = Builder.item(it.s, it)
	m.Name = "Item_" .. u
	m:SetAttribute("Item", u); m:SetAttribute("Plot", sessions[plr].plot); m:SetAttribute("Interact", "item")
	if it.dry then m:SetAttribute("Wet", true) end
	return m
end
local function slotsFor(refs, loc)
	if loc == "bench" then local t = {}; for _, c in ipairs(refs.standTray) do table.insert(t, c) end; for _, c in ipairs(refs.benchSlots) do table.insert(t, c) end; return t end
	if loc == "shelf" then return refs.shelfSlots end
	if loc == "floor" then return refs.floorSlots end
	if loc == "booth" then return { refs.booth } end
	if loc == "portbench" then return { refs.portbench } end
	return nil
end
local function mopedView(p, id)
	local mp = p.mopeds[id]
	local v = { mopId = id, ch = {}, eng = nil }
	for sock, u in pairs(mp.ch) do if u ~= "engine" and p.items[u] then v.ch[sock] = { sku = p.items[u].s, item = u, data = p.items[u] } end end
	if mp.engAt == "moped" then v.eng = {}; for sock, u in pairs(mp.eng) do if p.items[u] then v.eng[sock] = { sku = p.items[u].s, item = u, data = p.items[u] } end end end
	return v
end
-- the current moped: drivable (unanchored, upright via AlignOrientation), the client owns its physics
local function physicalMoped(plr, model, cf)
	local root = model.PrimaryPart
	local mop = Config.BY_ID[model:GetAttribute("Moped")]
	model:PivotTo(cf * CFrame.new(0, (mop.wr + 0.15) * S + 0.05, 0))
	local att = Instance.new("Attachment"); att.Name = "Drive"; att.Parent = root
	local lv = Instance.new("LinearVelocity"); lv.Name = "Drive"; lv.Attachment0 = att; lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis, lv.SecondaryTangentAxis = Vector3.new(1, 0, 0), Vector3.new(0, 0, 1)
	lv.RelativeTo = Enum.ActuatorRelativeTo.World; lv.MaxForce = 2e4; lv.PlaneVelocity = Vector2.new(0, 0); lv.Parent = root
	local ao = Instance.new("AlignOrientation"); ao.Name = "Tilt"; ao.Mode = Enum.OrientationAlignmentMode.OneAttachment; ao.Attachment0 = att
	ao.Responsiveness = 40; ao.MaxTorque = 1e6; ao.RigidityEnabled = false; ao.CFrame = cf.Rotation; ao.Parent = root
	local owner = Instance.new("ObjectValue"); owner.Name = "Owner"; owner.Value = plr; owner.Parent = model
	model.Parent = workspace
	for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") then pcall(function() d:SetNetworkOwner(plr) end) end end
	local seat = model:FindFirstChild("Seat")
	if seat then
		local last
		seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			local hum = seat.Occupant
			if hum and hum.Parent then last = hum.Parent; setRider(last, true) elseif last then setRider(last, false); last = nil end
		end)
	end
end

local function render(plr, what)
	local p, s = profiles[plr], sessions[plr]
	if not (p and s and s.plot) then return end
	local refs = PLOTS[s.plot].refs
	what = what or "all"
	-- loose parts
	if what == "all" or what == "items" then
		for _, c in ipairs(refs.dyn:GetChildren()) do if c.Name:sub(1, 5) == "Item_" or c.Name:sub(1, 4) == "Box_" then c:Destroy() end end
		local byLoc = {}
		for u, it in pairs(p.items) do if u ~= s.carry then byLoc[it.loc] = byLoc[it.loc] or {}; table.insert(byLoc[it.loc], u) end end
		for loc, list in pairs(byLoc) do
			table.sort(list, function(a, b) return (tonumber(a:sub(2)) or 0) < (tonumber(b:sub(2)) or 0) end)
			local slots = slotsFor(refs, loc)
			if slots then
				for i, u in ipairs(list) do
					local m = itemModel(plr, u)
					local slot = slots[(i - 1) % #slots + 1] * CFrame.new(0, math.floor((i - 1) / #slots) * 0.6, 0)
					local _, size = m:GetBoundingBox()
					anchorAt(m, slot * CFrame.new(0, size.Y / 2, 0))
					m.Parent = refs.dyn
				end
			end
		end
		-- delivery boxes outside the door
		local n = 0
		for _, o in ipairs(p.orders) do
			if o.state == "arrived" then
				n = n + 1
				local box = Instance.new("Part"); box.Name = "Box_" .. o.id; box.Size = Vector3.new(M2(0.7), M2(0.5), M2(0.5)); box.Anchored = true
				box.CFrame = refs.delivery * CFrame.new((n - 1) * M2(0.9), M2(0.25), 0); box.Color = Color3.fromRGB(176, 136, 90); box.Material = Enum.Material.Fabric
				box:SetAttribute("Interact", "box"); box:SetAttribute("Order", o.id); box:SetAttribute("Plot", s.plot); box:SetAttribute("Hint", "Öppna leveransen")
				local tape = Instance.new("Part"); tape.Size = Vector3.new(box.Size.X + 0.02, 0.06, M2(0.08)); tape.CFrame = box.CFrame * CFrame.new(0, box.Size.Y / 2, 0); tape.Anchored = true; tape.Color = Color3.fromRGB(200, 170, 80); tape.Parent = box
				box.Parent = refs.dyn
			end
		end
		-- the carried part in the hand
		if s.carry and p.items[s.carry] and plr.Character then
			local old = plr.Character:FindFirstChild("Carried"); if old then old:Destroy() end
			local h = hand(plr.Character)
			if h then
				local m = itemModel(plr, s.carry); m.Name = "Carried"
				m:PivotTo(h.CFrame * CFrame.new(0, -0.4, -0.6))
				for _, d in ipairs(m:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = false; d.Massless = true; d.CanCollide = false; d.CanQuery = false end end
				local w = Instance.new("WeldConstraint"); w.Part0, w.Part1 = h, m.PrimaryPart; w.Parent = m.PrimaryPart
				m.Parent = plr.Character
			end
		elseif plr.Character and plr.Character:FindFirstChild("Carried") then plr.Character.Carried:Destroy() end
	end
	-- the engine on the stand
	if what == "all" or what == "engine" then
		local old = refs.dyn:FindFirstChild("Engine"); if old then old:Destroy() end
		if p.stand then
			local map = {}
			for sock, u in pairs(p.mopeds[p.stand].eng) do if p.items[u] then map[sock] = { sku = p.items[u].s, item = u, data = p.items[u] } end end
			local e = Builder.engine(refs.dyn, refs.stand, p.stand, map, true)
			e:SetAttribute("Interact", "engine"); e:SetAttribute("Plot", s.plot); e:SetAttribute("Moped", p.stand)
		end
	end
	-- mopeds: the current one drivable at the moped spot, the others parked
	if what == "all" or what == "moped" then
		for _, c in ipairs(refs.dyn:GetChildren()) do if c.Name:sub(1, 7) == "Parked_" then c:Destroy() end end
		if not s.out then
			if s.moped then s.moped:Destroy(); s.moped = nil end
			if p.mopeds[p.cur] then
				local m = Builder.moped(mopedView(p, p.cur))
				m.Name = "Moped_" .. plr.Name
				m:SetAttribute("Interact", "moped"); m:SetAttribute("Plot", s.plot)
				if Economy.canRide(p, p.cur) then physicalMoped(plr, m, refs.moped)
				else
					-- not complete: stands still as if on a work stand (without wheels it would otherwise fall through the floor)
					local mop = Config.BY_ID[p.cur]
					anchorAt(m, refs.moped * CFrame.new(0, (mop.wr + 0.15) * S, 0))
					m.Parent = workspace
				end
				s.moped = m
			end
		end
		local k = 0
		for id, mp in pairs(p.mopeds) do
			if id ~= p.cur and mp.own then
				k = k + 1
				local spot = refs.parking[k]
				if spot then
					local m = Builder.moped(mopedView(p, id)); m.Name = "Parked_" .. id
					m:SetAttribute("Interact", "parked"); m:SetAttribute("Plot", s.plot)
					local mop = Config.BY_ID[id]
					anchorAt(m, spot * CFrame.new(0, (mop.wr + 0.15) * S, 0))
					m.Parent = refs.dyn
				end
			end
		end
	end
end

-- ---------- validation helpers ----------
local function near(plr, pos, dist)
	local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	return hrp ~= nil and (hrp.Position - pos).Magnitude <= (dist or REACH)
end
local function inGarage(plr)
	local s = sessions[plr]
	return s.plot and near(plr, PLOTS[s.plot].refs.origin.Position, 60)
end
local function mopedHome(plr)
	local s = sessions[plr]
	return s.moped and s.moped.Parent and not s.out and (s.moped:GetPivot().Position - PLOTS[s.plot].refs.moped.Position).Magnitude < 20
end

-- ---------- API ----------
local H = {}
H.state = function() return true end
H.pickup = function(plr, u)
	local p, s = profiles[plr], sessions[plr]
	local it = p.items[u]
	if s.carry then return false, "Du bär redan något" end
	if not it then return false, "Okänd del" end
	if it.loc:sub(1, 4) == "eng:" or it.loc:sub(1, 3) == "ch:" or it.loc == "tool" then return false, "Delen sitter monterad" end
	if it.loc:sub(1, 4) == "box:" then return false, "Öppna lådan först" end
	local m = PLOTS[s.plot].refs.dyn:FindFirstChild("Item_" .. u)
	if not m or not near(plr, m:GetPivot().Position) then return false, "För långt bort" end
	s.carry = u
	render(plr, "items")
	return true
end
H.place = function(plr, loc)
	local p, s = profiles[plr], sessions[plr]
	if not s.carry then return false, "Du bär ingenting" end
	if not inGarage(plr) then return false, "Gå in i ditt garage" end
	local target = loc == "booth" and PLOTS[s.plot].refs.booth or loc == "portbench" and PLOTS[s.plot].refs.portbench or nil
	if target and not near(plr, target.Position) then return false, "För långt bort" end
	local ok, err = Economy.move(p, s.carry, loc)
	if not ok then return false, err end
	s.carry = nil
	render(plr, "items")
	return true, loc == "booth" and "Kåpan ligger i lackboxen" or loc == "portbench" and "Cylindern ligger på portningsbänken" or nil
end
H.mountEngine = function(plr, u, sock)
	local p, s = profiles[plr], sessions[plr]
	if not near(plr, PLOTS[s.plot].refs.stand.Position, 18) then return false, "Gå fram till motorstativet" end
	if u ~= s.carry then
		local m = PLOTS[s.plot].refs.dyn:FindFirstChild("Item_" .. tostring(u))
		if not m or not near(plr, m:GetPivot().Position, 18) then return false, "Delen ligger för långt bort" end
	end
	local ok, err = Economy.mountEngine(p, u, sock)
	if not ok then return false, err end
	if s.carry == u then s.carry = nil end
	render(plr, "items"); render(plr, "engine")
	if #Economy.engineMissing(p, p.stand) == 0 then return true, "Motorn är komplett! Klicka på mopeden för att montera den." end
	return true
end
H.unmountEngine = function(plr, sock)
	local p, s = profiles[plr], sessions[plr]
	if not near(plr, PLOTS[s.plot].refs.stand.Position, 18) then return false, "Gå fram till motorstativet" end
	local ok, err = Economy.unmountEngine(p, sock, "bench")
	if not ok then return false, err end
	render(plr, "items"); render(plr, "engine")
	return true
end
H.mountMoped = function(plr, u, sock)
	local p, s = profiles[plr], sessions[plr]
	if not mopedHome(plr) or not near(plr, s.moped:GetPivot().Position, 18) then return false, "Gå fram till mopeden i garaget" end
	local ok, err = Economy.mountMoped(p, u, p.cur, sock)
	if not ok then return false, err end
	if s.carry == u then s.carry = nil end
	render(plr, "items"); render(plr, "moped")
	return true
end
H.unmountMoped = function(plr, sock)
	local p, s = profiles[plr], sessions[plr]
	if not mopedHome(plr) or not near(plr, s.moped:GetPivot().Position, 18) then return false, "Gå fram till mopeden i garaget" end
	local ok, err = Economy.unmountMoped(p, p.cur, sock, "bench")
	if not ok then return false, err end
	render(plr, "items"); render(plr, "moped")
	return true, "Lagd på arbetsbänken"
end
H.engineToStand = function(plr)
	local p = profiles[plr]
	if not mopedHome(plr) then return false, "Mopeden måste stå i garaget" end
	local ok, err = Economy.engineToStand(p, p.cur)
	if not ok then return false, err end
	render(plr)
	return true, "Motorn sitter i motorstativet"
end
H.engineToMoped = function(plr)
	local p = profiles[plr]
	if p.stand ~= p.cur then return false, "Välj mopeden som motorn hör till" end
	if not mopedHome(plr) then return false, "Mopeden måste stå i garaget" end
	local ok, err = Economy.engineToMoped(p)
	if not ok then return false, err end
	render(plr)
	return true, "Motorn monterad i mopeden"
end
H.order = function(plr, lines)
	local p = profiles[plr]
	local ok, err, o = Economy.order(p, lines, now())
	if not ok then return false, err end
	return true, "Beställning " .. o.id .. " skickad. Leverans om " .. math.ceil((o.eta - now()) / 60) .. " min."
end
H.openBox = function(plr, oid)
	local p, s = profiles[plr], sessions[plr]
	if not near(plr, PLOTS[s.plot].refs.delivery.Position, 18) then return false, "Gå till leveranslådan" end
	local ok, err = Economy.openBox(p, oid)
	if not ok then return false, err end
	render(plr, "items")
	return true, "Lådan öppnad, delarna ligger bredvid"
end
H.portStart = function(plr, training)
	local p, s = profiles[plr], sessions[plr]
	if not near(plr, PLOTS[s.plot].refs.portbench.Position, 18) then return false, "Gå till portningsbänken" end
	local tool = Economy.hasTool(p, "grinder")
	if not tool then return false, "Du behöver en slipmaskin (finns i butiken)" end
	local cyl = nil
	for u, it in pairs(p.items) do if it.loc == "portbench" then cyl = u end end
	if not training and not cyl then return false, "Lägg en cylinder på portningsbänken" end
	if not training and p.items[cyl].port then return false, "Cylindern är redan portad" end
	s.portT0, s.portItem = os.clock(), (not training) and cyl or nil
	return true, tool.val.steady
end
H.portDone = function(plr, res)
	local p, s = profiles[plr], sessions[plr]
	if not s.portT0 then return false, "Ingen portning pågår" end
	local t = os.clock() - s.portT0
	local u = s.portItem
	s.portT0, s.portItem = nil, nil
	if not u then return true, "Träningen är klar" end
	if type(res) ~= "table" or t < 8 then return false, "Portningen gick för fort, inget ändrades" end
	local ok, err = Economy.applyPort(p, u, res)
	if not ok then return false, err end
	render(plr, "items")
	return true, "Portningen sparad: " .. tostring(p.items[u].port.label)
end
H.paintStart = function(plr)
	local p, s = profiles[plr], sessions[plr]
	if not near(plr, PLOTS[s.plot].refs.booth.Position, 18) then return false, "Gå till lackboxen" end
	local tool = Economy.hasTool(p, "spray")
	if not tool then return false, "Du behöver en sprutpistol" end
	for u, it in pairs(p.items) do if it.loc == "booth" then s.paintT0, s.paintItem = os.clock(), u; return true, tool.val.even end end
	return false, "Lägg en kåpa i lackboxen"
end
H.paintDone = function(plr, col, fin, q)
	local p, s = profiles[plr], sessions[plr]
	if not s.paintT0 then return false, "Ingen lackering pågår" end
	local t, u = os.clock() - s.paintT0, s.paintItem
	s.paintT0, s.paintItem = nil, nil
	if t < 4 then return false, "Lackeringen gick för fort, inget ändrades" end
	local ok, err = Economy.applyPaint(p, u, col, fin, q, now())
	if not ok then return false, err end
	render(plr, "items")
	return true, "Lackerad! Låt lacken torka " .. Config.PAINT_DRY .. " s"
end
H.saveDesign = function(plr, name) local p = profiles[plr]; return Economy.saveDesign(p, p.cur, name) end
H.applyDesign = function(plr, name)
	local ok, err = Economy.applyDesign(profiles[plr], name)
	if ok and mopedHome(plr) then render(plr, "moped") end
	return ok, err
end
H.select = function(plr, id)
	local p, s = profiles[plr], sessions[plr]
	if not p.mopeds[id] then return false, "Du äger inte mopeden" end
	if s.out then return false, "Kör tillbaka till garaget först (R)" end
	p.cur = id
	render(plr, "moped")
	return true
end
H.ride = function(plr)
	local p, s = profiles[plr], sessions[plr]
	if not Economy.canRide(p, p.cur) then
		local miss = Economy.mopedMissing(p, p.cur)
		return false, "Mopeden är inte färdig. Saknas: " .. table.concat(miss, ", ")
	end
	if not s.moped then render(plr, "moped") end
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum and s.moped and s.moped:FindFirstChild("Seat") then s.moped.Seat:Sit(hum); s.out = true end
	return true
end
H.home = function(plr)
	local s = sessions[plr]
	s.out = false
	render(plr, "moped")
	return true
end
H.buyMoped = function(plr, id) local ok, err = Economy.buyMoped(profiles[plr], id, now()); if ok then render(plr, "moped") end; return ok, err end
H.sellMoped = function(plr, id) local ok, err = Economy.sellMoped(profiles[plr], id, now()); if ok then sessions[plr].out = false; render(plr) end; return ok, err end
H.sell = function(plr, u)
	local s = sessions[plr]
	if s.carry == u then return false, "Lägg ner delen först" end
	local ok, err = Economy.sell(profiles[plr], u, now()); if ok then render(plr, "items") end; return ok, err
end
H.repair = function(plr, emergency) local p = profiles[plr]; return Economy.repair(p, p.cur, emergency == true, now()) end
H.setJet = function(plr, jet) local p = profiles[plr]; return Economy.setJet(p, p.cur, jet) end
H.save = function(plr) return true, "Sparas automatiskt" end

Api.OnServerInvoke = function(plr, action, ...)
	if not profiles[plr] or not sessions[plr] or not sessions[plr].plot then return false, "Profilen laddas" end
	local h = type(action) == "string" and H[action]
	if not h then return false, "Okänt anrop" end
	local ok, a, b = pcall(h, plr, ...)
	if not ok then warn("Fel i " .. action .. ": " .. tostring(a)); return false, "Serverfel" end
	push(plr, type(b) == "string" and b or nil)
	return a, b
end

-- reports from the client while riding (checked against what the server sees)
Report.OnServerEvent:Connect(function(plr, kind, a, b, c, d)
	local p, s = profiles[plr], sessions[plr]
	if not p then return end
	if kind == "engine" then s.engineOn = a == true
	elseif kind == "dmg" then if type(a) == "number" and p.mopeds[p.cur] then p.mopeds[p.cur].dmg = math.clamp(a, 0, 1) end
	elseif kind == "dirty" then Economy.dirty(p)
	elseif kind == "crash" then Economy.crash(p, tostring(a):sub(1, 60), now()); push(plr)
	elseif kind == "wheelie" then
		local seen, t0 = 0, os.clock() - (tonumber(a) or 0)
		for _, e in ipairs(s.distLog) do if e[1] >= t0 then seen = seen + e[2] end end
		local r, why = Economy.wheelie(p, a, b, c, d, now(), seen)
		push(plr, r > 0 and ("Stegring: +" .. r .. " kr") or why)
	end
end)

-- ---------- loops: distance, delivery, drying ----------
local acc, tickAcc = 0, 0
RunService.Heartbeat:Connect(function(dt)
	acc, tickAcc = acc + dt, tickAcc + dt
	if acc >= 0.5 then
		local step = acc; acc = 0
		for plr, s in pairs(sessions) do
			local p, m = profiles[plr], s.moped
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			local seated = m and m.Parent and hum and hum.SeatPart == m:FindFirstChild("Seat")
			if seated then s.out = true
			elseif s.out and m and m.Parent and s.plot and (m:GetPivot().Position - PLOTS[s.plot].refs.moped.Position).Magnitude < 25 then s.out = false end -- parked at home again
			if seated and s.engineOn then
				local pos = m:GetPivot().Position
				if s.last then
					local d = Vector3.new(pos.X - s.last.X, 0, pos.Z - s.last.Z).Magnitude * Config.STUD
					if d / step <= Config.ECON.maxSpeed then
						local got = Economy.addDistance(p, d, now())
						p.stats.top = math.max(p.stats.top, d / step)
						table.insert(s.distLog, { os.clock(), d })
						if got > 0 then push(plr) end
					end
				end
				s.last = pos
			else s.last = nil end
			while #s.distLog > 0 and os.clock() - s.distLog[1][1] > 130 do table.remove(s.distLog, 1) end
		end
	end
	if tickAcc >= 1 then
		tickAcc = 0
		for plr, p in pairs(profiles) do
			local arrived = Economy.tick(p, now())
			local wet = false
			for _, it in pairs(p.items) do if it.dry then wet = true end end
			Economy.dryTick(p, now())
			if #arrived > 0 then render(plr, "items"); push(plr, "Leverans! Paketet står utanför garageporten.") end
			if wet then local still = false; for _, it in pairs(p.items) do if it.dry then still = true end end; if not still then render(plr, "items"); push(plr, "Lacken har torkat") end end
		end
	end
end)

-- ---------- join/leave ----------
local function load(plr)
	local raw, ok = nil, false
	if store then
		for attempt = 1, 3 do
			ok = pcall(function() raw = store:GetAsync("p_" .. plr.UserId) end)
			if ok then break end
			task.wait(attempt)
		end
	end
	profiles[plr] = Economy.load(raw)
	sessions[plr] = { saveOk = store ~= nil and ok, distLog = {}, out = false }
	for i, pl in ipairs(PLOTS) do
		if not pl.owner then pl.owner = plr; sessions[plr].plot = i; pl.refs.sign.Text = string.upper(plr.DisplayName) .. "S GARAGE"; break end
	end
	if not sessions[plr].plot then warn("Alla garage är upptagna") end
end
local function save(plr)
	local p, s = profiles[plr], sessions[plr]
	if not (p and s and store and s.saveOk) then return end
	local ok, err = pcall(function() store:SetAsync("p_" .. plr.UserId, Economy.public(p)) end)
	if not ok then warn("Kunde inte spara " .. plr.Name .. ": " .. tostring(err)) end
end
local function onAdded(plr)
	if profiles[plr] then return end
	load(plr)
	local function spawnChar(char)
		local s = sessions[plr]
		if not s or not s.plot then return end
		local hrp = char:WaitForChild("HumanoidRootPart", 10)
		if hrp then hrp.CFrame = PLOTS[s.plot].refs.spawn + Vector3.new(0, 3, 0) end
		s.out, s.carry = false, nil
		task.wait(0.5)
		render(plr)
		push(plr)
	end
	plr.CharacterAdded:Connect(spawnChar)
	if plr.Character then task.spawn(spawnChar, plr.Character) end
	push(plr, store and (sessions[plr].saveOk and "Välkommen till ditt garage!" or "Sparningen kunde inte läsas, inget sparas den här gången") or "Sparning är avstängd (DataStore saknas i Studio)")
end
Players.PlayerAdded:Connect(onAdded)
for _, plr in ipairs(Players:GetPlayers()) do task.spawn(onAdded, plr) end
Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	local s = sessions[plr]
	if s then
		if s.moped then s.moped:Destroy() end
		if s.plot then PLOTS[s.plot].owner = nil; PLOTS[s.plot].refs.sign.Text = "LEDIGT GARAGE"; PLOTS[s.plot].refs.dyn:ClearAllChildren() end
	end
	profiles[plr], sessions[plr] = nil, nil
end)
game:BindToClose(function() for plr in pairs(profiles) do save(plr) end end)
task.spawn(function() while true do task.wait(60); for plr in pairs(profiles) do save(plr) end end end)
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX19"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- The open world (the garages themselves are built by Main via GarageBuilder):
-- terrain with hills and a lake, the industrial street in front of the garages, drag strip and ring track (test track),
-- industrial area, country road with fields and a farm, car park, petrol station, Swedish houses and trees.
local Lighting = game:GetService("Lighting")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local S = 1 / Config.STUD
local function M(x) return x * S end

local world = Instance.new("Folder"); world.Name = "MoppeWorld"; world.Parent = workspace
local function part(name, size, cf, color, material, shape, parent)
	local p = Instance.new("Part"); p.Name = name
	if shape == "cyl" then p.Shape = Enum.PartType.Cylinder elseif shape == "ball" then p.Shape = Enum.PartType.Ball end
	p.Size, p.CFrame, p.Color, p.Material, p.Anchored = size, cf, color, material or Enum.Material.SmoothPlastic, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent or world
	return p
end
local function wedge(name, size, cf, color, material, parent)
	local w = Instance.new("WedgePart"); w.Name, w.Size, w.CFrame, w.Color, w.Material, w.Anchored = name, size, cf, color, material or Enum.Material.SmoothPlastic, true
	w.Parent = parent or world
	return w
end
-- box in metres: centre (x, z), y = bottom
local function blk(name, w, h, d, x, y, z, color, mat, ry)
	return part(name, Vector3.new(M(w), M(h), M(d)), CFrame.new(M(x), M(y + h / 2), -M(z)) * CFrame.Angles(0, math.rad(ry or 0), 0), color, mat)
end

-- ---------- light ----------
Lighting.ClockTime, Lighting.GeographicLatitude, Lighting.Brightness = 15, 59, 2.4
Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale = 1, 1
Lighting.OutdoorAmbient, Lighting.Ambient, Lighting.GlobalShadows = Color3.fromRGB(118, 124, 134), Color3.fromRGB(38, 40, 46), true
local atm = Instance.new("Atmosphere"); atm.Density, atm.Offset, atm.Color, atm.Decay, atm.Glare, atm.Haze = 0.3, 0.12, Color3.fromRGB(199, 214, 230), Color3.fromRGB(106, 126, 148), 0.25, 1.4; atm.Parent = Lighting
local cc = Instance.new("ColorCorrectionEffect"); cc.Saturation, cc.Contrast = 0.06, 0.06; cc.Parent = Lighting
local bloom = Instance.new("BloomEffect"); bloom.Intensity, bloom.Size, bloom.Threshold = 0.35, 24, 1.3; bloom.Parent = Lighting
local rays = Instance.new("SunRaysEffect"); rays.Intensity, rays.Spread = 0.04, 0.6; rays.Parent = Lighting

-- ---------- terrain ----------
local base = workspace:FindFirstChild("Baseplate"); if base then base:Destroy() end
local T = workspace.Terrain
T.WaterColor, T.WaterReflectance, T.WaterTransparency, T.WaterWaveSize, T.WaterWaveSpeed = Color3.fromRGB(40, 78, 96), 0.6, 0.4, 0.08, 6
-- the ground is a flat grass part just below zero: terrain bulges up slightly and would cover roads and garage floors
part("Ground", Vector3.new(M(560), 2, M(480)), CFrame.new(0, -1.05, M(110)), Color3.fromRGB(76, 122, 55), Enum.Material.Grass)
local hr = Random.new(3)
for i = 0, 31 do
	local a = i / 32 * math.pi * 2
	T:FillBall(Vector3.new(math.cos(a) * M(265), -M(4), M(110) + math.sin(a) * M(225)), M(26 + hr:NextNumber() * 18), hr:NextNumber() < 0.25 and Enum.Material.Rock or Enum.Material.Grass)
end
local lake = Vector3.new(-M(100), 0, M(250)) -- metres (x -100, z -250)
-- lake: sandy shore as a part, water from the terrain on top of it
part("Shore", Vector3.new(0.4, M(64), M(64)), CFrame.new(lake + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(194, 178, 128), Enum.Material.Sand, "cyl")
part("LakeBed", Vector3.new(0.4, M(56), M(56)), CFrame.new(lake + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(60, 70, 60), Enum.Material.Mud, "cyl")
T:FillCylinder(CFrame.new(lake + Vector3.new(0, 1.2, 0)), 2, M(28), Enum.Material.Water)

-- ---------- roads ----------
local asph, lineC, curbC, walk = Color3.fromRGB(56, 59, 64), Color3.fromRGB(232, 232, 226), Color3.fromRGB(165, 165, 160), Color3.fromRGB(150, 150, 146)
local function road(x1, z1, x2, z2, w)
	local A, B = Vector3.new(M(x1), 0.2, -M(z1)), Vector3.new(M(x2), 0.2, -M(z2))
	local len = (B - A).Magnitude
	local cf = CFrame.lookAt((A + B) / 2, B)
	part("Road", Vector3.new(M(w), 0.6, len + M(w) * 0.3), cf, asph, Enum.Material.Asphalt)
	for i = 0, math.floor(len / M(8)) - 1 do part("Dash", Vector3.new(0.35, 0.05, M(3)), cf * CFrame.new(0, 0.32, -len / 2 + M(4) + i * M(8)), lineC) end
	for _, s in ipairs({ -1, 1 }) do part("Edge", Vector3.new(0.35, 0.05, len), cf * CFrame.new(s * (M(w / 2) - 0.6), 0.32, 0), lineC) end
	return cf, len
end
local function streetlight(x, z, face)
	part("Pole", Vector3.new(M(6), M(0.16), M(0.16)), CFrame.new(M(x), M(3), -M(z)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(90, 94, 100), Enum.Material.Metal, "cyl")
	local lamp = part("StreetLamp", Vector3.new(M(0.6), M(0.12), M(0.3)), CFrame.new(M(x + face * 1.4), M(5.9), -M(z)), Color3.fromRGB(255, 236, 200), Enum.Material.Neon)
	part("Arm", Vector3.new(M(1.6), M(0.1), M(0.1)), CFrame.new(M(x + face * 0.8), M(5.95), -M(z)), Color3.fromRGB(90, 94, 100), Enum.Material.Metal)
	local l = Instance.new("SpotLight"); l.Face = Enum.NormalId.Bottom; l.Angle = 110; l.Range = 50; l.Brightness = 1.2; l.Color = Color3.fromRGB(255, 228, 180); l.Parent = lamp
end
-- industrial street in front of the garages (along X) with pavement on the garage side
local sz = Config.STREET_Z
road(-120, sz, 120, sz, 9)
blk("Pavement", 240, 0.15, 2.5, 0, 0, sz + 5.75, walk, Enum.Material.Pavement)
blk("Curb", 240, 0.15, 0.25, 0, 0, sz + 4.6, curbC, Enum.Material.Concrete)
for x = -110, 110, 22 do streetlight(x, sz + 6.2, -1) end
-- driveways from each garage to the street
for _, pl in ipairs(Config.PLOTS) do blk("Driveway", 7, 0.1, 4.5, pl.x, 0, pl.z - 10.5, asph, Enum.Material.Asphalt) end
-- drag strip south from the middle, ring track (test track) at its end
road(0, sz - 4, 0, -200, 10)
blk("StartLine", 10, 0.06, 0.5, 0, 0.5, sz - 12, lineC)
local ring = Vector3.new(M(80), 0, M(120))
local R1, R2, N = M(38), M(50), 72
for i = 0, N - 1 do
	local a = i / N * math.pi * 2
	local r = (R1 + R2) / 2
	part("Ring", Vector3.new(R2 - R1, 0.6, 2 * math.pi * r / N * 1.08), CFrame.new(ring + Vector3.new(math.cos(a) * r, 0.2, math.sin(a) * r)) * CFrame.Angles(0, -a, 0), asph, Enum.Material.Asphalt)
	for _, rr in ipairs({ R1 - M(0.4), R2 + M(0.4) }) do
		part("Kerb", Vector3.new(M(0.8), 0.7, 2 * math.pi * rr / N * 1.02), CFrame.new(ring + Vector3.new(math.cos(a) * rr, 0.2, math.sin(a) * rr)) * CFrame.Angles(0, -a, 0), i % 2 == 0 and Color3.fromRGB(200, 30, 30) or Color3.fromRGB(240, 240, 236))
	end
end
road(0, -120, 80 - 50, -120, 8)
-- country road west with fields and a farm
road(-120, sz, -200, sz, 7)
road(-200, sz, -230, -120, 7)
road(-230, -120, -230, -230, 7)
for i = 0, 5 do
	local fx, fz = -175 + (i % 2) * 40, -50 - math.floor(i / 2) * 55
	blk("Field", 34, 0.12, 48, fx, 0, fz, i % 3 == 0 and Color3.fromRGB(196, 170, 90) or Color3.fromRGB(110, 86, 60), i % 3 == 0 and Enum.Material.LeafyGrass or Enum.Material.Ground)
	for r = 0, 9 do blk("Row", 33, 0.08, 0.4, fx, 0.12, fz - 22 + r * 4.8, Color3.fromRGB(85, 120, 50), Enum.Material.LeafyGrass) end
end
blk("Barn", 18, 7, 10, -265, 0, -150, Color3.fromRGB(138, 43, 31), Enum.Material.WoodPlanks)
wedge("BarnRoofA", Vector3.new(M(19), M(4), M(5.5)), CFrame.new(M(-265), M(9), M(150) + M(2.75)) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(46, 47, 51), Enum.Material.Slate)
wedge("BarnRoofB", Vector3.new(M(19), M(4), M(5.5)), CFrame.new(M(-265), M(9), M(150) - M(2.75)), Color3.fromRGB(46, 47, 51), Enum.Material.Slate)
-- industrial area east: warehouses and containers
for i = 0, 3 do
	local wx, wz = 140 + (i % 2) * 34, -40 - math.floor(i / 2) * 40
	blk("Warehouse", 28, 9, 22, wx, 0, wz, i % 2 == 0 and Color3.fromRGB(150, 156, 160) or Color3.fromRGB(120, 130, 120), Enum.Material.CorrodedMetal)
	blk("WarehouseDoor", 6, 5, 0.3, wx, 0, wz + 11.1, Color3.fromRGB(200, 200, 196), Enum.Material.Metal)
end
local cr = Random.new(9)
for i = 0, 11 do
	local c = ({ Color3.fromRGB(170, 50, 40), Color3.fromRGB(40, 90, 150), Color3.fromRGB(60, 120, 70), Color3.fromRGB(200, 140, 40) })[i % 4 + 1]
	blk("Container", 6, 2.6, 2.4, 135 + (i % 4) * 7, (i >= 8) and 2.6 or 0, -120 - math.floor(i / 4 % 2) * 3, c, Enum.Material.CorrodedMetal, cr:NextNumber() * 6)
end
road(120, sz, 150, sz, 9)
road(150, sz, 150, -140, 8)
-- car park and petrol station (no brand)
blk("ParkingLot", 30, 0.1, 20, 30, 0, -40, asph, Enum.Material.Asphalt)
for i = 0, 7 do blk("Bay", 0.2, 0.05, 5, 17 + i * 3.6, 0.1, -35, lineC) end
blk("StationRoof", 16, 0.6, 10, -45, 5, -40, Color3.fromRGB(235, 235, 230), Enum.Material.SmoothPlastic)
for _, x in ipairs({ -51, -39 }) do blk("StationPillar", 0.5, 5, 0.5, x, 0, -40, Color3.fromRGB(235, 235, 230)) end
for _, x in ipairs({ -48, -42 }) do blk("Pump", 0.8, 1.6, 0.5, x, 0, -40, Color3.fromRGB(40, 140, 80)) end
blk("StationShop", 12, 4, 8, -45, 0, -52, Color3.fromRGB(210, 210, 205), Enum.Material.Concrete)
local ss = blk("StationSign", 6, 1, 0.2, -45, 4.2, -48, Color3.fromRGB(30, 120, 70))
local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Front; sg.CanvasSize = Vector2.new(300, 50); sg.Parent = ss
local stl = Instance.new("TextLabel"); stl.Size = UDim2.fromScale(1, 1); stl.BackgroundTransparency = 1; stl.Text = "MACKEN"; stl.TextScaled = true; stl.Font = Enum.Font.GothamBlack; stl.TextColor3 = Color3.new(1, 1, 1); stl.Parent = sg
blk("StationApron", 24, 0.1, 22, -45, 0, -44, asph, Enum.Material.Asphalt)

-- ---------- houses and trees ----------
local rnd = Random.new(7)
local white = Color3.fromRGB(242, 240, 234)
local function house(x, z, ry, col)
	local h = Instance.new("Model"); h.Name = "House"; h.Parent = world
	local cf = CFrame.new(M(x), 0, -M(z)) * CFrame.Angles(0, ry, 0)
	local w, d, Hh = 8, 6, 2.8
	local function p(n, sw, sh, sd, ox, oy, oz, c, mat) return part(n, Vector3.new(M(sw), M(sh), M(sd)), cf * CFrame.new(M(ox), M(oy), -M(oz)), c, mat, nil, h) end
	p("Plinth", w + 0.2, 0.5, d + 0.2, 0, 0.25, 0, Color3.fromRGB(85, 88, 92), Enum.Material.Concrete)
	p("Walls", w, Hh, d, 0, 0.5 + Hh / 2, 0, col, Enum.Material.WoodPlanks)
	for _, sx in ipairs({ -1, 1 }) do for _, szz in ipairs({ -1, 1 }) do p("Corner", 0.16, Hh, 0.16, sx * w / 2, 0.5 + Hh / 2, szz * d / 2, white, Enum.Material.WoodPlanks) end end
	for _, s in ipairs({ -1, 1 }) do wedge("Roof", Vector3.new(M(w + 0.5), M(1.8), M(d / 2 + 0.25)), cf * CFrame.new(0, M(0.5 + Hh + 0.9), s * M(d / 4 + 0.12)) * CFrame.Angles(0, s > 0 and math.pi or 0, 0), Color3.fromRGB(46, 47, 51), Enum.Material.Slate, h) end
	p("Chimney", 0.6, 1.6, 0.6, w * 0.25, 0.5 + Hh + 1.3, d * 0.15, Color3.fromRGB(120, 60, 45), Enum.Material.Brick)
	for i = 0, 2 do for _, s in ipairs({ -1, 1 }) do
		p("WinFrame", 1, 1.15, 0.08, -w / 2 + 1.5 + i * 2.6, 0.5 + 1.55, s * (d / 2 + 0.03), white, Enum.Material.WoodPlanks)
		local g = p("Glass", 0.82, 0.95, 0.1, -w / 2 + 1.5 + i * 2.6, 0.5 + 1.55, s * (d / 2 + 0.04), Color3.fromRGB(40, 55, 70), Enum.Material.Glass); g.Reflectance = 0.35
	end end
	p("Door", 1, 2, 0.08, w / 2 - 1.4, 0.5 + 1, d / 2 + 0.04, Color3.fromRGB(59, 42, 30), Enum.Material.Wood)
	for i = -10, 10 do p("Picket", 0.08, 0.9, 0.03, i * 0.5, 0.45, d / 2 + 4, white, Enum.Material.WoodPlanks) end
	p("Mailbox", 0.35, 0.3, 0.45, 6, 1.1, d / 2 + 4.5, Color3.fromRGB(40, 90, 170), Enum.Material.Metal)
	p("MailPost", 0.08, 1, 0.08, 6, 0.5, d / 2 + 4.5, Color3.fromRGB(70, 70, 70), Enum.Material.Metal)
end
local function spruce(x, z, hgt)
	part("Trunk", Vector3.new(M(1.6), M(0.4), M(0.4)), CFrame.new(M(x), M(0.8), -M(z)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(74, 51, 34), Enum.Material.Wood, "cyl")
	local col = Color3.fromRGB(26 + rnd:NextInteger(0, 10), 60 + rnd:NextInteger(0, 16), 34)
	for i = 0, 5 do local f = i / 5; local r = M(4.2 - 3.3 * f); part("Needles", Vector3.new(M(hgt * 0.16), r, r), CFrame.new(M(x), M(1.3 + f * hgt * 0.78), -M(z)) * CFrame.Angles(0, rnd:NextNumber() * 3, math.pi / 2), col, Enum.Material.Grass, "cyl") end
end
local function birch(x, z, hgt)
	part("Trunk", Vector3.new(M(hgt * 0.7), M(0.25), M(0.25)), CFrame.new(M(x), M(hgt * 0.35), -M(z)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(232, 228, 218), Enum.Material.SmoothPlastic, "cyl")
	for i = 0, 4 do local s = M(1.8 + rnd:NextNumber() * 1.2); part("Leaves", Vector3.new(s, s * 0.9, s), CFrame.new(M(x + (rnd:NextNumber() - 0.5) * 1.8), M(hgt * 0.6 + i * 0.55), -M(z + (rnd:NextNumber() - 0.5) * 1.8)), Color3.fromRGB(88 + rnd:NextInteger(0, 20), 140 + rnd:NextInteger(0, 20), 56), Enum.Material.LeafyGrass, "ball") end
end
-- areas kept free: garages + street, roads, ring, fields, industrial area, petrol station, car park, lake
local function blocked(x, z)
	if z > sz - 8 and z < 14 and x > -130 and x < 130 then return true end
	if math.abs(x) < 9 and z < sz and z > -205 then return true end
	local d = math.sqrt((x - 80) ^ 2 + (z + 120) ^ 2); if d > 30 and d < 60 then return true end
	if z > -126 and z < -114 and x > 0 and x < 40 then return true end
	if x < -150 and x > -210 and z < -20 and z > -200 then return true end
	if x > 115 and x < 200 and z < 10 and z > -140 then return true end
	if x > -60 and x < -28 and z > -60 and z < -28 then return true end
	if x > 12 and x < 48 and z > -52 and z < -28 then return true end
	if math.sqrt((x + 100) ^ 2 + (z + 250) ^ 2) < 36 then return true end
	if math.abs(x + 230) < 8 or (z > sz - 6 and z < sz + 6 and x < -100) then return true end
	if math.sqrt(x ^ 2 + (z + 110) ^ 2) > 240 then return true end
	return false
end
local colors = { Color3.fromRGB(138, 43, 31), Color3.fromRGB(214, 176, 74), Color3.fromRGB(234, 229, 216), Color3.fromRGB(138, 43, 31) }
local n = 0
for _ = 1, 800 do
	if n >= 18 then break end
	local x, z = rnd:NextNumber(-220, 220), rnd:NextNumber(-320, 100)
	if not blocked(x, z) and not blocked(x, z - 8) and not blocked(x + 6, z) and not blocked(x - 6, z) then n = n + 1; house(x, z, rnd:NextInteger(0, 3) * math.pi / 2, colors[n % 4 + 1]) end
end
n = 0
for _ = 1, 1600 do
	if n >= 140 then break end
	local x, z = rnd:NextNumber(-240, 240), rnd:NextNumber(-330, 110)
	if not blocked(x, z) then n = n + 1; if rnd:NextNumber() < 0.65 then spruce(x, z, 6 + rnd:NextNumber() * 6) else birch(x, z, 5 + rnd:NextNumber() * 4) end end
end
]]></ProtectedString></Properties></Item>
</Item>
<Item class="StarterPlayer" referent="RBX28"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX27"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX21"><Properties><string name="Name">Interact</string><ProtectedString name="Source"><![CDATA[-- Interaction in the garage: hover outline, pick up/carry/place parts, menu on the moped's parts,
-- and engine mode where parts are dragged onto the engine block and snap into the right place.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Assembly = require(Shared.Assembly)
local Economy = require(Shared.Economy)
local Builder = require(Shared.Builder)
local Panels = require(Shared.Panels)
local GarageBuilder = require(Shared.GarageBuilder)
local CS = require(Shared.ClientState)
local Api = RS:WaitForChild("Remotes"):WaitForChild("Api")
local plr = Players.LocalPlayer
local cam = workspace.CurrentCamera
local S = 1 / Config.STUD

local function call(action, ...)
	local ok, msg = Api:InvokeServer(action, ...)
	if msg and msg ~= "" and type(msg) == "string" then CS.toast:Fire(msg) end
	return ok, msg
end

-- ---------- UI: hint at the cursor, menu, engine panel ----------
local gui = Instance.new("ScreenGui"); gui.Name = "Interact"; gui.ResetOnSpawn = false; gui.Parent = plr:WaitForChild("PlayerGui")
local hint = Instance.new("TextLabel"); hint.BackgroundColor3 = Color3.fromRGB(20, 24, 30); hint.BackgroundTransparency = 0.2; hint.TextColor3 = Color3.new(1, 1, 1)
hint.Font = Enum.Font.GothamMedium; hint.TextSize = 14; hint.AutomaticSize = Enum.AutomaticSize.XY; hint.Visible = false; hint.Parent = gui
Instance.new("UICorner", hint).CornerRadius = UDim.new(0, 6)
local hp = Instance.new("UIPadding"); hp.PaddingLeft, hp.PaddingRight, hp.PaddingTop, hp.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 4), UDim.new(0, 4); hp.Parent = hint
local highlight = Instance.new("Highlight"); highlight.FillTransparency = 1; highlight.OutlineColor = Color3.fromRGB(255, 255, 255); highlight.DepthMode = Enum.HighlightDepthMode.Occluded; highlight.Parent = gui

local function btn(parent, text, primary, cb)
	local b = Instance.new("TextButton"); b.Text = text; b.Font = Enum.Font.GothamBold; b.TextSize = 14; b.AutoButtonColor = true
	b.TextColor3 = primary and Color3.fromRGB(20, 20, 20) or Color3.new(1, 1, 1); b.BackgroundColor3 = primary and Color3.fromRGB(255, 176, 32) or Color3.fromRGB(44, 52, 64)
	b.Size = UDim2.new(1, 0, 0, 30); b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	b.MouseButton1Click:Connect(cb)
	return b
end
local menu = Instance.new("Frame"); menu.BackgroundColor3 = Color3.fromRGB(24, 29, 37); menu.Size = UDim2.new(0, 210, 0, 0); menu.AutomaticSize = Enum.AutomaticSize.Y; menu.Visible = false; menu.Parent = gui
Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 8)
local ml = Instance.new("UIListLayout"); ml.Padding = UDim.new(0, 5); ml.Parent = menu
local mp = Instance.new("UIPadding"); mp.PaddingLeft, mp.PaddingRight, mp.PaddingTop, mp.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 8); mp.Parent = menu
local function closeMenu() menu.Visible = false; for _, c in ipairs(menu:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end end
local function label(parent, t, size, color)
	local l = Instance.new("TextLabel"); l.BackgroundTransparency = 1; l.Text = t; l.TextSize = size or 14; l.Font = Enum.Font.GothamMedium; l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextXAlignment = Enum.TextXAlignment.Left; l.TextWrapped = true; l.Size = UDim2.new(1, 0, 0, 0); l.AutomaticSize = Enum.AutomaticSize.Y; l.RichText = true; l.Parent = parent
	return l
end

-- ---------- helpers ----------
local function prof() return CS.profile end
local function myPlot() return prof() and prof()._plot end
local function anchors() return myPlot() and GarageBuilder.anchors(GarageBuilder.plotOrigin(myPlot())) end
local function attrUp(inst, name)
	while inst and inst ~= workspace do
		local v = inst:GetAttribute(name)
		if v ~= nil then return v, inst end
		inst = inst.Parent
	end
	return nil
end
local function mouseRay(ignore)
	local m = UIS:GetMouseLocation()
	local r = cam:ViewportPointToRay(m.X, m.Y)
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = ignore or {}
	return workspace:Raycast(r.Origin, r.Direction * 60, params), r
end
local function itemName(u) local it = prof().items[u]; return it and Catalog.BY_SKU[it.s] and Catalog.BY_SKU[it.s].name or "del" end

-- ---------- hand animation (unscrewing/fitting): a hand with a wrench by the part for a moment ----------
local function wrenchAnim(pos, dur)
	local h = Builder.hand("basic", {})
	h.Parent = cam
	local t0 = os.clock()
	local con
	con = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		h:PivotTo(CFrame.lookAt(pos + Vector3.new(0.6, 0.4, 0.6), pos) * CFrame.Angles(0, 0, math.sin(t * 14) * 0.6))
		if t > dur then con:Disconnect(); h:Destroy() end
	end)
	task.wait(dur)
end

-- ---------- engine mode ----------
local eng = { on = false, drag = nil, ghost = nil, markers = {}, panel = nil }
local enginePanel = Instance.new("Frame"); enginePanel.BackgroundColor3 = Color3.fromRGB(24, 29, 37); enginePanel.BackgroundTransparency = 0.1; enginePanel.AnchorPoint = Vector2.new(1, 0)
enginePanel.Position = UDim2.new(1, -14, 0, 70); enginePanel.Size = UDim2.new(0, 240, 0, 0); enginePanel.AutomaticSize = Enum.AutomaticSize.Y; enginePanel.Visible = false; enginePanel.Parent = gui
Instance.new("UICorner", enginePanel).CornerRadius = UDim.new(0, 8)
local el = Instance.new("UIListLayout"); el.Padding = UDim.new(0, 2); el.Parent = enginePanel
local ep = Instance.new("UIPadding"); ep.PaddingLeft, ep.PaddingRight, ep.PaddingTop, ep.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 8), UDim.new(0, 8); ep.Parent = enginePanel

local function engineState()
	local p = prof()
	local id = p.stand
	if not id then return nil end
	return id, Assembly.engineSockets(id), Economy.skuMap(p, p.mopeds[id].eng)
end
local function renderEnginePanel()
	for _, c in ipairs(enginePanel:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	local id, list, map = engineState()
	if not id then
		label(enginePanel, "<b>Motorstativet är tomt</b>", 15)
		label(enginePanel, "Klicka på mopeden och välj <b>Lyft ur motorn</b> (avgasen och bakhjulet måste av först).", 13, Color3.fromRGB(180, 188, 200))
	else
		label(enginePanel, "<b>Motor – " .. Config.BY_ID[id].n .. "</b>", 15)
		label(enginePanel, "Dra delar från brickan till motorn. Högerklick tar bort en del.", 12, Color3.fromRGB(180, 188, 200))
		for _, s in ipairs(list) do
			local done = map[s.id] ~= nil
			local blocked = false
			for _, r in ipairs(s.req) do if not map[r] then blocked = true end end
			label(enginePanel, (done and "<font color=\"#5ad26e\">✓</font> " or blocked and "<font color=\"#7a8494\">·</font> " or "<font color=\"#ffb020\">›</font> ") .. Catalog.KIND[s.kind][1], 13, done and Color3.new(1, 1, 1) or blocked and Color3.fromRGB(120, 128, 140) or Color3.fromRGB(255, 210, 120))
		end
		local miss = Economy.engineMissing(prof(), id)
		if #miss == 0 then btn(enginePanel, "Montera motorn i mopeden", true, function() call("engineToMoped") end) end
	end
	btn(enginePanel, "Klar (Esc)", false, function() eng.exit() end)
end

local function clearMarkers() for _, m in ipairs(eng.markers) do m:Destroy() end; eng.markers = {} end
local function marker(cf, ok)
	local p = Instance.new("Part"); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.35, 0.35, 0.35); p.CFrame = cf; p.Material = Enum.Material.Neon; p.Transparency = 0.35
	p.Color = ok and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 70); p.Parent = cam
	table.insert(eng.markers, p)
	return p
end

function eng.enter()
	if CS.mode then return end
	CS.setMode("engine"); eng.on = true
	local a = anchors()
	cam.CameraType = Enum.CameraType.Scriptable
	local target = a.stand.Position
	TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { CFrame = CFrame.lookAt(target + (a.stand.LookVector * -0.2 + Vector3.new(0, 0.9, 0)) + (a.origin.RightVector * -2.4) + a.origin.LookVector * 1.6, target) }):Play()
	enginePanel.Visible = true
	renderEnginePanel()
end
function eng.exit()
	if not eng.on then return end
	eng.on = false; CS.setMode(nil)
	if eng.ghost then eng.ghost:Destroy(); eng.ghost = nil end
	eng.drag = nil
	clearMarkers()
	enginePanel.Visible = false
	cam.CameraType = Enum.CameraType.Custom
	CS.modeEnded:Fire()
end
-- start dragging a loose part (u) whose model lies in the world
local function startDrag(u, srcModel)
	local p = prof()
	local id, list, map = engineState()
	if not id then CS.toast:Fire("Ingen motor i stativet"); return end
	local pr = Catalog.BY_SKU[p.items[u].s]
	local socks = Assembly.socketsFor(list, pr)
	if #socks == 0 then CS.toast:Fire(pr.name .. " hör inte till motorn"); return end
	local a = anchors()
	eng.drag = { u = u, socks = {}, src = srcModel }
	clearMarkers()
	for _, sid in ipairs(socks) do
		local why = Assembly.canMount(list, map, id, sid, pr.sku)
		local cf = Builder.socketCF(a.stand, Assembly.find(list, sid))
		table.insert(eng.drag.socks, { id = sid, cf = cf, why = why })
		marker(cf, why == nil)
		if why then CS.toast:Fire(why) end
	end
	eng.ghost = Builder.item(pr.sku, p.items[u])
	for _, d in ipairs(eng.ghost:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = true; d.CanQuery = false; d.CanCollide = false end end
	eng.ghost.Parent = cam
	if srcModel then for _, d in ipairs(srcModel:GetDescendants()) do if d:IsA("BasePart") then d.LocalTransparencyModifier = 0.8 end end end
end
local function endDrag(release)
	local d = eng.drag
	if not d then return end
	eng.drag = nil
	local snapped = d.snap
	clearMarkers()
	if release and snapped and not snapped.why then
		-- fitting animation: the part glides into place, then the server confirms
		local g = eng.ghost
		local tw = TweenService:Create(g.PrimaryPart, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { CFrame = snapped.cf })
		for _, part in ipairs(g:GetDescendants()) do if part:IsA("BasePart") and part ~= g.PrimaryPart then local w = Instance.new("WeldConstraint"); w.Part0, w.Part1 = g.PrimaryPart, part; w.Parent = part; part.Anchored = false end end
		tw:Play(); tw.Completed:Wait()
		wrenchAnim(snapped.cf.Position, 0.5)
		call("mountEngine", d.u, snapped.id)
	elseif release and snapped and snapped.why then CS.toast:Fire(snapped.why) end
	if eng.ghost then eng.ghost:Destroy(); eng.ghost = nil end
	if d.src and d.src.Parent then for _, x in ipairs(d.src:GetDescendants()) do if x:IsA("BasePart") then x.LocalTransparencyModifier = 0 end end end
end

-- ---------- moped menu ----------
local function openMenu(sock, inst)
	closeMenu()
	local p = prof()
	local id = p.cur
	local u = p.mopeds[id].ch[sock]
	local it = u and p.items[u]
	local title = sock == "engine" and "Motor" or (it and Catalog.BY_SKU[it.s].name or sock)
	label(menu, "<b>" .. title .. "</b>", 15)
	if it and it.paint then label(menu, "Färg " .. it.paint.col .. " · " .. ({ gloss = "blank", matt = "matt", metal = "metallic", pearl = "pärlemor", chrome = "krom" })[it.paint.fin] .. " · lack " .. math.floor((it.paint.q or 1) * 100) .. " %", 12, Color3.fromRGB(180, 188, 200)) end
	if sock == "engine" then
		btn(menu, "Lyft ur motorn", true, function() closeMenu(); call("engineToStand") end)
		btn(menu, "Gå till motorstativet", false, function() closeMenu(); eng.enter() end)
	else
		btn(menu, "Demontera", true, function()
			closeMenu()
			local pos = inst and (inst:IsA("Model") and inst:GetPivot().Position or inst.Position) or cam.CFrame.Position
			wrenchAnim(pos, 0.8)
			call("unmountMoped", sock)
		end)
		if it and Catalog.BY_SKU[it.s].kind == "panel" then
			btn(menu, "Lackera", false, function()
				closeMenu()
				local ok = call("unmountMoped", sock)
				if ok then CS.toast:Fire("Kåpan ligger på bänken: bär den till lackboxen") end
			end)
		end
		btn(menu, "Byt ut", false, function() closeMenu(); CS.openShop:Fire(it and { kind = Catalog.BY_SKU[it.s].kind, panel = Catalog.BY_SKU[it.s].val.panel } or nil) end)
		btn(menu, "Inspektera", false, function()
			closeMenu()
			if not inst then return end
			local pos = inst:IsA("Model") and inst:GetPivot().Position or inst.Position
			cam.CameraType = Enum.CameraType.Scriptable
			TweenService:Create(cam, TweenInfo.new(0.5), { CFrame = CFrame.lookAt(pos + (cam.CFrame.Position - pos).Unit * 3, pos) }):Play()
			CS.toast:Fire((it and Catalog.BY_SKU[it.s].desc or "") .. " (klicka var som helst för att gå tillbaka)")
			eng.inspect = true
		end)
	end
	btn(menu, "Stäng", false, closeMenu)
	local m = UIS:GetMouseLocation()
	menu.Position = UDim2.new(0, m.X + 12, 0, m.Y - 30)
	menu.Visible = true
end

-- ---------- hover and clicks ----------
local hover = nil
local function ignoreList()
	local t = { cam }
	if plr.Character then table.insert(t, plr.Character) end
	return t
end
RunService.RenderStepped:Connect(function()
	if not prof() then return end
	local p = prof()
	if CS.mode and CS.mode ~= "engine" then hint.Visible = false; highlight.Adornee = nil; return end
	local res = mouseRay(ignoreList())
	hover = nil
	local text
	if res then
		local inst = res.Instance
		local plot = attrUp(inst, "Plot")
		local own = plot == p._plot
		local interact, holder = attrUp(inst, "Interact")
		local sock, sockInst = attrUp(inst, "Sock")
		local itemId = attrUp(inst, "Item")
		if eng.on then
			if eng.drag then
				-- ghost follows the mouse in a plane through the engine; snaps when near a socket
				local _, ray = mouseRay(ignoreList())
				local a = anchors()
				local planeN = (cam.CFrame.Position - a.stand.Position).Unit
				local tHit = (a.stand.Position - ray.Origin):Dot(planeN) / ray.Direction.Unit:Dot(planeN)
				local pos = ray.Origin + ray.Direction.Unit * tHit
				local best, bd = nil, 1e9
				for _, s in ipairs(eng.drag.socks) do local dd = (s.cf.Position - pos).Magnitude; if dd < bd then best, bd = s, dd end end
				eng.drag.snap = (best and bd < 0.7) and best or nil
				local cf = eng.drag.snap and eng.drag.snap.cf or CFrame.new(pos)
				eng.ghost:PivotTo(cf)
				for _, d in ipairs(eng.ghost:GetDescendants()) do if d:IsA("BasePart") then d.Transparency = eng.drag.snap and 0.1 or 0.35 end end
				text = eng.drag.snap and (eng.drag.snap.why or "Släpp för att montera") or itemName(eng.drag.u)
			elseif own and itemId and interact == "item" then hover = { kind = "dragitem", u = itemId, inst = holder }; text = "Dra: " .. itemName(itemId)
			elseif own and sock and interact == "engine" then hover = { kind = "engsock", sock = sock, inst = sockInst }; text = Catalog.KIND[Assembly.find(Assembly.engineSockets(p.stand), sock).kind][1] .. " · högerklick: ta bort" end
		elseif not own and plot then text = "Någon annans garage"
		elseif interact == "item" and itemId then hover = { kind = "item", u = itemId, inst = holder }; text = "[Klick] Plocka upp " .. itemName(itemId) .. (holder:GetAttribute("Wet") and " (lacken torkar)" or "")
		elseif interact == "box" then hover = { kind = "box", oid = holder:GetAttribute("Order"), inst = holder }; text = "[Klick] Öppna leveransen"
		elseif interact == "moped" and sock then hover = { kind = "mopedpart", sock = sock, inst = sockInst }; text = p._carry and ("[Klick] Montera " .. itemName(p._carry)) or "[Klick] " .. (sock == "engine" and "Motor" or (p.mopeds[p.cur].ch[sock] and itemName(p.mopeds[p.cur].ch[sock]) or sock))
		elseif interact == "moped" then hover = { kind = "moped", inst = holder }; text = p._carry and ("[Klick] Montera " .. itemName(p._carry)) or "Mopeden"
		elseif interact == "parked" then hover = { kind = "parked", inst = holder }; text = "[Klick] Ställ fram den här mopeden"
		elseif interact then
			hover = { kind = interact, inst = holder }
			local h = holder:GetAttribute("Hint") or interact
			text = (p._carry and (interact == "bench" or interact == "shelf" or interact == "floor" or interact == "booth" or interact == "portbench")) and ("[Klick] " .. h) or (p._carry and interact ~= "stand") and itemName(p._carry) or ("[Klick] " .. h)
		end
	end
	highlight.Adornee = hover and hover.inst or nil
	if text then local m = UIS:GetMouseLocation(); hint.Text = text; hint.Position = UDim2.new(0, m.X + 18, 0, m.Y + 6); hint.Visible = true else hint.Visible = false end
end)

UIS.InputBegan:Connect(function(io, gp)
	if gp or not prof() then return end
	local p = prof()
	if io.KeyCode == Enum.KeyCode.Escape then if eng.on then eng.exit() end; closeMenu(); return end
	if eng.inspect and io.UserInputType == Enum.UserInputType.MouseButton1 then eng.inspect = false; cam.CameraType = Enum.CameraType.Custom; return end
	if io.UserInputType == Enum.UserInputType.MouseButton2 and eng.on and hover and hover.kind == "engsock" then
		local pos = hover.inst:GetPivot().Position
		wrenchAnim(pos, 0.5)
		call("unmountEngine", hover.sock)
		return
	end
	if io.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	if menu.Visible then return end
	if eng.on then
		if hover and hover.kind == "dragitem" then startDrag(hover.u, hover.inst) end
		return
	end
	if CS.mode or not hover then return end
	local k = hover.kind
	if p._carry then
		if k == "bench" or k == "shelf" or k == "floor" or k == "booth" or k == "portbench" then call("place", k)
		elseif k == "stand" or k == "engine" then eng.enter(); task.wait(0.7); startDrag(p._carry, nil)
		elseif k == "moped" or k == "mopedpart" then
			local pr = Catalog.BY_SKU[p.items[p._carry].s]
			local socks = Assembly.socketsFor(Assembly.chassisSlots(p.cur), pr)
			if #socks == 0 then CS.toast:Fire(pr.name .. " monteras inte direkt på mopeden"); return end
			local cmap = Economy.skuMap(p, p.mopeds[p.cur].ch)
			local sock = socks[1]
			for _, sid in ipairs(socks) do if not cmap[sid] then sock = sid; break end end
			wrenchAnim(hover.inst:GetPivot().Position, 0.6)
			call("mountMoped", p._carry, sock)
		end
		return
	end
	if k == "item" then call("pickup", hover.u)
	elseif k == "box" then call("openBox", hover.oid)
	elseif k == "computer" then CS.openShop:Fire(nil)
	elseif k == "stand" or k == "engine" then eng.enter()
	elseif k == "portbench" then CS.openPort:Fire()
	elseif k == "booth" then CS.openPaint:Fire()
	elseif k == "mopedpart" then openMenu(hover.sock, hover.inst)
	elseif k == "parked" then local id = hover.inst.Name:match("^Parked_(.+)$"); if id then call("select", id) end
	end
end)
UIS.InputEnded:Connect(function(io)
	if io.UserInputType == Enum.UserInputType.MouseButton1 and eng.drag then endDrag(true) end
end)
CS.changed.Event:Connect(function() if eng.on then renderEnginePanel() end end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX22"><Properties><string name="Name">Paint</string><ProtectedString name="Source"><![CDATA[-- The spray booth: choose colour (library, RGB, HEX) and paint type, then spray the panel with the spray gun in
-- first person. The paint is applied in real time on an enlarged view of the panel. Quality from Paint.lua.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = RS:WaitForChild("Shared")
local Paint = require(Shared.Paint)
local Builder = require(Shared.Builder)
local Catalog = require(Shared.Catalog)
local GarageBuilder = require(Shared.GarageBuilder)
local CS = require(Shared.ClientState)
local Api = RS:WaitForChild("Remotes"):WaitForChild("Api")
local plr = Players.LocalPlayer
local cam = workspace.CurrentCamera

local function new(class, props, parent) local o = Instance.new(class); for k, v in pairs(props) do o[k] = v end; o.Parent = parent; return o end
local function corner(o, r) new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o); return o end
local function txt(parent, t, size, color)
	return new("TextLabel", { BackgroundTransparency = 1, Text = t, TextSize = size or 14, TextColor3 = color or Color3.new(1, 1, 1), Font = Enum.Font.GothamMedium, RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, parent)
end
local function button(parent, t, color, cb, w)
	local b = corner(new("TextButton", { Text = t, TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = color, Size = UDim2.new(w or 1, 0, 0, 30) }, parent), 6)
	b.MouseButton1Click:Connect(cb)
	return b
end

local gui = new("ScreenGui", { Name = "PaintBooth", ResetOnSpawn = false, Enabled = false }, plr:WaitForChild("PlayerGui"))
local panel = corner(new("ScrollingFrame", { BackgroundColor3 = Color3.fromRGB(20, 24, 30), BackgroundTransparency = 0.08, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14),
	Size = UDim2.new(0, 290, 1, -28), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, BorderSizePixel = 0 }, gui))
new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) }, panel)
new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, panel)
local banner = corner(new("TextLabel", { BackgroundColor3 = Color3.fromRGB(20, 24, 30), BackgroundTransparency = 0.15, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamMedium, TextSize = 15,
	Text = "ⓘ  Välj färg och lacktyp, håll sedan vänster musknapp och spraya jämnt över hela kåpan", Position = UDim2.new(0, 14, 0, 14), Size = UDim2.new(0, 620, 0, 38) }, gui))

local P = { on = false, col = "#c8102e", fin = "gloss" }
local function cleanup()
	if P.view then P.view:Destroy() end
	if P.hand then P.hand:Destroy() end
	if P.con then P.con:Disconnect() end
	P.view, P.hand, P.con, P.on, P.s = nil, nil, nil, false, nil
	gui.Enabled = false
	cam.CameraType = Enum.CameraType.Custom
	UIS.MouseIconEnabled = true
	CS.setMode(nil); CS.modeEnded:Fire()
end
local function color3() return Color3.fromHex(P.col) end

-- colour selection UI
local preview, hexBox, rgb, quality
local buildFinish
local function refreshColour()
	preview.BackgroundColor3 = color3()
	hexBox.Text = P.col
	local c = color3()
	for i, k in ipairs({ "R", "G", "B" }) do rgb[i].fill.Size = UDim2.new(c[k], 0, 1, 0); rgb[i].val.Text = k .. " " .. math.floor(c[k] * 255 + 0.5) end
	if P.cells then for _, cell in ipairs(P.cells) do cell.Color = color3() end end
	if P.s then P.s = Paint.new(P.s.even) end -- a new colour starts over
end
local function buildUI(baseLabel)
	for _, c in ipairs(panel:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	txt(panel, "<b>Lackbox</b>", 18)
	txt(panel, baseLabel, 12, Color3.fromRGB(180, 188, 200))
	txt(panel, "Färgbibliotek", 13, Color3.fromRGB(255, 176, 32))
	local grid = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, panel)
	new("UIGridLayout", { CellSize = UDim2.new(0, 60, 0, 44), CellPadding = UDim2.new(0, 6, 0, 6) }, grid)
	for _, lib in ipairs(Paint.LIBRARY) do
		local b = corner(new("TextButton", { Text = "", BackgroundColor3 = Color3.fromHex(lib[2]) }, grid), 6)
		new("TextLabel", { BackgroundTransparency = 1, Text = lib[1], TextSize = 9, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, TextWrapped = true, Size = UDim2.fromScale(1, 1) }, b)
		b.MouseButton1Click:Connect(function() P.col, P.fin = lib[2], lib[3]; refreshColour(); buildFinish() end)
	end
	txt(panel, "RGB", 13, Color3.fromRGB(255, 176, 32))
	rgb = {}
	for i, k in ipairs({ "R", "G", "B" }) do
		local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22) }, panel)
		local val = new("TextLabel", { BackgroundTransparency = 1, Text = k, TextSize = 12, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.new(0, 46, 1, 0), TextXAlignment = Enum.TextXAlignment.Left }, row)
		local bg = corner(new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(50, 56, 66), Position = UDim2.new(0, 50, 0, 6), Size = UDim2.new(1, -50, 0, 10) }, row), 5)
		local fill = corner(new("Frame", { BackgroundColor3 = ({ Color3.fromRGB(230, 60, 60), Color3.fromRGB(60, 200, 90), Color3.fromRGB(70, 130, 240) })[i], Size = UDim2.new(0, 0, 1, 0) }, bg), 5)
		local function setFrom(x)
			local f = math.clamp((x - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
			local c = color3()
			local t = { c.R, c.G, c.B }
			t[i] = f
			P.col = string.format("#%02x%02x%02x", math.floor(t[1] * 255 + 0.5), math.floor(t[2] * 255 + 0.5), math.floor(t[3] * 255 + 0.5))
			refreshColour()
		end
		bg.MouseButton1Down:Connect(function(x) setFrom(x) end)
		rgb[i] = { fill = fill, val = val }
	end
	local hexRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30) }, panel)
	new("TextLabel", { BackgroundTransparency = 1, Text = "HEX", TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(255, 176, 32), Size = UDim2.new(0, 46, 1, 0), TextXAlignment = Enum.TextXAlignment.Left }, hexRow)
	hexBox = corner(new("TextBox", { Text = P.col, TextSize = 14, Font = Enum.Font.Code, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = Color3.fromRGB(44, 52, 64), Position = UDim2.new(0, 50, 0, 0), Size = UDim2.new(0, 110, 1, 0), ClearTextOnFocus = false }, hexRow), 6)
	preview = corner(new("Frame", { BackgroundColor3 = color3(), Position = UDim2.new(0, 170, 0, 0), Size = UDim2.new(1, -170, 1, 0) }, hexRow), 6)
	hexBox.FocusLost:Connect(function()
		local h = hexBox.Text:gsub("^([^#])", "#%1")
		if Paint.validHex(h) then P.col = h:lower(); refreshColour() else hexBox.Text = P.col; CS.toast:Fire("Ange en HEX-kod som #1a2b3c") end
	end)
	txt(panel, "Lacktyp", 13, Color3.fromRGB(255, 176, 32))
	P.finRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, panel)
	new("UIGridLayout", { CellSize = UDim2.new(0, 84, 0, 28), CellPadding = UDim2.new(0, 6, 0, 6) }, P.finRow)
	buildFinish()
	quality = txt(panel, "", 14)
	button(panel, "Klar – låt lacken torka", Color3.fromRGB(40, 160, 80), function()
		if not P.s then return end
		local r = Paint.result(P.s)
		local ok, msg = Api:InvokeServer("paintDone", P.col, P.fin, r.q)
		CS.toast:Fire(tostring(msg))
		if ok then cleanup() end
	end)
	button(panel, "Avbryt", Color3.fromRGB(110, 118, 130), function() Api:InvokeServer("paintDone", nil); cleanup() end)
	refreshColour()
end
buildFinish = function()
	for _, c in ipairs(P.finRow:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	for _, f in ipairs({ "gloss", "matt", "metal", "pearl", "chrome" }) do
		local b = button(P.finRow, Paint.FINISH[f], P.fin == f and Color3.fromRGB(26, 108, 220) or Color3.fromRGB(60, 68, 80), function() P.fin = f; buildFinish() end)
		b.Size = UDim2.new(0, 84, 0, 28)
	end
end

-- the work view: the panel enlarged on the booth rack, cells that are coloured as you spray
local SW, SH = 7, 4.4
local function buildView(center, look, baseColor)
	local m = new("Model", { Name = "PaintView" }, cam)
	local cf = CFrame.lookAt(center, center + Vector3.new(0, 0, -1)) -- the panel faces the camera (+Z)
	local base = new("Part", { Anchored = true, CanCollide = false, CanQuery = false, Size = Vector3.new(SW, SH, 0.2), CFrame = cf, Color = baseColor, Material = Enum.Material.SmoothPlastic }, m)
	local cells = {}
	for i = 1, Paint.GW * Paint.GH do
		local cu, cv = Paint.cellCenter(i)
		cells[i] = new("Part", { Anchored = true, CanCollide = false, CanQuery = false, Size = Vector3.new(SW / Paint.GW, SH / Paint.GH, 0.05), Color = color3(), Transparency = 1,
			CFrame = cf * CFrame.new(cu * SW / 2, cv * SH / 2, -0.13), Material = Enum.Material.SmoothPlastic }, m)
	end
	return m, cells, base, cf
end

CS.openPaint.Event:Connect(function()
	if CS.mode then return end
	local ok, even = Api:InvokeServer("paintStart")
	if not ok then CS.toast:Fire(tostring(even)); return end
	CS.setMode("paint")
	local item
	for _, it in pairs(CS.profile.items) do if it.loc == "booth" then item = it end end
	local pr = item and Catalog.BY_SKU[item.s]
	local a = GarageBuilder.anchors(GarageBuilder.plotOrigin(CS.profile._plot))
	local center = a.booth.Position + Vector3.new(0, 1.6, 0)
	local baseC = item and item.paint and Color3.fromHex(item.paint.col) or Color3.fromRGB(190, 190, 190)
	P.s = Paint.new(even or 0.7)
	P.view, P.cells, P.base, P.cf = buildView(center, pr and pr.val.look, baseC)
	gui.Enabled = true
	buildUI((pr and pr.name or "Kåpa") .. (item and item.paint and (" · nu " .. item.paint.col) or ""))
	cam.CameraType = Enum.CameraType.Scriptable
	TweenService:Create(cam, TweenInfo.new(0.6), { CFrame = CFrame.lookAt(center + Vector3.new(-1.2, 0.6, -9), center) }):Play()
	P.hand = Builder.hand("spray", { even = even })
	P.hand.Parent = cam
	pcall(function() P.hand:ScaleTo(9) end)
	local noz = new("Attachment", { Position = Vector3.new(0, 0, -0.085 / 0.28 * 9) }, P.hand.PrimaryPart)
	P.mist = new("ParticleEmitter", { Texture = "rbxasset://textures/particles/smoke_main.dds", Rate = 0, Lifetime = NumberRange.new(0.25, 0.5), Speed = NumberRange.new(8, 12), SpreadAngle = Vector2.new(14, 14),
		Size = NumberSequence.new(0.3, 1.6), Transparency = NumberSequence.new(0.5, 1), EmissionDirection = Enum.NormalId.Front }, noz)
	P.on = true
	UIS.MouseIconEnabled = false
	local acc, handIn = 0, 0
	P.con = RunService.RenderStepped:Connect(function(dt)
		local mpos = UIS:GetMouseLocation()
		local ray = cam:ViewportPointToRay(mpos.X, mpos.Y)
		local n = P.cf.LookVector
		local t = (P.cf.Position - ray.Origin):Dot(n) / ray.Direction:Dot(n)
		local hit = ray.Origin + ray.Direction * t
		local lp = P.cf:PointToObjectSpace(hit)
		local u, v = lp.X / (SW / 2), lp.Y / (SH / 2)
		local spraying = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and P.s ~= nil
		handIn = math.min(1, handIn + dt * 3)
		local aim = P.cf * CFrame.new(math.clamp(lp.X, -SW, SW), math.clamp(lp.Y, -SH, SH), -0.1)
		local gunPos = aim.Position - P.cf.LookVector * 4.5 + Vector3.new(0, -0.3, 0)
		local from = cam.CFrame.Position + cam.CFrame.RightVector * 5 - cam.CFrame.UpVector * 3
		P.hand:PivotTo(CFrame.lookAt(from:Lerp(gunPos, handIn), aim.Position) * CFrame.Angles(0, 0, spraying and math.sin(os.clock() * 30) * 0.02 or 0))
		P.mist.Rate = spraying and 120 or 0
		P.mist.Color = ColorSequence.new(color3())
		if spraying and math.abs(u) < 1.4 and math.abs(v) < 1.4 then Paint.spray(P.s, u, v, dt) end
		acc = acc + dt
		if acc > 0.08 and P.s then
			acc = 0
			for i, cell in ipairs(P.cells) do
				local w = P.s.g[i]
				cell.Transparency = 1 - math.min(1, w)
				cell.Color = w > 1.7 and color3():Lerp(Color3.new(0, 0, 0), 0.35) or color3()
			end
			local r = Paint.result(P.s)
			quality.Text = string.format("Täckning %d %%<br/>Jämnhet %d %%<br/>Rinningar %d %%<br/>Kvalitet: <b>%s</b>", math.floor(r.coverage * 100), math.floor(r.evenness * 100), math.floor(r.runs * 100), r.label)
		end
	end)
end)
UIS.InputBegan:Connect(function(io, gp) if not gp and io.KeyCode == Enum.KeyCode.Escape and gui.Enabled then Api:InvokeServer("paintDone", nil); cleanup() end end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX23"><Properties><string name="Name">Porting</string><ProtectedString name="Source"><![CDATA[-- Cylinder porting in first person: an enlarged work view of the cylinder in the vise, glowing port areas,
-- a hand with a die grinder that follows the mouse. Hold the left button to grind. Quality from Porting.lua.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = RS:WaitForChild("Shared")
local Porting = require(Shared.Porting)
local Builder = require(Shared.Builder)
local GarageBuilder = require(Shared.GarageBuilder)
local CS = require(Shared.ClientState)
local Api = RS:WaitForChild("Remotes"):WaitForChild("Api")
local plr = Players.LocalPlayer
local cam = workspace.CurrentCamera

local function new(class, props, parent) local o = Instance.new(class); for k, v in pairs(props) do o[k] = v end; o.Parent = parent; return o end
local function corner(o) new("UICorner", { CornerRadius = UDim.new(0, 8) }, o); return o end
local function txt(parent, t, size, color)
	return new("TextLabel", { BackgroundTransparency = 1, Text = t, TextSize = size or 14, TextColor3 = color or Color3.new(1, 1, 1), Font = Enum.Font.GothamMedium, RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, parent)
end
local function button(parent, t, color, cb)
	local b = corner(new("TextButton", { Text = t, TextSize = 14, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = color, Size = UDim2.new(1, 0, 0, 32) }, parent))
	b.MouseButton1Click:Connect(cb)
	return b
end

local gui = new("ScreenGui", { Name = "Porting", ResetOnSpawn = false, Enabled = false }, plr:WaitForChild("PlayerGui"))
local banner = corner(new("TextLabel", { BackgroundColor3 = Color3.fromRGB(20, 24, 30), BackgroundTransparency = 0.15, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamMedium, TextSize = 16,
	Text = "ⓘ  Porta de markerade områdena för bästa prestanda!", Position = UDim2.new(0, 16, 0, 16), Size = UDim2.new(0, 470, 0, 40) }, gui))
local panel = corner(new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 24, 30), BackgroundTransparency = 0.1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Size = UDim2.new(0, 250, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, gui))
new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) }, panel)
new("UIListLayout", { Padding = UDim.new(0, 5) }, panel)
local title = txt(panel, "<b>Framsteg</b>", 18)
local bars = {}
for _, z in ipairs(Porting.ZONES) do
	txt(panel, z.n, 12, Color3.fromRGB(190, 198, 210))
	local bg = corner(new("Frame", { BackgroundColor3 = Color3.fromRGB(50, 56, 66), Size = UDim2.new(1, 0, 0, 8) }, panel))
	bars[z.id] = corner(new("Frame", { BackgroundColor3 = z.color, Size = UDim2.new(0, 0, 1, 0) }, bg))
end
local metrics = txt(panel, "", 14)
local start = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, panel)
new("UIListLayout", { Padding = UDim.new(0, 5) }, start)

local W = { on = false } -- work state
local function cleanup()
	if W.piece then W.piece:Destroy() end
	if W.hand then W.hand:Destroy() end
	if W.con then W.con:Disconnect() end
	W = { on = false }
	gui.Enabled = false
	cam.CameraType = Enum.CameraType.Custom
	UIS.MouseIconEnabled = true
	CS.setMode(nil); CS.modeEnded:Fire()
end

-- the enlarged work view: finned cylinder, bore (the work surface) and the zones as cells
local R = 2.6 -- the bore's radius in studs (the view is enlarged, the real cylinder is 8.5 cm)
local function buildPiece(center)
	local m = new("Model", { Name = "PortingView" }, cam)
	local function p(props) local x = new("Part", { Anchored = true, CanCollide = false, CanQuery = false, TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth }, m); for k, v in pairs(props) do x[k] = v end; return x end
	p({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 7.4, 7.4), CFrame = CFrame.new(center - Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(160, 165, 172), Material = Enum.Material.Metal })
	for i = 0, 5 do p({ Size = Vector3.new(9, 0.18, 9), CFrame = CFrame.new(center - Vector3.new(0, 2.9 - i * 0.5, 0)), Color = Color3.fromRGB(150, 155, 162), Material = Enum.Material.Metal }) end
	p({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.06, R * 2, R * 2), CFrame = CFrame.new(center + Vector3.new(0, 0.01, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(40, 42, 46), Material = Enum.Material.Metal })
	local cells = {}
	for _, z in ipairs(Porting.ZONES) do
		cells[z.id] = {}
		local cw = (z.u[2] - z.u[1]) / Porting.CU * R * 0.92
		local ch = (z.v[2] - z.v[1]) / Porting.CV * R * 0.92
		for i = 1, Porting.CU * Porting.CV do
			local cu, cv = Porting.cellCenter(z, i)
			cells[z.id][i] = p({ Size = Vector3.new(cw, 0.05, ch), CFrame = CFrame.new(center + Vector3.new(cu * R, 0.06, -cv * R)), Color = z.color, Material = Enum.Material.Neon, Transparency = 0.25 })
		end
	end
	return m, cells
end

local function uvFromMouse(center)
	local mpos = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mpos.X, mpos.Y)
	if math.abs(ray.Direction.Y) < 1e-3 then return nil end
	local t = (center.Y + 0.06 - ray.Origin.Y) / ray.Direction.Y
	local hit = ray.Origin + ray.Direction * t
	return (hit.X - center.X) / R, -(hit.Z - center.Z) / R, hit
end

local function begin(training)
	local ok, steady = Api:InvokeServer("portStart", training)
	if not ok then CS.toast:Fire(tostring(steady)); return end
	for _, c in ipairs(start:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	local a = GarageBuilder.anchors(GarageBuilder.plotOrigin(CS.profile._plot))
	local center = a.portbench.Position + Vector3.new(0, 3.2, 0)
	W.training = training
	W.s = Porting.new(steady or 0.6, training)
	W.piece, W.cells = buildPiece(center)
	cam.CameraType = Enum.CameraType.Scriptable
	TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { CFrame = CFrame.lookAt(center + Vector3.new(0, 9, 5.5), center) }):Play()
	W.hand = Builder.hand("grinder", { steady = steady })
	W.hand.Parent = cam
	local tip = new("Attachment", { Position = Vector3.new(0, 0, -0.13 / 0.28) }, W.hand.PrimaryPart)
	-- the work view is enlarged (bore 8.5 cm -> 5.2 studs), so the hand is enlarged by the same factor
	local SCALE = R / (0.0425 / 0.28)
	pcall(function() W.hand:ScaleTo(SCALE) end)
	W.tipLen = tip.Position.Magnitude
	W.sparks = new("ParticleEmitter", { Texture = "rbxasset://textures/particles/sparkles_main.dds", Rate = 0, Lifetime = NumberRange.new(0.15, 0.4), Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(60, 60), Size = NumberSequence.new(0.15, 0), Color = ColorSequence.new(Color3.fromRGB(255, 200, 90)), LightEmission = 1 }, tip)
	W.dust = new("ParticleEmitter", { Texture = "rbxasset://textures/particles/smoke_main.dds", Rate = 0, Lifetime = NumberRange.new(0.3, 0.6), Speed = NumberRange.new(1, 2), Size = NumberSequence.new(0.3, 1.2),
		Transparency = NumberSequence.new(0.6, 1), Color = ColorSequence.new(Color3.fromRGB(170, 170, 170)) }, tip)
	-- the hand slides in from the lower right
	W.handIn = 0
	W.on = true
	UIS.MouseIconEnabled = false
	local acc = 0
	W.con = RunService.RenderStepped:Connect(function(dt)
		local u, v, hit = uvFromMouse(center)
		if not u then return end
		local grinding = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		local jitter = grinding and (1 - W.s.steady) * 0.08 + 0.015 or 0
		local jx, jz = (math.random() - 0.5) * jitter, (math.random() - 0.5) * jitter
		W.handIn = math.min(1, W.handIn + dt * 3)
		local from = cam.CFrame.Position + cam.CFrame.RightVector * 6 - cam.CFrame.UpVector * 4
		local target = hit + Vector3.new(jx, 0.25, jz)
		local pos = from:Lerp(target, W.handIn)
		-- the grinder leans towards the cylinder; the hand rotates slightly with movement
		W.vel = (W.last and (pos - W.last) / math.max(dt, 1e-3)) or Vector3.zero
		W.last = pos
		local tilt = math.clamp(W.vel.X * 0.03, -0.4, 0.4)
		-- place the grip so the bit tip ends up exactly at the mouse pointer (the tool comes in from above at an angle)
		local dir = Vector3.new(-0.25, -0.85, -0.45).Unit
		W.hand:PivotTo(CFrame.lookAt(pos - dir * W.tipLen, pos) * CFrame.Angles(0, 0, tilt))
		local zone = Porting.grind(W.s, u + jx / R, v - jz / R, dt, grinding and W.handIn >= 1)
		W.sparks.Rate = (grinding and zone) and 140 or 0
		W.dust.Rate = (grinding and not zone) and 40 or 0
		acc = acc + dt
		if acc > 0.1 then
			acc = 0
			for _, z in ipairs(Porting.ZONES) do
				for i, cell in ipairs(W.cells[z.id]) do
					local w = W.s.cells[z.id][i]
					if w > 1.4 then cell.Color, cell.Material, cell.Transparency = Color3.fromRGB(120, 30, 20), Enum.Material.Metal, 0
					elseif w >= 1 then cell.Color, cell.Material, cell.Transparency = Color3.fromRGB(225, 230, 236), Enum.Material.Metal, 0
					else cell.Color, cell.Material, cell.Transparency = z.color:Lerp(Color3.fromRGB(225, 230, 236), w), Enum.Material.Neon, 0.25 + 0.5 * w end
				end
				bars[z.id].Size = UDim2.new(Porting.zoneProgress(W.s, z.id), 0, 1, 0)
			end
			local r = Porting.result(W.s)
			local function ck(x) return x > 0.7 and " <font color=\"#5ad26e\">✓</font>" or "" end
			metrics.Text = string.format("Jämnhet %d %%%s<br/>Precision %d %%%s<br/>Kvalitet: <b>%s</b>%s<br/>%s",
				math.floor(r.evenness * 100), ck(r.evenness), math.floor(r.precision * 100), ck(r.precision), r.label, r.over > 0.05 and " <font color=\"#ff6a4a\">(överportad!)</font>" or "",
				W.training and "<font color=\"#ffb020\">Träningsläge: ingen cylinder ändras</font>" or "")
			title.Text = string.format("<b>Framsteg %d %%</b>", math.floor(r.coverage * 100))
		end
	end)
	button(start, W.training and "Avsluta träningen" or "Klar – spara portningen", Color3.fromRGB(40, 160, 80), function()
		local r = Porting.result(W.s)
		-- the hand slides out, then the result goes to the server
		W.handIn = 0
		local ok2, msg = Api:InvokeServer("portDone", r)
		CS.toast:Fire(tostring(msg))
		cleanup()
	end)
	button(start, "Avbryt", Color3.fromRGB(110, 118, 130), function() Api:InvokeServer("portDone", nil); cleanup() end)
end

CS.openPort.Event:Connect(function()
	if CS.mode then return end
	CS.setMode("port")
	gui.Enabled = true
	metrics.Text = "Cylindern spänns fast i skruvstycket. Håll vänster musknapp för att slipa. Jobba jämnt över varje område, stanna innanför markeringarna och slipa inte för länge på samma ställe."
	for _, c in ipairs(start:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	local hasCyl = false
	for _, it in pairs(CS.profile.items) do if it.loc == "portbench" then hasCyl = true end end
	if hasCyl then button(start, "Börja porta", Color3.fromRGB(26, 108, 220), function() begin(false) end) end
	button(start, "Träna (ingen cylinder ändras)", Color3.fromRGB(230, 140, 20), function() begin(true) end)
	button(start, "Stäng", Color3.fromRGB(110, 118, 130), function() cleanup() end)
end)
UIS.InputBegan:Connect(function(io, gp) if not gp and io.KeyCode == Enum.KeyCode.Escape and gui.Enabled then if W.on then Api:InvokeServer("portDone", nil) end; cleanup() end end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX24"><Properties><string name="Name">Ride</string><ProtectedString name="Source"><![CDATA[-- Riding on the client: keys -> RideSim (the physics), RideSim -> the moped's constraints.
-- The client owns the moped's physics and drives it with LinearVelocity (speed in the ground plane) and
-- AlignOrientation (heading, lean, wheelie). Rewards are calculated and checked by the server.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local RideSim = require(Shared.RideSim)
local CS = require(Shared.ClientState)
local remotes = RS:WaitForChild("Remotes")
local Report, Api = remotes:WaitForChild("Report"), remotes:WaitForChild("Api")
local plr = Players.LocalPlayer
local S = 1 / Config.STUD

local R = RideSim.new(function(kind, ...)
	if kind == "say" then CS.toast:Fire((...))
	else Report:FireServer(kind, ...) end
end)
R.whValue = RideSim.whValue
CS.ride = R
CS.changed.Event:Connect(function() local p = CS.profile; if p and p.mopeds[p.cur] then RideSim.setProfile(R, p) end end)

local function myMoped()
	for _, m in ipairs(workspace:GetChildren()) do
		local o = m:FindFirstChild("Owner")
		if o and o.Value == plr and m:FindFirstChild("Seat") then return m end
	end
end
local function seatedOn(m)
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and m ~= nil and hum.SeatPart == m.Seat
end

local K = {}
local function key(k) return K[k] == true end
UIS.InputBegan:Connect(function(io, gp)
	if gp or io.UserInputType ~= Enum.UserInputType.Keyboard or CS.mode then return end
	local k = io.KeyCode.Name
	K[k] = true
	if not R.mop then return end
	if k == "K" then RideSim.kick(R, 1)
	elseif k == "X" then RideSim.stop(R)
	elseif k == "E" and not R.mop.cvt then R.gear = math.min(4, R.gear + 1)
	elseif k == "Q" and not R.mop.cvt then R.gear = math.max(1, R.gear - 1)
	elseif k == "R" then
		R.v, R.crash, R.wh, R.pitch, R.pw, R.lean = 0, nil, nil, 0, 0, 0
		Report:FireServer("dirty")
		task.spawn(function() Api:InvokeServer("home") end) -- the moped back to the garage
	end
end)
UIS.InputEnded:Connect(function(io) K[io.KeyCode.Name] = false end)
UIS.WindowFocusReleased:Connect(function() K = {} end)

local wasSeated = false
local baseC0 = setmetatable({}, { __mode = "k" }) -- the spokes' starting position per weld
RunService.Heartbeat:Connect(function(dtReal)
	if not R.P then return end
	local m = myMoped()
	local seated = seatedOn(m)
	if seated and not wasSeated and not R.on then RideSim.kick(R, 3) end -- "Åk ut" starts the engine
	wasSeated = seated
	local input = {
		thr = (key("W") or key("Up")) and 1 or 0,
		brk = (key("S") or key("Down")) and 1 or 0,
		st = ((key("D") or key("Right")) and 1 or 0) - ((key("A") or key("Left")) and 1 or 0),
		back = key("LeftShift") or key("RightShift"),
	}
	-- physics in sub-steps of at most 1/60 s based on real time
	local real = math.min(0.25, dtReal)
	local n = math.max(1, math.ceil(real * 60))
	for _ = 1, n do RideSim.step(R, real / n, seated, input) end
	R.seated = seated
	if not m then return end
	local root = m.PrimaryPart
	local lv, ao = root and root:FindFirstChild("Drive"), root and root:FindFirstChild("Tilt")
	if not (lv and ao) then return end
	if seated then
		if not R.drive then R.drive = true; local _, y = root.CFrame:ToOrientation(); R.h = y end
		local vs = R.v * S
		lv.MaxForce = 4e5
		lv.PlaneVelocity = Vector2.new(-math.sin(R.h) * vs, -math.cos(R.h) * vs)
		ao.MaxTorque = 1e6
		local roll = R.crash and R.crash.side * math.min(1.45, R.crash.t * 2.4) or -R.lean
		ao.CFrame = CFrame.Angles(0, R.h, 0) * CFrame.Angles(R.pitch, 0, roll)
	else
		-- parked: upright with the current heading and standing still (never limp, it would tip over)
		R.drive = false
		local _, y = root.CFrame:ToOrientation()
		lv.MaxForce, lv.PlaneVelocity = 2e4, Vector2.new(0, 0)
		ao.MaxTorque, ao.CFrame = 1e6, CFrame.Angles(0, y, 0)
	end
	-- spinning wheels (local visual) and exhaust smoke after the throttle
	local refs = m:FindFirstChild("Refs")
	if refs then
		R.wheelA = ((R.wheelA or 0) + (seated and R.v or 0) / R.mop.wr * real) % (2 * math.pi)
		for _, o in ipairs(refs:GetChildren()) do
			local w = o:IsA("ObjectValue") and o.Value
			if w and w:IsA("Weld") then
				if not baseC0[w] then baseC0[w] = w.C0 end
				w.C0 = baseC0[w] * CFrame.Angles(-R.wheelA, 0, 0)
			end
		end
	end
	local exAtt = root:FindFirstChild("ExhaustAtt")
	local smoke = exAtt and exAtt:FindFirstChild("Smoke")
	if smoke then smoke.Rate = R.on and (6 + 40 * R.thr) or 0 end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX25"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- The computer in the garage: the web shop Moppelagret.se (made-up shop, game money).
-- Start page, search, categories, product images (3D), stock status, cart, delivery time and order history.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Builder = require(Shared.Builder)
local Delivery = require(Shared.Delivery)
local CS = require(Shared.ClientState)
local Api = RS:WaitForChild("Remotes"):WaitForChild("Api")
local plr = Players.LocalPlayer
local COL = { bg = Color3.fromRGB(242, 244, 247), card = Color3.fromRGB(255, 255, 255), line = Color3.fromRGB(222, 226, 232), tx = Color3.fromRGB(28, 32, 38), mu = Color3.fromRGB(110, 118, 130),
	blue = Color3.fromRGB(26, 108, 220), green = Color3.fromRGB(40, 160, 80), orange = Color3.fromRGB(230, 140, 20), top = Color3.fromRGB(20, 26, 36) }

local function new(class, props, parent) local o = Instance.new(class); for k, v in pairs(props) do o[k] = v end; o.Parent = parent; return o end
local function corner(o, r) new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o); return o end
local function pad(o, n) new("UIPadding", { PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n), PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n) }, o) end
local function txt(parent, t, size, color, bold, props)
	local l = new("TextLabel", { BackgroundTransparency = 1, Text = t, TextSize = size or 14, TextColor3 = color or COL.tx, Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, RichText = true, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, parent)
	for k, v in pairs(props or {}) do l[k] = v end
	return l
end
local function button(parent, t, color, cb, w)
	local b = corner(new("TextButton", { Text = t, TextSize = 14, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = color or COL.blue, Size = UDim2.new(w or 1, 0, 0, 32), AutoButtonColor = true }, parent))
	b.MouseButton1Click:Connect(cb)
	return b
end
local function kr(n) return Catalog.fmt(n) .. " kr" end
local function call(a, ...) local ok, msg = Api:InvokeServer(a, ...); if type(msg) == "string" then CS.toast:Fire(msg) end; return ok, msg end

local gui = new("ScreenGui", { Name = "Shop", ResetOnSpawn = false, Enabled = false, IgnoreGuiInset = true, DisplayOrder = 5 }, plr:WaitForChild("PlayerGui"))
local win = corner(new("Frame", { BackgroundColor3 = COL.bg, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.94, 0, 0.9, 0) }, gui), 10)
-- browser bar
local bar = new("Frame", { BackgroundColor3 = Color3.fromRGB(225, 229, 235), Size = UDim2.new(1, 0, 0, 30) }, win); corner(bar, 10)
txt(bar, "  ●  ●  ●     🔒 https://moppelagret.se", 13, COL.mu, false, { Position = UDim2.new(0, 8, 0, 7), Size = UDim2.new(1, -60, 0, 16) })
local close = button(bar, "✕", Color3.fromRGB(200, 60, 50), function() gui.Enabled = false; CS.setMode(nil); CS.modeEnded:Fire() end); close.Size = UDim2.new(0, 34, 0, 24); close.Position = UDim2.new(1, -40, 0, 3)
-- site header
local head = new("Frame", { BackgroundColor3 = COL.top, Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, 0, 0, 56) }, win)
txt(head, "<b>MOPPELAGRET</b><font color=\"#ffb020\">.se</font>", 22, Color3.new(1, 1, 1), true, { Position = UDim2.new(0, 16, 0, 14), Size = UDim2.new(0, 220, 0, 28) })
local search = corner(new("TextBox", { PlaceholderText = "Sök efter produkter …", Text = "", TextSize = 15, Font = Enum.Font.Gotham, TextColor3 = COL.tx, BackgroundColor3 = Color3.new(1, 1, 1),
	Position = UDim2.new(0, 250, 0, 12), Size = UDim2.new(1, -560, 0, 32), ClearTextOnFocus = false }, head), 16)
local fitBtn = corner(new("TextButton", { Text = "", TextSize = 13, Font = Enum.Font.GothamMedium, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = Color3.fromRGB(50, 60, 76),
	Position = UDim2.new(1, -300, 0, 12), Size = UDim2.new(0, 160, 0, 32) }, head))
local cartBtn = corner(new("TextButton", { Text = "Kundvagn (0)", TextSize = 14, Font = Enum.Font.GothamBold, TextColor3 = COL.top, BackgroundColor3 = Color3.fromRGB(255, 176, 32),
	Position = UDim2.new(1, -130, 0, 12), Size = UDim2.new(0, 116, 0, 32) }, head))
-- left: categories
local left = new("ScrollingFrame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 86), Size = UDim2.new(0, 190, 1, -86), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4 }, win)
pad(left, 10); new("UIListLayout", { Padding = UDim.new(0, 2) }, left) -- the layouts are created once; clear() only removes GUI objects
-- centre: content, right: cart
local content = new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 200, 0, 96), Size = UDim2.new(1, -500, 1, -106), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6 }, win)
new("UIGridLayout", { CellSize = UDim2.new(0, 178, 0, 250), CellPadding = UDim2.new(0, 10, 0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, content)
local side = corner(new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.new(1, -290, 0, 96), Size = UDim2.new(0, 280, 1, -106) }, win), 8)
pad(side, 12); new("UIListLayout", { Padding = UDim.new(0, 6) }, side)
local modal = corner(new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 560, 0, 380), Visible = false, ZIndex = 10 }, win), 10)
pad(modal, 16)

local state = { cat = "Start", onlyMine = true, cart = {}, tab = "cart", filter = nil }
local function profile() return CS.profile end
local function mine() return profile() and profile().cur end

local function preview(parent, sku, h)
	local vp = corner(new("ViewportFrame", { BackgroundColor3 = Color3.fromRGB(236, 239, 243), Size = UDim2.new(1, 0, 0, h or 110), Ambient = Color3.fromRGB(160, 160, 170), LightDirection = Vector3.new(-1, -1.4, -0.7) }, parent), 6)
	local m = Builder.item(sku, { paint = { col = "#c8102e", fin = "gloss", q = 1 } })
	m.Parent = vp
	local c = new("Camera", { FieldOfView = 30 }, vp)
	vp.CurrentCamera = c
	local cf, size = m:GetBoundingBox()
	local r = math.max(0.3, size.Magnitude / 2)
	c.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0.55, 0.42, 0.72).Unit * (r / math.sin(math.rad(15)) * 1.05), cf.Position)
	return vp
end
local function stockColor(s) return s == "I lager" and COL.green or s == "Få kvar" and COL.orange or COL.mu end
local function cartCount() local n = 0; for _, l in ipairs(state.cart) do n = n + l.q end; return n end
local function addCart(sku, q)
	for _, l in ipairs(state.cart) do if l.sku == sku then l.q = math.min(10, l.q + (q or 1)); CS.toast:Fire("Lagd i kundvagnen"); return end end
	table.insert(state.cart, { sku = sku, q = q or 1 })
	CS.toast:Fire("Lagd i kundvagnen")
end

local renderSide, renderContent
local function clear(f) for _, c in ipairs(f:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end end

local function showProduct(pr)
	clear(modal); modal.Visible = true
	local vp = preview(modal, pr.sku, 220); vp.Size = UDim2.new(0, 230, 0, 230); vp.ZIndex = 11
	local info = new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 246, 0, 0), Size = UDim2.new(1, -246, 1, 0), ZIndex = 11 }, modal)
	new("UIListLayout", { Padding = UDim.new(0, 6) }, info)
	txt(info, "<b>" .. pr.name .. "</b>", 19, COL.tx).ZIndex = 11
	txt(info, pr.man .. " · " .. pr.cat .. " · art.nr " .. pr.sku, 12, COL.mu).ZIndex = 11
	txt(info, "<b>" .. kr(pr.price) .. "</b>", 22, COL.tx).ZIndex = 11
	txt(info, "● " .. pr.stock .. (pr.stock == "Beställningsvara" and " (+2 min leverans)" or ""), 13, stockColor(pr.stock)).ZIndex = 11
	txt(info, pr.desc ~= "" and pr.desc or "–", 14, COL.tx).ZIndex = 11
	local fits = {}
	for _, m in ipairs(Config.MOPEDS) do if Catalog.fits(pr, m.id) then table.insert(fits, m.n) end end
	txt(info, "Passar: " .. table.concat(fits, ", "), 13, COL.mu).ZIndex = 11
	local q = 1
	local qrow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), ZIndex = 11 }, info)
	local ql = txt(qrow, "Antal: 1", 15, COL.tx, true, { Size = UDim2.new(0, 90, 0, 32), AutomaticSize = Enum.AutomaticSize.None, ZIndex = 11 })
	local minus = button(qrow, "−", COL.mu, function() q = math.max(1, q - 1); ql.Text = "Antal: " .. q end)
	minus.Size, minus.Position, minus.ZIndex = UDim2.new(0, 32, 0, 30), UDim2.new(0, 96, 0, 0), 11
	local plus = button(qrow, "+", COL.mu, function() q = math.min(10, q + 1); ql.Text = "Antal: " .. q end)
	plus.Size, plus.Position, plus.ZIndex = UDim2.new(0, 32, 0, 30), UDim2.new(0, 132, 0, 0), 11
	button(info, "Lägg i kundvagn", COL.blue, function() addCart(pr.sku, q); modal.Visible = false; renderSide() end).ZIndex = 11
	button(info, "Stäng", COL.mu, function() modal.Visible = false end).ZIndex = 11
end

local function productCard(parent, pr, order)
	local card = corner(new("Frame", { BackgroundColor3 = COL.card, LayoutOrder = order }, parent), 8)
	pad(card, 8); new("UIListLayout", { Padding = UDim.new(0, 3) }, card)
	preview(card, pr.sku, 104)
	local name = new("TextButton", { BackgroundTransparency = 1, Text = pr.name, TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = COL.tx, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 34) }, card)
	name.MouseButton1Click:Connect(function() showProduct(pr) end)
	txt(card, pr.man, 11, COL.mu)
	txt(card, "<b>" .. kr(pr.price) .. "</b>  <font color=\"#" .. stockColor(pr.stock):ToHex() .. "\" size=\"11\">● " .. pr.stock .. "</font>", 15, COL.tx)
	button(card, "Köp", COL.blue, function() addCart(pr.sku, 1); renderSide() end)
end

local function matches(pr)
	if pr.price <= 0 then return false end
	if state.onlyMine and mine() and not Catalog.fits(pr, mine()) then return false end
	if state.filter then
		if state.filter.kind and pr.kind ~= state.filter.kind then return false end
		if state.filter.panel and pr.val.panel ~= state.filter.panel then return false end
	elseif state.cat ~= "Start" and state.cat ~= "Sök" and pr.cat ~= state.cat then return false end
	local q = string.lower(search.Text)
	if q ~= "" then for w in q:gmatch("%S+") do if not (string.lower(pr.name):find(w, 1, true) or string.lower(pr.man):find(w, 1, true) or string.lower(pr.cat):find(w, 1, true)) then return false end end end
	return true
end

function renderContent()
	clear(content)
	if state.cat == "Start" and search.Text == "" and not state.filter then
		local hero = corner(new("Frame", { BackgroundColor3 = COL.top, LayoutOrder = 0 }, content), 8)
		pad(hero, 12)
		txt(hero, "<b>Allt för din moppe</b>", 17, Color3.new(1, 1, 1))
		txt(hero, "Snabb leverans till garaget. Små order ~1 min, stora ~10 min.", 12, Color3.fromRGB(200, 208, 220))
	end
	local n = 0
	for _, pr in ipairs(Catalog.PR) do
		if matches(pr) and (state.cat ~= "Start" or search.Text ~= "" or state.filter or n < 12) then n = n + 1; productCard(content, pr, n) end
	end
	if n == 0 then txt(content, "Inga produkter hittades.", 15, COL.mu) end
end

function renderSide()
	clear(side)
	cartBtn.Text = "Kundvagn (" .. cartCount() .. ")"
	local tabs = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30) }, side)
	local b1 = button(tabs, "Din beställning", state.tab == "cart" and COL.blue or COL.mu, function() state.tab = "cart"; renderSide() end); b1.Size = UDim2.new(0.5, -3, 0, 28)
	local b2 = button(tabs, "Mina ordrar", state.tab == "orders" and COL.blue or COL.mu, function() state.tab = "orders"; renderSide() end); b2.Size = UDim2.new(0.5, -3, 0, 28); b2.Position = UDim2.new(0.5, 3, 0, 0)
	local p = profile()
	if state.tab == "cart" then
		local tot = 0
		if #state.cart == 0 then txt(side, "Kundvagnen är tom.", 14, COL.mu) end
		for i, l in ipairs(state.cart) do
			local pr = Catalog.BY_SKU[l.sku]
			tot = tot + pr.price * l.q
			local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40) }, side)
			txt(row, pr.name .. "<br/><font color=\"#6e7682\">" .. l.q .. " st × " .. kr(pr.price) .. "</font>", 12, COL.tx, false, { Size = UDim2.new(1, -60, 0, 40), AutomaticSize = Enum.AutomaticSize.None })
			local x = button(row, "✕", Color3.fromRGB(200, 60, 50), function() table.remove(state.cart, i); renderSide() end); x.Size = UDim2.new(0, 28, 0, 26); x.Position = UDim2.new(1, -28, 0, 6)
		end
		txt(side, "<b>Totalt: " .. kr(tot) .. "</b>", 16, COL.tx)
		if p then txt(side, "Ditt saldo: " .. kr(p.money), 13, tot > p.money and Color3.fromRGB(200, 60, 50) or COL.mu) end
		if #state.cart > 0 then
			local secs = Delivery.seconds(state.cart)
			txt(side, "Leverans: ca " .. (secs < 120 and "1 min" or math.floor(secs / 60 + 0.5) .. " min"), 13, COL.mu)
			button(side, "Beställ", COL.green, function()
				local ok = call("order", state.cart)
				if ok then state.cart = {}; state.tab = "orders" end
				renderSide()
			end)
		end
	else
		local any = false
		for _, o in ipairs(p and p.orders or {}) do
			any = true
			local box = corner(new("Frame", { BackgroundColor3 = COL.bg, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, side), 6)
			pad(box, 8); new("UIListLayout", { Padding = UDim.new(0, 3) }, box)
			local n = 0
			for _, l in ipairs(o.lines) do n = n + l.q end
			txt(box, "<b>Order " .. o.id .. "</b> · " .. n .. " delar · " .. kr(o.total), 13, COL.tx)
			if o.state == "transit" then
				local left_ = math.max(0, o.eta - workspace:GetServerTimeNow())
				txt(box, string.format("På väg – %d:%02d kvar", math.floor(left_ / 60), math.floor(left_ % 60)), 12, COL.orange)
				local barBg = corner(new("Frame", { BackgroundColor3 = COL.line, Size = UDim2.new(1, 0, 0, 6) }, box), 3)
				corner(new("Frame", { BackgroundColor3 = COL.orange, Size = UDim2.new(math.clamp(1 - left_ / math.max(1, o.eta - o.t0), 0, 1), 0, 1, 0) }, barBg), 3)
			elseif o.state == "arrived" then txt(box, "Levererad – paketet står vid garageporten", 12, COL.green)
			else txt(box, "Uppackad", 12, COL.mu) end
		end
		if not any then txt(side, "Inga beställningar än.", 14, COL.mu) end
	end
end

local function renderLeft()
	clear(left)
	for _, c in ipairs({ "Start", table.unpack(Catalog.CATS) }) do
		local b = new("TextButton", { Text = (c == "Start" and "Startsida" or c), TextSize = 14, Font = state.cat == c and Enum.Font.GothamBold or Enum.Font.Gotham, BackgroundTransparency = state.cat == c and 0 or 1,
			BackgroundColor3 = Color3.fromRGB(230, 238, 252), TextColor3 = state.cat == c and COL.blue or COL.tx, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 28) }, left)
		corner(b, 4)
		b.MouseButton1Click:Connect(function() state.cat, state.filter = c, nil; renderLeft(); renderContent() end)
	end
end
local function renderFit() fitBtn.Text = state.onlyMine and ("Bara till " .. (mine() and Config.BY_ID[mine()].n or "min moppe")) or "Alla modeller" end
fitBtn.MouseButton1Click:Connect(function() state.onlyMine = not state.onlyMine; renderFit(); renderContent() end)
cartBtn.MouseButton1Click:Connect(function() state.tab = "cart"; renderSide() end)
search:GetPropertyChangedSignal("Text"):Connect(function() if gui.Enabled then renderContent() end end)

CS.openShop.Event:Connect(function(filter)
	if CS.mode and CS.mode ~= "shop" then return end
	CS.setMode("shop")
	state.filter = filter
	if filter then state.cat = "Sök" end
	gui.Enabled = true
	renderLeft(); renderFit(); renderContent(); renderSide()
end)
CS.changed.Event:Connect(function() if gui.Enabled then renderSide() end end)
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc = acc + dt
	if gui.Enabled and state.tab == "orders" and acc > 1 then acc = 0; renderSide() end
end)
UIS.InputBegan:Connect(function(io, gp) if not gp and io.KeyCode == Enum.KeyCode.Escape and gui.Enabled then gui.Enabled = false; CS.setMode(nil); CS.modeEnded:Fire() end end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX26"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- HUD (money, messages, speedometer when riding), the "Min moppe" panel (M) and styling mode (3D view of the moped).
-- Most of the work happens physically in the garage (Interact, Shop, Porting, Paint); here only overview and settings.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Engine = require(Shared.Engine)
local Economy = require(Shared.Economy)
local Assembly = require(Shared.Assembly)
local Panels = require(Shared.Panels)
local CS = require(Shared.ClientState)
local remotes = RS:WaitForChild("Remotes")
local Api, StateEv = remotes:WaitForChild("Api"), remotes:WaitForChild("State")
local plr = Players.LocalPlayer
local cam = workspace.CurrentCamera
local COL = { bg = Color3.fromRGB(20, 24, 30), panel = Color3.fromRGB(28, 34, 43), input = Color3.fromRGB(44, 52, 64), tx = Color3.fromRGB(232, 236, 241), mu = Color3.fromRGB(150, 160, 175),
	ac = Color3.fromRGB(255, 176, 32), pos = Color3.fromRGB(90, 200, 110), neg = Color3.fromRGB(240, 100, 75) }

local function new(class, props, parent) local o = Instance.new(class); for k, v in pairs(props or {}) do o[k] = v end; o.Parent = parent; return o end
local function corner(o, r) new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o); return o end
local function pad(o, n) new("UIPadding", { PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n), PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n) }, o) end
local function txt(parent, t, size, color, bold)
	return new("TextLabel", { BackgroundTransparency = 1, Text = t, TextSize = size or 14, TextColor3 = color or COL.tx, Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham, RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, parent)
end
local function button(parent, t, primary, cb, w)
	local b = corner(new("TextButton", { Text = t, TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = primary and Color3.fromRGB(20, 20, 20) or COL.tx, BackgroundColor3 = primary and COL.ac or COL.input,
		Size = UDim2.new(w or 1, w and -4 or 0, 0, 30), AutoButtonColor = true }, parent), 6)
	b.MouseButton1Click:Connect(cb)
	return b
end
local function kr(n) return Catalog.fmt(n) .. " kr" end
local function call(a, ...) local ok, msg = Api:InvokeServer(a, ...); if type(msg) == "string" and msg ~= "" then CS.toast:Fire(msg) end; return ok end
local function clear(f) for _, c in ipairs(f:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end end

local gui = new("ScreenGui", { Name = "MoppeHUD", ResetOnSpawn = false }, plr:WaitForChild("PlayerGui"))
-- Roblox's player list covers the money top right: hide it (the garage signs show who owns what)
pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false) end)
-- ---------- HUD ----------
local money = corner(new("TextLabel", { BackgroundColor3 = COL.bg, BackgroundTransparency = 0.15, TextColor3 = Color3.fromRGB(255, 209, 102), Font = Enum.Font.GothamBold, TextSize = 22,
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.new(0, 170, 0, 40) }, gui))
local toastBox = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70), Size = UDim2.new(0, 520, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, gui)
new("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center }, toastBox)
CS.toast.Event:Connect(function(t)
	local l = corner(new("TextLabel", { BackgroundColor3 = COL.bg, BackgroundTransparency = 0.1, TextColor3 = COL.tx, Font = Enum.Font.GothamMedium, TextSize = 15, Text = t, TextWrapped = true,
		Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY }, toastBox), 8)
	pad(l, 8)
	task.delay(3.5, function() l:Destroy() end)
end)
local tip = corner(new("TextLabel", { BackgroundColor3 = COL.bg, BackgroundTransparency = 0.25, TextColor3 = COL.tx, Font = Enum.Font.Gotham, TextSize = 13, Position = UDim2.new(0, 14, 1, -40),
	Size = UDim2.new(0, 0, 0, 26), AutomaticSize = Enum.AutomaticSize.X }, gui), 6)
pad(tip, 6)
local speedo = corner(new("Frame", { BackgroundColor3 = COL.bg, BackgroundTransparency = 0.15, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14), Size = UDim2.new(0, 240, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false }, gui))
pad(speedo, 10); new("UIListLayout", { Padding = UDim.new(0, 2) }, speedo)
local spd = txt(speedo, "0 km/h", 34, COL.tx, true)
local rpmBg = corner(new("Frame", { BackgroundColor3 = Color3.fromRGB(60, 60, 60), Size = UDim2.new(1, 0, 0, 6) }, speedo), 3)
local rpmFill = corner(new("Frame", { BackgroundColor3 = COL.ac, Size = UDim2.new(0, 0, 1, 0) }, rpmBg), 3)
local info = txt(speedo, "", 13)

-- ---------- the "Min moppe" panel ----------
local side = corner(new("ScrollingFrame", { BackgroundColor3 = COL.panel, BackgroundTransparency = 0.05, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 62), Size = UDim2.new(0, 330, 1, -130),
	CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, BorderSizePixel = 0, Visible = false }, gui))
pad(side, 12); new("UIListLayout", { Padding = UDim.new(0, 6) }, side)
local mainBtn = corner(new("TextButton", { Text = "☰  Min moppe (M)", TextSize = 14, Font = Enum.Font.GothamBold, TextColor3 = COL.tx, BackgroundColor3 = COL.bg, BackgroundTransparency = 0.15,
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -194, 0, 14), Size = UDim2.new(0, 160, 0, 40) }, gui))
mainBtn.MouseButton1Click:Connect(function() side.Visible = not side.Visible end)

local function renderSide()
	local p = CS.profile
	if not p or not side.Visible then return end
	clear(side)
	local id = p.cur
	local mp = p.mopeds[id]
	local mop = Config.BY_ID[id]
	txt(side, "<b>" .. mop.n .. "</b>", 19)
	-- choose moped
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30) }, side)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4) }, row)
	for _, m in ipairs(Config.MOPEDS) do if p.mopeds[m.id] then button(row, m.n, m.id == id, function() call("select", m.id) end, 0.33) end end
	-- status
	local miss = Economy.mopedMissing(p, id)
	if #miss == 0 then txt(side, "<font color=\"#5ad26e\">✓ Komplett och körbar</font>", 14)
	else
		local names = {}
		for _, x in ipairs(Assembly.names(Assembly.chassisSlots(id), miss, id)) do table.insert(names, x) end
		if #Economy.engineMissing(p, id) > 0 then for _, x in ipairs(Assembly.names(Assembly.engineSockets(id), Economy.engineMissing(p, id), id)) do table.insert(names, "motor: " .. x) end end
		txt(side, "<font color=\"#ff6a4a\">Saknas:</font> " .. table.concat(names, ", "), 13)
	end
	local P = Economy.engine(p, id)
	local R = CS.ride
	local th = R and R.thermal and R.thermal[id] or Engine.newThermal()
	local ti = Engine.tinfo(mop, th)
	txt(side, string.format("<b>%.1f hk</b> · %s %d°C (%s) · skick %d %%", P.hp, ti.lab, math.floor(ti.v + 0.5), ti.band, math.floor((1 - (mp.dmg or 0)) * 100 + 0.5)), 13, COL.mu)
	local cyl = mp.eng.cyl and p.items[mp.eng.cyl]
	if cyl and cyl.port then txt(side, string.format("Portad cylinder: %s (+%.1f° avgastiming)", cyl.port.label, cyl.port.deg), 12, COL.mu) end
	-- the jet (the only setting outside the garage's work stations)
	local jr = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30) }, side)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), VerticalAlignment = Enum.VerticalAlignment.Center }, jr)
	local jl = txt(jr, "Huvudmunstycke <b>" .. mp.jet .. "</b>", 14); jl.Size = UDim2.new(0, 170, 0, 28); jl.AutomaticSize = Enum.AutomaticSize.None
	button(jr, "−", false, function() call("setJet", mp.jet - 1) end, 0.15)
	button(jr, "+", false, function() call("setJet", mp.jet + 1) end, 0.15)
	local mix = P.m < 0.93 and "<font color=\"#ff6a4a\">för mager – motorn blir varm</font>" or P.m > 1.1 and "<font color=\"#4aa3ff\">för fet – tappar effekt</font>" or "<font color=\"#5ad26e\">bra blandning</font>"
	txt(side, mix, 12)
	if (mp.dmg or 0) > 0 then button(side, "Reparera motorn, " .. kr(Economy.repairCost(p, id)), true, function() call("repair", false) end) end
	button(side, p._out and "Hämta hem mopeden (R)" or "Kör ut", not p._out, function() if p._out then call("home") else call("ride") end end)
	button(side, "Styling-läge", false, function() CS.openStyling:Fire() end)
	-- designs
	txt(side, "<b>Mina designer</b>", 14, COL.ac)
	local dr = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30) }, side)
	local box = corner(new("TextBox", { PlaceholderText = "Namn, t.ex. Black Edition", Text = "", TextSize = 13, Font = Enum.Font.Gotham, TextColor3 = COL.tx, BackgroundColor3 = COL.input, Size = UDim2.new(0.62, 0, 1, 0), ClearTextOnFocus = false }, dr), 6)
	local sb = button(dr, "Spara", true, function() call("saveDesign", box.Text) end); sb.Size = UDim2.new(0.36, 0, 1, 0); sb.Position = UDim2.new(0.64, 0, 0, 0)
	for name, d in pairs(p.designs) do if d.moped == id then button(side, "Lägg på: " .. name, false, function() call("applyDesign", name) end) end end
	-- mopeds to buy/sell
	txt(side, "<b>Mopeder</b>", 14, COL.ac)
	for _, m in ipairs(Config.MOPEDS) do
		if p.mopeds[m.id] then button(side, "Sälj " .. m.n .. " (" .. kr(Economy.sellValue(p, m.id)) .. ")", false, function() call("sellMoped", m.id) end)
		else button(side, "Köp " .. m.n .. " – " .. kr(m.price), false, function() call("buyMoped", m.id) end) end
	end
	-- tools
	local tools = {}
	for _, it in pairs(p.items) do if it.loc == "tool" then table.insert(tools, Catalog.BY_SKU[it.s].name) end end
	txt(side, "<b>Verktyg:</b> " .. table.concat(tools, ", "), 12, COL.mu)
	local s = p.stats
	txt(side, string.format("Byggda motorer %d · portade cylindrar %d · lackerade kåpor %d · körsträcka %.1f km · stegringar %d · intjänat %s", s.built, s.ported, s.painted, s.dist / 1000, s.wn, kr(s.earned)), 12, COL.mu)
end

-- ---------- styling mode: the moped in a large 3D view ----------
local sty = { on = false }
local styGui = new("ScreenGui", { Name = "Styling", ResetOnSpawn = false, Enabled = false }, plr:WaitForChild("PlayerGui"))
local styLeft = corner(new("ScrollingFrame", { BackgroundColor3 = COL.panel, BackgroundTransparency = 0.08, Position = UDim2.new(0, 14, 0, 14), Size = UDim2.new(0, 250, 1, -28), CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, BorderSizePixel = 0 }, styGui))
pad(styLeft, 10); new("UIListLayout", { Padding = UDim.new(0, 4) }, styLeft)
local styRight = corner(new("Frame", { BackgroundColor3 = COL.panel, BackgroundTransparency = 0.08, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.new(0, 230, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, styGui))
pad(styRight, 10); new("UIListLayout", { Padding = UDim.new(0, 6) }, styRight)
local styHl = new("Highlight", { FillTransparency = 0.7, FillColor = COL.ac, OutlineColor = COL.ac }, styGui)
local function renderStyling()
	local p = CS.profile
	clear(styLeft); clear(styRight)
	txt(styLeft, "<b>Kåpor</b>", 16)
	local id = p.cur
	for _, pd in ipairs(Panels[id]) do
		local u = p.mopeds[id].ch["pan:" .. pd.id]
		local it = u and p.items[u]
		local f = corner(new("TextButton", { Text = "", BackgroundColor3 = COL.input, Size = UDim2.new(1, 0, 0, 36), AutoButtonColor = true }, styLeft), 6)
		corner(new("Frame", { BackgroundColor3 = it and it.paint and Color3.fromHex(it.paint.col) or Color3.fromRGB(60, 60, 60), Position = UDim2.new(0, 6, 0, 8), Size = UDim2.new(0, 20, 0, 20) }, f), 10)
		new("TextLabel", { BackgroundTransparency = 1, Text = pd.n .. (it and "" or " (demonterad)"), TextSize = 12, Font = Enum.Font.GothamMedium, TextColor3 = it and COL.tx or COL.mu,
			TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(0, 34, 0, 0), Size = UDim2.new(1, -38, 1, 0), TextWrapped = true }, f)
		f.MouseButton1Click:Connect(function()
			local m = workspace:FindFirstChild("Moped_" .. plr.Name)
			styHl.Adornee = m and m:FindFirstChild("Panel_" .. pd.id) or nil
			CS.toast:Fire(it and (Catalog.BY_SKU[it.s].name .. " · " .. it.paint.col .. " · lack " .. math.floor((it.paint.q or 1) * 100) .. " %") or (pd.n .. " är demonterad"))
		end)
	end
	txt(styRight, "<b>Styling</b>", 16)
	txt(styRight, "Klicka på en kåpa i garaget för att demontera eller byta den. Lackering görs i lackboxen: demontera kåpan, bär den dit och spraya.", 12, COL.mu)
	button(styRight, "Rotera 360°", true, function() sty.spin = not sty.spin end)
	for name, d in pairs(p.designs) do if d.moped == id then button(styRight, "Design: " .. name, false, function() call("applyDesign", name) end) end end
	button(styRight, "Stäng (Esc)", false, function() sty.exit() end)
end
function sty.exit()
	if not sty.on then return end
	sty.on = false; styGui.Enabled = false; styHl.Adornee = nil
	if sty.con then sty.con:Disconnect() end
	cam.CameraType = Enum.CameraType.Custom
	CS.setMode(nil); CS.modeEnded:Fire()
end
CS.openStyling.Event:Connect(function()
	if CS.mode then return end
	local m = workspace:FindFirstChild("Moped_" .. plr.Name)
	if not m then CS.toast:Fire("Mopeden står inte i garaget"); return end
	CS.setMode("styling"); sty.on = true; styGui.Enabled = true; side.Visible = false
	renderStyling()
	cam.CameraType = Enum.CameraType.Scriptable
	sty.az, sty.el, sty.dist, sty.spin = 0.8, 0.25, 9, false
	sty.con = RunService.RenderStepped:Connect(function(dt)
		if sty.spin then sty.az = sty.az + dt * 0.6 end
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then local d = UIS:GetMouseDelta(); sty.az = sty.az - d.X * 0.008; sty.el = math.clamp(sty.el + d.Y * 0.006, 0.02, 1.2) end
		local c = m:GetPivot().Position
		cam.CFrame = CFrame.lookAt(c + Vector3.new(math.sin(sty.az) * math.cos(sty.el), math.sin(sty.el), math.cos(sty.az) * math.cos(sty.el)) * sty.dist, c)
	end)
end)
UIS.InputChanged:Connect(function(io) if sty.on and io.UserInputType == Enum.UserInputType.MouseWheel then sty.dist = math.clamp(sty.dist - io.Position.Z * 0.8, 3.5, 18) end end)

-- ---------- updates ----------
StateEv.OnClientEvent:Connect(function(p, msg)
	CS.profile = p
	CS.changed:Fire()
	if msg and msg ~= "" then CS.toast:Fire(tostring(msg)) end
	renderSide()
	if sty.on then renderStyling() end
end)
task.spawn(function() for _ = 1, 30 do if Api:InvokeServer("state") then break end; task.wait(1) end end)
UIS.InputBegan:Connect(function(io, gp)
	if gp then return end
	if io.KeyCode == Enum.KeyCode.M and not CS.mode then side.Visible = not side.Visible; renderSide() end
	if io.KeyCode == Enum.KeyCode.Escape and sty.on then sty.exit() end
end)
local last = 0
RunService.RenderStepped:Connect(function()
	local p, R = CS.profile, CS.ride
	if not p then return end
	money.Text = kr(p.money)
	local riding = R and R.seated
	speedo.Visible = riding and true or false
	tip.Text = CS.mode and "Esc = lämna" or riding and "W gas · S broms · A/D styr · Shift stegring · K starta · X stäng av · Q/E växla · R tillbaka till garaget · Mellanslag kliv av"
		or (p._carry and "Du bär en del – klicka på bänken, hyllan, motorn eller mopeden" or "Klicka på saker i garaget · Datorn = butik · M = min moppe")
	if riding and R.P then
		spd.Text = math.floor(R.v * 3.6 + 0.5) .. " km/h"
		rpmFill.Size = UDim2.new(math.clamp(R.rpm / R.P.lim, 0, 1), 0, 1, 0)
		local ti = Engine.tinfo(R.mop, R.thermal[R.mop.id])
		local lines = {}
		if R.crash then table.insert(lines, "<font color=\"#ff6a4a\"><b>VURPA</b></font> – " .. R.crash.why)
		elseif not R.on then table.insert(lines, "<font color=\"#ff6a4a\"><b>Motorn är av</b></font> · K") end
		if R.wh then local est, mult = R.whValue(R.wh); table.insert(lines, string.format("<font color=\"#ffd166\"><b>STEGRING %.1f s</b></font> · ×%.2f · ≈ +%d kr", R.wh.t, mult or 0, est or 0)) end
		if R.on then table.insert(lines, math.floor(R.rpm) .. " rpm" .. (R.mop.cvt and "" or (" · växel " .. R.gear))) end
		table.insert(lines, string.format("%s <b>%d°C</b> %s", ti.lab, math.floor(ti.v + 0.5), ti.band))
		info.Text = table.concat(lines, "\n")
	end
	if side.Visible and os.clock() - last > 1 and not UIS:GetFocusedTextBox() then last = os.clock(); renderSide() end
end)
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</roblox>
