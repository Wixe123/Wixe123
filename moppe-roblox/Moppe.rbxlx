-- tändning ------------------------------------------------------------------
add("cdi", "origo", "Origo", "CDI original (spärrad)", 390, 5, { limit = 7000 }, "Varvspärr för 45 km/h.")
add("cdi", "snabbo", "Snabbo", "CDI Racing ospärrad", 790, 4, { limit = 13000 }, "Ingen varvspärr.")
