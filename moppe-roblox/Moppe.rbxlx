add("avgas", "snabbo", "Snabbo", "Avgas Pipe 80", 3490, 0, { mult = 1.31, rpm = 1500, lvl = 3, loud = 1.8 }, "Störst kammare. Kräver racingcylinder.")

-- verktyg ----------------------------------------------------------------------
add("verktyg", "hylsor", "Bruksmek", "Hylsnyckelsats", 0, 99, { tool = "hylsor" }, "Hylsor och spärrskaft. Följer med garaget.")
add("verktyg", "slip", "Bruksmek", "Rak slipmaskin", 690, 8, { tool = "slip", steady = 0.0, speed = 1.0 }, "Rak slipmaskin för portning.")
add("verktyg", "slippro", "Fartek", "Rak slipmaskin Pro", 1490, 3, { tool = "slip", steady = 1.0, speed = 1.3 }, "Stadigare och snabbare. Lättare att porta jämnt.")
add("verktyg", "spruta", "Bruksmek", "Sprutpistol", 490, 8, { tool = "spruta", even = 0.0 }, "Enkel sprutpistol.")
add("verktyg", "sprutapro", "Fartek", "Sprutpistol HVLP Pro", 1290, 3, { tool = "spruta", even = 1.0 }, "Jämnare stråle, färre rinningar.")

function Parts.get(sku) return Parts.ITEMS[sku] end
function Parts.kindName(kind) local k = Parts.KINDS[kind]; return k and k.n or kind end
function Parts.byKind(kind)
	local r = {}
	for _, it in ipairs(Parts.LIST) do if it.kind == kind then r[#r + 1] = it end end
	return r
end
function Parts.category(sku)
	local it = Parts.ITEMS[sku]
	return it and Parts.KINDS[it.kind].cat
end
function Parts.brandColor(brand)
	local b = Parts.BRANDS[brand]
	local c = b and b.color or { 190, 194, 200 }
	return c[1], c[2], c[3]
end

return Parts
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Performance</string><ProtectedString name="Source"><![CDATA[-- Engine and moped performance from the mounted parts. A simplified, game-balanced model:
-- the cylinder gives the base power and rev range; carburettor, intake, exhaust, ignition and porting scale it,
-- parts that are too small for the cylinder hold it back, and the CVT (variator, rollers, clutch) decides
-- where the engine runs at each speed. The same functions drive the riding simulation.
local Parts = require(script.Parent.Parts)
local Performance = {}

local KMH = 3.6
Performance.MASS = 152 -- moped + rider, kg
Performance.CDA = 0.62 -- drag area m^2
Performance.CRR = 0.016
Performance.WHEEL_R = 0.27 -- m
Performance.GEARBOX = 12.4 -- fixed reduction after the CVT
Performance.CVT_LOW = 2.55

local function st(items, map, sock, key, default)
	local uid = map and map[sock]
	local it = uid and items[uid]
	local p = it and Parts.get(it.sku)
	local v = p and p.stats[key]
	if v == nil then return default end
	return v
end
local function item(items, map, sock)
	local uid = map and map[sock]
	return uid and items[uid]
end

-- level mismatch: a part below the cylinder's level holds power back
local function match(partLvl, cylLvl)
	local d = (partLvl or 0) - (cylLvl or 0)
	if d >= 0 then return 1 + 0.025 * math.min(d, 2) end
	return 1 + 0.06 * d
end

-- cfg from an engine socket map; chassis map optional
function Performance.config(items, engine, chassis, jet)
	local c = {}
	jet = jet or 0 -- -2 (rich) .. +2 (lean)
	local cyl = item(items, engine, "cylinder")
	local lvl = st(items, engine, "cylinder", "lvl", 0)
	local hp = st(items, engine, "cylinder", "hp", 3.0)
	local rpm = st(items, engine, "cylinder", "rpm", 6500)
	local cc = st(items, engine, "cylinder", "cc", 49.3)
	local stroke = st(items, engine, "vevaxel", "stroke", 39.2)
	cc = cc * stroke / 39.2
	hp = hp * (stroke / 39.2) ^ 0.8
	-- porting result stored on the cylinder item
	local portQ = cyl and cyl.port and cyl.port.q
	if portQ then
		hp = hp * (0.92 + 0.17 * portQ)
	end
	-- multipliers from parts
	for _, s in ipairs({ "vevhus", "vevaxel", "fotpackning", "cdi", "spole" }) do hp = hp * st(items, engine, s, "hp", 1) end
	hp = hp * st(items, engine, "topplock", "comp", 1)
	local exhMult = st(items, chassis, "avgas", "mult", 1.0)
	local exhLvl = st(items, chassis, "avgas", "lvl", 0)
	hp = hp * exhMult * match(exhLvl, lvl)
	hp = hp * match(st(items, engine, "reed", "lvl", 0), lvl)
	hp = hp * match(st(items, engine, "insug", "lvl", 0), lvl)
	hp = hp * match(st(items, engine, "luftfilter", "lvl", 0), lvl)
	-- jetting: lean gives a little power and much more heat
	hp = hp * (1 + 0.03 * jet - 0.012 * jet * jet)
	-- carburettor flow: soft cap
	local cap = st(items, engine, "forgasare", "cap", 4.6)
	if hp > cap then hp = cap + (hp - cap) * 0.25 end
	-- wear on piston and rings
	local wear = 0
	for _, s in ipairs({ "kolv", "kolvringar", "cylinder" }) do
		local it = item(items, engine, s)
		if it and it.wear then wear = math.max(wear, it.wear) end
	end
	hp = hp * (1 - 0.45 * wear)
	rpm = rpm + st(items, chassis, "avgas", "rpm", 0) + st(items, engine, "vevaxel", "rpm", 0)
	c.hp = hp
	c.peak = rpm
	c.cc = cc
	c.lvl = lvl
	c.wear = wear
	-- rev limit: the CDI, and bearings/pin decide how far over peak it can rev
	local mech = rpm + 1800 + st(items, engine, "vevlager", "rpm", 0) + st(items, engine, "nallager", "rpm", 0) + st(items, engine, "kolvbult", "rpm", 0)
	c.limit = math.min(st(items, engine, "cdi", "limit", 7000), mech)
	c.idle = 1800
	-- torque at peak (Nm): P[kW] = T * rpm / 9549, hp = kW * 1.341
	c.tq = hp / 1.341 * 9549 / rpm
	c.width = 0.42 + 0.06 * (3 - lvl) -- racing engines have a narrow powerband
	-- CVT
	c.high = st(items, engine, "variator", "high", 1.25)
	local gram = st(items, engine, "vikter", "gram", 6.0)
	c.shift = math.min(c.limit - 200, rpm - 900 + (6.0 - gram) * 650) -- rpm the variator holds
	c.engage = st(items, engine, "koppling", "engage", 3400)
	c.acc = st(items, engine, "variator", "acc", 1) * st(items, engine, "koppling", "acc", 1) * st(items, engine, "klocka", "acc", 1) * st(items, engine, "remskiva", "acc", 1) * st(items, engine, "svanghjul", "acc", 1)
	c.eff = 0.86 * st(items, engine, "rem", "eff", 1)
	-- heat: bigger tune runs hotter, a lean jet much hotter; cold plug, fan and head help
	local heat = st(items, engine, "cylinder", "heat", 1.0) * st(items, engine, "topplock", "heat", 1.0)
	heat = heat * (1 + 0.09 * jet) / st(items, engine, "flakt", "cool", 1.0)
	local range = st(items, engine, "tandstift", "range", 7)
	heat = heat * (1 - 0.02 * (range - 7))
	c.heat = heat
	-- chassis
	c.grip = (st(items, chassis, "framhjul", "grip", 1) + st(items, chassis, "bakhjul", "grip", 1)) / 2
	c.brake = (st(items, chassis, "frambroms", "brake", 1) * 0.65 + st(items, chassis, "bakbroms", "brake", 1) * 0.35)
	c.handling = st(items, chassis, "gaffel", "handling", 1) * st(items, chassis, "dampare", "handling", 1) * st(items, chassis, "styre", "handling", 1)
	c.loud = st(items, chassis, "avgas", "loud", 1)
	return c
end

-- engine torque (Nm) at rpm, full throttle
function Performance.torque(c, rpm)
	if rpm < 900 then return 0 end
	if rpm > c.limit then return 0 end
	local x = (rpm - c.peak) / (c.peak * c.width)
	local t = c.tq * math.max(0.12, 1 - 0.55 * x * x)
	if rpm > c.peak then t = c.tq * math.max(0.05, 1 - 0.9 * x * x) end
	return t
end
function Performance.powerHp(c, rpm) return Performance.torque(c, rpm) * rpm / 9549 * 1.341 end

-- CVT: engine rpm and total ratio for a road speed (m/s); also whether the clutch slips
function Performance.drive(c, v)
	local wheelRpm = math.abs(v) / (2 * math.pi * Performance.WHEEL_R) * 60
	local low, high = Performance.CVT_LOW * Performance.GEARBOX, c.high * Performance.GEARBOX
	local rpmLow = wheelRpm * low
	if rpmLow < c.engage then
		return math.max(c.engage, rpmLow), low, true
	end
	if rpmLow < c.shift then return rpmLow, low, false end
	local rpmHigh = wheelRpm * high
	if rpmHigh < c.shift then return c.shift, c.shift / math.max(wheelRpm, 1e-3), false end
	return rpmHigh, high, false
end

-- forward force (N) at speed v with throttle 0..1
function Performance.force(c, v, thr)
	local rpm, ratio, slip = Performance.drive(c, v)
	local t = Performance.torque(c, rpm) * thr
	if slip then t = t * 0.92 end
	return t * ratio * c.eff * c.acc / Performance.WHEEL_R, rpm
end
function Performance.resist(v)
	local drag = 0.5 * 1.2 * Performance.CDA * v * v
	local roll = Performance.MASS * 9.81 * Performance.CRR
	return drag + (v > 0.05 and roll or 0)
end

-- simulate full throttle from standstill: top speed (km/h) and 0-45 / 0-60 times
function Performance.simulate(c)
	local v, t, dt = 0, 0, 0.02
	local t45, t60
	local last = 0
	for i = 1, 4000 do
		local f = Performance.force(c, v, 1)
		local a = (f - Performance.resist(v)) / Performance.MASS
		v = math.max(0, v + a * dt)
		t = t + dt
		if not t45 and v * KMH >= 45 then t45 = t end
		if not t60 and v * KMH >= 60 then t60 = t end
		if i % 100 == 0 then
			if math.abs(v - last) < 0.005 then break end
			last = v
		end
	end
	return v * KMH, t45, t60
end

-- equilibrium temperature at full throttle on a straight (°C), from heat and power
function Performance.temp(c, kmh)
	local cool = 0.35 + 0.65 * math.min(1, (kmh or 40) / 60)
	return 70 + c.hp * 4.0 * c.heat / cool
end
Performance.TEMP_WARN = 150
Performance.TEMP_SEIZE = 175

-- everything the UI shows
function Performance.summary(items, engine, chassis, jet)
	local c = Performance.config(items, engine, chassis, jet)
	local top, t45, t60 = Performance.simulate(c)
	local peakHp, peakRpm = 0, 0
	for r = 2000, math.floor(c.limit), 100 do
		local h = Performance.powerHp(c, r)
		if h > peakHp then peakHp, peakRpm = h, r end
	end
	local temp = Performance.temp(c, top)
	local status = "OK"
	if c.wear > 0.6 then status = "Sliten" elseif temp > Performance.TEMP_WARN then status = "Går varm" elseif c.peak > c.limit + 300 then status = "Strypt (CDI)" end
	return { hp = peakHp, rpm = peakRpm, limit = c.limit, top = top, t45 = t45, t60 = t60, temp = temp, status = status, cc = c.cc, cfg = c }
end

return Performance
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Porting</string><ProtectedString name="Source"><![CDATA[-- Cylinder porting: four port windows, each a grid of cells that are ground down to the marked depth.
-- The client sends the cell depths when done; the server computes the quality from them with result().
local Porting = {}

Porting.COLS, Porting.ROWS = 6, 3
Porting.ZONES = {
	{ id = "avgas", n = "Porta avgasporten", face = "front", w = 0.62, h = 0.36 },
	{ id = "overV", n = "Överströmning vänster", face = "left", w = 0.4, h = 0.26 },
	{ id = "overH", n = "Överströmning höger", face = "right", w = 0.4, h = 0.26 },
	{ id = "insug", n = "Porta insuget", face = "back", w = 0.5, h = 0.3 },
}
Porting.BY_ID = {}
for _, z in ipairs(Porting.ZONES) do Porting.BY_ID[z.id] = z end
Porting.TARGET = 1.0 -- depth that counts as done
Porting.OVER = 1.3 -- deeper than this is over-ported (bad)

function Porting.new()
	local s = { cells = {}, inside = 0, outside = 0 }
	for _, z in ipairs(Porting.ZONES) do
		local c = {}
		for i = 1, Porting.COLS * Porting.ROWS do c[i] = 0 end
		s.cells[z.id] = c
	end
	return s
end

-- grind at (u,v) in 0..1 zone coordinates for dt seconds; speed from the tool; returns true if inside the zone
function Porting.grind(s, zoneId, u, v, dt, speed)
	local cells = s.cells[zoneId]
	if not cells then return false end
	speed = speed or 1
	if u < -0.02 or u > 1.02 or v < -0.02 or v > 1.02 then
		s.outside = s.outside + dt
		return false
	end
	s.inside = s.inside + dt
	local cx, cy = u * Porting.COLS + 0.5, v * Porting.ROWS + 0.5
	for row = 1, Porting.ROWS do
		for col = 1, Porting.COLS do
			local d = math.sqrt((col - cx) ^ 2 + (row - cy) ^ 2)
			if d < 1.25 then
				local i = (row - 1) * Porting.COLS + col
				cells[i] = cells[i] + dt * 1.3 * speed * (1 - d / 1.25)
			end
		end
	end
	return true
end

function Porting.zoneProgress(s, zoneId)
	local cells = s.cells[zoneId]
	local sum = 0
	for _, d in ipairs(cells) do sum = sum + math.min(d, Porting.TARGET) end
	return sum / (#cells * Porting.TARGET)
end
function Porting.progress(s)
	local t = 0
	for _, z in ipairs(Porting.ZONES) do t = t + Porting.zoneProgress(s, z.id) end
	return t / #Porting.ZONES
end

-- quality metrics 0..1 and an overall q; label in Swedish
function Porting.result(s)
	local all = {}
	for _, z in ipairs(Porting.ZONES) do
		local cells = s.cells and s.cells[z.id]
		if type(cells) ~= "table" then return nil end
		for i = 1, Porting.COLS * Porting.ROWS do
			local d = tonumber(cells[i]) or 0
			all[#all + 1] = math.max(0, math.min(3, d))
		end
	end
	local n = #all
	local cover, mean, over = 0, 0, 0
	for _, d in ipairs(all) do
		cover = cover + math.min(d, Porting.TARGET) / Porting.TARGET
		mean = mean + d
		if d > Porting.OVER then over = over + 1 end
	end
	cover, mean = cover / n, mean / n
	local var = 0
	for _, d in ipairs(all) do var = var + (math.min(d, 1.6) - math.min(mean, 1.6)) ^ 2 end
	local even = math.max(0, 1 - math.sqrt(var / n) * 1.6)
	local inside, outside = tonumber(s.inside) or 0, tonumber(s.outside) or 0
	local precision = (inside + outside) > 0 and inside / (inside + outside) or 0
	local overF = over / n
	local q = cover * 0.45 + even * 0.3 + precision * 0.25 - overF * 0.8
	q = math.max(0, math.min(1, q))
	if cover < 0.5 then q = math.min(q, 0.3) end
	local label = q >= 0.9 and "Perfekt" or (q >= 0.75 and "Bra" or (q >= 0.5 and "OK" or "Dålig"))
	return { cover = cover, even = even, precision = precision, over = overF, q = q, label = label }
end

return Porting
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Profile</string><ProtectedString name="Source"><![CDATA[-- A player's saved garage and every rule for changing it. Pure Lua (no Roblox objects), so the server is the only
-- one that changes a profile and the rules can be tested without Roblox. Functions return ok, err (Swedish message).
local Config = require(script.Parent.Config)
local Parts = require(script.Parent.Parts)
local EngineDef = require(script.Parent.EngineDef)
local MopedDef = require(script.Parent.MopedDef)
local Porting = require(script.Parent.Porting)
local Paint = require(script.Parent.Paint)
local Performance = require(script.Parent.Performance)
local Profile = {}

Profile.VERSION = 3
Profile.STORAGE = { hylla = true, bank = true, golv = true }
Profile.SHELF_SLOTS = 24
Profile.BENCH_SLOTS = 8
Profile.MAX_MOPEDS = 4
Profile.MAX_ORDER_LINES = 20

local function err(m) return false, m end

---------------------------------------------------------------- items
function Profile.addItem(p, sku, loc, extra)
	local id = "i" .. p.nextId
	p.nextId = p.nextId + 1
	local it = { sku = sku, loc = loc or "golv" }
	if extra then for k, v in pairs(extra) do it[k] = v end end
	p.items[id] = it
	return id
end
function Profile.count(p, loc)
	local n = 0
	for _, it in pairs(p.items) do if it.loc == loc then n = n + 1 end end
	return n
end
-- first storage place with room: shelf, then bench, then floor
function Profile.freeStorage(p)
	if Profile.count(p, "hylla") < Profile.SHELF_SLOTS then return "hylla" end
	if Profile.count(p, "bank") < Profile.BENCH_SLOTS then return "bank" end
	return "golv"
end
function Profile.inHand(p)
	for id, it in pairs(p.items) do if it.loc == "hand" then return id end end
end
local function boxOrder(p, loc)
	local oid = type(loc) == "string" and loc:match("^box:(%d+)$")
	if not oid then return nil end
	for _, o in ipairs(p.orders) do if o.id == tonumber(oid) then return o end end
end
-- can this item be picked up / used as a free part?
local function free(p, it)
	if not it then return false end
	if Profile.STORAGE[it.loc] or it.loc == "hand" then return true end
	-- a cylinder in the vise or a panel on the paint stand can be used when no session is running
	if it.loc == "port" then return not p.portStart end
	if it.loc == "lack" then return not p.paintStart end
	local o = boxOrder(p, it.loc)
	return o ~= nil and o.state == "oppnad"
end
Profile.isFree = free

function Profile.moveItem(p, id, loc)
	local it = p.items[id]
	if not it then return err("Delen finns inte") end
	if not free(p, it) and it.loc ~= "port" and it.loc ~= "lack" then
		if boxOrder(p, it.loc) then return err("Öppna paketet först") end
		return err("Delen sitter monterad")
	end
	if it.loc == "port" and p.portStart then return err("Portningen pågår") end
	if loc == "hand" then
		local h = Profile.inHand(p)
		if h and h ~= id then return err("Du bär redan något") end
	elseif loc == "hylla" then
		if Profile.count(p, "hylla") >= Profile.SHELF_SLOTS and it.loc ~= "hylla" then return err("Hyllan är full") end
	elseif loc == "bank" then
		if Profile.count(p, "bank") >= Profile.BENCH_SLOTS and it.loc ~= "bank" then return err("Arbetsbänken är full") end
	elseif loc == "port" then
		if Parts.get(it.sku).kind ~= "cylinder" then return err("Bara cylindrar kan portas") end
		if it.port then return err("Cylindern är redan portad") end
		for oid, o in pairs(p.items) do if o.loc == "port" and oid ~= id then return err("Det ligger redan en cylinder i skruvstädet") end end
	elseif loc == "lack" then
		if Parts.get(it.sku).kind ~= "kapa" then return err("Bara kåpor kan lackeras i lackboxen") end
		for oid, o in pairs(p.items) do if o.loc == "lack" and oid ~= id then return err("Det hänger redan en kåpa i lackboxen") end end
	elseif loc ~= "golv" then
		return err("Kan inte lägga delen där")
	end
	it.loc = loc
	Profile.cleanBoxes(p)
	return true
end

---------------------------------------------------------------- engine and moped
local function engineMap(p, target)
	if target == "stand" then return p.stand end
	local m = p.mopeds[p.cur]
	return m and m.engine, m
end
function Profile.mountEngine(p, target, sock, id)
	local map = engineMap(p, target)
	if not map then return err("Ingen motor där") end
	local it = p.items[id]
	if not free(p, it) then return err("Delen är inte ledig") end
	local ok, e = EngineDef.canMount(map, sock, it.sku, p.items)
	if not ok then return err(e) end
	map[sock] = id
	it.loc = "mount"
	Profile.cleanBoxes(p)
	return true
end
function Profile.unmountEngine(p, target, sock)
	local map = engineMap(p, target)
	if not map then return err("Ingen motor där") end
	local ok, e = EngineDef.canRemove(map, sock)
	if not ok then return err(e) end
	local id = map[sock]
	map[sock] = nil
	p.items[id].loc = Profile.count(p, "bank") < Profile.BENCH_SLOTS and "bank" or "golv"
	return true, id
end
function Profile.mountChassis(p, slot, id, now)
	local m = p.mopeds[p.cur]
	if not m then return err("Ingen moped på lyften") end
	local it = p.items[id]
	if not free(p, it) then return err("Delen är inte ledig") end
	if it.dry and now and it.dry > now then return err("Lacken är inte torr än") end
	local ok, e = MopedDef.canMount(m, slot, it.sku)
	if not ok then return err(e) end
	m.slots[slot] = id
	it.loc = "mount"
	Profile.cleanBoxes(p)
	return true
end
function Profile.unmountChassis(p, slot)
	local m = p.mopeds[p.cur]
	if not m then return err("Ingen moped på lyften") end
	if slot == "motor" then return Profile.engineToStand(p) end
	local ok, e = MopedDef.canRemove(m, slot)
	if not ok then return err(e) end
	local id = m.slots[slot]
	m.slots[slot] = nil
	p.items[id].loc = Profile.count(p, "bank") < Profile.BENCH_SLOTS and "bank" or "golv"
	return true, id
end
function Profile.engineToMoped(p)
	local m = p.mopeds[p.cur]
	if not m then return err("Ingen moped på lyften") end
	local ok, e = MopedDef.canMountEngine(m, p.stand)
	if not ok then return err(e) end
	m.engine = p.stand
	p.stand = {}
	return true
end
function Profile.engineToStand(p)
	local m = p.mopeds[p.cur]
	if not m or not m.engine then return err("Mopeden har ingen motor") end
	if not EngineDef.isEmpty(p.stand) then return err("Motorstativet är upptaget") end
	local ok, e = MopedDef.canRemove(m, "motor")
	if not ok then return err(e) end
	p.stand = m.engine
	m.engine = nil
	return true
end

-- problems that stop the current moped from running (missing parts, seized engine)
function Profile.mopedProblems(p, m)
	m = m or p.mopeds[p.cur]
	if not m then return { "Ingen moped" } end
	local r = MopedDef.missing(m)
	if m.engine then
		for _, s in ipairs({ "kolv", "kolvringar" }) do
			local id = m.engine[s]
			if id and p.items[id] and (p.items[id].wear or 0) >= 1 then r[#r + 1] = "Kolvskär: byt " .. EngineDef.BY_ID[s].name:lower() end
		end
	end
	return r
end
function Profile.canRide(p) return #Profile.mopedProblems(p) == 0 end
function Profile.chassisMap(m)
	local c = {}
	for k, v in pairs(m.slots) do c[k] = v end
	return c
end
function Profile.perf(p, m)
	m = m or p.mopeds[p.cur]
	if not m or not m.engine then return nil end
	return Performance.summary(p.items, m.engine, m.slots, m.jet or 0)
end

---------------------------------------------------------------- mopeds
local OEM = {
	ram = nil, gaffel = "gaffel_origo", framhjul = "framhjul_origo", frambroms = "frambroms_origo", styre = "styre_origo", dampare = "dampare_origo",
	bakhjul = "bakhjul_origo", bakbroms = "bakbroms_origo", avgas = "avgas_origo", tank = "tank_origo", sadel = "sadel_origo",
}
Profile.OEM_ENGINE = {
	vevhus = "vevhus_origo", vevlager = "vevlager_origo", vevaxel = "vevaxel_origo", packbox = "packbox_origo", nallager = "nallager_origo",
	kolv = "kolv_40", kolvbult = "kolvbult_origo", kolvringar = "kolvringar_40", fotpackning = "fotpackning_origo", cylinder = "cylinder_origo50",
	topplock = "topplock_origo", tandstift = "tandstift_b7", reed = "reed_origo", insug = "insug_origo", forgasare = "forgasare_origo12",
	luftfilter = "luftfilter_origo", slang = "slang_origo", stator = "stator_origo", svanghjul = "svanghjul_origo", cdi = "cdi_origo",
	spole = "spole_origo", tandkabel = "tandkabel_origo", variator = "variator_origo", vikter = "vikter_6g", flakt = "flakt_origo",
	remskiva = "remskiva_origo", koppling = "koppling_origo", rem = "rem_origo", klocka = "klocka_origo",
}
function Profile.newEngine(p, extra)
	local map = {}
	for sock, sku in pairs(Profile.OEM_ENGINE) do map[sock] = Profile.addItem(p, sku, "mount", extra) end
	return map
end
function Profile.giveMoped(p, model, color)
	local def = MopedDef.MODELS[model]
	local m = { model = model, slots = {}, engine = nil, jet = 0, odo = 0 }
	m.slots.ram = Profile.addItem(p, "ram_" .. model, "mount")
	for slot, sku in pairs(OEM) do m.slots[slot] = Profile.addItem(p, sku, "mount") end
	for _, pan in ipairs(def.panels) do
		m.slots["pan:" .. pan.id] = Profile.addItem(p, "kapa_" .. model .. "_" .. pan.id, "mount", { paint = { c = color or def.color, f = "blank", g = 0.6, q = 1 } })
	end
	m.engine = Profile.newEngine(p)
	p.mopeds[#p.mopeds + 1] = m
	return #p.mopeds
end
function Profile.buyMoped(p, model)
	local def = MopedDef.MODELS[model]
	if not def then return err("Okänd modell") end
	if #p.mopeds >= Profile.MAX_MOPEDS then return err("Garaget rymmer " .. Profile.MAX_MOPEDS .. " mopeder") end
	if p.money < def.price then return err("Du har inte råd") end
	p.money = p.money - def.price
	local idx = Profile.giveMoped(p, model)
	return true, idx
end
local function mopedItems(m)
	local r = {}
	for _, id in pairs(m.slots) do r[#r + 1] = id end
	if m.engine then for _, id in pairs(m.engine) do r[#r + 1] = id end end
	return r
end
function Profile.mopedValue(p, m)
	local v = 0
	for _, id in ipairs(mopedItems(m)) do
		local it = p.items[id]
		local part = it and Parts.get(it.sku)
		if part then v = v + part.price * (1 - 0.5 * (it.wear or 0)) end
	end
	return math.floor(v * 0.6)
end
function Profile.sellMoped(p, idx)
	local m = p.mopeds[idx]
	if not m then return err("Ingen sådan moped") end
	if #p.mopeds <= 1 then return err("Du måste ha minst en moped") end
	local v = Profile.mopedValue(p, m)
	for _, id in ipairs(mopedItems(m)) do p.items[id] = nil end
	table.remove(p.mopeds, idx)
	if p.cur > #p.mopeds then p.cur = #p.mopeds elseif p.cur > idx then p.cur = p.cur - 1 end
	p.money = p.money + v
	return true, v
end
function Profile.selectMoped(p, idx)
	if not p.mopeds[idx] then return err("Ingen sådan moped") end
	p.cur = idx
	return true
end
function Profile.setJet(p, jet)
	local m = p.mopeds[p.cur]
	jet = tonumber(jet)
	if not m or not jet then return err("Fel värde") end
	m.jet = math.max(-2, math.min(2, math.floor(jet + 0.5)))
	return true
end

---------------------------------------------------------------- shop
function Profile.deliverySeconds(lines)
	local n, back = 0, false
	for _, l in ipairs(lines) do
		n = n + l.qty
		if l.back then back = true end
	end
	local s
	if n <= 2 then s = 60 elseif n <= 6 then s = 180 + (n - 3) * 30 else s = 600 end
	if back then s = s + 120 end
	return s
end
-- cart = { {sku=, qty=} }; stock(sku) -> number in stock (server-wide); returns ok, order
function Profile.order(p, cart, now, stock)
	if type(cart) ~= "table" or #cart == 0 then return err("Kundvagnen är tom") end
	if #cart > Profile.MAX_ORDER_LINES then return err("För många rader") end
	local lines, total, seen = {}, 0, {}
	for _, l in ipairs(cart) do
		local part = type(l) == "table" and Parts.get(l.sku)
		local qty = type(l) == "table" and tonumber(l.qty)
		if not part or not qty then return err("Ogiltig vara") end
		qty = math.floor(qty)
		if qty < 1 or qty > 10 then return err("Antal måste vara 1–10") end
		if seen[part.sku] then return err("Dubbel rad") end
		seen[part.sku] = true
		if part.kind == "verktyg" and part.price == 0 then return err(part.name .. " följer redan med garaget") end
		local inStock = stock and stock(part.sku) or part.stock
		lines[#lines + 1] = { sku = part.sku, qty = qty, price = part.price, back = inStock < qty }
		total = total + part.price * qty
	end
	local freight = total >= 2000 and 0 or 99
	total = total + freight
	if p.money < total then return err("Du har inte råd (" .. total .. " kr)") end
	p.money = p.money - total
	local o = { id = p.nextOrder, lines = lines, total = total, freight = freight, placed = now, ready = now + Profile.deliverySeconds(lines), state = "vag" }
	p.nextOrder = p.nextOrder + 1
	table.insert(p.orders, o)
	while #p.orders > 30 do table.remove(p.orders, 1) end
	return true, o
end
-- orders that have arrived get their parts in a box; returns ids of arrived orders
function Profile.tick(p, now)
	local arrived = {}
	for _, o in ipairs(p.orders) do
		if o.state == "vag" and o.ready <= now then
			o.state = "framme"
			for _, l in ipairs(o.lines) do
				for _ = 1, l.qty do Profile.addItem(p, l.sku, "box:" .. o.id) end
			end
			arrived[#arrived + 1] = o.id
		end
	end
	return arrived
end
function Profile.openBox(p, oid)
	for _, o in ipairs(p.orders) do
		if o.id == oid then
			if o.state ~= "framme" then return err("Paketet är redan öppnat") end
			o.state = "oppnad"
			return true
		end
	end
	return err("Inget sådant paket")
end
function Profile.boxItems(p, oid)
	local r = {}
	for id, it in pairs(p.items) do if it.loc == "box:" .. oid then r[#r + 1] = id end end
	table.sort(r)
	return r
end
-- an opened box with nothing left is thrown away
function Profile.cleanBoxes(p)
	for _, o in ipairs(p.orders) do
		if o.state == "oppnad" and #Profile.boxItems(p, o.id) == 0 then o.state = "tom" end
	end
end
function Profile.sellItem(p, id)
	local it = p.items[id]
	if not it or not free(p, it) then return err("Delen kan inte säljas") end
	if it.cust then return err("Delen tillhör en kund") end
	local part = Parts.get(it.sku)
	if part.kind == "verktyg" and part.price == 0 then return err("Den behåller du") end
	local v = math.floor(part.price * Config.SELL_FACTOR * (1 - 0.6 * (it.wear or 0)))
	p.items[id] = nil
	p.money = p.money + v
	Profile.cleanBoxes(p)
	return true, v
end
function Profile.bestTool(p, toolKind)
	local best
	for _, it in pairs(p.items) do
		local part = Parts.get(it.sku)
		if part and part.kind == "verktyg" and part.stats.tool == toolKind then
			if not best or part.price > best.price then best = part end
		end
	end
	return best
end

---------------------------------------------------------------- porting and paint
function Profile.portStart(p, now)
	local id
	for oid, it in pairs(p.items) do if it.loc == "port" then id = oid end end
	if not id then return err("Lägg en cylinder i skruvstädet först") end
	if not Profile.bestTool(p, "slip") then return err("Du behöver en rak slipmaskin") end
	p.portStart = now
	return true, id
end
function Profile.portDone(p, state, now)
	if not p.portStart then return err("Ingen portning pågår") end
	local elapsed = now - p.portStart
	p.portStart = nil
	if elapsed < Config.PORT_MIN_TIME then return err("För snabbt") end
	local id
	for oid, it in pairs(p.items) do if it.loc == "port" then id = oid end end
	if not id then return err("Cylindern är borta") end
	local res = Porting.result(state)
	if not res then return err("Ogiltigt resultat") end
	p.items[id].port = { q = res.q, label = res.label }
	p.stats.ported = p.stats.ported + 1
	return true, res
end
function Profile.paintStart(p, now)
	local id
	for oid, it in pairs(p.items) do if it.loc == "lack" then id = oid end end
	if not id then return err("Häng en kåpa i lackboxen först") end
	if not Profile.bestTool(p, "spruta") then return err("Du behöver en sprutpistol") end
	p.paintStart = now
	return true, id
end
function Profile.paintDone(p, color, finish, gloss, state, now)
	if not p.paintStart then return err("Ingen lackering pågår") end
	local elapsed = now - p.paintStart
	p.paintStart = nil
	if elapsed < Config.PAINT_MIN_TIME then return err("För snabbt") end
	local c = Paint.validColor(color)
	if not c or not Paint.FIN[finish] then return err("Ogiltig färg") end
	local id
	for oid, it in pairs(p.items) do if it.loc == "lack" then id = oid end end
	if not id then return err("Kåpan är borta") end
	local res = Paint.result(state)
	if not res then return err("Ogiltigt resultat") end
	gloss = math.max(0, math.min(1, tonumber(gloss) or 0.6))
	p.items[id].paint = { c = c, f = finish, g = gloss, q = res.q }
	p.items[id].dry = now + Config.PAINT_DRY
	p.stats.painted = p.stats.painted + 1
	return true, res
end
-- designs: the colours of every panel of the current moped
function Profile.saveDesign(p, name)
	local m = p.mopeds[p.cur]
	if type(name) ~= "string" then return err("Ange ett namn") end
	name = name:sub(1, 24):gsub("[%c<>]", "")
	if name == "" then return err("Ange ett namn") end
	local d = { n = name, model = m.model, panels = {} }
	for slot, id in pairs(m.slots) do
		local pid = slot:match("^pan:(.+)$")
		local it = p.items[id]
		if pid and it and it.paint then d.panels[pid] = { c = it.paint.c, f = it.paint.f, g = it.paint.g } end
	end
	if next(d.panels) == nil then return err("Inga lackerade kåpor att spara") end
	for i, old in ipairs(p.designs) do if old.n == name then p.designs[i] = d; return true end end
	if #p.designs >= 12 then return err("Max 12 designer") end
	p.designs[#p.designs + 1] = d
	return true
end
Profile.DESIGN_COST = 120
function Profile.applyDesign(p, idx, now)
	local d = p.designs[idx]
	local m = p.mopeds[p.cur]
	if not d or not m then return err("Ingen sådan design") end
	if d.model ~= m.model then return err("Designen är gjord för " .. MopedDef.MODELS[d.model].n) end
	local targets = {}
	for pid, paint in pairs(d.panels) do
		local id = m.slots["pan:" .. pid]
		if id then targets[#targets + 1] = { id = id, paint = paint } end
	end
	local cost = #targets * Profile.DESIGN_COST
	if #targets == 0 then return err("Inga kåpor monterade") end
	if p.money < cost then return err("Lackeringen kostar " .. cost .. " kr") end
	p.money = p.money - cost
	for _, t in ipairs(targets) do p.items[t.id].paint = { c = t.paint.c, f = t.paint.f, g = t.paint.g, q = 1 } end
	return true, cost
end

---------------------------------------------------------------- riding
Profile.KM_PAY = 12
function Profile.addDistance(p, meters)
	meters = math.max(0, math.min(400, tonumber(meters) or 0)) -- server caps per report
	p.stats.km = p.stats.km + meters / 1000
	local m = p.mopeds[p.cur]
	if m then m.odo = (m.odo or 0) + meters / 1000 end
	p.distAcc = (p.distAcc or 0) + meters
	local pay = math.floor(p.distAcc / 1000 * Profile.KM_PAY)
	if pay > 0 then
		p.distAcc = p.distAcc - pay * 1000 / Profile.KM_PAY
		p.money = p.money + pay
		p.stats.earned = p.stats.earned + pay
	end
	return pay
end
-- overheating wears piston and rings; at 1 the engine seizes
function Profile.addWear(p, amount)
	local m = p.mopeds[p.cur]
	if not m or not m.engine then return end
	amount = math.max(0, math.min(0.25, tonumber(amount) or 0))
	for _, s in ipairs({ "kolv", "kolvringar" }) do
		local it = p.items[m.engine[s]]
		if it then it.wear = math.min(1, (it.wear or 0) + amount) end
	end
end

---------------------------------------------------------------- jobs (uppdrag)
Profile.DESTINATIONS = {
	norr = "Verkstad Norr", hamn = "Hamnens lager", macken = "Macken", gard = "Lindgårdens gård", ind = "Industriverkstaden",
}
local DEST_ORDER = { "norr", "hamn", "macken", "gard", "ind" }
-- the board always offers three jobs; which ones depends on how many jobs you have done
function Profile.offers(p)
	local n = p.stats.jobs
	local r = {}
	local d1 = DEST_ORDER[(n % #DEST_ORDER) + 1]
	local d2 = DEST_ORDER[((n + 2) % #DEST_ORDER) + 1]
	r[1] = { key = "lev:" .. d1, type = "leverans", dest = d1, n = "Leverera reservdelar till " .. Profile.DESTINATIONS[d1], pay = 300 + (n % 3) * 75, about = "Hämta paketet vid garageporten och kör det till markeringen." }
	r[2] = { key = "rep:" .. n, type = "reparation", n = "Kolvskär: byt kolv och ringar på kundmotor", pay = 950, about = "Kundens motor ställs på ditt motorstativ. Byt kolv och kolvringar mot nya (40 mm) och lämna tillbaka motorn." }
	r[3] = { key = "bygg:" .. d2, type = "bygg", n = "Bygg en trimmad motor åt en kund", pay = 600, lvl = 1, about = "Bygg en komplett motor på stativet med minst sportcylinder (70 cc). Du får betalt för delarna plus arbetet." }
	return r
end
function Profile.acceptJob(p, key)
	if #p.jobs >= 2 then return err("Du har redan två uppdrag") end
	local offer
	for _, o in ipairs(Profile.offers(p)) do if o.key == key then offer = o end end
	if not offer then return err("Uppdraget finns inte längre") end
	for _, j in ipairs(p.jobs) do
		if j.type == offer.type then return err("Du har redan ett sådant uppdrag") end
	end
	local job = { key = offer.key, type = offer.type, n = offer.n, pay = offer.pay, dest = offer.dest, lvl = offer.lvl, id = p.nextJob }
	p.nextJob = p.nextJob + 1
	if offer.type == "reparation" then
		if not EngineDef.isEmpty(p.stand) then return err("Töm motorstativet först") end
		p.stand = Profile.newEngine(p, { cust = job.id })
		for _, s in ipairs({ "kolv", "kolvringar" }) do p.items[p.stand[s]].wear = 1 end
	end
	p.jobs[#p.jobs + 1] = job
	return true, job
end
local function jobIndex(p, id) for i, j in ipairs(p.jobs) do if j.id == id then return i, j end end end
-- deliver: the server checks the player is at the destination before calling this
function Profile.completeJob(p, id)
	local i, j = jobIndex(p, id)
	if not j then return err("Inget sådant uppdrag") end
	local pay = j.pay
	if j.type == "reparation" then
		for _, s in ipairs({ "kolv", "kolvringar" }) do
			local it = p.items[p.stand[s] or ""]
			if not it or (it.wear or 0) > 0.05 then return err("Byt " .. EngineDef.BY_ID[s].name:lower() .. " först") end
		end
		if not EngineDef.complete(p.stand) then return err("Motorn måste vara komplett") end
		for _, id2 in pairs(p.stand) do p.items[id2] = nil end
		p.stand = {}
		for id2, it in pairs(p.items) do if it.cust == j.id then p.items[id2] = nil end end -- the old worn parts go to scrap
	elseif j.type == "bygg" then
		if not EngineDef.complete(p.stand) then return err("Bygg en komplett motor på stativet") end
		local cyl = Parts.get(p.items[p.stand.cylinder].sku)
		if (cyl.stats.lvl or 0) < (j.lvl or 1) then return err("Kunden vill ha minst en 70 cc sportcylinder") end
		local value = 0
		for _, id2 in pairs(p.stand) do
			local it = p.items[id2]
			if it.cust then return err("Motorn innehåller en annan kunds delar") end
			value = value + Parts.get(it.sku).price
			p.items[id2] = nil
		end
		p.stand = {}
		pay = pay + math.floor(value * 1.1)
	end
	table.remove(p.jobs, i)
	p.money = p.money + pay
	p.stats.jobs = p.stats.jobs + 1
	p.stats.earned = p.stats.earned + pay
	return true, pay
end
function Profile.cancelJob(p, id)
	local i, j = jobIndex(p, id)
	if not j then return err("Inget sådant uppdrag") end
	if j.type == "reparation" then
		-- the customer takes back their engine as it is; their parts leave the garage
		for s, id2 in pairs(p.stand) do if p.items[id2] and p.items[id2].cust == j.id then p.stand[s] = nil end end
		for id2, it in pairs(p.items) do if it.cust == j.id then p.items[id2] = nil end end
		-- player's own parts left on the stand go back to the bench
		for s, id2 in pairs(p.stand) do p.stand[s] = nil; p.items[id2].loc = "bank" end
	end
	table.remove(p.jobs, i)
	return true
end

---------------------------------------------------------------- create, load, save
function Profile.new()
	local p = {
		v = Profile.VERSION, money = Config.START_MONEY, items = {}, nextId = 1, stand = {}, mopeds = {}, cur = 1,
		orders = {}, nextOrder = 1, designs = {}, jobs = {}, nextJob = 1,
		stats = { km = 0, built = 0, ported = 0, painted = 0, jobs = 0, earned = 0 },
	}
	Profile.giveMoped(p, "citi", { 200, 30, 40 })
	Profile.addItem(p, "verktyg_hylsor", "verktyg")
	Profile.addItem(p, "verktyg_slip", "verktyg")
	Profile.addItem(p, "verktyg_spruta", "verktyg")
	-- a few spare parts on the shelf to start building with
	Profile.addItem(p, "fotpackning_origo", "hylla")
	Profile.addItem(p, "tandstift_b7", "hylla")
	Profile.addItem(p, "cylinder_origo50", "hylla")
	return p
end

local function validMap(p, map, used)
	if type(map) ~= "table" then return {} end
	local r = {}
	for k, id in pairs(map) do
		if type(k) == "string" and type(id) == "string" and p.items[id] and not used[id] then r[k] = id; used[id] = true end
	end
	return r
end
-- validate saved data; anything broken is repaired or dropped. Bad or old data gives a new profile.
function Profile.load(d)
	if type(d) ~= "table" or d.v ~= Profile.VERSION or type(d.items) ~= "table" then return Profile.new(), "ny" end
	local p = Profile.new()
	p.items = {}
	p.mopeds = {}
	p.money = math.max(0, math.floor(tonumber(d.money) or 0))
	p.nextId = math.max(1, math.floor(tonumber(d.nextId) or 1))
	for id, it in pairs(d.items) do
		if type(id) == "string" and type(it) == "table" and Parts.get(it.sku) then
			local num = tonumber(id:match("^i(%d+)$"))
			if num then
				p.items[id] = it
				if num >= p.nextId then p.nextId = num + 1 end
			end
		end
	end
	local used = {}
	p.stand = validMap(p, d.stand, used)
	if type(d.mopeds) == "table" then
		for _, m in ipairs(d.mopeds) do
			if type(m) == "table" and MopedDef.MODELS[m.model] then
				local nm = { model = m.model, slots = validMap(p, m.slots, used), engine = m.engine and validMap(p, m.engine, used) or nil, jet = tonumber(m.jet) or 0, odo = tonumber(m.odo) or 0 }
				p.mopeds[#p.mopeds + 1] = nm
			end
		end
	end
	if #p.mopeds == 0 then Profile.giveMoped(p, "citi", { 200, 30, 40 }) end
	p.cur = math.max(1, math.min(#p.mopeds, math.floor(tonumber(d.cur) or 1)))
	p.orders = {}
	if type(d.orders) == "table" then
		for _, o in ipairs(d.orders) do
			if type(o) == "table" and type(o.id) == "number" and type(o.lines) == "table" and type(o.state) == "string" then p.orders[#p.orders + 1] = o end
		end
	end
	p.nextOrder = math.max(1, math.floor(tonumber(d.nextOrder) or 1))
	for _, o in ipairs(p.orders) do if o.id >= p.nextOrder then p.nextOrder = o.id + 1 end end
	p.designs = type(d.designs) == "table" and d.designs or {}
	p.jobs = type(d.jobs) == "table" and d.jobs or {}
	p.nextJob = math.max(1, math.floor(tonumber(d.nextJob) or 1))
	if type(d.stats) == "table" then for k in pairs(p.stats) do p.stats[k] = tonumber(d.stats[k]) or 0 end end
	-- locations: mounted parts must be referenced; things in hand go to the bench
	for id, it in pairs(p.items) do
		if it.loc == "mount" and not used[id] then it.loc = "golv" end
		if used[id] then it.loc = "mount" end
		if it.loc == "hand" then it.loc = "bank" end
		if type(it.loc) ~= "string" then it.loc = "golv" end
	end
	-- delivery jobs carry nothing physical; a lost leverans job is just kept
	Profile.cleanBoxes(p)
	return p, "laddad"
end
-- the data that is saved (plain tables only)
function Profile.save(p)
	local d = {}
	for k, v in pairs(p) do
		if k ~= "portStart" and k ~= "paintStart" and k ~= "distAcc" then d[k] = v end
	end
	return d
end

return Profile
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX18"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX16"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- The server: one garage per player, saved profiles, every change to a profile (validated here only),
-- the physical things other players see (moped, engine, parts, boxes), deliveries, riding and jobs.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local PhysicsService = game:GetService("PhysicsService")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Parts = require(Shared.Parts)
local EngineDef = require(Shared.EngineDef)
local MopedDef = require(Shared.MopedDef)
local Profile = require(Shared.Profile)
local Models = require(Shared.Models)
local GarageBuilder = require(Shared.GarageBuilder)
local Map = require(Shared.Map)

local V3, CF = Vector3.new, CFrame.new
local function now() return workspace:GetServerTimeNow() end

---------------------------------------------------------------- remotes and collision groups
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local Api = Instance.new("RemoteFunction")
Api.Name = "Api"
Api.Parent = remotes
local StateEv = Instance.new("RemoteEvent")
StateEv.Name = "State"
StateEv.Parent = remotes
local Notify = Instance.new("RemoteEvent")
Notify.Name = "Notify"
Notify.Parent = remotes
local RideEv = Instance.new("RemoteEvent")
RideEv.Name = "Ride"
RideEv.Parent = remotes
remotes.Parent = RS

PhysicsService:RegisterCollisionGroup("Moped")
PhysicsService:CollisionGroupSetCollidable("Moped", "Default", false)

---------------------------------------------------------------- data store
local store
local okStore = pcall(function() store = DataStoreService:GetDataStore(Config.SAVE_KEY) end)
if not okStore then store = nil end
local saving = {} -- plr -> bool (whether saving works for this player)

---------------------------------------------------------------- stock (shared by all players, restocks slowly)
local stock = {}
for _, it in ipairs(Parts.LIST) do stock[it.sku] = it.stock end
task.spawn(function()
	while true do
		task.wait(120)
		for _, it in ipairs(Parts.LIST) do if stock[it.sku] < it.stock then stock[it.sku] = stock[it.sku] + 1 end end
	end
end)

---------------------------------------------------------------- plots
local plotsFolder = Instance.new("Folder")
plotsFolder.Name = "Garage"
plotsFolder.Parent = workspace
local plots = {}
for i = 1, Config.MAX_PLAYERS do
	local origin = CF(Config.plotOrigin(i), 0, 0)
	local folder = Instance.new("Folder")
	folder.Name = "Plot" .. i
	folder:SetAttribute("Plot", i)
	folder:SetAttribute("OwnerId", 0)
	folder.Parent = plotsFolder
	local refs = GarageBuilder.build(folder, origin, i)
	local dyn = Instance.new("Folder")
	dyn.Name = "Dynamic"
	dyn.Parent = folder
	plots[i] = { i = i, origin = origin, folder = folder, refs = refs, dyn = dyn, owner = nil }
	-- station prompts (the client opens the work modes; the server only checks actions)
	local function prompt(part, action, text, key, obj)
		local pp = Instance.new("ProximityPrompt")
		pp.Name = "Prompt_" .. action
		pp.ActionText = text
		pp.ObjectText = obj or ""
		pp.KeyboardKeyCode = key or Enum.KeyCode.E
		pp.MaxActivationDistance = 9
		pp.RequiresLineOfSight = false
		pp:SetAttribute("Action", action)
		pp:SetAttribute("Plot", i)
		pp.Parent = part
		return pp
	end
	local function find(name) return refs.model:FindFirstChild(name, true) end
	prompt(find("Lyftbord"), "work", "Arbeta på mopeden", Enum.KeyCode.E, "Mopedlyft")
	prompt(find("Lyftbord"), "ride", "Kör ut", Enum.KeyCode.F, "Mopedlyft")
	prompt(find("Motorstativ"), "engine", "Bygg motor", Enum.KeyCode.E, "Motorstativ")
	prompt(refs.screen, "shop", "Använd datorn", Enum.KeyCode.E, "Dator")
	prompt(find("Skruvstäd"), "port", "Porta cylinder", Enum.KeyCode.E, "Portningsbänk")
	prompt(find("Lackstativ"), "paint", "Lackera", Enum.KeyCode.E, "Lackbox")
end

---------------------------------------------------------------- per-player state
local profiles = {} -- plr -> profile
local plotOf = {} -- plr -> plot
local riding = {} -- plr -> { moped = model, last = pos }

local function pushState(plr)
	local p = profiles[plr]
	if not p then return end
	StateEv:FireClient(plr, p, { now = now(), plot = plotOf[plr] and plotOf[plr].i, saving = saving[plr] == true, stock = stock })
end
local function notify(plr, text, kind) Notify:FireClient(plr, text, kind or "info") end

local function clear(folder, name)
	local o = folder:FindFirstChild(name)
	if o then o:Destroy() end
end
local function newFolder(parent, name)
	clear(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- items lying around: shelf, bench, floor, hand, porting vise, paint stand
local function itemSlots(p, loc)
	local ids = {}
	for id, it in pairs(p.items) do if it.loc == loc then ids[#ids + 1] = id end end
	table.sort(ids, function(a, b) return tonumber(a:sub(2)) < tonumber(b:sub(2)) end)
	return ids
end
local function placeItem(parent, id, it, cf, plr)
	local model = Models.item(it.sku, it)
	model.Name = "Del_" .. id
	model:SetAttribute("Item", id)
	model:SetAttribute("OwnerId", plr.UserId)
	model:PivotTo(cf * CF(0, model.PrimaryPart.Size.Y / 2, 0))
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then d.CanQuery = true end
	end
	model.Parent = parent
	return model
end
local function renderItems(plr)
	local p, plot = profiles[plr], plotOf[plr]
	if not (p and plot) then return end
	local f = newFolder(plot.dyn, "Delar")
	local refs = plot.refs
	for i, id in ipairs(itemSlots(p, "hylla")) do if refs.shelfSlots[i] then placeItem(f, id, p.items[id], refs.shelfSlots[i], plr) end end
	for i, id in ipairs(itemSlots(p, "bank")) do if refs.benchSlots[i] then placeItem(f, id, p.items[id], refs.benchSlots[i], plr) end end
	for i, id in ipairs(itemSlots(p, "golv")) do
		local slot = refs.floorSlots[(i - 1) % #refs.floorSlots + 1]
		placeItem(f, id, p.items[id], slot * CF(0, math.floor((i - 1) / #refs.floorSlots) * 0.8, 0), plr)
	end
	for _, id in ipairs(itemSlots(p, "verktyg")) do
		local part = Parts.get(p.items[id].sku)
		local idx = ({ hylsor = 1, slip = 2, spruta = 3 })[part.stats.tool] or 4
		local m = placeItem(f, id, p.items[id], refs.toolSlots[idx] * CF(0, -0.6, 0), plr)
		m:SetAttribute("Tool", true)
	end
	for _, id in ipairs(itemSlots(p, "port")) do placeItem(f, id, p.items[id], plot.origin * GarageBuilder.PORT * CF(0, -0.4, 0), plr) end
	for _, id in ipairs(itemSlots(p, "lack")) do placeItem(f, id, p.items[id], plot.origin * GarageBuilder.BOOTH, plr) end
	-- the part in the player's hand
	local hand = itemSlots(p, "hand")[1]
	local char = plr.Character
	local grip = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
	if hand and grip then
		local m = placeItem(f, hand, p.items[hand], grip.CFrame * CF(0, -0.4, -0.6), plr)
		local main = m.PrimaryPart
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.Massless = true
				if d ~= main then
					local w = Instance.new("WeldConstraint")
					w.Part0 = main
					w.Part1 = d
					w.Parent = d
				end
			end
		end
		local w = Instance.new("WeldConstraint")
		w.Part0 = grip
		w.Part1 = main
		w.Parent = main
		for _, d in ipairs(m:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = false end end
		m:SetAttribute("InHand", true)
		m.Parent = char
		m.Name = "Bärs"
	end
end
local function renderEngine(plr)
	local p, plot = profiles[plr], plotOf[plr]
	if not (p and plot) then return end
	clear(plot.dyn, "Motor")
	local eng = Models.engine(plot.dyn, plot.origin * GarageBuilder.STAND, p.stand, p.items)
	eng:SetAttribute("OwnerId", plr.UserId)
end
local function renderBoxes(plr)
	local p, plot = profiles[plr], plotOf[plr]
	if not (p and plot) then return end
	local f = newFolder(plot.dyn, "Paket")
	local k = 0
	for _, o in ipairs(p.orders) do
		if o.state == "framme" or o.state == "oppnad" then
			k = k + 1
			local slot = plot.refs.deliverySlots[(k - 1) % #plot.refs.deliverySlots + 1]
			local cf = slot * CF(0, 0.7, 0) * CFrame.Angles(0, math.rad(8 * k), 0)
			local box = Models.box(f, cf, V3(2.2, 1.4, 1.6), o.state == "oppnad")
			box.Name = "Paket_" .. o.id
			box:SetAttribute("Order", o.id)
			if o.state == "framme" then
				local pp = Instance.new("ProximityPrompt")
				pp.ActionText = "Öppna paketet"
				pp.ObjectText = "Order #" .. o.id
				pp.MaxActivationDistance = 8
				pp.RequiresLineOfSight = false
				pp:SetAttribute("Action", "openBox")
				pp:SetAttribute("Order", o.id)
				pp:SetAttribute("Plot", plot.i)
				pp.Parent = box.PrimaryPart
			else
				-- the parts lie on top of the open box, ready to be picked up
				for j, id in ipairs(Profile.boxItems(p, o.id)) do
					placeItem(f, id, p.items[id], cf * CF(-0.6 + ((j - 1) % 3) * 0.6, 0.75 + math.floor((j - 1) / 3) * 0.5, 0), plr)
				end
			end
		end
	end
end
local function mopedCF(plot) return plot.origin * GarageBuilder.LIFT end
local function renderMoped(plr, force)
	local p, plot = profiles[plr], plotOf[plr]
	if not (p and plot) then return end
	if riding[plr] and not force then return end
	clear(plot.dyn, "Moped")
	local m = p.mopeds[p.cur]
	if not m then return end
	local model = Models.moped(plot.dyn, m, p.items, mopedCF(plot))
	model:SetAttribute("OwnerId", plr.UserId)
	model:SetAttribute("Plot", plot.i)
	return model
end
local function renderAll(plr)
	renderMoped(plr)
	renderEngine(plr)
	renderItems(plr)
	renderBoxes(plr)
end

---------------------------------------------------------------- riding
local function weldMoped(model)
	local root = model.PrimaryPart
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CollisionGroup = "Moped"
			if d ~= root then
				d.Massless = true
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = d
				w.Parent = d
			end
		end
	end
	for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = false end end
end
local function anchorMoped(model)
	for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = true end end
end
local function seatPlayer(plr, model)
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	local seat = model:FindFirstChild("Seat")
	seat.Disabled = false
	seat:Sit(hum)
	return true
end
local function startRide(plr, model)
	weldMoped(model)
	local root = model.PrimaryPart
	if root:CanSetNetworkOwnership() then root:SetNetworkOwner(plr) end
	model:SetAttribute("Riding", true)
	riding[plr] = { moped = model, last = root.Position, t = now() }
	if not seatPlayer(plr, model) then return false end
	local seat = model:FindFirstChild("Seat")
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if seat.Occupant == nil and riding[plr] and riding[plr].moped == model then
			-- the rider stepped off: park upright where it is
			local _, y = root.CFrame:ToOrientation()
			anchorMoped(model)
			model:PivotTo(CF(root.Position) * CFrame.Angles(0, y, 0))
			seat.Disabled = true
			model:SetAttribute("Riding", false)
			local pp = root:FindFirstChild("Prompt_mount")
			if not pp then
				pp = Instance.new("ProximityPrompt")
				pp.Name = "Prompt_mount"
				pp.ActionText = "Kör"
				pp.ObjectText = "Din moped"
				pp.MaxActivationDistance = 8
				pp.RequiresLineOfSight = false
				pp:SetAttribute("Action", "mount")
				pp.Parent = root
			end
			pp.Enabled = true
		end
	end)
	return true
end
local function goHome(plr)
	local r = riding[plr]
	riding[plr] = nil
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.SeatPart then hum.Sit = false end
	if r and r.moped then r.moped:Destroy() end
	renderMoped(plr, true)
	local plot = plotOf[plr]
	if char and plot then
		task.defer(function()
			if char.Parent then char:PivotTo(plot.origin * CF(-2, GarageBuilder.FLOOR + 3, -6)) end
		end)
	end
end

---------------------------------------------------------------- distance checks
local function charPos(plr)
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	return root and root.Position
end
local function near(plr, pos, dist)
	local cp = charPos(plr)
	return cp ~= nil and (cp - pos).Magnitude <= (dist or Config.REACH)
end
local function inGarage(plr)
	local cp, plot = charPos(plr), plotOf[plr]
	if not (cp and plot) then return false end
	local l = plot.origin:PointToObjectSpace(cp)
	return math.abs(l.X) < GarageBuilder.W / 2 + 4 and l.Z > -GarageBuilder.D / 2 - 14 and l.Z < GarageBuilder.D / 2 + 2
end

---------------------------------------------------------------- API
local H = {}
local function changed(plr, what)
	for _, w in ipairs(what) do
		if w == "items" then renderItems(plr)
		elseif w == "engine" then renderEngine(plr)
		elseif w == "moped" then renderMoped(plr)
		elseif w == "boxes" then renderBoxes(plr) end
	end
	pushState(plr)
end
function H.state(plr) pushState(plr); return true end
function H.pickup(plr, p, id)
	local it = p.items[id]
	if not it then return false, "Delen finns inte" end
	if not inGarage(plr) then return false, "Gå in i ditt garage" end
	local ok, e = Profile.moveItem(p, id, "hand")
	if not ok then return ok, e end
	changed(plr, { "items", "boxes" })
	return true
end
function H.place(plr, p, loc)
	local id = Profile.inHand(p)
	if not id then return false, "Du bär ingenting" end
	if not inGarage(plr) then return false, "Gå in i ditt garage" end
	local ok, e = Profile.moveItem(p, id, loc)
	if not ok then return ok, e end
	changed(plr, { "items" })
	return true
end
function H.moveTo(plr, p, id, loc)
	-- move a free part straight to a place (used from the work modes and the tray menu)
	if not inGarage(plr) then return false, "Gå in i ditt garage" end
	if loc ~= "hylla" and loc ~= "bank" and loc ~= "golv" and loc ~= "lack" and loc ~= "port" then return false, "Kan inte lägga delen där" end
	local ok, e = Profile.moveItem(p, id, loc)
	if not ok then return ok, e end
	changed(plr, { "items", "boxes" })
	return true
end
function H.mountEngine(plr, p, target, sock, id)
	if not inGarage(plr) then return false, "Gå in i ditt garage" end
	if riding[plr] and target ~= "stand" then return false, "Mopeden är ute" end
	local ok, e = Profile.mountEngine(p, target, sock, id)
	if not ok then return ok, e end
	if target == "stand" and EngineDef.complete(p.stand) then p.stats.built = p.stats.built + 1 end
	changed(plr, { target == "stand" and "engine" or "moped", "items", "boxes" })
	return true
end
function H.unmountEngine(plr, p, target, sock)
	if not inGarage(plr) then return false, "Gå in i ditt garage" end
	if riding[plr] and target ~= "stand" then return false, "Mopeden är ute" end
	local ok, e = Profile.unmountEngine(p, target, sock)
	if not ok then return ok, e end
	changed(plr, { target == "stand" and "engine" or "moped", "items" })
	return true, e
end
function H.mountChassis(plr, p, slot, id)
	if not inGarage(plr) or riding[plr] then return false, "Mopeden måste stå på lyften" end
	local ok, e = Profile.mountChassis(p, slot, id, now())
	if not ok then return ok, e end
	changed(plr, { "moped", "items", "boxes" })
	return true
end
function H.unmountChassis(plr, p, slot)
	if not inGarage(plr) or riding[plr] then return false, "Mopeden måste stå på lyften" end
	local ok, e = Profile.unmountChassis(p, slot)
	if not ok then return ok, e end
	changed(plr, { "moped", "items", "engine" })
	return true, e
end
function H.engineToMoped(plr, p)
	if not inGarage(plr) or riding[plr] then return false, "Mopeden måste stå på lyften" end
	local ok, e = Profile.engineToMoped(p)
	if not ok then return ok, e end
	changed(plr, { "moped", "engine" })
	return true
end
function H.engineToStand(plr, p)
	if not inGarage(plr) or riding[plr] then return false, "Mopeden måste stå på lyften" end
	local ok, e = Profile.engineToStand(p)
	if not ok then return ok, e end
	changed(plr, { "moped", "engine" })
	return true
end
function H.order(plr, p, cart)
	local ok, o = Profile.order(p, cart, now(), function(sku) return stock[sku] or 0 end)
	if not ok then return ok, o end
	for _, l in ipairs(o.lines) do stock[l.sku] = math.max(0, (stock[l.sku] or 0) - l.qty) end
	changed(plr, {})
	return true, { id = o.id, ready = o.ready }
end
function H.openBox(plr, p, oid)
	local plot = plotOf[plr]
	local box = plot and plot.dyn:FindFirstChild("Paket") and plot.dyn.Paket:FindFirstChild("Paket_" .. tostring(oid))
	if not box or not near(plr, box:GetPivot().Position, 12) then return false, "Gå fram till paketet" end
	local ok, e = Profile.openBox(p, tonumber(oid))
	if not ok then return ok, e end
	changed(plr, { "boxes" })
	return true
end
function H.sell(plr, p, id)
	local ok, v = Profile.sellItem(p, id)
	if not ok then return ok, v end
	changed(plr, { "items", "boxes" })
	return true, v
end
function H.buyMoped(plr, p, model)
	local ok, e = Profile.buyMoped(p, model)
	if not ok then return ok, e end
	changed(plr, {})
	return true, e
end
function H.sellMoped(plr, p, idx)
	if riding[plr] then return false, "Kör hem först" end
	local ok, v = Profile.sellMoped(p, tonumber(idx))
	if not ok then return ok, v end
	changed(plr, { "moped" })
	return true, v
end
function H.selectMoped(plr, p, idx)
	if riding[plr] then return false, "Kör hem först" end
	local ok, e = Profile.selectMoped(p, tonumber(idx))
	if not ok then return ok, e end
	changed(plr, { "moped" })
	return true
end
function H.setJet(plr, p, jet)
	local ok, e = Profile.setJet(p, jet)
	if not ok then return ok, e end
	changed(plr, {})
	return true
end
function H.portStart(plr, p)
	if not near(plr, plotOf[plr].origin * GarageBuilder.PORT.Position, 12) then return false, "Gå fram till portningsbänken" end
	local ok, e = Profile.portStart(p, now())
	if not ok then return ok, e end
	local tool = Profile.bestTool(p, "slip")
	return true, { item = e, steady = tool.stats.steady, speed = tool.stats.speed }
end
function H.portDone(plr, p, state)
	local ok, r = Profile.portDone(p, state, now())
	if not ok then return ok, r end
	changed(plr, { "items" })
	return true, r
end
function H.paintStart(plr, p)
	if not near(plr, plotOf[plr].origin * GarageBuilder.BOOTH.Position, 14) then return false, "Gå in i lackboxen" end
	local ok, e = Profile.paintStart(p, now())
	if not ok then return ok, e end
	local tool = Profile.bestTool(p, "spruta")
	return true, { item = e, even = tool.stats.even }
end
function H.paintDone(plr, p, color, finish, gloss, state)
	local ok, r = Profile.paintDone(p, color, finish, gloss, state, now())
	if not ok then return ok, r end
	changed(plr, { "items" })
	return true, r
end
function H.saveDesign(plr, p, name)
	local ok, e = Profile.saveDesign(p, name)
	if not ok then return ok, e end
	changed(plr, {})
	return true
end
function H.applyDesign(plr, p, idx)
	if riding[plr] then return false, "Kör hem först" end
	local ok, e = Profile.applyDesign(p, tonumber(idx), now())
	if not ok then return ok, e end
	changed(plr, { "moped" })
	return true, e
end
function H.ride(plr, p)
	if riding[plr] then return false, "Du kör redan" end
	local probs = Profile.mopedProblems(p)
	if #probs > 0 then return false, "Mopeden saknar: " .. table.concat(probs, ", ") end
	if not inGarage(plr) then return false, "Gå in i ditt garage" end
	if Profile.inHand(p) then
		Profile.moveItem(p, Profile.inHand(p), Profile.freeStorage(p))
		renderItems(plr)
	end
	local plot = plotOf[plr]
	clear(plot.dyn, "Moped")
	local model = Models.moped(plot.dyn, p.mopeds[p.cur], p.items, plot.origin * GarageBuilder.EXIT * CF(0, 0.15, 0))
	model:SetAttribute("OwnerId", plr.UserId)
	model:SetAttribute("Plot", plot.i)
	if not startRide(plr, model) then goHome(plr); return false, "Kunde inte sätta dig på mopeden" end
	pushState(plr)
	return true
end
function H.mount(plr, p)
	local r = riding[plr]
	if not r or not r.moped then return false, "Mopeden står i garaget" end
	if not near(plr, r.moped.PrimaryPart.Position, 10) then return false, "Gå fram till mopeden" end
	local model = r.moped
	clear(model.PrimaryPart, "Prompt_mount")
	weldMoped(model)
	local root = model.PrimaryPart
	if root:CanSetNetworkOwnership() then root:SetNetworkOwner(plr) end
	model:SetAttribute("Riding", true)
	seatPlayer(plr, model)
	return true
end
function H.home(plr, p)
	goHome(plr)
	pushState(plr)
	return true
end
function H.acceptJob(plr, p, key)
	local ok, j = Profile.acceptJob(p, key)
	if not ok then return ok, j end
	changed(plr, { "engine" })
	return true, j
end
function H.cancelJob(plr, p, id)
	local ok, e = Profile.cancelJob(p, tonumber(id))
	if not ok then return ok, e end
	changed(plr, { "engine", "items" })
	return true
end
function H.completeJob(plr, p, id)
	id = tonumber(id)
	local job
	for _, j in ipairs(p.jobs) do if j.id == id then job = j end end
	if not job then return false, "Inget sådant uppdrag" end
	if job.type == "leverans" then
		local pl = Map.PLACES[job.dest]
		if not near(plr, V3(pl.x, charPos(plr) and charPos(plr).Y or 0, pl.z), Map.DELIVER_RADIUS + 6) then return false, "Kör till " .. pl.n end
	end
	local ok, pay = Profile.completeJob(p, id)
	if not ok then return ok, pay end
	notify(plr, "Uppdraget klart: +" .. pay .. " kr", "money")
	changed(plr, { "engine", "items" })
	return true, pay
end

Api.OnServerInvoke = function(plr, action, ...)
	local p = profiles[plr]
	if not p then return false, "Profilen laddas" end
	local f = H[action]
	if type(action) ~= "string" or not f then return false, "Okänd åtgärd" end
	local res = table.pack(pcall(f, plr, p, ...))
	if not res[1] then
		warn("Api " .. action .. " failed: " .. tostring(res[2]))
		return false, "Något gick fel"
	end
	return res[2], res[3]
end

-- prompts that the server handles itself
game:GetService("ProximityPromptService").PromptTriggered:Connect(function(pp, plr)
	local action = pp:GetAttribute("Action")
	local p = profiles[plr]
	if not p then return end
	if action == "openBox" then
		local plot = plotOf[plr]
		if plot and pp:GetAttribute("Plot") == plot.i then
			local ok, e = H.openBox(plr, p, pp:GetAttribute("Order"))
			if not ok then notify(plr, e, "error") end
		else
			notify(plr, "Det är inte ditt paket", "error")
		end
	elseif action == "ride" then
		local plot = plotOf[plr]
		if plot and pp:GetAttribute("Plot") == plot.i then
			local ok, e = H.ride(plr, p)
			if not ok then notify(plr, e, "error") end
		end
	elseif action == "mount" then
		local model = pp.Parent and pp.Parent.Parent
		if model and model:GetAttribute("OwnerId") == plr.UserId then
			local ok, e = H.mount(plr, p)
			if not ok then notify(plr, e, "error") end
		end
	end
end)

-- ride reports from the client: overheating wears the engine
RideEv.OnServerEvent:Connect(function(plr, kind, value)
	local p = profiles[plr]
	if not p or not riding[plr] then return end
	if kind == "overheat" then
		local before = 0
		local m = p.mopeds[p.cur]
		local k = m and m.engine and p.items[m.engine.kolv]
		if k then before = k.wear or 0 end
		Profile.addWear(p, math.min(0.05, (tonumber(value) or 0) * 0.02))
		if k and before < 1 and (k.wear or 0) >= 1 then
			notify(plr, "Kolvskär! Motorn skar. Byt kolv och kolvringar.", "error")
		end
		pushState(plr)
	end
end)

-- distance pay measured on the server (moped movement while seated)
task.spawn(function()
	while true do
		task.wait(1)
		for plr, r in pairs(riding) do
			local root = r.moped and r.moped.PrimaryPart
			local p = profiles[plr]
			if root and p and r.moped:GetAttribute("Riding") then
				local pos = root.Position
				local d = (pos - r.last).Magnitude
				r.last = pos
				if d < 60 then
					local pay = Profile.addDistance(p, d * Config.STUD)
					if pay > 0 then pushState(plr) end
				end
			elseif root then
				r.last = root.Position
			end
		end
	end
end)

-- deliveries
task.spawn(function()
	while true do
		task.wait(1)
		for plr, p in pairs(profiles) do
			local arrived = Profile.tick(p, now())
			if #arrived > 0 then
				renderBoxes(plr)
				notify(plr, "Paketet har kommit! Det står vid garageporten.", "box")
				pushState(plr)
			end
		end
	end
end)

---------------------------------------------------------------- join and leave
local function save(plr)
	local p = profiles[plr]
	if not (p and store and saving[plr]) then return end
	local data = Profile.save(p)
	local ok, err = pcall(function() store:SetAsync("p_" .. plr.UserId, data) end)
	if not ok then warn("Kunde inte spara " .. plr.Name .. ": " .. tostring(err)) end
end
local function load(plr)
	if not store then return Profile.new(), false end
	local data, ok, err
	for _ = 1, 3 do
		ok, err = pcall(function() data = store:GetAsync("p_" .. plr.UserId) end)
		if ok then break end
		task.wait(1)
	end
	if not ok then
		warn("Kunde inte ladda " .. plr.Name .. ": " .. tostring(err))
		return Profile.new(), false
	end
	return (Profile.load(data)), true
end
local function claimPlot(plr)
	for _, plot in ipairs(plots) do
		if not plot.owner then
			plot.owner = plr
			plot.folder:SetAttribute("OwnerId", plr.UserId)
			plot.refs.nameLabel.Text = string.upper(plr.DisplayName) .. "S GARAGE"
			return plot
		end
	end
end
local function onCharacter(plr, char)
	local plot = plotOf[plr]
	if not plot then return end
	task.defer(function()
		if char.Parent then char:PivotTo(plot.origin * GarageBuilder.SPAWN) end
	end)
	if riding[plr] and riding[plr].moped then riding[plr].moped:Destroy() end
	riding[plr] = nil
	renderMoped(plr, true)
	renderItems(plr)
end
local function onJoin(plr)
	local plot = claimPlot(plr)
	if not plot then
		plr:Kick("Alla garage är upptagna. Försök igen om en stund.")
		return
	end
	plotOf[plr] = plot
	local p, okSave = load(plr)
	saving[plr] = okSave
	if not plr.Parent then plot.owner = nil; return end
	profiles[plr] = p
	plr:SetAttribute("Plot", plot.i)
	renderAll(plr)
	plr.CharacterAdded:Connect(function(char) onCharacter(plr, char) end)
	if plr.Character then onCharacter(plr, plr.Character) end
	pushState(plr)
	if not okSave then
		notify(plr, store and "Sparning fungerar inte just nu. Dina framsteg sparas inte." or "Sparning är avstängd (slå på API-åtkomst i Studio).", "error")
	end
end
local function onLeave(plr)
	save(plr)
	local plot = plotOf[plr]
	if riding[plr] and riding[plr].moped then riding[plr].moped:Destroy() end
	riding[plr] = nil
	if plot then
		plot.dyn:ClearAllChildren()
		plot.owner = nil
		plot.folder:SetAttribute("OwnerId", 0)
		plot.refs.nameLabel.Text = "LEDIGT GARAGE"
	end
	profiles[plr] = nil
	plotOf[plr] = nil
	saving[plr] = nil
end
Players.PlayerAdded:Connect(onJoin)
Players.PlayerRemoving:Connect(onLeave)
for _, plr in ipairs(Players:GetPlayers()) do task.spawn(onJoin, plr) end
task.spawn(function()
	while true do
		task.wait(60)
		for plr in pairs(profiles) do save(plr) end
	end
end)
game:BindToClose(function()
	for plr in pairs(profiles) do save(plr) end
end)
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX17"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Builds the world around the garages: ground, roads from Map (with markings and street lights), the town on
-- Storgatan, the petrol station, the supermarket, the industrial area, the harbour, the country road to the farm,
-- the test track and the drag strip. Everything is anchored parts; terrain is only used for water.
local RS = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Map = require(Shared.Map)
local Models = require(Shared.Models)
local GarageBuilder = require(Shared.GarageBuilder)

local V3, CF, C3 = Vector3.new, CFrame.new, Color3.fromRGB
local M = Enum.Material
local rad = math.rad

local world = Instance.new("Folder")
world.Name = "Världen"
world.Parent = workspace
local mk = Models.maker(world)
local function box(name, size, cf, color, mat, collide)
	local p = mk.box(name, size, cf, color, mat)
	p.CanCollide = collide ~= false
	return p
end
local function cyl(name, len, r, cf, color, mat, collide)
	local p = mk.cyl(name, len, r, cf, color, mat)
	p.CanCollide = collide ~= false
	return p
end

---------------------------------------------------------------- light and sky
Lighting.ClockTime = 14.5
Lighting.GeographicLatitude = 58
Lighting.Brightness = 2.2
Lighting.Ambient = C3(70, 72, 80)
Lighting.OutdoorAmbient = C3(130, 135, 145)
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.8
Lighting.GlobalShadows = true
Lighting.ShadowSoftness = 0.25
local atm = Instance.new("Atmosphere")
atm.Density = 0.28
atm.Offset = 0.2
atm.Color = C3(200, 214, 230)
atm.Decay = C3(110, 120, 140)
atm.Glare = 0.2
atm.Haze = 1.2
atm.Parent = Lighting
local cc = Instance.new("ColorCorrectionEffect")
cc.Contrast = 0.06
cc.Saturation = 0.08
cc.Parent = Lighting
local bloom = Instance.new("BloomEffect")
bloom.Intensity = 0.35
bloom.Size = 26
bloom.Threshold = 1.4
bloom.Parent = Lighting
local rays = Instance.new("SunRaysEffect")
rays.Intensity = 0.06
rays.Parent = Lighting

---------------------------------------------------------------- ground
-- one flat grass plate; roads, pavements and garage floors are parts on top of it (no terrain grass)
-- (the harbour basin in the west is left open for the water)
box("Mark", V3(1440, 4, 2048), CF(300, -2, 0), C3(86, 128, 62), M.Grass)
box("Mark", V3(600, 4, 1224), CF(-720, -2, 412), C3(86, 128, 62), M.Grass)
box("Mark", V3(600, 4, 564), CF(-720, -2, -742), C3(86, 128, 62), M.Grass)
box("Mark", V3(400, 4, 260), CF(-820, -2, -330), C3(86, 128, 62), M.Grass)

---------------------------------------------------------------- roads
local ASPHALT, LINE, KERB, PAVE = C3(58, 58, 62), C3(235, 235, 230), C3(170, 170, 166), C3(150, 148, 144)
local RY = Map.ROAD_Y
local function roadSegment(r)
	local a, b = V3(r.a[1], 0, r.a[2]), V3(r.b[1], 0, r.b[2])
	local len = (b - a).Magnitude
	if len < 0.1 then return end
	local mid = (a + b) / 2
	local look = CFrame.lookAt(mid, b)
	local col = r.drag and C3(46, 46, 50) or ASPHALT
	box("Väg", V3(r.w, 0.24, len), look * CF(0, RY - 0.12, 0), col, M.Asphalt)
	-- round joint so bends have no gaps
	cyl("Väg", 0.24, r.w / 2, CF(b.X, RY - 0.12 - 0.001, b.Z) * CFrame.Angles(0, 0, rad(90)), col, M.Asphalt)
	-- markings: dashed centre line on normal roads, edge lines on the track
	if r.track then
		for _, s in ipairs({ -1, 1 }) do box("Kantlinje", V3(0.3, 0.02, len), look * CF(s * (r.w / 2 - 0.6), RY + 0.01, 0), LINE, M.SmoothPlastic, false) end
	elseif r.drag then
		box("Mittlinje", V3(0.3, 0.02, len), look * CF(0, RY + 0.01, 0), LINE, M.SmoothPlastic, false)
		for _, s in ipairs({ -1, 1 }) do box("Kantlinje", V3(0.3, 0.02, len), look * CF(s * (r.w / 2 - 0.5), RY + 0.01, 0), LINE, M.SmoothPlastic, false) end
	else
		local n = math.floor(len / 9)
		for i = 0, n - 1 do
			local z = -len / 2 + 4.5 + i * 9
			box("Mittlinje", V3(0.3, 0.02, 4), look * CF(0, RY + 0.01, z), LINE, M.SmoothPlastic, false)
		end
	end
end
for _, r in ipairs(Map.ROADS) do roadSegment(r) end

-- pavement along Garagegatan (town side) and both sides of Storgatan, with kerbs
local function pavement(x0, z0, x1, z1, w)
	local a, b = V3(x0, 0, z0), V3(x1, 0, z1)
	local len = (b - a).Magnitude
	local look = CFrame.lookAt((a + b) / 2, b)
	box("Trottoar", V3(w, 0.4, len), look * CF(0, 0.2, 0), PAVE, M.Pavement)
	return look, len
end
local SZ = Config.STREET_Z
pavement(-322, SZ - 11, -8, SZ - 11, 5)
pavement(8, SZ - 11, 322, SZ - 11, 5)
for _, s in ipairs({ -1, 1 }) do pavement(s * 10.5, SZ - 14, s * 10.5, -282, 5) end
for _, s in ipairs({ -1, 1 }) do pavement(s * 10.5, -298, s * 10.5, -522, 5) end

-- street lights
local function streetLight(x, z, faceX)
	box("Lyktstolpe", V3(0.5, 16, 0.5), CF(x, 8, z), C3(60, 62, 66), M.Metal)
	box("Lyktarm", V3(math.abs(faceX) * 3 + 0.4, 0.35, 0.4), CF(x + faceX * 1.5, 15.8, z), C3(60, 62, 66), M.Metal)
	local lamp = box("Lykta", V3(1.6, 0.4, 0.9), CF(x + faceX * 3, 15.6, z), C3(255, 236, 190), M.Neon, false)
	local l = Instance.new("SpotLight")
	l.Face = Enum.NormalId.Bottom
	l.Range = 34
	l.Angle = 110
	l.Brightness = 1.2
	l.Color = C3(255, 220, 170)
	l.Parent = lamp
end
for x = -300, 300, 50 do if math.abs(x) > 20 then streetLight(x, SZ - 10, 1) end end
for z = -80, -500, -50 do streetLight(-11, z, 1); streetLight(11, z - 25, -1) end
for x = -300, 300, 60 do streetLight(x, -299, 1) end

---------------------------------------------------------------- trees and fences
local LEAF = { C3(58, 110, 46), C3(74, 126, 52), C3(48, 96, 40) }
local treeN = 0
local function tree(x, z, s)
	treeN = treeN + 1
	s = s or 1
	box("Stam", V3(0.9 * s, 7 * s, 0.9 * s), CF(x, 3.5 * s, z), C3(92, 70, 50), M.Wood)
	local leaf = LEAF[treeN % 3 + 1]
	mk.ball("Krona", 7 * s, CF(x, 8.5 * s, z), leaf, M.Grass)
	mk.ball("Krona", 5 * s, CF(x + 1.6 * s, 10.5 * s, z - 0.8 * s), leaf, M.Grass)
	mk.ball("Krona", 4.5 * s, CF(x - 1.4 * s, 11 * s, z + 1 * s), leaf, M.Grass)
end
local function birch(x, z)
	box("Stam", V3(0.6, 12, 0.6), CF(x, 6, z), C3(236, 232, 224), M.SmoothPlastic)
	mk.ball("Krona", 6, CF(x, 12.5, z), C3(110, 160, 60), M.Grass)
	mk.ball("Krona", 4.5, CF(x + 1.2, 14.5, z), C3(110, 160, 60), M.Grass)
end
