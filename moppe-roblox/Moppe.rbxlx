</Item>
<Item class="StarterPlayer" referent="RBX29"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX28"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX19"><Properties><string name="Name">Assembly</string><ProtectedString name="Source"><![CDATA[-- Building by hand: the engine on the stand ("engine") and the moped on the lift ("work").
-- Drag a part from the tray onto the engine/moped. Where it belongs shows up green (fits now) or red (with what
-- has to go on first). Let go on the marker and the part slides into place while a hand tightens it.
-- Right-click a mounted part to take it off; left-click it for Demontera / Lackera / Byt ut / Inspektera.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = RS:WaitForChild("Shared")
local Parts = require(Shared.Parts)
local EngineDef = require(Shared.EngineDef)
local MopedDef = require(Shared.MopedDef)
local Models = require(Shared.Models)
local Profile = require(Shared.Profile)
local GarageBuilder = require(Shared.GarageBuilder)
local plr = Players.LocalPlayer
local S = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UIKit"))

local gui = UI.screen("Montering", 10, plr)
gui.Enabled = false

local A = { mode = nil, cat = "Alla", yaw = 0, pitch = 0.32, dist = 7, focus = Vector3.new(), filterKind = nil }

---------------------------------------------------------------- what we are working on
local function engineMap()
	local p = S.profile
	if A.mode == "engine" then return p.stand, "stand" end
	local m = S.moped()
	return m and m.engine, "moped"
end
local function mopedCtx()
	local m = S.moped()
	return { cf = S.origin() * GarageBuilder.LIFT, def = MopedDef.MODELS[m.model] }
end
local function engineCF()
	if A.mode == "engine" then return S.origin() * GarageBuilder.STAND end
	return Models.engineCF(mopedCtx())
end
-- where a part kind goes: returns { kind = "engine"|"chassis", id = socket/slot, name }
local function placeFor(sku)
	local part = Parts.get(sku)
	if not part then return nil end
	local sock = EngineDef.socketForKind(part.kind)
	if sock then
		local map = engineMap()
		if not map then return nil end
		return { kind = "engine", id = sock, name = EngineDef.BY_ID[sock].name }
	end
	if A.mode ~= "work" then return nil end
	local m = S.moped()
	if part.kind == "kapa" then
		if part.stats.fits ~= m.model then return nil end
		return { kind = "chassis", id = "pan:" .. part.stats.panel, name = MopedDef.MODELS[m.model].panelById[part.stats.panel].n }
	end
	for _, s in ipairs(MopedDef.SLOTS) do
		if s.kind == part.kind then return { kind = "chassis", id = s.id, name = s.n } end
	end
end
local function canMount(place, sku)
	local p = S.profile
	if place.kind == "engine" then
		local map = engineMap()
		return EngineDef.canMount(map, place.id, sku, p.items)
	end
	return MopedDef.canMount(S.moped(), place.id, sku)
end
-- parts that are free to use: shelf, bench, floor, in hand, opened boxes
local function freeItems()
	local p = S.profile
	local r = {}
	for id, it in pairs(p.items) do
		if Profile.isFree(p, it) and placeFor(it.sku) then
			local part = Parts.get(it.sku)
			if A.cat == "Alla" or Parts.KINDS[part.kind].grp == A.cat then
				if not A.filterKind or A.filterKind == part.kind then r[#r + 1] = id end
			end
		end
	end
	table.sort(r, function(a, b)
		local pa, pb = Parts.get(p.items[a].sku), Parts.get(p.items[b].sku)
		if pa.kind ~= pb.kind then
			local oa, ob = EngineDef.ORDER[EngineDef.socketForKind(pa.kind) or ""] or 99, EngineDef.ORDER[EngineDef.socketForKind(pb.kind) or ""] or 99
			if oa ~= ob then return oa < ob end
			return pa.kind < pb.kind
		end
		return a < b
	end)
	return r
end

---------------------------------------------------------------- camera
local function updateCam()
	local cf = CFrame.new(A.focus) * CFrame.Angles(0, A.yaw, 0) * CFrame.Angles(-A.pitch, 0, 0) * CFrame.new(0, 0, A.dist)
	S.camTo(cf, 50)
end

---------------------------------------------------------------- UI layout
local top = UI.panel(gui, UDim2.fromOffset(420, 36), UDim2.new(0.5, 0, 0, 8), { anchor = Vector2.new(0.5, 0), name = "Info", transp = 0.15 })
local topText = UI.text(top, "", UDim2.new(1, -20, 1, 0), UDim2.fromOffset(10, 0), { ts = 15, xa = Enum.TextXAlignment.Center, font = UI.BOLD, name = "Infotext" })

local tray = UI.panel(gui, UDim2.fromOffset(400, 470), UDim2.fromOffset(12, 58), { name = "Delar" })
local trayTitle = UI.text(tray, "Motorbygge", UDim2.new(1, -20, 0, 36), UDim2.fromOffset(14, 4), { font = UI.BOLD, ts = 18, name = "Titel" })
local cats = UI.new("Frame", { Size = UDim2.fromOffset(118, 410), Position = UDim2.fromOffset(8, 46), BackgroundTransparency = 1, Name = "Kategorier" }, tray)
UI.list(cats, 4)
local grid = UI.scroll(tray, UDim2.fromOffset(262, 410), UDim2.fromOffset(132, 46), { name = "Lista" })
UI.grid(grid, UDim2.fromOffset(124, 126), UDim2.fromOffset(6, 6))

local checklist = UI.panel(gui, UDim2.fromOffset(240, 470), UDim2.new(1, -12, 0, 58), { anchor = Vector2.new(1, 0), name = "Checklista" })
local checkTitle = UI.text(checklist, "Monteringsordning", UDim2.new(1, -20, 0, 32), UDim2.fromOffset(12, 4), { font = UI.BOLD, ts = 16 })
local checkList = UI.scroll(checklist, UDim2.new(1, -16, 1, -44), UDim2.fromOffset(8, 40), { name = "Rader" })
UI.list(checkList, 3)

local bottom = UI.new("Frame", { Size = UDim2.fromOffset(820, 44), Position = UDim2.new(0.5, 0, 1, -12), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Name = "Knappar" }, gui)
UI.list(bottom, 8, true, Enum.HorizontalAlignment.Center)
local hint = UI.text(gui, "Rotera: R / högerklick och dra   ·   Zoom: rullhjul   ·   Ta bort: högerklicka på en del", UDim2.fromOffset(600, 20), UDim2.new(0.5, 0, 1, -84), { anchor = Vector2.new(0.5, 0), ts = 13, color = UI.C.dim, xa = Enum.TextXAlignment.Center })

local menu -- context menu
local function closeMenu() if menu then menu:Destroy(); menu = nil end end

---------------------------------------------------------------- markers, ghost and the hand
local fx = Instance.new("Folder")
fx.Name = "MonteringLokal"
local function tint(model, color, transp)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Color = color
			d.Material = Enum.Material.SmoothPlastic
			d.Transparency = math.max(d.Transparency, transp)
			d.CanQuery = false
			d.CastShadow = false
		end
	end
end
local function buildAt(sku, item, place)
	local model = Instance.new("Model")
	model.Name = "Markering"
	if place.kind == "engine" then Models.buildInto(model, sku, item, engineCF())
	else Models.buildInto(model, sku, item, nil, mopedCtx()) end
	return model
end
-- a hand with a wrench tightening at a point, then disappears
local function handAnim(pos, unscrew)
	local cam = workspace.CurrentCamera
	local toCam = (cam.CFrame.Position - pos).Unit
	local start = CFrame.lookAt(pos + toCam * 2.2 + Vector3.new(0, 0.6, 0), pos)
	local hand = Models.hand(fx, start * CFrame.Angles(math.rad(-20), 0, 0), true)
	local wrench = Models.tool(hand, "nyckel", start * CFrame.new(0, 0.05, -0.55), false)
	for _, p in ipairs(wrench.parts) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = hand.PrimaryPart
		w.Part1 = p
		w.Parent = p
		p.Anchored = false
	end
	local main = hand.PrimaryPart
	for _, d in ipairs(hand:GetDescendants()) do
		if d:IsA("BasePart") and d ~= main then
			if not d:FindFirstChildOfClass("WeldConstraint") then
				local w = Instance.new("WeldConstraint")
				w.Part0 = main
				w.Part1 = d
				w.Parent = d
			end
			d.Anchored = false
		end
	end
	task.spawn(function()
		local near = CFrame.lookAt(pos + toCam * 0.9 + Vector3.new(0, 0.25, 0), pos)
		local tw = TweenService:Create(main, TweenInfo.new(0.25), { CFrame = near })
		tw:Play()
		tw.Completed:Wait()
		for i = 1, 4 do
			local a = (unscrew and -1 or 1) * math.rad(55)
			local t1 = TweenService:Create(main, TweenInfo.new(0.14), { CFrame = near * CFrame.Angles(0, 0, a) })
			t1:Play(); t1.Completed:Wait()
			local t2 = TweenService:Create(main, TweenInfo.new(0.1), { CFrame = near })
			t2:Play(); t2.Completed:Wait()
		end
		local t3 = TweenService:Create(main, TweenInfo.new(0.2), { CFrame = start })
		t3:Play(); t3.Completed:Wait()
		hand:Destroy()
	end)
end

local drag -- { id, sku, place, ok, why, marker, ghost, snapped }
local function endDrag()
	if drag then
		if drag.marker then drag.marker:Destroy() end
		if drag.ghost then drag.ghost:Destroy() end
	end
	drag = nil
end
local function startDrag(id)
	if drag or not A.mode then return end
	local it = S.item(id)
	if not it then return end
	local place = placeFor(it.sku)
	if not place then S.toast(Parts.get(it.sku).name .. " sitter inte här", "error"); return end
	local ok, why = canMount(place, it.sku)
	local marker = buildAt(it.sku, it, place)
	tint(marker, ok and Color3.fromRGB(70, 220, 110) or Color3.fromRGB(230, 70, 60), 0.5)
	marker.Parent = fx
	local ghost = Models.item(it.sku, it)
	for _, d in ipairs(ghost:GetDescendants()) do if d:IsA("BasePart") then d.CanQuery = false end end
	ghost.Parent = fx
	drag = { id = id, sku = it.sku, place = place, ok = ok, why = why, marker = marker, ghost = ghost }
	topText.Text = ok and ("Dra " .. Parts.get(it.sku).name:lower() .. " till den gröna markeringen") or ("Går inte än: " .. tostring(why))
	top.BackgroundColor3 = ok and UI.C.panel or Color3.fromRGB(110, 30, 30)
end
local function dropDrag()
	local d = drag
	if not d then return end
	if not d.snapped then endDrag(); A.refresh(); return end
	if not d.ok then S.toast(d.why or "Går inte", "error"); endDrag(); A.refresh(); return end
	-- slide the ghost onto the marker, then mount on the server
	local cf = d.marker:GetBoundingBox()
	d.ghost:PivotTo(CFrame.new(cf.Position))
	local map, target = engineMap()
	local okA, err
	if d.place.kind == "engine" then okA, err = S.api("mountEngine", target, d.place.id, d.id)
	else okA, err = S.api("mountChassis", d.place.id, d.id) end
	if okA then
		handAnim(cf.Position, false)
		S.toast(Parts.get(d.sku).name .. " monterad", "ok")
	end
	endDrag()
	A.refresh()
end

---------------------------------------------------------------- mounted parts in 3D
local function mountedAt(inst)
	local plot = S.plot()
	if not plot or not inst then return nil end
	local x = inst
	while x and x ~= plot do
		if x:IsA("Model") then
			local sock = x:GetAttribute("Sock")
			local slot = x:GetAttribute("Slot")
			if A.mode == "engine" and sock and x.Parent and x.Parent.Name == "Motor" and x.Parent.Parent and x.Parent.Parent.Name == "Dynamic" then
				return { kind = "engine", id = sock, item = x:GetAttribute("Item"), model = x }
			end
			if A.mode == "work" and x:FindFirstAncestor("Moped") then
				if sock then return { kind = "engine", id = sock, item = x:GetAttribute("Item"), model = x } end
				if slot and slot ~= "motor" then return { kind = "chassis", id = slot, item = x:GetAttribute("Item"), model = x } end
			end
		end
		x = x.Parent
	end
end
local function unmount(mp)
	local map, target = engineMap()
	local ok
	if mp.kind == "engine" then ok = S.api("unmountEngine", target, mp.id)
	else ok = S.api("unmountChassis", mp.id) end
	if ok then
		handAnim(mp.model:GetBoundingBox().Position, true)
		S.toast("Demonterad – delen ligger på arbetsbänken", "ok")
	end
	return ok
end
local function inspect(id)
	local it = S.item(id)
	if not it then return end
	local part = Parts.get(it.sku)
	local lines = { part.name, part.brand .. " · " .. Parts.KINDS[part.kind].cat, part.desc }
	if it.wear and it.wear > 0 then lines[#lines + 1] = string.format("Slitage: %d %%", math.floor(it.wear * 100)) end
	if it.port then lines[#lines + 1] = "Portad: " .. it.port.label .. string.format(" (%d %%)", math.floor(it.port.q * 100)) end
	if it.paint then lines[#lines + 1] = "Lack: " .. (it.paint.f or "") .. string.format(", kvalitet %d %%", math.floor((it.paint.q or 1) * 100)) end
	if it.cust then lines[#lines + 1] = "Kundens del" end
	S.toast(table.concat(lines, "\n"), "info")
end
local function contextMenu(mp, x, y)
	closeMenu()
	menu = UI.panel(gui, UDim2.fromOffset(190, 10), UDim2.fromOffset(x + 8, y - 50), { name = "Meny", z = 20 })
	menu.AutomaticSize = Enum.AutomaticSize.Y
	UI.pad(menu, 6)
	UI.list(menu, 4)
	local it = S.item(mp.item)
	UI.text(menu, it and Parts.get(it.sku).name or "Del", UDim2.new(1, 0, 0, 24), nil, { font = UI.BOLD, ts = 14, z = 21, truncate = true })
	local function add(text, kind, f)
		UI.button(menu, text, UDim2.new(1, 0, 0, 32), nil, { kind = kind or "secondary", ts = 14, z = 21 }, function() closeMenu(); f() end)
	end
	add("Demontera", "secondary", function() unmount(mp) end)
	if mp.kind == "chassis" and mp.id:sub(1, 4) == "pan:" then
		add("Lackera", "secondary", function()
			local ok, id = S.api("unmountChassis", mp.id)
			if ok and id then
				if S.api("moveTo", id, "lack") then
					S.endMode()
					S.open:Fire("paint")
				end
			end
		end)
	end
	add("Byt ut", "secondary", function()
		local part = it and Parts.get(it.sku)
		if unmount(mp) and part then A.filterKind = part.kind; A.refresh() end
	end)
	add("Inspektera", "secondary", function() inspect(mp.item) end)
end

---------------------------------------------------------------- tray, checklist and buttons
local function card(id, order)
	local it = S.item(id)
	local part = Parts.get(it.sku)
	local c = UI.new("TextButton", { Size = UDim2.fromOffset(124, 126), BackgroundColor3 = UI.C.panel2, Text = "", AutoButtonColor = true, LayoutOrder = order, Name = "Del_" .. id }, grid)
	UI.corner(c, 8)
	local place = placeFor(it.sku)
	local ok = place and canMount(place, it.sku)
	UI.stroke(c, ok and UI.C.green or UI.C.line, ok and 2 or 1, ok and 0.2 or 0.5)
	local model = Models.item(it.sku, it)
	UI.viewport(c, model, UDim2.fromOffset(112, 74), UDim2.fromOffset(6, 6), { z = 1 })
	UI.text(c, part.name, UDim2.new(1, -10, 0, 30), UDim2.fromOffset(6, 82), { ts = 12, wrap = true, font = UI.BOLD, ya = Enum.TextYAlignment.Top })
	UI.text(c, part.brand .. (it.loc:sub(1, 4) == "box:" and " · i paket" or ""), UDim2.new(1, -10, 0, 14), UDim2.fromOffset(6, 108), { ts = 11, color = UI.C.dim })
	c.MouseButton1Down:Connect(function() startDrag(id) end)
	c.MouseButton2Click:Connect(function()
		closeMenu()
		local mpos = UIS:GetMouseLocation()
		menu = UI.panel(gui, UDim2.fromOffset(190, 10), UDim2.fromOffset(mpos.X + 8, mpos.Y - 60), { name = "Meny", z = 20 })
		menu.AutomaticSize = Enum.AutomaticSize.Y
		UI.pad(menu, 6)
		UI.list(menu, 4)
		UI.text(menu, part.name, UDim2.new(1, 0, 0, 24), nil, { font = UI.BOLD, ts = 14, z = 21 })
		UI.button(menu, "Lägg på hyllan", UDim2.new(1, 0, 0, 32), nil, { kind = "secondary", ts = 14, z = 21 }, function() closeMenu(); S.api("moveTo", id, "hylla") end)
		UI.button(menu, "Inspektera", UDim2.new(1, 0, 0, 32), nil, { kind = "secondary", ts = 14, z = 21 }, function() closeMenu(); inspect(id) end)
		if not it.cust then
			UI.button(menu, "Sälj (" .. UI.kr(math.floor(part.price * 0.5 * (1 - 0.6 * (it.wear or 0)))) .. ")", UDim2.new(1, 0, 0, 32), nil, { kind = "danger", ts = 14, z = 21 }, function() closeMenu(); S.api("sell", id) end)
		end
	end)
	return c
end

function A.refresh()
	if not A.mode or not S.profile then return end
	local p = S.profile
	-- categories
	UI.clear(cats)
	local catList = A.mode == "engine" and { "Alla", "Motorblock", "Transmission", "Insug", "Tändning" } or { "Alla", "Chassi", "Kåpor", "Motorblock", "Transmission", "Insug", "Tändning" }
	for i, c in ipairs(catList) do
		UI.button(cats, c == "Alla" and "Alla delar" or c, UDim2.new(1, 0, 0, 30), nil, { kind = (A.cat == c and not A.filterKind) and "primary" or "ghost", xa = Enum.TextXAlignment.Left, ts = 13, order = i, name = c }, function()
			A.cat = c
			A.filterKind = nil
			A.refresh()
		end)
	end
	if A.filterKind then
		UI.button(cats, "Visa alla", UDim2.new(1, 0, 0, 30), nil, { kind = "yellow", ts = 13, order = 99 }, function() A.filterKind = nil; A.refresh() end)
	end
	-- parts
	UI.clear(grid)
	local items = freeItems()
	for i, id in ipairs(items) do card(id, i) end
	if #items == 0 then
		local l = UI.text(grid, A.filterKind and ("Du har ingen ledig " .. Parts.kindName(A.filterKind):lower() .. ". Beställ en på datorn.") or "Inga lediga delar här. Beställ delar på datorn eller hämta dem ur paketen.", UDim2.fromOffset(250, 80), nil, { ts = 13, wrap = true, color = UI.C.dim })
		l.LayoutOrder = 1
	end
	-- checklist
	UI.clear(checkList)
	local order = 0
	local map = engineMap()
	if A.mode == "engine" then
		trayTitle.Text = "Motorbygge"
		checkTitle.Text = "Motorn  " .. (map and (29 - #EngineDef.missing(map)) or 0) .. "/29"
		local nextUp = {}
		for _, s in ipairs(EngineDef.nextUp(map or {})) do nextUp[s] = true end
		for _, grp in ipairs(EngineDef.GROUPS) do
			order = order + 1
			UI.text(checkList, grp, UDim2.new(1, 0, 0, 22), nil, { ts = 13, font = UI.BOLD, color = UI.C.accent2, order = order })
			for _, s in ipairs(EngineDef.SOCKETS) do
				if s.grp == grp then
					order = order + 1
					local row = UI.check(checkList, s.name, map and map[s.id] ~= nil, order, nextUp[s.id])
					local btn = UI.new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Name = "Klick" }, row)
					btn.Activated:Connect(function() A.filterKind = s.kind; A.refresh() end)
				end
			end
		end
		topText.Text = map and EngineDef.complete(map) and "Motorn är komplett! Sätt den i mopeden." or "Dra delarna till rätt plats!"
	else
		local m = S.moped()
		trayTitle.Text = "Mopedbygge"
		checkTitle.Text = MopedDef.MODELS[m.model].n
		for _, sid in ipairs(MopedDef.slotIds(m.model)) do
			order = order + 1
			local info = MopedDef.slotInfo(m.model, sid)
			local done = MopedDef.filled(m, sid)
			local label = info.n
			if sid == "motor" and m.engine and not EngineDef.complete(m.engine) then label = "Motor (ofullständig)" end
			local row = UI.check(checkList, label, done, order, false)
			local btn = UI.new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Name = "Klick" }, row)
			btn.Activated:Connect(function()
				if sid == "motor" then return end
				A.filterKind = info.kind
				A.cat = "Alla"
				A.refresh()
			end)
		end
		local probs = Profile.mopedProblems(p, m)
		topText.Text = #probs == 0 and "Mopeden är klar att köra!" or "Dra delarna till mopeden. Saknas: " .. #probs
	end
	top.BackgroundColor3 = UI.C.panel
	-- buttons
	UI.clear(bottom)
	local function btn(text, kind, f, order2) UI.button(bottom, text, UDim2.fromOffset(math.max(120, #text * 9 + 30), 40), nil, { kind = kind, order = order2, ts = 15 }, f) end
	local m = S.moped()
	if A.mode == "engine" then
		if map and EngineDef.complete(map) and m and not m.engine then btn("Sätt motorn i mopeden", "green", function() if S.api("engineToMoped") then S.toast("Motorn sitter i mopeden", "ok") end end, 1) end
		if m and m.engine and EngineDef.isEmpty(p.stand) then btn("Lyft ur motorn ur mopeden", "secondary", function() if S.api("engineToStand") then S.toast("Motorn står på stativet", "ok") end end, 2) end
		for _, j in ipairs(p.jobs) do
			if j.type == "reparation" or j.type == "bygg" then btn("Lämna motorn till kunden", "yellow", function() S.api("completeJob", j.id) end, 3) end
		end
	else
		if m.engine then btn("Lyft ur motorn", "secondary", function() if S.api("engineToStand") then S.toast("Motorn står på motorstativet", "ok") end end, 1)
		elseif EngineDef.complete(p.stand) then btn("Montera motorn från stativet", "green", function() S.api("engineToMoped") end, 1) end
		if #Profile.mopedProblems(p, m) == 0 then btn("Kör ut", "green", function() S.endMode(); S.open:Fire("ride") end, 2) end
	end
	btn("Klar", "primary", function() S.endMode() end, 10)
end

---------------------------------------------------------------- open / close
local function open(mode)
	if not S.profile then return end
	if mode == "work" and not S.moped() then return end
	if not S.setMode(mode) then return end
	A.mode = mode
	A.cat = "Alla"
	A.filterKind = nil
	fx.Parent = workspace
	if mode == "engine" then
		A.focus = (S.origin() * GarageBuilder.STAND * CFrame.new(0, 0.1, 0.5)).Position
		A.dist, A.yaw, A.pitch = 6.5, math.rad(200), 0.35
	else
		A.focus = (S.origin() * GarageBuilder.LIFT * CFrame.new(0, 2.2, 0)).Position
		A.dist, A.yaw, A.pitch = 11, math.rad(240), 0.3
	end
	-- face the camera along the station's rotation
	local _, ry = (mode == "engine" and S.origin() * GarageBuilder.STAND or S.origin() * GarageBuilder.LIFT):ToOrientation()
	A.yaw = A.yaw + ry
	updateCam()
	gui.Enabled = true
	A.refresh()
end
local function close()
	endDrag()
	closeMenu()
	gui.Enabled = false
	A.mode = nil
	fx:ClearAllChildren()
	fx.Parent = nil
end
S.open.Event:Connect(function(what, atStation)
	if (what == "engine" or what == "work") and atStation then open(what) end
end)
S.modeEv.Event:Connect(function(mode) if mode ~= "engine" and mode ~= "work" and A.mode then close() end end)
S.changed.Event:Connect(function() if A.mode and not drag then A.refresh() end end)

---------------------------------------------------------------- input
local rotating = false
UIS.InputBegan:Connect(function(input, gp)
	if not A.mode then return end
	if input.KeyCode == Enum.KeyCode.R and not gp then A.yaw = A.yaw + math.rad(45); updateCam() end
	if input.UserInputType == Enum.UserInputType.MouseButton2 and not gp then
		local mp = mountedAt(plr:GetMouse().Target)
		if mp then
			local okR, why
			if mp.kind == "engine" then okR, why = EngineDef.canRemove(engineMap(), mp.id) else okR, why = MopedDef.canRemove(S.moped(), mp.id) end
			if okR then unmount(mp) else S.toast(why, "error") end
		else
			rotating = true
		end
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not gp and not drag then
		closeMenu()
		local mp = mountedAt(plr:GetMouse().Target)
		if mp then
			local pos = UIS:GetMouseLocation()
			contextMenu(mp, pos.X, pos.Y - 58)
		end
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then rotating = false end
	if input.UserInputType == Enum.UserInputType.MouseButton1 and drag then dropDrag() end
end)
UIS.InputChanged:Connect(function(input, gp)
	if not A.mode then return end
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		A.dist = math.clamp(A.dist - input.Position.Z * 0.8, A.mode == "engine" and 2.5 or 5, A.mode == "engine" and 12 or 22)
		updateCam()
	elseif input.UserInputType == Enum.UserInputType.MouseMovement and rotating then
		A.yaw = A.yaw - input.Delta.X * 0.01
		A.pitch = math.clamp(A.pitch + input.Delta.Y * 0.008, -0.2, 1.2)
		updateCam()
	end
end)

-- dragging: the ghost follows the mouse in a plane through the target; near the marker it snaps
RunService.RenderStepped:Connect(function()
	if not (A.mode and drag) then return end
	local cam = workspace.CurrentCamera
	local mpos = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mpos.X, mpos.Y)
	local center = drag.marker:GetBoundingBox().Position
	local n = cam.CFrame.LookVector
	local denom = ray.Direction:Dot(n)
	local point = center
	if math.abs(denom) > 1e-4 then point = ray.Origin + ray.Direction * ((center - ray.Origin):Dot(n) / denom) end
	local sp, onScreen = cam:WorldToViewportPoint(center)
	local d = (Vector2.new(sp.X, sp.Y) - mpos).Magnitude
	drag.snapped = onScreen and d < 80
	if drag.snapped then
		drag.ghost:PivotTo(CFrame.new(center))
		for _, p in ipairs(drag.marker:GetDescendants()) do if p:IsA("BasePart") then p.Transparency = 0.25 end end
	else
		drag.ghost:PivotTo(CFrame.new(point))
		for _, p in ipairs(drag.marker:GetDescendants()) do if p:IsA("BasePart") then p.Transparency = 0.55 end end
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX20"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- HUD: start menu, money, toasts and tips, the garage side menu with Moped Info, and the windows
-- "Min moppe" (status, tuning, mopeds, designs), "Statistik" and "Inställningar".
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Shared = RS:WaitForChild("Shared")
local MopedDef = require(Shared.MopedDef)
local Profile = require(Shared.Profile)
local Performance = require(Shared.Performance)
local Models = require(Shared.Models)
local Config = require(Shared.Config)
local plr = Players.LocalPlayer
local S = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UIKit"))

pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false) end)
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)

local gui = UI.screen("Hud", 5, plr)

---------------------------------------------------------------- money, toasts, tip
local money = UI.panel(gui, UDim2.fromOffset(196, 40), UDim2.new(1, -12, 0, 8), { anchor = Vector2.new(1, 0), name = "Pengar" })
local moneyText = UI.text(money, "", UDim2.new(1, -54, 1, 0), UDim2.fromOffset(14, 0), { font = UI.BOLD, ts = 20, xa = Enum.TextXAlignment.Right, name = "Belopp" })
UI.button(money, "+", UDim2.fromOffset(32, 32), UDim2.new(1, -36, 0, 4), { kind = "green", ts = 22, name = "Tjäna" }, function() S.open:Fire("jobs") end)

local toasts = UI.new("Frame", { Size = UDim2.fromOffset(460, 300), Position = UDim2.new(0.5, 0, 0, 54), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Name = "Notiser" }, gui)
UI.list(toasts, 6, false, Enum.HorizontalAlignment.Center)
local TOAST = { error = UI.C.red, money = UI.C.green, box = UI.C.orange, info = UI.C.accent, ok = UI.C.green }
S.toastEv.Event:Connect(function(text, kind)
	local t = UI.panel(toasts, UDim2.fromOffset(440, 40), nil, { name = "Notis" })
	t.AutomaticSize = Enum.AutomaticSize.Y
	UI.new("Frame", { Size = UDim2.new(0, 5, 1, -12), Position = UDim2.fromOffset(8, 6), BackgroundColor3 = TOAST[kind] or UI.C.accent, BorderSizePixel = 0 }, t)
	local l = UI.text(t, text, UDim2.new(1, -36, 0, 40), UDim2.fromOffset(22, 0), { ts = 15, wrap = true })
	l.AutomaticSize = Enum.AutomaticSize.Y
	task.delay(kind == "error" and 4 or 3.2, function() t:Destroy() end)
end)
local tip = UI.panel(gui, UDim2.fromOffset(560, 34), UDim2.new(0.5, 0, 1, -14), { anchor = Vector2.new(0.5, 1), name = "Tips", transp = 0.25, visible = false })
local tipText = UI.text(tip, "", UDim2.fromScale(1, 1), nil, { ts = 14, xa = Enum.TextXAlignment.Center, color = UI.C.text })
S.tipEv.Event:Connect(function(text)
	tip.Visible = text ~= nil and text ~= "" and S.settings.tips
	tipText.Text = text or ""
end)

---------------------------------------------------------------- garage side menu and Moped Info
local side = UI.new("Frame", { Size = UDim2.fromOffset(196, 290), Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1, Name = "Garagemeny" }, gui)
UI.list(side, 8)
local MENU = {
	{ "Bygg motor", "engine" }, { "Porta cylinder", "port" }, { "Beställ delar", "shop" }, { "Lackering", "paint" }, { "Min moppe", "moped" }, { "Kör ut", "ride" },
}
for i, m in ipairs(MENU) do
	local b = UI.button(side, m[1], UDim2.new(1, 0, 0, 40), nil, { kind = i == 6 and "primary" or "ghost", xa = Enum.TextXAlignment.Left, order = i, transp = i == 6 and 0 or 0.1, name = m[1] })
	if i ~= 6 then UI.stroke(b, UI.C.line, 1, 0.5) end
	b.Activated:Connect(function() S.open:Fire(m[2]) end)
end
local info = UI.panel(gui, UDim2.fromOffset(250, 236), UDim2.new(1, -12, 0.5, 10), { anchor = Vector2.new(1, 0.5), name = "MopedInfo" })
UI.pad(info, 14, 14, 10, 10)
UI.list(info, 4)
local infoTitle = UI.text(info, "Moped Info", UDim2.new(1, 0, 0, 24), nil, { font = UI.BOLD, ts = 17, order = 0 })
local rows = {}
for i, k in ipairs({ { "hp", "Hästkrafter" }, { "top", "Toppfart" }, { "acc", "0–45 km/h" }, { "rpm", "Max effekt vid" }, { "temp", "Temperatur" }, { "status", "Motorstatus" } }) do
	local r = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = i, Name = k[1] }, info)
	UI.text(r, k[2] .. ":", UDim2.new(0.6, 0, 1, 0), nil, { ts = 14, color = UI.C.dim })
	rows[k[1]] = UI.text(r, "", UDim2.new(0.4, 0, 1, 0), UDim2.fromScale(0.6, 0), { ts = 14, font = UI.BOLD, xa = Enum.TextXAlignment.Right, name = "Värde" })
end
local powerBar = select(2, UI.bar(info, UDim2.new(1, 0, 0, 6), nil, 0, UI.C.green))
powerBar.Parent.LayoutOrder = 10
local speedBar = select(2, UI.bar(info, UDim2.new(1, 0, 0, 6), nil, 0, UI.C.accent2))
speedBar.Parent.LayoutOrder = 11

local function inGarage()
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not root or not S.meta.plot then return false end
	local l = S.origin():PointToObjectSpace(root.Position)
	return math.abs(l.X) < 24 and math.abs(l.Z) < 17
end
local function updateInfo()
	local p = S.profile
	local m = S.moped()
	if not (p and m) then return end
	moneyText.Text = UI.kr(p.money)
	infoTitle.Text = MopedDef.MODELS[m.model].n
	local s = S.perf(m)
	if s then
		rows.hp.Text = string.format("%.1f hk", s.hp)
		rows.top.Text = string.format("%d km/h", math.floor(s.top + 0.5))
		rows.acc.Text = s.t45 and string.format("%.1f s", s.t45) or "–"
		rows.rpm.Text = string.format("%d rpm", s.rpm)
		rows.temp.Text = string.format("%d °C", math.floor(s.temp + 0.5))
		rows.temp.TextColor3 = s.temp > Performance.TEMP_WARN and UI.C.red or UI.C.text
		local probs = Profile.mopedProblems(p, m)
		rows.status.Text = #probs > 0 and "Ej körbar" or s.status
		rows.status.TextColor3 = #probs > 0 and UI.C.red or (s.status == "OK" and UI.C.green or UI.C.yellow)
		powerBar.Size = UDim2.fromScale(math.clamp(s.hp / 16, 0.03, 1), 1)
		speedBar.Size = UDim2.fromScale(math.clamp(s.top / 110, 0.03, 1), 1)
	else
		for _, k in ipairs({ "hp", "top", "acc", "rpm", "temp" }) do rows[k].Text = "–" end
		rows.status.Text = "Ingen motor"
		rows.status.TextColor3 = UI.C.red
	end
end
S.changed.Event:Connect(updateInfo)

---------------------------------------------------------------- windows
local win = UI.panel(gui, UDim2.fromOffset(760, 500), UDim2.fromScale(0.5, 0.5), { anchor = Vector2.new(0.5, 0.5), name = "Fönster", visible = false, z = 5 })
local winTitle
local body = UI.new("Frame", { Size = UDim2.new(1, -24, 1, -64), Position = UDim2.fromOffset(12, 52), BackgroundTransparency = 1, Name = "Innehåll" }, win)
local current
local function closeWin()
	win.Visible = false
	current = nil
end
local header = UI.header(win, "", closeWin)
winTitle = header.Titel
local function openWin(title, build)
	current = build
	winTitle.Text = title
	UI.clear(body)
	build(body)
	win.Visible = true
end
local function refreshWin() if win.Visible and current then UI.clear(body); current(body) end end
S.changed.Event:Connect(refreshWin)

-- Min moppe -------------------------------------------------------------
local mopedTab = "status"
local function tabs(parent, list, cur, onPick)
	local bar = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Name = "Flikar" }, parent)
	UI.list(bar, 6, true)
	for i, t in ipairs(list) do
		UI.button(bar, t[2], UDim2.fromOffset(130, 32), nil, { kind = t[1] == cur and "primary" or "secondary", order = i, ts = 15 }, function() onPick(t[1]) end)
	end
	return bar
end
local function buildMoped(b)
	local p = S.profile
	local m = S.moped()
	tabs(b, { { "status", "Status" }, { "mopeder", "Mopeder" }, { "designer", "Designer" } }, mopedTab, function(t) mopedTab = t; refreshWin() end)
	local area = UI.new("Frame", { Size = UDim2.new(1, 0, 1, -44), Position = UDim2.fromOffset(0, 44), BackgroundTransparency = 1, Name = "Flik" }, b)
	if mopedTab == "status" then
		local left = UI.new("Frame", { Size = UDim2.new(0.5, -8, 1, 0), BackgroundTransparency = 1 }, area)
		UI.list(left, 6)
		UI.text(left, MopedDef.MODELS[m.model].n, UDim2.new(1, 0, 0, 26), nil, { font = UI.BOLD, ts = 20, order = 1 })
		UI.text(left, string.format("Mätarställning: %.1f km", m.odo or 0), UDim2.new(1, 0, 0, 20), nil, { ts = 14, color = UI.C.dim, order = 2 })
		local probs = Profile.mopedProblems(p, m)
		if #probs == 0 then
			UI.text(left, "Redo att köra", UDim2.new(1, 0, 0, 22), nil, { ts = 16, font = UI.BOLD, color = UI.C.green, order = 3 })
		else
			UI.text(left, "Saknas innan du kan köra:", UDim2.new(1, 0, 0, 22), nil, { ts = 15, font = UI.BOLD, color = UI.C.red, order = 3 })
			for i, t in ipairs(probs) do UI.text(left, "• " .. t, UDim2.new(1, 0, 0, 20), nil, { ts = 14, order = 3 + i }) end
		end
		local mp = MopedDef.missingPanels(m)
		if #mp > 0 then UI.text(left, "Kåpor som saknas: " .. table.concat(mp, ", "), UDim2.new(1, 0, 0, 38), nil, { ts = 13, color = UI.C.dim, wrap = true, order = 30 }) end
		-- jetting
		local jet = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = 40 }, left)
		UI.text(jet, "Munstycke (bränsle):", UDim2.new(0.5, 0, 1, 0), nil, { ts = 14 })
		local jt = ({ [-2] = "Mycket fett", [-1] = "Fett", [0] = "Normal", [1] = "Magert", [2] = "Mycket magert" })[m.jet or 0]
		UI.button(jet, "−", UDim2.fromOffset(32, 32), UDim2.new(0.5, 0, 0, 4), { kind = "secondary", name = "Fetare" }, function() S.api("setJet", (m.jet or 0) - 1) end)
		UI.text(jet, jt, UDim2.fromOffset(110, 40), UDim2.new(0.5, 36, 0, 0), { ts = 14, xa = Enum.TextXAlignment.Center, font = UI.BOLD })
		UI.button(jet, "+", UDim2.fromOffset(32, 32), UDim2.new(0.5, 150, 0, 4), { kind = "secondary", name = "Magrare" }, function() S.api("setJet", (m.jet or 0) + 1) end)
		UI.text(left, "Magrare ger lite mer effekt men mycket mer värme. Går motorn för varm skär kolven.", UDim2.new(1, 0, 0, 36), nil, { ts = 12, color = UI.C.dim, wrap = true, order = 41 })
		local actions = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = 50 }, left)
		UI.list(actions, 8, true)
		UI.button(actions, "Kör ut", UDim2.fromOffset(120, 36), nil, { kind = "green", order = 1 }, function() closeWin(); S.open:Fire("ride") end)
		UI.button(actions, "Hämta hem mopeden", UDim2.fromOffset(190, 36), nil, { kind = "secondary", order = 2 }, function() S.api("home") end)
		-- stats
		local right = UI.panel(area, UDim2.new(0.5, -8, 1, 0), UDim2.new(0.5, 8, 0, 0), { color = UI.C.panel2, transp = 0 })
		UI.pad(right, 14)
		UI.list(right, 6)
		UI.text(right, "Prestanda (beräknad)", UDim2.new(1, 0, 0, 22), nil, { font = UI.BOLD, ts = 16, order = 0 })
		local s = S.perf(m)
		local lines = s and {
			{ "Slagvolym", string.format("%.0f cc", s.cc) }, { "Max effekt", string.format("%.1f hk vid %d rpm", s.hp, s.rpm) },
			{ "Varvspärr", string.format("%d rpm", s.limit) }, { "Toppfart", string.format("%d km/h", math.floor(s.top + 0.5)) },
			{ "0–45 km/h", s.t45 and string.format("%.1f s", s.t45) or "når inte 45" }, { "0–60 km/h", s.t60 and string.format("%.1f s", s.t60) or "når inte 60" },
			{ "Temperatur fullgas", string.format("%d °C", math.floor(s.temp + 0.5)) }, { "Motorstatus", s.status },
		} or { { "Motor", "Saknas" } }
		for i, l in ipairs(lines) do
			local r = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = i }, right)
			UI.text(r, l[1], UDim2.new(0.5, 0, 1, 0), nil, { ts = 14, color = UI.C.dim })
			UI.text(r, l[2], UDim2.new(0.5, 0, 1, 0), UDim2.fromScale(0.5, 0), { ts = 14, font = UI.BOLD, xa = Enum.TextXAlignment.Right })
		end
		UI.text(right, "Värdena räknas fram ur delarna. Testkör för att se hur den går på riktigt.", UDim2.new(1, 0, 0, 40), nil, { ts = 12, color = UI.C.dim, wrap = true, order = 20 })
	elseif mopedTab == "mopeder" then
		local list = UI.scroll(area, UDim2.new(0.45, 0, 1, 0))
		UI.list(list, 8)
		for i, mm in ipairs(p.mopeds) do
			local row = UI.panel(list, UDim2.new(1, -8, 0, 64), nil, { color = i == p.cur and UI.C.accent or UI.C.panel2, transp = i == p.cur and 0.35 or 0 })
			row.LayoutOrder = i
			UI.text(row, MopedDef.MODELS[mm.model].n, UDim2.new(1, -20, 0, 24), UDim2.fromOffset(10, 6), { font = UI.BOLD, ts = 15 })
			UI.text(row, i == p.cur and "På lyften" or ("Värde " .. UI.kr(Profile.mopedValue(p, mm))), UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 32), { ts = 13, color = UI.C.dim })
			if i ~= p.cur then
				UI.button(row, "Välj", UDim2.fromOffset(64, 28), UDim2.new(1, -148, 0, 18), { kind = "secondary", ts = 14 }, function() S.api("selectMoped", i) end)
				UI.button(row, "Sälj", UDim2.fromOffset(64, 28), UDim2.new(1, -76, 0, 18), { kind = "danger", ts = 14 }, function() S.api("sellMoped", i) end)
			end
		end
		-- dealer: every model with a 3D picture
		local dealer = UI.new("Frame", { Size = UDim2.new(0.55, -12, 1, 0), Position = UDim2.new(0.45, 12, 0, 0), BackgroundTransparency = 1 }, area)
		UI.text(dealer, "Köp ny moped", UDim2.new(1, 0, 0, 24), nil, { font = UI.BOLD, ts = 16 })
		for i, id in ipairs(MopedDef.ORDER) do
			local def = MopedDef.MODELS[id]
			local card = UI.panel(dealer, UDim2.new(1, 0, 0, 112), UDim2.fromOffset(0, 30 + (i - 1) * 120), { color = UI.C.panel2, transp = 0 })
			local tmp = Profile.new()
			local idx = Profile.giveMoped(tmp, id, def.color)
			local model = Instance.new("Model")
			Models.moped(model, tmp.mopeds[idx], tmp.items, CFrame.new())
			UI.viewport(card, model, UDim2.fromOffset(160, 100), UDim2.fromOffset(6, 6), { dir = Vector3.new(-1, 0.35, -0.2), zoom = 0.9 })
			UI.text(card, def.n, UDim2.new(1, -180, 0, 24), UDim2.fromOffset(176, 10), { font = UI.BOLD, ts = 16 })
			UI.text(card, UI.kr(def.price), UDim2.new(1, -180, 0, 22), UDim2.fromOffset(176, 36), { ts = 15, color = UI.C.green, font = UI.BOLD })
			UI.button(card, "Köp", UDim2.fromOffset(90, 30), UDim2.fromOffset(176, 70), { kind = "green" }, function() S.api("buyMoped", id) end)
		end
	else
		UI.text(area, "Spara färgerna på alla kåpor som en design och lägg på den igen senare.", UDim2.new(1, 0, 0, 22), nil, { ts = 14, color = UI.C.dim })
		local box = UI.new("TextBox", { Size = UDim2.fromOffset(260, 34), Position = UDim2.fromOffset(0, 30), BackgroundColor3 = UI.C.panel2, Text = "", PlaceholderText = "Namn på designen", TextColor3 = UI.C.text, Font = UI.FONT, TextSize = 15, ClearTextOnFocus = false, Name = "Designnamn" }, area)
		UI.corner(box, 6)
		UI.button(area, "Spara design", UDim2.fromOffset(140, 34), UDim2.fromOffset(270, 30), { kind = "primary" }, function() S.api("saveDesign", box.Text) end)
		local list = UI.scroll(area, UDim2.new(1, 0, 1, -80), UDim2.fromOffset(0, 76))
		UI.list(list, 6)
		for i, d in ipairs(p.designs) do
			local row = UI.panel(list, UDim2.new(1, -8, 0, 46), nil, { color = UI.C.panel2, transp = 0 })
			row.LayoutOrder = i
			UI.text(row, d.n .. "  (" .. MopedDef.MODELS[d.model].n .. ")", UDim2.new(0.5, 0, 1, 0), UDim2.fromOffset(10, 0), { ts = 15, font = UI.BOLD })
			local x = 0
			for pid, pa in pairs(d.panels) do
				local sw = UI.new("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0.5, x, 0.5, -9), BackgroundColor3 = Color3.fromRGB(pa.c[1], pa.c[2], pa.c[3]), BorderSizePixel = 0, Name = pid }, row)
				UI.corner(sw, 9)
				x = x + 22
			end
			local n = 0
			for pid in pairs(d.panels) do if m.slots["pan:" .. pid] then n = n + 1 end end
			UI.button(row, "Lägg på (" .. UI.kr(n * Profile.DESIGN_COST) .. ")", UDim2.fromOffset(170, 32), UDim2.new(1, -178, 0, 7), { kind = "secondary", ts = 14 }, function() S.api("applyDesign", i) end)
		end
		if #p.designs == 0 then UI.text(list, "Inga sparade designer än.", UDim2.new(1, 0, 0, 30), nil, { ts = 14, color = UI.C.dim }) end
	end
end

local function buildStats(b)
	local p = S.profile
	UI.list(b, 8)
	local st = p.stats
	for i, l in ipairs({
		{ "Körda kilometer", string.format("%.1f km", st.km) }, { "Motorer byggda", tostring(st.built) }, { "Cylindrar portade", tostring(st.ported) },
		{ "Kåpor lackerade", tostring(st.painted) }, { "Uppdrag klara", tostring(st.jobs) }, { "Intjänat", UI.kr(st.earned) },
		{ "Mopeder", tostring(#p.mopeds) }, { "Sparning", S.meta.saving and "På" or "Av (Studio utan API-åtkomst)" },
	}) do
		local r = UI.panel(b, UDim2.new(1, 0, 0, 40), nil, { color = UI.C.panel2, transp = 0 })
		r.LayoutOrder = i
		UI.text(r, l[1], UDim2.new(0.6, 0, 1, 0), UDim2.fromOffset(14, 0), { ts = 16 })
		UI.text(r, l[2], UDim2.new(0.4, -14, 1, 0), UDim2.fromScale(0.6, 0), { ts = 16, font = UI.BOLD, xa = Enum.TextXAlignment.Right })
	end
end
local function buildSettings(b)
	UI.list(b, 10)
	local function toggle(order, label, key, onSet)
		local r = UI.panel(b, UDim2.new(1, 0, 0, 48), nil, { color = UI.C.panel2, transp = 0 })
		r.LayoutOrder = order
		UI.text(r, label, UDim2.new(0.7, 0, 1, 0), UDim2.fromOffset(14, 0), { ts = 16 })
		UI.button(r, S.settings[key] and "På" or "Av", UDim2.fromOffset(80, 32), UDim2.new(1, -92, 0, 8), { kind = S.settings[key] and "green" or "secondary", name = key }, function()
			S.settings[key] = not S.settings[key]
			if onSet then onSet(S.settings[key]) end
			refreshWin()
		end)
	end
	toggle(1, "Visa hjälptexter längst ner", "tips", function(on) if not on then tip.Visible = false end end)
	toggle(2, "Visa minikarta när du kör", "minimap")
	UI.text(b, "Tangenter: E använd · F kör ut · W/S gas och broms · A/D styr · Mellanslag kliv av · R tillbaka till garaget · Esc lämna arbetsläge", UDim2.new(1, 0, 0, 60), nil, { ts = 14, color = UI.C.dim, wrap = true, order = 10 })
end

S.open.Event:Connect(function(what)
	if what == "moped" then openWin("Min moppe", buildMoped)
	elseif what == "stats" then openWin("Statistik", buildStats)
	elseif what == "settings" then openWin("Inställningar", buildSettings)
	elseif what == "closeWindows" then closeWin() end
end)

---------------------------------------------------------------- start menu
local menu = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 10, 16), BackgroundTransparency = 0.35, Name = "Startmeny", ZIndex = 20 }, gui)
UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(10, 14, 24), Color3.fromRGB(255, 255, 255)), Transparency = NumberSequence.new(0, 0.85) }, menu)
local logo = UI.text(menu, "MOPPE", UDim2.fromOffset(420, 70), UDim2.fromOffset(60, 70), { font = UI.BLACK, ts = 68, z = 21, name = "Logo1" })
logo.Rotation = -4
local logo2 = UI.text(menu, "MEKANIKER", UDim2.fromOffset(460, 60), UDim2.fromOffset(70, 132), { font = UI.BLACK, ts = 52, z = 21, color = UI.C.accent2, name = "Logo2" })
logo2.Rotation = -4
UI.text(menu, "Bygg, trimma och kör din egen moppe", UDim2.fromOffset(420, 24), UDim2.fromOffset(74, 196), { ts = 16, color = UI.C.dim, z = 21 })
local mlist = UI.new("Frame", { Size = UDim2.fromOffset(240, 300), Position = UDim2.fromOffset(60, 250), BackgroundTransparency = 1, Name = "Knappar", ZIndex = 21 }, menu)
UI.list(mlist, 8)
local function closeMenu() menu.Visible = false end
for i, b in ipairs({ { "Spela", "play" }, { "Garage", "garage" }, { "Butik", "shop" }, { "Statistik", "stats" }, { "Inställningar", "settings" } }) do
	UI.button(mlist, b[1], UDim2.new(1, 0, 0, i == 1 and 52 or 42), nil, { kind = i == 1 and "primary" or "ghost", xa = Enum.TextXAlignment.Left, ts = i == 1 and 22 or 17, order = i, z = 21, transp = i == 1 and 0 or 0.15 }, function()
		closeMenu()
		if b[2] == "shop" or b[2] == "stats" or b[2] == "settings" then S.open:Fire(b[2]) end
	end)
end

---------------------------------------------------------------- visibility
game:GetService("RunService").Heartbeat:Connect(function()
	local g = inGarage() and S.mode == nil and not menu.Visible
	side.Visible = g
	info.Visible = g
	money.Visible = not menu.Visible
end)
S.modeEv.Event:Connect(function(mode) if mode then closeWin() end end)
updateInfo()
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX21"><Properties><string name="Name">Interact</string><ProtectedString name="Source"><![CDATA[-- Walking around the garage: hover a part to see what it is, click to pick it up (it sits in your hand),
-- click a shelf, the bench, the floor, the vise or the paint stand to put it down. Prompts and the side menu
-- open the work modes; the side menu walks you to the station first.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local PPS = game:GetService("ProximityPromptService")
local Shared = RS:WaitForChild("Shared")
local Parts = require(Shared.Parts)
local GarageBuilder = require(Shared.GarageBuilder)
local plr = Players.LocalPlayer
local S = require(script.Parent:WaitForChild("State"))
local mouse = plr:GetMouse()

-- where each station is (garage-local) and which mode it opens
local STATIONS = {
	engine = Vector3.new(9, 3, -2.5), work = Vector3.new(-3, 3, -4), shop = Vector3.new(10.5, 3, 11),
	port = Vector3.new(17.5, 3, 8), paint = Vector3.new(17, 3, -5.5), jobs = Vector3.new(10.5, 3, 11),
}
local PLACE = { shelf = "hylla", bench = "bank", floor = "golv", portbench = "port", booth = "lack" }
local PLACE_TEXT = { hylla = "lägga den på hyllan", bank = "lägga den på arbetsbänken", golv = "ställa den på golvet", port = "spänna fast den i skruvstädet", lack = "hänga den i lackboxen" }

local hl = Instance.new("Highlight")
hl.FillTransparency = 0.75
hl.OutlineColor = Color3.fromRGB(255, 255, 255)
hl.FillColor = Color3.fromRGB(74, 152, 255)
hl.DepthMode = Enum.HighlightDepthMode.Occluded
hl.Enabled = false
hl.Parent = workspace

local function ownerName(inst)
	local plot = inst:FindFirstAncestorWhichIsA("Folder")
	while plot and not plot:GetAttribute("Plot") do plot = plot.Parent and plot.Parent:IsA("Folder") and plot.Parent or nil end
	local id = plot and plot:GetAttribute("OwnerId")
	local owner = id and Players:GetPlayerByUserId(id)
	return owner and owner.DisplayName or "någon annan"
end
-- what is under the mouse: an item model (picked up by click) or a surface to put things on
local function target()
	local t = mouse.Target
	if not t then return nil end
	local m = t
	while m and m ~= workspace do
		if m:IsA("Model") and m:GetAttribute("Item") and not m:GetAttribute("Tool") and not m:GetAttribute("InHand") then return "item", m end
		if m:GetAttribute("Interact") then return "surface", m end
		m = m.Parent
	end
end
local function holding()
	local p = S.profile
	if not p then return nil end
	for id, it in pairs(p.items) do if it.loc == "hand" then return id, it end end
end
local function near(inst, dist)
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	local pos = inst:IsA("Model") and inst:GetPivot().Position or inst.Position
	return root and (root.Position - pos).Magnitude <= (dist or 14)
end

RunService.RenderStepped:Connect(function()
	if S.mode or not S.profile then hl.Enabled = false; return end
	local kind, obj = target()
	local heldId, held = holding()
	if kind == "item" then
		hl.Adornee = obj
		hl.Enabled = true
		local part = Parts.get(obj:GetAttribute("Sku") or "")
		local name = part and part.name or "Del"
		if not S.isMine(obj) then S.tip(name .. " (tillhör " .. ownerName(obj) .. ")")
		elseif held then S.tip("Du bär redan " .. Parts.get(held.sku).name .. ". Lägg ner den först.")
		elseif not near(obj) then S.tip(name .. " – gå närmare")
		else S.tip("Klicka för att plocka upp " .. name) end
	elseif kind == "surface" and held and S.isMine(obj) then
		local loc = PLACE[obj:GetAttribute("Interact")]
		if loc then
			hl.Adornee = obj
			hl.Enabled = true
			S.tip("Klicka för att " .. PLACE_TEXT[loc] .. " (" .. Parts.get(held.sku).name .. ")")
		else
			hl.Enabled = false
			S.tip("Du bär " .. Parts.get(held.sku).name .. ". Klicka på hyllan, bänken eller golvet för att lägga ner den.")
		end
	else
		hl.Enabled = false
		if held then S.tip("Du bär " .. Parts.get(held.sku).name .. ". Klicka på hyllan, bänken eller golvet för att lägga ner den.")
		else S.tip(nil) end
	end
end)

UIS.InputBegan:Connect(function(input, gp)
	if gp or S.mode or not S.profile then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	local kind, obj = target()
	if not kind or not S.isMine(obj) then return end
	if kind == "item" and not holding() then
		if near(obj) then S.api("pickup", obj:GetAttribute("Item")) else S.toast("Gå närmare", "info") end
	elseif kind == "surface" and holding() then
		local loc = PLACE[obj:GetAttribute("Interact")]
		if loc then
			if near(obj, 18) then S.api("place", loc) else S.toast("Gå närmare", "info") end
		end
	end
end)

-- prompts: the work modes open on the client after an ownership check
PPS.PromptTriggered:Connect(function(pp)
	local action = pp:GetAttribute("Action")
	local plotI = pp:GetAttribute("Plot")
	if not action or action == "openBox" or action == "ride" or action == "mount" then return end
	if plotI and plotI ~= S.meta.plot then
		S.toast("Det här är " .. ownerName(pp) .. "s garage. Du kan titta men inte jobba här.", "info")
		return
	end
	S.open:Fire(action, true)
end)

-- side menu / buttons: walk to the station, then open
S.open.Event:Connect(function(what, atStation)
	if what == "ride" then
		if S.mode then return end
		S.walkTo(Vector3.new(-2, 3, -4), function() S.api("ride") end, 12)
		return
	end
	local st = STATIONS[what]
	if st and not atStation and not S.mode then
		S.walkTo(st, function() S.open:Fire(what, true) end, 7)
	end
end)

-- escape always leaves a work mode
UIS.InputBegan:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Escape and S.mode then S.endMode() end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX22"><Properties><string name="Name">Paint</string><ProtectedString name="Source"><![CDATA[-- Paint booth: the panel hangs on the stand (shown enlarged). Pick a colour (library, RGB sliders or HEX),
-- a finish and the gloss, then hold the left button and spray with the gun in your hand. Coverage builds up
-- where you spray; too much in one place makes runs. Mouse wheel moves the gun closer or further away.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("Shared")
local Parts = require(Shared.Parts)
local Paint = require(Shared.Paint)
local Models = require(Shared.Models)
local GarageBuilder = require(Shared.GarageBuilder)
local plr = Players.LocalPlayer
local S = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UIKit"))

local gui = UI.screen("Lackering", 10, plr)
gui.Enabled = false
local L = { color = { 200, 22, 30 }, finish = "blank", gloss = 0.7, dist = 1.0, spraying = false, state = nil, t = 0, even = 0 }

---------------------------------------------------------------- UI
local info = UI.panel(gui, UDim2.fromOffset(480, 40), UDim2.fromOffset(12, 8), { name = "Info", transp = 0.15 })
UI.text(info, "Håll vänster musknapp och spraya jämnt över kåpan", UDim2.new(1, -20, 1, 0), UDim2.fromOffset(12, 0), { ts = 15, font = UI.BOLD })
local side = UI.panel(gui, UDim2.fromOffset(290, 600), UDim2.new(1, -12, 0, 8), { anchor = Vector2.new(1, 0), name = "Färgpanel" })
UI.pad(side, 12)
UI.text(side, "Färg:", UDim2.new(1, 0, 0, 20), nil, { font = UI.BOLD, ts = 15 })
local swatches = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 24), BackgroundTransparency = 1, Name = "Bibliotek" }, side)
UI.grid(swatches, UDim2.fromOffset(28, 28), UDim2.fromOffset(5, 5))
local preview = UI.new("Frame", { Size = UDim2.fromOffset(60, 60), Position = UDim2.fromOffset(0, 104), BackgroundColor3 = Color3.new(1, 0, 0), BorderSizePixel = 0, Name = "Förhandsvisning" }, side)
UI.corner(preview, 8)
local colorName = UI.text(side, "", UDim2.fromOffset(190, 22), UDim2.fromOffset(70, 104), { ts = 14, font = UI.BOLD, name = "Färgnamn" })
local hex = UI.new("TextBox", { Size = UDim2.fromOffset(110, 30), Position = UDim2.fromOffset(70, 130), BackgroundColor3 = UI.C.panel2, TextColor3 = UI.C.text, Font = UI.FONT, TextSize = 15, ClearTextOnFocus = false, Text = "", Name = "HEX" }, side)
UI.corner(hex, 6)
UI.text(side, "HEX", UDim2.fromOffset(40, 30), UDim2.fromOffset(186, 130), { ts = 13, color = UI.C.dim })
local sliders = {}
local function slider(y, label, color, get, set)
	UI.text(side, label, UDim2.fromOffset(20, 22), UDim2.fromOffset(0, y), { ts = 14, font = UI.BOLD })
	local bar = UI.new("Frame", { Size = UDim2.fromOffset(190, 10), Position = UDim2.fromOffset(26, y + 6), BackgroundColor3 = color, BorderSizePixel = 0, Name = label .. "Reglage" }, side)
	UI.corner(bar, 5)
	local knob = UI.new("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Name = "Knopp" }, bar)
	UI.corner(knob, 8)
	local val = UI.text(side, "", UDim2.fromOffset(46, 22), UDim2.fromOffset(222, y), { ts = 13, xa = Enum.TextXAlignment.Right })
	local s = { bar = bar, knob = knob, val = val, get = get, set = set }
	bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then s.drag = true end end)
	sliders[#sliders + 1] = s
	return s
end
local function hexOf(c) return Paint.hex(c) end
slider(172, "R", Color3.fromRGB(200, 50, 50), function() return L.color[1] / 255 end, function(v) L.color[1] = math.floor(v * 255 + 0.5) end)
slider(198, "G", Color3.fromRGB(50, 170, 70), function() return L.color[2] / 255 end, function(v) L.color[2] = math.floor(v * 255 + 0.5) end)
slider(224, "B", Color3.fromRGB(50, 90, 210), function() return L.color[3] / 255 end, function(v) L.color[3] = math.floor(v * 255 + 0.5) end)
UI.text(side, "Lacktyp:", UDim2.new(1, 0, 0, 20), UDim2.fromOffset(0, 256), { font = UI.BOLD, ts = 15 })
local finishes = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 280), BackgroundTransparency = 1, Name = "Lacktyper" }, side)
UI.grid(finishes, UDim2.fromOffset(84, 30), UDim2.fromOffset(4, 4))
UI.text(side, "Glans:", UDim2.fromOffset(60, 22), UDim2.fromOffset(0, 352), { font = UI.BOLD, ts = 15 })
local glossSlider = slider(376, "", Color3.fromRGB(120, 130, 150), function() return L.gloss end, function(v) L.gloss = v end)
local statText = UI.text(side, "", UDim2.new(1, 0, 0, 90), UDim2.fromOffset(0, 404), { ts = 14, wrap = true, rich = true, ya = Enum.TextYAlignment.Top, name = "Resultat" })
local distText = UI.text(side, "", UDim2.new(1, 0, 0, 20), UDim2.fromOffset(0, 494), { ts = 13, color = UI.C.dim, name = "Avstånd" })
local buttons = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 530), BackgroundTransparency = 1, Name = "Knappar" }, side)
UI.list(buttons, 6, true)
local picker = UI.panel(gui, UDim2.fromOffset(420, 320), UDim2.fromScale(0.5, 0.5), { anchor = Vector2.new(0.5, 0.5), name = "Välj", visible = false })

local function refreshColor()
	local c = Color3.fromRGB(L.color[1], L.color[2], L.color[3])
	preview.BackgroundColor3 = c
	local name = "Egen färg"
	for _, e in ipairs(Paint.LIBRARY) do if e.c[1] == L.color[1] and e.c[2] == L.color[2] and e.c[3] == L.color[3] then name = e.n end end
	colorName.Text = name
	if not hex:IsFocused() then hex.Text = hexOf(L.color) end
	for _, s in ipairs(sliders) do
		local v = s.get()
		s.knob.Position = UDim2.fromScale(v, 0.5)
		s.val.Text = s == glossSlider and string.format("%d %%", math.floor(v * 100)) or tostring(math.floor(v * 255 + 0.5))
	end
	UI.clear(finishes)
	for i, f in ipairs(Paint.FINISH) do
		UI.button(finishes, f.n, UDim2.fromOffset(84, 30), nil, { kind = L.finish == f.id and "primary" or "secondary", ts = 13, order = i, name = f.id }, function() L.finish = f.id; refreshColor() end)
	end
	if L.cells then for _, p in pairs(L.cells) do p.Color = c end end
end
for i, e in ipairs(Paint.LIBRARY) do
	local b = UI.new("TextButton", { Size = UDim2.fromOffset(28, 28), BackgroundColor3 = Color3.fromRGB(e.c[1], e.c[2], e.c[3]), Text = "", LayoutOrder = i, Name = e.n, AutoButtonColor = true }, swatches)
	UI.corner(b, 6)
	UI.stroke(b, UI.C.line, 1, 0.3)
	b.Activated:Connect(function() L.color = { e.c[1], e.c[2], e.c[3] }; refreshColor() end)
end
hex.FocusLost:Connect(function()
	local c = Paint.validHex(hex.Text)
	if c then L.color = c else S.toast("Skriv HEX som #RRGGBB", "error") end
	refreshColor()
end)

---------------------------------------------------------------- scene: enlarged panel, coverage cells, gun and hand
local scene = Instance.new("Model")
scene.Name = "LackLokal"
local function boothCF() return S.origin() * GarageBuilder.BOOTH * CFrame.new(0, 1.6, 0) end
local frame -- face frame: LookVector points from the panel towards the camera
local function buildScene(id)
	scene:ClearAllChildren()
	scene.Parent = workspace -- must be in the world before raycasting against the panel
	local it = S.item(id)
	-- hide the real part on the stand while the enlarged one is shown
	local plot = S.plot()
	L.hidden = {}
	if plot then
		for _, d in ipairs(plot:GetDescendants()) do
			if d:IsA("Model") and d:GetAttribute("Item") == id then
				for _, q in ipairs(d:GetDescendants()) do if q:IsA("BasePart") then q.LocalTransparencyModifier = 1; L.hidden[#L.hidden + 1] = q end end
			end
		end
	end
	local model = Models.item(it.sku, nil) -- unpainted (primer)
	if model.PrimaryPart then model.PrimaryPart:Destroy() end -- the invisible handle must not catch the paint rays
	model:ScaleTo(2.2)
	-- turn the panel so its broad side faces the booth opening (+Z)
	local _, size0 = model:GetBoundingBox()
	local turn = size0.X < size0.Z and CFrame.Angles(0, math.rad(-90), 0) or CFrame.new()
	model:PivotTo(boothCF() * turn)
	for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") then d.Color = Color3.fromRGB(160, 162, 166); d.Material = Enum.Material.SmoothPlastic end end
	model.Parent = scene
	L.panelModel = model
	local cf, size = model:GetBoundingBox()
	local w, h, depth = size.X, size.Y, size.Z
	local worldNormal = Vector3.new(0, 0, 1)
	frame = CFrame.lookAt(cf.Position + worldNormal * (depth / 2 + 0.06), cf.Position + worldNormal * 5)
	L.w, L.h = math.max(w, 1), math.max(h, 1)
	-- coverage cells only where the panel is behind them
	L.cells = {}
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { model }
	local mk = Models.maker(scene)
	for row = 1, Paint.ROWS do
		for col = 1, Paint.COLS do
			local x = -L.w / 2 + (col - 0.5) * L.w / Paint.COLS
			local y = L.h / 2 - (row - 0.5) * L.h / Paint.ROWS
			local p0 = frame * Vector3.new(x, y, 0)
			local hit = workspace:Raycast(p0 + frame.LookVector * 1, -frame.LookVector * (depth + 2), params)
			if hit then
				local p = mk.box("Lack", Vector3.new(L.w / Paint.COLS * 1.02, L.h / Paint.ROWS * 1.02, 0.03), CFrame.new(hit.Position + hit.Normal * 0.03) * frame.Rotation, Color3.fromRGB(L.color[1], L.color[2], L.color[3]), Enum.Material.SmoothPlastic)
				p.Transparency = 1
				p.CanQuery = false
				L.cells[(row - 1) * Paint.COLS + col] = p
			end
		end
	end
	-- cells with no panel behind them count as painted so they do not lower the coverage
	L.state = Paint.new()
	for i = 1, Paint.COLS * Paint.ROWS do if not L.cells[i] then L.state.cells[i] = 1 end end
	-- gun and hand rig
	local hand = Models.hand(scene, CFrame.new(), true)
	L.handRig = {}
	for _, d in ipairs(hand:GetDescendants()) do if d:IsA("BasePart") then d.CanQuery = false; L.handRig[#L.handRig + 1] = { d, d.CFrame } end end
	local gun = Instance.new("Model")
	gun.Name = "Sprutpistol"
	gun.Parent = scene
	Models.tool(gun, "spruta", CFrame.new(), L.even > 0.5)
	L.gunRig = {}
	for _, d in ipairs(gun:GetDescendants()) do if d:IsA("BasePart") then d.CanQuery = false; L.gunRig[#L.gunRig + 1] = { d, d.CFrame } end end
	local nozzle = mk.box("Munstycke", Vector3.new(0.05, 0.05, 0.05), CFrame.new(), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	nozzle.Transparency = 1
	local att = Instance.new("Attachment")
	att.Parent = nozzle
	L.mist = Instance.new("ParticleEmitter")
	L.mist.Rate = 0
	L.mist.Lifetime = NumberRange.new(0.3, 0.6)
	L.mist.Speed = NumberRange.new(8, 10)
	L.mist.SpreadAngle = Vector2.new(12, 12)
	L.mist.Size = NumberSequence.new(0.15, 0.9)
	L.mist.Transparency = NumberSequence.new(0.4, 1)
	L.mist.Parent = att
	L.nozzle = nozzle
	scene.Parent = workspace
	S.camTo(CFrame.lookAt(frame.Position + frame.LookVector * 4.6 + Vector3.new(0, 0.4, 0), frame.Position), 62, 0.4)
end
local function paintCells()
	for i, p in pairs(L.cells) do
		local x = L.state.cells[i]
		p.Transparency = 1 - math.clamp(x, 0, 1) * 0.92
		p.Color = Color3.fromRGB(L.color[1], L.color[2], L.color[3])
		if x > 1.8 then p.Color = p.Color:Lerp(Color3.new(0, 0, 0), 0.35) end
		local fin = Paint.FIN[L.finish]
		p.Material = Enum.Material[fin.mat]
		p.Reflectance = fin.refl[1] + (fin.refl[2] - fin.refl[1]) * L.gloss
	end
end
local function refreshStats()
	local r = Paint.result(L.state)
	local col = r.q >= 0.75 and "#2ECC71" or (r.q >= 0.5 and "#F1C40F" or "#E74C3C")
	statText.Text = string.format('Täckning: <b>%d %%</b>\nJämnhet: <b>%d %%</b>\nRinningar: <b>%d</b>\nKvalitet: <font color="%s"><b>%s</b></font>', math.floor(r.cover * 100), math.floor(r.even * 100), math.floor(r.runs * Paint.COLS * Paint.ROWS + 0.5), col, r.label)
	distText.Text = string.format("Avstånd: %s (rullhjul)", L.dist < 0.85 and "nära" or (L.dist > 1.2 and "långt" or "lagom"))
end
local function buildButtons()
	UI.clear(buttons)
	UI.button(buttons, "Klar", UDim2.fromOffset(84, 36), nil, { kind = "green", order = 1 }, function()
		if L.t < 3 then S.toast("Spraya kåpan först", "error"); return end
		local ok, r = S.api("paintDone", L.color, L.finish, L.gloss, L.state)
		if ok then
			S.toast(string.format("Lackerat: %s (%d %%). Lacken torkar i 20 sekunder.", r.label, math.floor(r.q * 100)), "ok")
			S.endMode("paint")
		end
	end)
	UI.button(buttons, "Börja om", UDim2.fromOffset(90, 36), nil, { kind = "secondary", order = 2 }, function()
		local s2 = Paint.new()
		for i = 1, Paint.COLS * Paint.ROWS do if not L.cells[i] then s2.cells[i] = 1 end end
		L.state = s2
		paintCells()
		refreshStats()
	end)
	UI.button(buttons, "Avbryt", UDim2.fromOffset(84, 36), nil, { kind = "danger", order = 3 }, function() S.endMode("paint") end)
end

---------------------------------------------------------------- open / close
local function begin()
	local ok, inf = S.api("paintStart")
	if not ok then return false end
	L.even = inf.even or 0
	L.t = 0
	buildScene(inf.item)
	side.Visible, info.Visible = true, true
	refreshColor()
	buildButtons()
	paintCells()
	refreshStats()
	return true
end
local function showPicker()
	UI.clear(picker)
	UI.pad(picker, 12)
	UI.list(picker, 6)
	UI.text(picker, "Häng en kåpa i lackboxen", UDim2.new(1, 0, 0, 26), nil, { font = UI.BOLD, ts = 16, order = 0 })
	local n = 0
	for id, it in pairs(S.profile.items) do
		local part = Parts.get(it.sku)
		if part.kind == "kapa" and (it.loc == "hylla" or it.loc == "bank" or it.loc == "golv" or it.loc == "hand" or it.loc:sub(1, 4) == "box:") then
			n = n + 1
			UI.button(picker, part.name, UDim2.new(1, 0, 0, 34), nil, { kind = "secondary", order = n, ts = 14 }, function()
				if S.api("moveTo", id, "lack") then picker.Visible = false; begin() end
			end)
		end
	end
	if n == 0 then UI.text(picker, "Du har ingen lös kåpa. Gå till mopeden, klicka på en kåpa och välj Lackera, eller beställ en kåpa.", UDim2.new(1, 0, 0, 60), nil, { ts = 14, wrap = true, color = UI.C.dim, order = 1 }) end
	UI.button(picker, "Avbryt", UDim2.new(1, 0, 0, 36), nil, { kind = "danger", order = 99 }, function() S.endMode("paint") end)
	picker.Visible = true
end
local function open()
	if not S.setMode("paint") then return end
	gui.Enabled = true
	side.Visible, info.Visible = false, false
	S.camTo(S.origin() * GarageBuilder.BOOTH * CFrame.new(0, 2, -9) * CFrame.Angles(math.rad(-8), math.pi, 0), 50, 0.4)
	local hung
	for _, it in pairs(S.profile.items) do if it.loc == "lack" then hung = true end end
	if not (hung and begin()) then showPicker() end
end
local function close()
	gui.Enabled = false
	picker.Visible = false
	L.spraying = false
	L.cells = nil
	for _, q in ipairs(L.hidden or {}) do if q.Parent then q.LocalTransparencyModifier = 0 end end
	L.hidden = nil
	scene:ClearAllChildren()
	scene.Parent = nil
end
S.open.Event:Connect(function(what, atStation) if what == "paint" and atStation then open() end end)
S.modeEv.Event:Connect(function(mode) if mode ~= "paint" and gui.Enabled then close() end end)

---------------------------------------------------------------- input and spraying
UIS.InputBegan:Connect(function(input, gp)
	if S.mode ~= "paint" or not L.state then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not gp then L.spraying = true end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		L.spraying = false
		for _, s in ipairs(sliders) do s.drag = false end
	end
end)
UIS.InputChanged:Connect(function(input)
	if S.mode ~= "paint" then return end
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		L.dist = math.clamp(L.dist - input.Position.Z * 0.1, 0.6, 1.6)
		refreshStats()
	elseif input.UserInputType == Enum.UserInputType.MouseMovement then
		for _, s in ipairs(sliders) do
			if s.drag then
				local m = UIS:GetMouseLocation()
				s.set(math.clamp((m.X - s.bar.AbsolutePosition.X) / s.bar.AbsoluteSize.X, 0, 1))
				refreshColor()
				paintCells()
			end
		end
	end
end)
local acc = 0
RunService.RenderStepped:Connect(function(dt)
	if S.mode ~= "paint" or not L.state or not frame or not L.handRig then return end
	local cam = workspace.CurrentCamera
	local m = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(m.X, m.Y)
	local n = frame.LookVector
	local denom = ray.Direction:Dot(n)
	if math.abs(denom) < 1e-4 then return end
	local hit = ray.Origin + ray.Direction * ((frame.Position - ray.Origin):Dot(n) / denom)
	-- the gun hovers in front of the panel at the chosen distance, nozzle aimed at the point
	local gunPos = hit + n * (1.2 + 1.6 * L.dist) + frame.UpVector * 0.25
	local gunCF = CFrame.lookAt(gunPos, hit)
	for _, r in ipairs(L.gunRig) do r[1].CFrame = gunCF * r[2] end
	local handCF = gunCF * CFrame.new(0.05, -0.45, 0.25) * CFrame.Angles(math.rad(-70), 0, 0)
	for _, r in ipairs(L.handRig) do r[1].CFrame = handCF * r[2] end
	L.nozzle.CFrame = gunCF * CFrame.new(0, 0.03, -0.32)
	L.mist.Color = ColorSequence.new(Color3.fromRGB(L.color[1], L.color[2], L.color[3]))
	L.mist.Rate = L.spraying and 90 or 0
	if L.spraying then
		local l = frame:PointToObjectSpace(hit)
		local u, v = (l.X + L.w / 2) / L.w, (L.h / 2 - l.Y) / L.h
		if u > -0.15 and u < 1.15 and v > -0.15 and v < 1.15 then Paint.spray(L.state, u, v, dt, L.dist, L.even) else L.state.t = L.state.t + dt end
		L.t = L.t + dt
		acc = acc + dt
		if acc > 0.08 then acc = 0; paintCells(); refreshStats() end
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX23"><Properties><string name="Name">Porting</string><ProtectedString name="Source"><![CDATA[-- Cylinder porting in first person: the cylinder sits in the vise (shown enlarged), the four port windows glow
-- where material should come off, and your hand holds the die grinder at the mouse. Hold the left button to
-- grind. Cells fade from glowing blue to polished metal when done, and turn red if you go too deep.
-- A shaky hand (cheap grinder) makes it harder; training mode lets you practise without a cylinder.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = RS:WaitForChild("Shared")
local Parts = require(Shared.Parts)
local Porting = require(Shared.Porting)
local Models = require(Shared.Models)
local GarageBuilder = require(Shared.GarageBuilder)
local plr = Players.LocalPlayer
local S = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UIKit"))

local gui = UI.screen("Portning", 10, plr)
gui.Enabled = false
local P = { state = nil, zone = 1, training = false, steady = 0, speed = 1, grinding = false, t = 0 }
local SIZE = 3.2 -- the enlarged cylinder block
local FACES = { front = 0, right = 90, back = 180, left = 270 } -- rotation so the face looks at the camera

---------------------------------------------------------------- UI
local topInfo = UI.panel(gui, UDim2.fromOffset(470, 40), UDim2.fromOffset(12, 8), { name = "Info", transp = 0.15 })
UI.text(topInfo, "Porta de markerade områdena för bästa prestanda!", UDim2.new(1, -20, 1, 0), UDim2.fromOffset(12, 0), { ts = 15, font = UI.BOLD })
local zones = UI.panel(gui, UDim2.fromOffset(250, 250), UDim2.new(1, -12, 0, 8), { anchor = Vector2.new(1, 0), name = "Zoner" })
UI.pad(zones, 10)
UI.list(zones, 4)
local stats = UI.panel(gui, UDim2.fromOffset(250, 190), UDim2.new(1, -12, 0, 266), { anchor = Vector2.new(1, 0), name = "Resultat" })
UI.pad(stats, 12)
UI.text(stats, "Framsteg", UDim2.new(1, 0, 0, 22), nil, { font = UI.BOLD, ts = 17, xa = Enum.TextXAlignment.Center })
local progText = UI.text(stats, "0 %", UDim2.new(1, 0, 0, 26), UDim2.fromOffset(0, 22), { font = UI.BLACK, ts = 24, xa = Enum.TextXAlignment.Center, name = "Procent" })
local _, progFill = UI.bar(stats, UDim2.new(1, 0, 0, 10), UDim2.fromOffset(0, 52), 0, UI.C.accent2)
local evenRow = UI.text(stats, "", UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 72), { ts = 15, name = "Jämnhet" })
local precRow = UI.text(stats, "", UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 96), { ts = 15, name = "Precision" })
local overRow = UI.text(stats, "", UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 120), { ts = 15, name = "Överportat" })
local qualRow = UI.text(stats, "", UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 144), { ts = 16, font = UI.BOLD, name = "Kvalitet", rich = true })
local buttons = UI.new("Frame", { Size = UDim2.fromOffset(700, 44), Position = UDim2.new(0.5, 0, 1, -12), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Name = "Knappar" }, gui)
UI.list(buttons, 8, true, Enum.HorizontalAlignment.Center)
local hint = UI.panel(gui, UDim2.fromOffset(380, 56), UDim2.new(1, -12, 1, -64), { anchor = Vector2.new(1, 1), name = "Tips", transp = 0.2 })
UI.text(hint, "Håll vänster musknapp för att slipa. A/D eller zonlistan byter port.", UDim2.new(1, -20, 1, 0), UDim2.fromOffset(12, 0), { ts = 13, wrap = true })
local picker = UI.panel(gui, UDim2.fromOffset(420, 300), UDim2.fromScale(0.5, 0.5), { anchor = Vector2.new(0.5, 0.5), name = "Välj", visible = false })

---------------------------------------------------------------- the enlarged cylinder, cells, hand and grinder
local scene = Instance.new("Model")
scene.Name = "PortningLokal"
local cells = {} -- zoneId -> { part per cell }
local block, hand, tool, sparks
local function baseCF() return S.origin() * GarageBuilder.PORT * CFrame.new(0, 1.9, 0) end
local function faceCF(face)
	-- outward face frame: LookVector points out of the face
	return baseCF() * CFrame.Angles(0, math.rad(FACES[face]), 0) * CFrame.new(0, 0, -SIZE / 2)
end
local function buildScene(sku)
	scene:ClearAllChildren()
	cells = {}
	local mk = Models.maker(scene)
	local part = Parts.get(sku or "cylinder_origo50")
	local lvl = part and part.stats.lvl or 0
	local col = (lvl == 0 and Color3.fromRGB(128, 131, 137)) or (lvl == 1 and Color3.fromRGB(70, 72, 78)) or Color3.fromRGB(176, 180, 186)
	block = mk.box("Cylinderblock", Vector3.new(SIZE, SIZE * 0.9, SIZE), baseCF(), col, Enum.Material.Metal)
	for i = 0, 3 do mk.box("Fläns", Vector3.new(SIZE + 0.9, 0.12, SIZE + 0.9), baseCF() * CFrame.new(0, SIZE * 0.45 + 0.1 + i * 0.28, 0), col, Enum.Material.Metal) end
	mk.cyl("Lopp", 0.06, SIZE * 0.34, baseCF() * CFrame.new(0, SIZE * 0.45 + 0.02, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(60, 60, 64), Enum.Material.Metal)
	for _, z in ipairs(Porting.ZONES) do
		local f = faceCF(z.face)
		local w, h = z.w * SIZE * 1.3, z.h * SIZE * 1.3
		mk.box("Port", Vector3.new(w + 0.1, h + 0.1, 0.05), f * CFrame.new(0, 0, -0.02), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic)
		cells[z.id] = {}
		for row = 1, Porting.ROWS do
			for c = 1, Porting.COLS do
				local cw, ch = w / Porting.COLS, h / Porting.ROWS
				local p = mk.box("Cell", Vector3.new(cw * 0.92, ch * 0.9, 0.04), f * CFrame.new(-w / 2 + (c - 0.5) * cw, h / 2 - (row - 0.5) * ch, -0.06), Color3.fromRGB(70, 170, 255), Enum.Material.Neon)
				p.CastShadow = false
				cells[z.id][(row - 1) * Porting.COLS + c] = p
			end
		end
	end
	-- hand and die grinder: anchored parts moved every frame from stored offsets (no welds, no physics)
	hand = Models.hand(scene, CFrame.new(), false)
	P.handRig = {}
	for _, d in ipairs(hand:GetDescendants()) do if d:IsA("BasePart") then d.CanQuery = false; d.CastShadow = false; P.handRig[#P.handRig + 1] = { d, d.CFrame } end end
	tool = Instance.new("Model")
	tool.Name = "Slipmaskin"
	tool.Parent = scene
	Models.tool(tool, "slip", CFrame.new(), P.speed > 1.1)
	P.toolRig = {}
	for _, d in ipairs(tool:GetDescendants()) do if d:IsA("BasePart") then d.CanQuery = false; P.toolRig[#P.toolRig + 1] = { d, d.CFrame } end end
	local tipPart = mk.box("Spets", Vector3.new(0.05, 0.05, 0.05), CFrame.new(), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	tipPart.Transparency = 1
	tipPart.CanQuery = false
	P.tip = tipPart
	local att = Instance.new("Attachment")
	att.Parent = tipPart
	sparks = Instance.new("ParticleEmitter")
	sparks.Rate = 0
	sparks.Lifetime = NumberRange.new(0.15, 0.4)
	sparks.Speed = NumberRange.new(6, 12)
	sparks.SpreadAngle = Vector2.new(40, 40)
	sparks.Size = NumberSequence.new(0.06, 0.01)
	sparks.LightEmission = 1
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 120, 40))
	sparks.Parent = att
	scene.Parent = workspace
end
local function cellColor(d)
	if d > Porting.OVER then return Color3.fromRGB(230, 60, 50), Enum.Material.Neon, 0 end
	if d >= Porting.TARGET then return Color3.fromRGB(205, 210, 216), Enum.Material.Metal, 0 end
	local glow = Color3.fromRGB(70, 170, 255):Lerp(Color3.fromRGB(150, 155, 162), d)
	return glow, d > 0.85 and Enum.Material.Metal or Enum.Material.Neon, 0
end
local function paintCells()
	for zid, list in pairs(cells) do
		local depths = P.state.cells[zid]
		for i, p in ipairs(list) do
			local c, m = cellColor(depths[i])
			p.Color = c
			p.Material = m
		end
	end
end

---------------------------------------------------------------- UI updates
local function zoneDone(z) return Porting.zoneProgress(P.state, z.id) >= 0.97 end
local function refreshUI()
	UI.clear(zones)
	UI.text(zones, P.training and "Träningsläge" or "Arbetsmoment", UDim2.new(1, 0, 0, 24), nil, { font = UI.BOLD, ts = 16, order = 0 })
	for i, z in ipairs(Porting.ZONES) do
		local row = UI.check(zones, z.n, zoneDone(z), i, i == P.zone)
		local b = UI.new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Name = "Välj" }, row)
		b.Activated:Connect(function() P.setZone(i) end)
	end
	local res = Porting.result(P.state)
	UI.check(zones, "Jämn finish", res.even > 0.75 and res.cover > 0.9, 10, false)
	UI.clear(buttons)
	UI.button(buttons, "Klar", UDim2.fromOffset(140, 40), nil, { kind = "green", order = 1 }, function() P.finish() end)
	UI.button(buttons, P.training and "Avsluta träning" or "Träningsläge", UDim2.fromOffset(170, 40), nil, { kind = "secondary", order = 2 }, function() P.toggleTraining() end)
	UI.button(buttons, "Avbryt", UDim2.fromOffset(120, 40), nil, { kind = "danger", order = 3 }, function() S.endMode("port") end)
end
local function refreshStats()
	local res = Porting.result(P.state)
	local prog = Porting.progress(P.state)
	progText.Text = string.format("%d %%", math.floor(prog * 100))
	progFill.Size = UDim2.fromScale(prog, 1)
	local function mark(ok) return ok and "  ✓" or "" end
	evenRow.Text = string.format("Jämnhet: %d %%%s", math.floor(res.even * 100), mark(res.even > 0.75))
	precRow.Text = string.format("Precision: %d %%%s", math.floor(res.precision * 100), mark(res.precision > 0.85))
	overRow.Text = string.format("Överportat: %d %%", math.floor(res.over * 100))
	overRow.TextColor3 = res.over > 0 and UI.C.red or UI.C.text
	local col = res.q >= 0.75 and "#2ECC71" or (res.q >= 0.5 and "#F1C40F" or "#E74C3C")
	qualRow.Text = string.format('Kvalitet: <font color="%s">%s (%d %%)</font>', col, res.label, math.floor(res.q * 100))
end
function P.setZone(i)
	P.zone = ((i - 1) % #Porting.ZONES) + 1
	local z = Porting.ZONES[P.zone]
	local f = faceCF(z.face)
	S.camTo(f * CFrame.new(0.6, 0.9, -4.6) * CFrame.Angles(0, math.pi, 0) * CFrame.Angles(math.rad(-10), math.rad(-6), 0), 45, 0.35)
	refreshUI()
end

---------------------------------------------------------------- start, finish
local function freeCylinders()
	local r = {}
	for id, it in pairs(S.profile.items) do
		if Parts.get(it.sku).kind == "cylinder" and not it.port and (it.loc == "hylla" or it.loc == "bank" or it.loc == "golv" or it.loc == "hand" or it.loc:sub(1, 4) == "box:") then r[#r + 1] = id end
	end
	return r
end
local function showPicker()
	UI.clear(picker)
	UI.pad(picker, 12)
	UI.list(picker, 6)
	UI.text(picker, "Spänn fast en cylinder i skruvstädet", UDim2.new(1, 0, 0, 26), nil, { font = UI.BOLD, ts = 16, order = 0 })
	local list = freeCylinders()
	for i, id in ipairs(list) do
		local it = S.item(id)
		UI.button(picker, Parts.get(it.sku).name, UDim2.new(1, 0, 0, 36), nil, { kind = "secondary", order = i, ts = 14 }, function()
			if S.api("moveTo", id, "port") then picker.Visible = false; P.begin() end
		end)
	end
	if #list == 0 then
		UI.text(picker, "Du har ingen oportad cylinder ledig. Lyft ur motorn och ta loss cylindern, eller beställ en. Du kan också öva i träningsläget.", UDim2.new(1, 0, 0, 70), nil, { ts = 14, wrap = true, color = UI.C.dim, order = 1 })
	end
	UI.button(picker, "Träningsläge", UDim2.new(1, 0, 0, 36), nil, { kind = "primary", order = 50 }, function() picker.Visible = false; P.training = true; P.begin() end)
	UI.button(picker, "Avbryt", UDim2.new(1, 0, 0, 36), nil, { kind = "danger", order = 51 }, function() S.endMode("port") end)
	picker.Visible = true
end
function P.begin()
	local sku
	if not P.training then
		local ok, info = S.api("portStart")
		if not ok then showPicker(); return end
		P.steady, P.speed = info.steady or 0, info.speed or 1
		sku = S.item(info.item) and S.item(info.item).sku
	else
		P.steady, P.speed = 0.5, 1
	end
	P.state = Porting.new()
	P.t = 0
	buildScene(sku)
	topInfo.Visible, zones.Visible, stats.Visible, hint.Visible = true, true, true, true
	P.setZone(1)
	refreshStats()
end
function P.toggleTraining()
	P.training = not P.training
	P.begin()
end
function P.finish()
	if P.training then
		local res = Porting.result(P.state)
		S.toast(string.format("Träning klar: %s (%d %%). Testa på riktigt när du har en cylinder.", res.label, math.floor(res.q * 100)), "info")
		S.endMode("port")
		return
	end
	if P.t < 6 then S.toast("Ta det lugnt – portning tar tid. Slipa klart först.", "error"); return end
	local ok, res = S.api("portDone", P.state)
	if ok then
		S.toast(string.format("Portningen klar: %s (%d %%). Effekten syns i Moped Info när cylindern sitter i motorn.", res.label, math.floor(res.q * 100)), res.q >= 0.5 and "ok" or "error")
		S.endMode("port")
	end
end
local function open()
	if not S.setMode("port") then return end
	gui.Enabled = true
	P.training = false
	topInfo.Visible, zones.Visible, stats.Visible, hint.Visible = false, false, false, false
	S.camTo(S.origin() * GarageBuilder.PORT * CFrame.new(0, 3, -7) * CFrame.Angles(math.rad(-20), math.pi, 0), 50, 0.4)
	local onVise
	for _, it in pairs(S.profile.items) do if it.loc == "port" then onVise = true end end
	if onVise then P.begin() else showPicker() end
end
local function close()
	gui.Enabled = false
	picker.Visible = false
	P.grinding = false
	scene:ClearAllChildren()
	scene.Parent = nil
	UIS.MouseIconEnabled = true
end
S.open.Event:Connect(function(what, atStation) if what == "port" and atStation then open() end end)
S.modeEv.Event:Connect(function(mode) if mode ~= "port" and gui.Enabled then close() end end)

---------------------------------------------------------------- input and the grinding loop
UIS.InputBegan:Connect(function(input, gp)
	if S.mode ~= "port" or not P.state then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not gp then P.grinding = true end
	if input.KeyCode == Enum.KeyCode.A then P.setZone(P.zone - 1) elseif input.KeyCode == Enum.KeyCode.D then P.setZone(P.zone + 1) end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then P.grinding = false end
end)
local acc = 0
RunService.RenderStepped:Connect(function(dt)
	if S.mode ~= "port" or not P.state or not hand or not hand.Parent then return end
	local z = Porting.ZONES[P.zone]
	local f = faceCF(z.face)
	local cam = workspace.CurrentCamera
	local m = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(m.X, m.Y)
	-- intersect the face plane
	local n = f.LookVector
	local denom = ray.Direction:Dot(n)
	if math.abs(denom) < 1e-4 then return end
	local hit = ray.Origin + ray.Direction * ((f.Position - ray.Origin):Dot(n) / denom)
	-- shaky hand: noise that the pro grinder mostly removes
	local shake = (1 - P.steady) * 0.07 * (P.grinding and 1 or 0.4)
	local tnow = os.clock()
	local wob = f.RightVector * math.sin(tnow * 23) * shake + f.UpVector * math.cos(tnow * 17) * shake
	local tipPos = hit + wob + n * 0.02
	-- the grinder points into the face from the camera side (tip at local -0.78 X); the hand holds its body
	local back = (n * 2.5 + f.RightVector * 1.1 + f.UpVector * 0.9).Unit
	local up = f.UpVector - back * f.UpVector:Dot(back)
	up = up.Unit
	local toolCF = CFrame.fromMatrix(tipPos + back * 0.78, back, up)
	for _, r in ipairs(P.toolRig) do r[1].CFrame = toolCF * r[2] end
	local grip = toolCF * Vector3.new(0.18, -0.15, 0)
	local sleeve = (back - up * 0.7 + f.RightVector * 0.3).Unit
	local handCF = CFrame.lookAt(grip, grip - sleeve, up)
	if P.grinding then handCF = handCF * CFrame.new(math.sin(tnow * 60) * 0.01, 0, 0) end
	for _, r in ipairs(P.handRig) do r[1].CFrame = handCF * r[2] end
	P.tip.CFrame = CFrame.new(tipPos)
	sparks.Rate = 0
	if P.grinding then
		local l = f:PointToObjectSpace(tipPos)
		local w, h = z.w * SIZE * 1.3, z.h * SIZE * 1.3
		local u, v = (l.X + w / 2) / w, (h / 2 - l.Y) / h
		local inside = Porting.grind(P.state, z.id, u, v, dt, P.speed)
		sparks.Rate = inside and 140 or 40
		P.t = P.t + dt
		acc = acc + dt
		if acc > 0.1 then acc = 0; paintCells(); refreshStats() end
	end
end)
-- refresh the checklist when a zone completes
task.spawn(function()
	while true do
		task.wait(0.5)
		if S.mode == "port" and P.state and gui.Enabled and zones.Visible then refreshUI() end
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX24"><Properties><string name="Name">Ride</string><ProtectedString name="Source"><![CDATA[-- Riding: the client drives its own moped (network owner). Speed comes from Performance (the same model as the
-- numbers in Moped Info), the moped follows the ground with raycasts, stops at walls, leans in curves and the
-- suspension bobs. Engine temperature rises with throttle; too hot wears the piston and can seize it.
-- HUD: speedometer with rpm and temperature, minimap with roads and the delivery target.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("Shared")
local Performance = require(Shared.Performance)
local MopedDef = require(Shared.MopedDef)
local Config = require(Shared.Config)
local Map = require(Shared.Map)
local plr = Players.LocalPlayer
local S = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local RideEv = RS:WaitForChild("Remotes"):WaitForChild("Ride")

local STUD = Config.STUD
local R = { v = 0, yaw = 0, lean = 0, pitch = 0, bob = 0, bobV = 0, temp = 40, rpm = 0, thr = 0, over = 0, cfg = nil, model = nil }

---------------------------------------------------------------- HUD
local gui = UI.screen("Körning", 4, plr)
gui.Enabled = false
local speedo = UI.panel(gui, UDim2.fromOffset(230, 150), UDim2.new(1, -16, 1, -16), { anchor = Vector2.new(1, 1), name = "Hastighet" })
local kmh = UI.text(speedo, "0", UDim2.fromOffset(150, 70), UDim2.fromOffset(16, 8), { font = UI.BLACK, ts = 60, name = "Kmh" })
UI.text(speedo, "KM/H", UDim2.fromOffset(60, 20), UDim2.fromOffset(160, 50), { ts = 14, color = UI.C.dim, font = UI.BOLD })
UI.text(speedo, "Varv", UDim2.fromOffset(60, 18), UDim2.fromOffset(16, 86), { ts = 12, color = UI.C.dim })
local rpmBg, rpmFill = UI.bar(speedo, UDim2.fromOffset(150, 10), UDim2.fromOffset(64, 90), 0, UI.C.accent2)
local rpmText = UI.text(speedo, "", UDim2.fromOffset(60, 18), UDim2.fromOffset(160, 86), { ts = 12, xa = Enum.TextXAlignment.Right })
UI.text(speedo, "Temp", UDim2.fromOffset(60, 18), UDim2.fromOffset(16, 112), { ts = 12, color = UI.C.dim })
local tempBg, tempFill = UI.bar(speedo, UDim2.fromOffset(150, 10), UDim2.fromOffset(64, 116), 0, UI.C.green)
local tempText = UI.text(speedo, "", UDim2.fromOffset(60, 18), UDim2.fromOffset(160, 112), { ts = 12, xa = Enum.TextXAlignment.Right })
local warn = UI.panel(gui, UDim2.fromOffset(420, 40), UDim2.new(0.5, 0, 0, 60), { anchor = Vector2.new(0.5, 0), name = "Varning", color = UI.C.red, transp = 0.1, visible = false })
local warnText = UI.text(warn, "", UDim2.fromScale(1, 1), nil, { ts = 15, font = UI.BOLD, xa = Enum.TextXAlignment.Center })
local help = UI.text(gui, "W gas · S broms · A/D styr · Mellanslag kliv av · R tillbaka till garaget", UDim2.fromOffset(560, 20), UDim2.new(0.5, 0, 1, -14), { anchor = Vector2.new(0.5, 1), ts = 13, color = UI.C.text, xa = Enum.TextXAlignment.Center })
local deliver = UI.button(gui, "Lämna paketet", UDim2.fromOffset(220, 46), UDim2.new(0.5, 0, 1, -60), { kind = "green", anchor = Vector2.new(0.5, 1), name = "Lämna", ts = 18 })
deliver.Visible = false

-- minimap: roads as rotated frames inside a clipped square, the moped in the middle pointing up
local mapFrame = UI.panel(gui, UDim2.fromOffset(200, 200), UDim2.fromOffset(16, 16), { name = "Minikarta", clip = true, color = Color3.fromRGB(70, 100, 60), transp = 0.1 })
local mapInner = UI.new("Frame", { Size = UDim2.fromOffset(0, 0), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Name = "Vägar" }, mapFrame)
local MAP_SCALE = 0.32 -- pixels per stud
for i, r in ipairs(Map.ROADS) do
	local ax, az, bx, bz = r.a[1], r.a[2], r.b[1], r.b[2]
	local len = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
	local f = UI.new("Frame", {
		Size = UDim2.fromOffset(len * MAP_SCALE + r.w * MAP_SCALE, math.max(3, r.w * MAP_SCALE)), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((ax + bx) / 2 * MAP_SCALE, (az + bz) / 2 * MAP_SCALE), Rotation = math.deg(math.atan2(bz - az, bx - ax)),
		BackgroundColor3 = r.track and Color3.fromRGB(200, 120, 60) or Color3.fromRGB(70, 70, 76), BorderSizePixel = 0, Name = "Väg" .. i,
	}, mapInner)
end
local home = UI.new("Frame", { Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = UI.C.accent2, BorderSizePixel = 0, Name = "Hem" }, mapInner)
UI.corner(home, 4)
local pin = UI.new("Frame", { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = UI.C.yellow, BorderSizePixel = 0, Name = "Mål", Visible = false }, mapInner)
UI.corner(pin, 6)
local me = UI.new("TextLabel", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Text = "▲", TextColor3 = Color3.new(1, 1, 1), TextSize = 16, Font = UI.BOLD, Name = "Jag", ZIndex = 3 }, mapFrame)

-- the destination beacon in the world (local only)
local beacon = Instance.new("Part")
beacon.Name = "Leveransmål"
beacon.Anchored = true
beacon.CanCollide = false
beacon.CanQuery = false
beacon.Shape = Enum.PartType.Cylinder
beacon.Size = Vector3.new(60, 10, 10)
beacon.Material = Enum.Material.Neon
beacon.Color = Color3.fromRGB(241, 196, 15)
beacon.Transparency = 0.55

local function activeDelivery()
	local p = S.profile
	if not p then return nil end
	for _, j in ipairs(p.jobs) do if j.type == "leverans" then return j, Map.PLACES[j.dest] end end
end

---------------------------------------------------------------- riding state
local function myRide()
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	local model = seat and seat.Parent
	if model and model:GetAttribute("OwnerId") == plr.UserId and model.PrimaryPart then return model, hum end
end
local function loadCfg()
	local p, m = S.profile, S.moped()
	if p and m and m.engine then R.cfg = Performance.config(p.items, m.engine, m.slots, m.jet or 0) end
end
S.changed.Event:Connect(loadCfg)

local keys = {}
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	keys[input.KeyCode] = true
	if input.KeyCode == Enum.KeyCode.R and not S.mode and myRide() then S.api("home") end
end)
UIS.InputEnded:Connect(function(input) keys[input.KeyCode] = false end)
UIS.WindowFocusReleased:Connect(function() keys = {} end)
local function key(...) for _, k in ipairs({ ... }) do if keys[k] then return true end end return false end

deliver.Activated:Connect(function()
	local j = activeDelivery()
	if j then S.api("completeJob", j.id) end
end)

local overAcc = 0
RunService.Heartbeat:Connect(function(dt)
	local model, hum = myRide()
	if not model then
		if R.model then
			R.model, R.v = nil, 0
			gui.Enabled = false
			beacon.Parent = nil
		end
		-- the delivery pin also helps when walking
		return
	end
	if R.model ~= model then
		R.model = model
		R.v, R.lean, R.pitch, R.bob, R.bobV = 0, 0, 0, 0, 0
		local _, y = model.PrimaryPart.CFrame:ToOrientation()
		R.yaw = y
		loadCfg()
		gui.Enabled = true
		local light = model:FindFirstChild("Strålkastare", true)
		local spot = light and light:FindFirstChildOfClass("SpotLight")
		if spot then spot.Enabled = true end
	end
	local c = R.cfg
	if not c then return end
	dt = math.min(dt, 0.1)
	local root = model.PrimaryPart
	local def = MopedDef.MODELS[model:GetAttribute("Model") or "citi"]
	-- input
	local thr = key(Enum.KeyCode.W, Enum.KeyCode.Up) and 1 or 0
	local brk = key(Enum.KeyCode.S, Enum.KeyCode.Down) and 1 or 0
	local steer = (key(Enum.KeyCode.D, Enum.KeyCode.Right) and 1 or 0) - (key(Enum.KeyCode.A, Enum.KeyCode.Left) and 1 or 0)
	if R.seized then thr = 0 end
	R.thr = R.thr + (thr - R.thr) * math.min(1, dt * 6)
	-- longitudinal (metres per second)
	local force, rpm = Performance.force(c, math.max(0, R.v), R.thr)
	R.rpm = R.thr > 0.05 and rpm or math.max(c.idle, R.rpm - dt * 6000)
	local a = (force - Performance.resist(math.abs(R.v)) * (R.v >= 0 and 1 or -1)) / Performance.MASS
	if brk > 0 then
		if R.v > 0.3 then a = a - 7.5 * c.brake else a = -1.2 end -- slow backing when stopped
	end
	R.v = R.v + a * dt
	if R.v < -1.6 then R.v = -1.6 end
	if thr == 0 and brk == 0 and math.abs(R.v) < 0.15 then R.v = 0 end
	-- steering: tighter at low speed, limited by tyre grip
	local vs = math.abs(R.v)
	local turn = steer * 1.7 * c.handling / (1 + vs * 0.12)
	local maxTurn = (7 * c.grip) / math.max(vs, 1)
	turn = math.clamp(turn, -maxTurn, maxTurn)
	R.yaw = R.yaw - turn * dt * (R.v >= 0 and 1 or -1)
	local targetLean = -steer * math.min(1, vs / 10) * 0.42
	R.lean = R.lean + (targetLean - R.lean) * math.min(1, dt * 5)
	-- move, follow the ground, stop at walls
	local fwd = Vector3.new(-math.sin(R.yaw), 0, -math.cos(R.yaw))
	local step = fwd * (R.v / STUD) * dt
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { model, plr.Character }
	local pos = root.Position
	local groundOffset = def.r
	if step.Magnitude > 1e-4 then
		local wall = workspace:Raycast(pos + Vector3.new(0, 0.6, 0), step + step.Unit * (def.wb / 2 + 0.8), params)
		if wall and wall.Instance.CanCollide and wall.Normal.Y < 0.6 then
			R.v = 0
			step = Vector3.new()
		end
	end
	local newPos = pos + step
	local function groundAt(p)
		local hit = workspace:Raycast(p + Vector3.new(0, 4, 0), Vector3.new(0, -14, 0), params)
		return hit and hit.Position.Y
	end
	local gy = groundAt(newPos)
	local y = gy and (gy + groundOffset) or newPos.Y
	-- pitch from the ground under the wheels
	local gf, gb = groundAt(newPos + fwd * def.wb / 2), groundAt(newPos - fwd * def.wb / 2)
	if gf and gb then R.pitch = R.pitch + (math.atan2(gf - gb, def.wb) - R.pitch) * math.min(1, dt * 8) end
	-- suspension: a spring on the body height
	local target = y
	R.bobV = R.bobV + ((target - (pos.Y + R.bob)) * 80 - R.bobV * 12) * dt
	R.bob = math.clamp(R.bob + R.bobV * dt, -0.3, 0.3)
	local finalY = target + R.bob * 0.4
	local cf = CFrame.new(newPos.X, finalY, newPos.Z) * CFrame.Angles(0, R.yaw, 0) * CFrame.Angles(R.pitch, 0, R.lean)
	root.CFrame = cf
	root.AssemblyLinearVelocity = fwd * (R.v / STUD)
	root.AssemblyAngularVelocity = Vector3.new()
	-- temperature: rises towards the full-throttle value with throttle, cools with speed
	local kmhNow = vs * 3.6
	local hot = Performance.temp(c, kmhNow)
	local targetT = 45 + (hot - 45) * R.thr
	R.temp = R.temp + (targetT - R.temp) * math.min(1, dt / (targetT > R.temp and 14 or 8))
	if R.temp > Performance.TEMP_WARN then
		overAcc = overAcc + dt
		warn.Visible = true
		warnText.Text = R.temp > Performance.TEMP_SEIZE - 8 and "Motorn är på väg att skära! Släpp gasen!" or "Motorn går varm – släpp gasen en stund"
		if overAcc >= 1 then RideEv:FireServer("overheat", overAcc); overAcc = 0 end
	else
		warn.Visible = R.seized == true
		overAcc = 0
	end
	-- seized engine (from the server's wear)
	local p, m = S.profile, S.moped()
	local k = p and m and m.engine and p.items[m.engine.kolv]
	R.seized = k ~= nil and (k.wear or 0) >= 1
	if R.seized then warn.Visible = true; warnText.Text = "Kolvskär! Tryck R för att åka hem och byta kolv." end
	-- smoke
	local smoke = root:FindFirstChild("Rök", true)
	if smoke then smoke.Rate = R.seized and 0 or (4 + 30 * R.thr) end
	-- HUD
	kmh.Text = tostring(math.floor(kmhNow + 0.5))
	rpmFill.Size = UDim2.fromScale(math.clamp(R.rpm / math.max(c.limit, 1), 0, 1), 1)
	rpmFill.BackgroundColor3 = R.rpm >= c.limit - 150 and UI.C.red or UI.C.accent2
	rpmText.Text = tostring(math.floor(R.rpm / 100) * 100)
	tempFill.Size = UDim2.fromScale(math.clamp((R.temp - 20) / (Performance.TEMP_SEIZE - 20), 0, 1), 1)
	tempFill.BackgroundColor3 = R.temp > Performance.TEMP_WARN and UI.C.red or (R.temp > 120 and UI.C.yellow or UI.C.green)
	tempText.Text = string.format("%d °C", math.floor(R.temp))
	-- minimap
	mapFrame.Visible = S.settings.minimap
	-- north-up map centred on the moped; the arrow turns with the heading
	mapInner.Position = UDim2.new(0.5, -newPos.X * MAP_SCALE, 0.5, -newPos.Z * MAP_SCALE)
	me.Rotation = -math.deg(R.yaw)
	local o = S.origin()
	home.Position = UDim2.fromOffset(o.X * MAP_SCALE, o.Z * MAP_SCALE)
	-- delivery job
	local j, pl = activeDelivery()
	if pl then
		pin.Visible = true
		pin.Position = UDim2.fromOffset(pl.x * MAP_SCALE, pl.z * MAP_SCALE)
		beacon.CFrame = CFrame.new(pl.x, 30, pl.z) * CFrame.Angles(0, 0, math.rad(90))
		beacon.Parent = workspace
		local d = (Vector3.new(pl.x, 0, pl.z) - Vector3.new(newPos.X, 0, newPos.Z)).Magnitude
		deliver.Visible = d < Map.DELIVER_RADIUS
	else
		pin.Visible = false
		beacon.Parent = nil
		deliver.Visible = false
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX25"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Moppelagret.se on the garage computer: start page, search, categories, product pictures and pages, stock,
-- cart, orders with delivery countdown, and the job board (Uppdrag).
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("Shared")
local Parts = require(Shared.Parts)
local Models = require(Shared.Models)
local Profile = require(Shared.Profile)
local GarageBuilder = require(Shared.GarageBuilder)
local plr = Players.LocalPlayer
local S = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UIKit"))

local gui = UI.screen("Butik", 12, plr)
gui.Enabled = false
local W = { tab = "butik", cat = nil, search = "", product = nil, cart = {} }

local site = UI.new("Frame", { Size = UDim2.fromOffset(1180, 600), Position = UDim2.new(0.5, 0, 0.5, 4), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(242, 244, 247), BorderSizePixel = 0, Name = "Webbplats" }, gui)
UI.corner(site, 12)
local DARK = Color3.fromRGB(28, 32, 40)
local MUTED = Color3.fromRGB(110, 116, 128)
local WHITE = Color3.fromRGB(255, 255, 255)
local BLUE = UI.C.accent

-- top bar
local bar = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = WHITE, BorderSizePixel = 0, Name = "Toppmeny" }, site)
UI.corner(bar, 12)
UI.new("Frame", { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(16, 13), BackgroundColor3 = BLUE, BorderSizePixel = 0, Name = "Logga" }, bar)
UI.text(bar.Logga, "M", UDim2.fromScale(1, 1), nil, { font = UI.BLACK, ts = 22, xa = Enum.TextXAlignment.Center })
UI.corner(bar.Logga, 6)
UI.text(bar, "Moppelagret.se", UDim2.fromOffset(200, 60), UDim2.fromOffset(58, 0), { font = UI.BLACK, ts = 22, color = DARK, name = "Namn" })
local search = UI.new("TextBox", { Size = UDim2.fromOffset(330, 36), Position = UDim2.fromOffset(250, 12), BackgroundColor3 = Color3.fromRGB(236, 238, 242), Text = "", PlaceholderText = "Sök efter produkter...", TextColor3 = DARK, PlaceholderColor3 = MUTED, Font = UI.FONT, TextSize = 15, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, Name = "Sök" }, bar)
UI.corner(search, 8)
UI.pad(search, 12, 8, 0, 0)
local tabBar = UI.new("Frame", { Size = UDim2.fromOffset(420, 36), Position = UDim2.fromOffset(600, 12), BackgroundTransparency = 1, Name = "Flikar" }, bar)
UI.list(tabBar, 6, true)
UI.button(bar, "X", UDim2.fromOffset(36, 36), UDim2.new(1, -48, 0, 12), { kind = "secondary", name = "Stäng" }, function() S.endMode("shop") end)

local left = UI.new("Frame", { Size = UDim2.fromOffset(170, 520), Position = UDim2.fromOffset(16, 72), BackgroundTransparency = 1, Name = "Kategorier" }, site)
UI.list(left, 2)
local main = UI.new("Frame", { Size = UDim2.fromOffset(700, 520), Position = UDim2.fromOffset(192, 72), BackgroundTransparency = 1, Name = "Mitt" }, site)
local cartPanel = UI.new("Frame", { Size = UDim2.fromOffset(268, 516), Position = UDim2.new(1, -284, 0, 72), BackgroundColor3 = WHITE, BorderSizePixel = 0, Name = "Kundvagn" }, site)
UI.corner(cartPanel, 10)

local function stockText(sku)
	local n = S.meta.stock and S.meta.stock[sku] or (Parts.get(sku).stock)
	if n > 5 then return "I lager", UI.C.green end
	if n > 0 then return "Få kvar (" .. n .. " st)", UI.C.orange end
	return "Beställningsvara (+2 min)", UI.C.red
end
local function cartCount() local n = 0; for _, l in ipairs(W.cart) do n = n + l.qty end return n end
local function addToCart(sku, qty)
	for _, l in ipairs(W.cart) do if l.sku == sku then l.qty = math.min(10, l.qty + (qty or 1)); W.refresh(); return end end
	W.cart[#W.cart + 1] = { sku = sku, qty = qty or 1 }
	S.toast(Parts.get(sku).name .. " ligger i kundvagnen", "ok")
	W.refresh()
end
local function card(parent, part, order)
	local c = UI.new("Frame", { Size = UDim2.fromOffset(164, 236), BackgroundColor3 = WHITE, BorderSizePixel = 0, LayoutOrder = order, Name = part.sku }, parent)
	UI.corner(c, 10)
	local img = UI.viewport(c, Models.item(part.sku), UDim2.fromOffset(148, 110), UDim2.fromOffset(8, 8), { bg = Color3.fromRGB(246, 247, 249) })
	local open = UI.new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Name = "Öppna" }, img)
	open.Activated:Connect(function() W.product = part.sku; W.refresh() end)
	UI.text(c, part.brand, UDim2.fromOffset(148, 16), UDim2.fromOffset(10, 122), { ts = 12, color = MUTED })
	UI.text(c, part.name, UDim2.fromOffset(148, 36), UDim2.fromOffset(10, 138), { ts = 14, font = UI.BOLD, color = DARK, wrap = true, ya = Enum.TextYAlignment.Top })
	local st, col = stockText(part.sku)
	UI.text(c, st, UDim2.fromOffset(148, 14), UDim2.fromOffset(10, 176), { ts = 11, color = col })
	UI.text(c, part.price == 0 and "Ingår" or UI.kr(part.price), UDim2.fromOffset(90, 30), UDim2.fromOffset(10, 196), { ts = 16, font = UI.BOLD, color = DARK })
	if part.price > 0 then UI.button(c, "Köp", UDim2.fromOffset(60, 28), UDim2.fromOffset(96, 198), { kind = "primary", ts = 14 }, function() addToCart(part.sku) end) end
	return c
end
local function matches(part)
	if W.cat and Parts.KINDS[part.kind].cat ~= W.cat then return false end
	local q = W.search:lower()
	if q ~= "" then
		local hay = (part.name .. " " .. part.brand .. " " .. Parts.KINDS[part.kind].n .. " " .. Parts.KINDS[part.kind].cat):lower()
		for word in q:gmatch("%S+") do if not hay:find(word, 1, true) then return false end end
	end
	return true
end

local function buildShop()
	UI.clear(left)
	UI.text(left, "Kategorier", UDim2.new(1, 0, 0, 26), nil, { ts = 13, font = UI.BOLD, color = MUTED, order = 0 })
	local cats = { { nil, "Startsida" } }
	for _, c in ipairs(Parts.CATEGORIES) do cats[#cats + 1] = { c, c } end
	for i, c in ipairs(cats) do
		local b = UI.button(left, c[2], UDim2.new(1, 0, 0, 30), nil, { kind = "ghost", xa = Enum.TextXAlignment.Left, ts = 14, order = i, font = W.cat == c[1] and UI.BOLD or UI.FONT, name = c[2] }, function()
			W.cat, W.product, W.search = c[1], nil, ""
			search.Text = ""
			W.refresh()
		end)
		b.BackgroundColor3 = W.cat == c[1] and Color3.fromRGB(220, 232, 250) or Color3.fromRGB(242, 244, 247)
		b.TextColor3 = W.cat == c[1] and BLUE or DARK
	end
	UI.clear(main)
	if W.product then
		local part = Parts.get(W.product)
		local page = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Name = "Produktsida" }, main)
		UI.corner(page, 10)
		UI.button(page, "< Tillbaka", UDim2.fromOffset(110, 30), UDim2.fromOffset(14, 12), { kind = "secondary", ts = 14 }, function() W.product = nil; W.refresh() end)
		UI.viewport(page, Models.item(part.sku), UDim2.fromOffset(320, 300), UDim2.fromOffset(16, 56), { bg = Color3.fromRGB(246, 247, 249) })
		UI.text(page, part.brand .. " · " .. Parts.KINDS[part.kind].cat, UDim2.fromOffset(340, 20), UDim2.fromOffset(356, 56), { ts = 14, color = MUTED })
		UI.text(page, part.name, UDim2.fromOffset(340, 60), UDim2.fromOffset(356, 78), { ts = 24, font = UI.BOLD, color = DARK, wrap = true, ya = Enum.TextYAlignment.Top })
		UI.text(page, UI.kr(part.price), UDim2.fromOffset(200, 36), UDim2.fromOffset(356, 140), { ts = 26, font = UI.BLACK, color = UI.C.green })
		local st, col = stockText(part.sku)
		UI.text(page, st, UDim2.fromOffset(300, 20), UDim2.fromOffset(356, 178), { ts = 14, font = UI.BOLD, color = col })
		UI.text(page, part.desc, UDim2.fromOffset(330, 70), UDim2.fromOffset(356, 204), { ts = 14, color = DARK, wrap = true, ya = Enum.TextYAlignment.Top })
		-- specs from the stats
		local specs = {}
		local s = part.stats
		if s.cc then specs[#specs + 1] = string.format("Slagvolym %.0f cc, borrning %s mm", s.cc, tostring(s.bore)) end
		if s.bore and not s.cc then specs[#specs + 1] = "Diameter " .. tostring(s.bore) .. " mm" end
		if s.mm then specs[#specs + 1] = "Spjäll " .. tostring(s.mm) .. " mm" end
		if s.gram then specs[#specs + 1] = "Rullvikt " .. tostring(s.gram) .. " g" end
		if s.engage then specs[#specs + 1] = "Inkoppling " .. s.engage .. " rpm" end
		if s.limit then specs[#specs + 1] = s.limit >= 12000 and "Ingen varvspärr" or ("Varvspärr " .. s.limit .. " rpm") end
		if s.stroke then specs[#specs + 1] = "Slaglängd " .. tostring(s.stroke) .. " mm" end
		if s.fits then specs[#specs + 1] = "Passar " .. (require(Shared.MopedDef).MODELS[s.fits].n) end
		if s.range then specs[#specs + 1] = "Värmetal " .. s.range end
		if s.lvl then specs[#specs + 1] = "Nivå: " .. ({ [0] = "Original", [1] = "Sport", [2] = "Racing", [3] = "Racing+" })[s.lvl] end
		UI.text(page, table.concat(specs, "\n"), UDim2.fromOffset(330, 100), UDim2.fromOffset(356, 280), { ts = 13, color = MUTED, wrap = true, ya = Enum.TextYAlignment.Top })
		if part.price > 0 then UI.button(page, "Lägg i varukorg", UDim2.fromOffset(180, 42), UDim2.fromOffset(356, 400), { kind = "green", ts = 16 }, function() addToCart(part.sku) end) end
		return
	end
	local list = UI.scroll(main, UDim2.fromScale(1, 1), nil, { name = "Produkter" })
	UI.grid(list, UDim2.fromOffset(164, 236), UDim2.fromOffset(10, 10))
	local order = 0
	if not W.cat and W.search == "" then
		local banner = UI.new("Frame", { Size = UDim2.fromOffset(164, 236), BackgroundColor3 = BLUE, BorderSizePixel = 0, LayoutOrder = 0, Name = "Erbjudande" }, list)
		UI.corner(banner, 10)
		UI.text(banner, "Trimma din moppe", UDim2.new(1, -20, 0, 60), UDim2.fromOffset(10, 12), { font = UI.BLACK, ts = 20, wrap = true, ya = Enum.TextYAlignment.Top })
		UI.text(banner, "Cylinderkit, förgasare och avgassystem. Fri frakt över 2 000 kr.\n\nLeverans: 1 del ca 1 min, 3–6 delar 3–5 min, större order ca 10 min.", UDim2.new(1, -20, 0, 150), UDim2.fromOffset(10, 76), { ts = 13, wrap = true, ya = Enum.TextYAlignment.Top })
	end
	local FEATURED = { cylinder_nordtrim70 = 1, cylinder_fartek70 = 1, forgasare_gs19 = 1, avgas_fartek = 1, variator_nordtrim = 1, koppling_nordtrim = 1, cdi_snabbo = 1, luftfilter_fartek = 1, reed_fartek = 1, vevaxel_fartek = 1, verktyg_slippro = 1 }
	-- the category's own kind first (cylinders before pistons under "Cylindrar")
	local MAIN = { Cylindrar = "cylinder", ["Förgasare"] = "forgasare", Variatorer = "variator", Kopplingar = "koppling", Vevpartier = "vevaxel", ["Tändsystem"] = "cdi", Insug = "reed", Avgassystem = "avgas", Chassi = "ram" }
	local list2 = {}
	for i, part in ipairs(Parts.LIST) do list2[i] = part end
	if W.cat and MAIN[W.cat] then
		local mainKind = MAIN[W.cat]
		table.sort(list2, function(a, b)
			local ma, mb = a.kind == mainKind, b.kind == mainKind
			if ma ~= mb then return ma end
			return (Parts.LIST_INDEX[a.sku] or 0) < (Parts.LIST_INDEX[b.sku] or 0)
		end)
	end
	for _, part in ipairs(list2) do
		if matches(part) and (W.cat or W.search ~= "" or FEATURED[part.sku]) then
			order = order + 1
			card(list, part, order)
		end
	end
	if order == 0 then UI.text(list, "Inga träffar.", UDim2.fromOffset(300, 40), nil, { ts = 16, color = MUTED }) end
end

local function buildCart()
	UI.clear(cartPanel)
	UI.pad(cartPanel, 12)
	UI.text(cartPanel, "Din beställning", UDim2.new(1, 0, 0, 26), nil, { font = UI.BOLD, ts = 17, color = DARK })
	local lines = UI.scroll(cartPanel, UDim2.new(1, 0, 0, 250), UDim2.fromOffset(0, 32), { name = "Rader" })
	UI.list(lines, 4)
	local sum = 0
	for i, l in ipairs(W.cart) do
		local part = Parts.get(l.sku)
		sum = sum + part.price * l.qty
		local r = UI.new("Frame", { Size = UDim2.new(1, -8, 0, 46), BackgroundColor3 = Color3.fromRGB(246, 247, 249), BorderSizePixel = 0, LayoutOrder = i, Name = l.sku }, lines)
		UI.corner(r, 6)
		UI.text(r, part.name, UDim2.new(1, -90, 0, 20), UDim2.fromOffset(8, 3), { ts = 12, color = DARK, truncate = true })
		UI.text(r, l.qty .. " st · " .. UI.kr(part.price * l.qty), UDim2.new(1, -90, 0, 18), UDim2.fromOffset(8, 23), { ts = 12, color = MUTED })
		UI.button(r, "−", UDim2.fromOffset(24, 24), UDim2.new(1, -82, 0, 11), { kind = "secondary", ts = 14 }, function() l.qty = l.qty - 1; if l.qty <= 0 then table.remove(W.cart, i) end W.refresh() end)
		UI.button(r, "+", UDim2.fromOffset(24, 24), UDim2.new(1, -54, 0, 11), { kind = "secondary", ts = 14 }, function() l.qty = math.min(10, l.qty + 1); W.refresh() end)
		UI.button(r, "X", UDim2.fromOffset(22, 24), UDim2.new(1, -26, 0, 11), { kind = "danger", ts = 12 }, function() table.remove(W.cart, i); W.refresh() end)
	end
	if #W.cart == 0 then UI.text(lines, "Kundvagnen är tom.", UDim2.new(1, 0, 0, 30), nil, { ts = 13, color = MUTED }) end
	local freight = (sum >= 2000 or sum == 0) and 0 or 99
	local function row(y, a, b, bold, color)
		UI.text(cartPanel, a, UDim2.new(0.5, 0, 0, 22), UDim2.fromOffset(0, y), { ts = bold and 17 or 14, color = DARK, font = bold and UI.BOLD or UI.FONT })
		UI.text(cartPanel, b, UDim2.new(0.5, 0, 0, 22), UDim2.new(0.5, 0, 0, y), { ts = bold and 17 or 14, color = color or DARK, font = UI.BOLD, xa = Enum.TextXAlignment.Right })
	end
	row(292, "Delsumma", UI.kr(sum))
	row(316, "Frakt", freight == 0 and "0 kr" or UI.kr(freight))
	row(344, "Totalt", UI.kr(sum + freight), true, UI.C.red)
	local lines2 = {}
	local back = false
	for _, l in ipairs(W.cart) do
		lines2[#lines2 + 1] = { qty = l.qty }
		local n = S.meta.stock and S.meta.stock[l.sku] or 99
		if n < l.qty then back = true; lines2[#lines2].back = true end
	end
	local secs = #W.cart > 0 and Profile.deliverySeconds(lines2) or 0
	local okMoney = S.profile and S.profile.money >= sum + freight
	UI.button(cartPanel, "Beställ", UDim2.new(1, 0, 0, 44), UDim2.fromOffset(0, 380), { kind = (#W.cart > 0 and okMoney) and "primary" or "secondary", ts = 18, name = "Beställ" }, function()
		if #W.cart == 0 then return end
		local cart = {}
		for _, l in ipairs(W.cart) do cart[#cart + 1] = { sku = l.sku, qty = l.qty } end
		local ok, o = S.api("order", cart)
		if ok then
			W.cart = {}
			S.toast("Tack för din beställning! Leverans om " .. UI.time(o.ready - S.now()) .. ".", "ok")
			W.tab = "ordrar"
			W.refresh()
		end
	end)
	UI.text(cartPanel, #W.cart > 0 and ("Beräknad leverans: " .. (secs <= 60 and "ca 1 min" or (secs <= 300 and string.format("ca %d min", math.ceil(secs / 60)) or string.format("ca %d min", math.ceil(secs / 60)))) .. (back and " (beställningsvara)" or "")) or "", UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 430), { ts = 13, color = MUTED, xa = Enum.TextXAlignment.Center })
	if not okMoney and #W.cart > 0 then UI.text(cartPanel, "Du har inte råd med allt i kundvagnen.", UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 452), { ts = 13, color = UI.C.red, xa = Enum.TextXAlignment.Center }) end
end

local STATE = { vag = "På väg", framme = "Levererad – står vid garageporten", oppnad = "Öppnad", tom = "Uppackad" }
local countdowns = {}
local function buildOrders()
	UI.clear(left)
	UI.clear(main)
	countdowns = {}
	local list = UI.scroll(main, UDim2.fromScale(1, 1), nil, { name = "Ordrar" })
	UI.list(list, 8)
	local p = S.profile
	local n = 0
	for i = #p.orders, 1, -1 do
		local o = p.orders[i]
		n = n + 1
		local r = UI.new("Frame", { Size = UDim2.new(1, -10, 0, 96), BackgroundColor3 = WHITE, BorderSizePixel = 0, LayoutOrder = n, Name = "Order" .. o.id }, list)
		UI.corner(r, 10)
		UI.text(r, "Order #" .. o.id .. " · " .. UI.kr(o.total), UDim2.new(0.6, 0, 0, 24), UDim2.fromOffset(14, 8), { ts = 16, font = UI.BOLD, color = DARK })
		local names = {}
		for _, l in ipairs(o.lines) do names[#names + 1] = l.qty .. " × " .. Parts.get(l.sku).name end
		UI.text(r, table.concat(names, ", "), UDim2.new(1, -28, 0, 36), UDim2.fromOffset(14, 32), { ts = 13, color = MUTED, wrap = true, ya = Enum.TextYAlignment.Top })
		local st = UI.text(r, STATE[o.state] or o.state, UDim2.new(0.4, -14, 0, 24), UDim2.new(0.6, 0, 0, 8), { ts = 14, font = UI.BOLD, color = o.state == "vag" and UI.C.orange or UI.C.green, xa = Enum.TextXAlignment.Right })
		if o.state == "vag" then
			local _, fill = UI.bar(r, UDim2.new(1, -28, 0, 8), UDim2.fromOffset(14, 76), 0, BLUE)
			countdowns[#countdowns + 1] = { o = o, label = st, fill = fill }
		end
	end
	if n == 0 then UI.text(list, "Du har inga ordrar än.", UDim2.fromOffset(300, 40), nil, { ts = 16, color = MUTED }) end
end
local function buildJobs()
	UI.clear(left)
	UI.clear(main)
	local p = S.profile
	local list = UI.scroll(main, UDim2.fromScale(1, 1), nil, { name = "Uppdrag" })
	UI.list(list, 8)
	UI.text(list, "Pågående uppdrag", UDim2.new(1, 0, 0, 26), nil, { ts = 16, font = UI.BOLD, color = DARK, order = 0 })
	for i, j in ipairs(p.jobs) do
		local r = UI.new("Frame", { Size = UDim2.new(1, -10, 0, 70), BackgroundColor3 = Color3.fromRGB(255, 248, 225), BorderSizePixel = 0, LayoutOrder = i, Name = "Pågår" .. j.id }, list)
		UI.corner(r, 10)
		UI.text(r, j.n, UDim2.new(1, -240, 0, 24), UDim2.fromOffset(14, 8), { ts = 15, font = UI.BOLD, color = DARK, wrap = true })
		UI.text(r, "Betalning: " .. UI.kr(j.pay) .. (j.type == "bygg" and " + delarnas värde" or ""), UDim2.new(1, -240, 0, 20), UDim2.fromOffset(14, 38), { ts = 13, color = MUTED })
		if j.type ~= "leverans" then UI.button(r, "Lämna", UDim2.fromOffset(100, 32), UDim2.new(1, -218, 0, 19), { kind = "green", ts = 14 }, function() S.api("completeJob", j.id) end)
		else UI.text(r, "Kör till " .. require(Shared.Map).PLACES[j.dest].n, UDim2.fromOffset(200, 32), UDim2.new(1, -318, 0, 19), { ts = 13, color = DARK, xa = Enum.TextXAlignment.Right }) end
		UI.button(r, "Avbryt", UDim2.fromOffset(100, 32), UDim2.new(1, -110, 0, 19), { kind = "danger", ts = 14 }, function() S.api("cancelJob", j.id) end)
	end
	if #p.jobs == 0 then UI.text(list, "Inga just nu.", UDim2.new(1, 0, 0, 24), nil, { ts = 14, color = MUTED, order = 1 }) end
	UI.text(list, "Lediga uppdrag", UDim2.new(1, 0, 0, 30), nil, { ts = 16, font = UI.BOLD, color = DARK, order = 10 })
	for i, o in ipairs(Profile.offers(p)) do
		local r = UI.new("Frame", { Size = UDim2.new(1, -10, 0, 86), BackgroundColor3 = WHITE, BorderSizePixel = 0, LayoutOrder = 10 + i, Name = "Erbjudande" .. i }, list)
		UI.corner(r, 10)
		UI.text(r, o.n, UDim2.new(1, -160, 0, 24), UDim2.fromOffset(14, 8), { ts = 15, font = UI.BOLD, color = DARK })
		UI.text(r, o.about, UDim2.new(1, -160, 0, 34), UDim2.fromOffset(14, 32), { ts = 12, color = MUTED, wrap = true, ya = Enum.TextYAlignment.Top })
		UI.text(r, UI.kr(o.pay), UDim2.fromOffset(120, 24), UDim2.new(1, -134, 0, 8), { ts = 17, font = UI.BOLD, color = UI.C.green, xa = Enum.TextXAlignment.Right })
		UI.button(r, "Ta uppdraget", UDim2.fromOffset(120, 32), UDim2.new(1, -134, 0, 44), { kind = "primary", ts = 14 }, function() if S.api("acceptJob", o.key) then S.toast("Uppdrag accepterat", "ok") end end)
	end
end

function W.refresh()
	if not gui.Enabled or not S.profile then return end
	UI.clear(tabBar)
	for i, t in ipairs({ { "butik", "Butik" }, { "ordrar", "Mina ordrar" }, { "uppdrag", "Uppdrag" }, { "kundvagn", "Kundvagn (" .. cartCount() .. ")" } }) do
		UI.button(tabBar, t[2], UDim2.fromOffset(t[1] == "kundvagn" and 120 or 96, 36), nil, { kind = (W.tab == t[1]) and "primary" or "secondary", ts = 14, order = i, name = t[1] }, function()
			if t[1] == "kundvagn" then W.tab = "butik" else W.tab = t[1] end
			W.product = nil
			W.refresh()
		end)
	end
	if W.tab == "butik" then buildShop() elseif W.tab == "ordrar" then buildOrders() else buildJobs() end
	buildCart()
end
search:GetPropertyChangedSignal("Text"):Connect(function()
	if W.search == search.Text then return end
	W.search = search.Text
	W.product = nil
	if W.tab ~= "butik" then W.tab = "butik" end
	W.refresh()
end)

RunService.Heartbeat:Connect(function()
	if not gui.Enabled then return end
	for _, c in ipairs(countdowns) do
		local o = c.o
		local left2 = o.ready - S.now()
		c.label.Text = left2 > 0 and ("På väg · " .. UI.time(left2) .. " kvar") or "Levereras nu..."
		c.fill.Size = UDim2.fromScale(math.clamp(1 - left2 / math.max(1, o.ready - o.placed), 0, 1), 1)
	end
end)

local function open(tab)
	if not S.setMode("shop") then return end
	W.tab = tab or "butik"
	W.product = nil
	local cf = S.origin() * GarageBuilder.COMPUTER
	S.camTo(cf * CFrame.new(0, 0.2, -4.2) * CFrame.Angles(0, math.pi, 0), 50, 0.5)
	gui.Enabled = true
	W.refresh()
end
S.open.Event:Connect(function(what, atStation)
	if what == "shop" and atStation then open("butik")
	elseif what == "jobs" and atStation then open("uppdrag") end
end)
S.modeEv.Event:Connect(function(mode) if mode ~= "shop" then gui.Enabled = false end end)
S.changed.Event:Connect(function() if gui.Enabled then W.refresh() end end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- Client state shared by all LocalScripts: the profile from the server, API calls, the current work mode,
-- toasts, camera and movement locking.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = RS:WaitForChild("Shared")
local Profile = require(Shared.Profile)
local Config = require(Shared.Config)
local remotes = RS:WaitForChild("Remotes")
local Api = remotes:WaitForChild("Api")
local plr = Players.LocalPlayer

local S = {}
S.profile = nil
S.meta = { now = 0, plot = nil, stock = {} }
S.mode = nil
S.changed = Instance.new("BindableEvent")
S.toastEv = Instance.new("BindableEvent")
S.modeEv = Instance.new("BindableEvent")
S.open = Instance.new("BindableEvent") -- open a window or work mode by name ("shop", "engine", "moped", ...)
S.tipEv = Instance.new("BindableEvent")
S.settings = { tips = true, minimap = true }
local clockOffset = 0

remotes:WaitForChild("State").OnClientEvent:Connect(function(p, meta)
	S.profile = p
	S.meta = meta or S.meta
	clockOffset = (meta and meta.now or 0) - os.clock()
	S.changed:Fire()
end)
remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text, kind) S.toastEv:Fire(text, kind) end)

function S.now() return os.clock() + clockOffset end
function S.tip(text) S.tipEv:Fire(text) end
-- walk to a point in my garage (garage-local Vector3), then call cb (also if already there)
function S.walkTo(localPos, cb, dist)
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) then return end
	local target = S.origin() * localPos
	if (root.Position - target).Magnitude <= (dist or 8) then cb(); return end
	hum:MoveTo(target)
	local done = false
	local conn
	conn = hum.MoveToFinished:Connect(function()
		if done then return end
		done = true
		conn:Disconnect()
		cb()
	end)
	task.delay(8, function()
		if not done then done = true; conn:Disconnect(); cb() end
	end)
end
function S.toast(text, kind) S.toastEv:Fire(text, kind or "info") end
-- call the server; shows the error as a toast; returns ok, result
function S.api(action, ...)
	local ok, a, b = pcall(function(...) return Api:InvokeServer(action, ...) end, ...)
	if not ok then
		S.toast("Ingen kontakt med servern", "error")
		return false
	end
	if not a and b then S.toast(b, "error") end
	return a, b
end

-- my garage
function S.plot()
	local i = S.meta.plot or plr:GetAttribute("Plot")
	local g = workspace:FindFirstChild("Garage")
	return i and g and g:FindFirstChild("Plot" .. i), i
end
function S.origin()
	local _, i = S.plot()
	return CFrame.new(Config.plotOrigin(i or 1), 0, 0)
end
function S.moped() local p = S.profile; return p and p.mopeds[p.cur] end
function S.item(id) return S.profile and S.profile.items[id] end
function S.perf(m)
	local p = S.profile
	if not p then return nil end
	return Profile.perf(p, m)
end

-- work modes: only one at a time; modes lock walking and may take over the camera
-- hide my own character and the E-prompts while working (the camera is close)
local function workView(on)
	pcall(function() game:GetService("ProximityPromptService").Enabled = not on end)
	local char = plr.Character
	if char then
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then d.LocalTransparencyModifier = on and 1 or 0 end
		end
	end
end
function S.setMode(name)
	if S.mode == name then return true end
	if S.mode then return false end
	S.mode = name
	workView(true)
	S.lockMove(true)
	S.modeEv:Fire(name)
	return true
end
function S.endMode(name)
	if name and S.mode ~= name then return end
	S.mode = nil
	workView(false)
	S.lockMove(false)
	S.camRelease()
	S.modeEv:Fire(nil)
end
local saved
function S.lockMove(on)
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if on then
		saved = saved or { hum.WalkSpeed, hum.JumpPower }
		hum.WalkSpeed = 0
		hum.JumpPower = 0
	elseif saved then
		hum.WalkSpeed, hum.JumpPower = saved[1], saved[2]
		saved = nil
	end
end
function S.camTo(cf, fov, t)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	if t and t > 0 then
		TweenService:Create(cam, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = cf, FieldOfView = fov or 60 }):Play()
	else
		cam.CFrame = cf
		cam.FieldOfView = fov or 60
	end
end
function S.camRelease()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 70
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then cam.CameraSubject = hum end
end
-- is a world object part of my own plot?
function S.isMine(inst)
	local plot = S.plot()
	return plot ~= nil and inst:IsDescendantOf(plot)
end

return S
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[-- Small UI toolkit: dark rounded panels, blue buttons, green money, product pictures in ViewportFrames.
-- Everything is designed for 1280x720 and scaled with UIScale on other screen sizes.
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local UI = {}

local function c3(t) return Color3.fromRGB(t[1], t[2], t[3]) end
UI.C = {}
for k, v in pairs(Config.UI) do UI.C[k] = c3(v) end
UI.FONT = Enum.Font.GothamMedium
UI.BOLD = Enum.Font.GothamBold
UI.BLACK = Enum.Font.GothamBlack

function UI.new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
function UI.corner(o, r) return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
function UI.stroke(o, color, thick, transp)
	return UI.new("UIStroke", { Color = color or UI.C.line, Thickness = thick or 1, Transparency = transp or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
function UI.pad(o, l, r, t, b)
	return UI.new("UIPadding", { PaddingLeft = UDim.new(0, l or 8), PaddingRight = UDim.new(0, r or l or 8), PaddingTop = UDim.new(0, t or l or 8), PaddingBottom = UDim.new(0, b or t or l or 8) }, o)
end
function UI.list(o, padding, horizontal, align)
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, padding or 6), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = horizontal and Enum.VerticalAlignment.Center or Enum.VerticalAlignment.Top,
	}, o)
end
function UI.grid(o, cell, gap)
	return UI.new("UIGridLayout", { CellSize = cell, CellPadding = gap or UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, o)
end

-- a ScreenGui that scales with the screen
function UI.screen(name, order, player)
	local gui = UI.new("ScreenGui", { Name = name, ResetOnSpawn = false, DisplayOrder = order or 0, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = false })
	local scale = UI.new("UIScale", {}, gui)
	local function fit()
		local cam = workspace.CurrentCamera
		local v = cam and cam.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(v.X / 1280, (v.Y - 58) / 662), 0.7, 1.6)
	end
	fit()
	if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit) end
	gui.Parent = player:WaitForChild("PlayerGui")
	return gui
end

function UI.panel(parent, size, pos, opts)
	opts = opts or {}
	local f = UI.new("Frame", {
		Size = size, Position = pos or UDim2.new(), AnchorPoint = opts.anchor or Vector2.new(0, 0),
		BackgroundColor3 = opts.color or UI.C.panel, BackgroundTransparency = opts.transp or 0.08, BorderSizePixel = 0,
		Name = opts.name or "Panel", ZIndex = opts.z or 1, Visible = opts.visible ~= false, ClipsDescendants = opts.clip or false,
	}, parent)
	UI.corner(f, opts.radius or 10)
	if opts.stroke ~= false then UI.stroke(f, UI.C.line, 1, 0.4) end
	return f
end
function UI.text(parent, text, size, pos, opts)
	opts = opts or {}
	local l = UI.new("TextLabel", {
		Size = size, Position = pos or UDim2.new(), AnchorPoint = opts.anchor or Vector2.new(0, 0), BackgroundTransparency = 1,
		Text = text, TextColor3 = opts.color or UI.C.text, TextSize = opts.ts or 16, Font = opts.font or UI.FONT,
		TextXAlignment = opts.xa or Enum.TextXAlignment.Left, TextYAlignment = opts.ya or Enum.TextYAlignment.Center,
		TextWrapped = opts.wrap or false, RichText = opts.rich or false, Name = opts.name or "Text", ZIndex = opts.z or 1,
		LayoutOrder = opts.order or 0, TextTruncate = opts.truncate and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None,
	}, parent)
	if opts.scaled then l.TextScaled = true end
	return l
end
local KINDS = {
	primary = { bg = "accent", fg = "text" }, secondary = { bg = "panel2", fg = "text" }, green = { bg = "green", fg = "text" },
	danger = { bg = "red", fg = "text" }, ghost = { bg = "panel", fg = "text" }, yellow = { bg = "yellow", fg = "panel" },
}
function UI.button(parent, text, size, pos, opts, onClick)
	opts = opts or {}
	local k = KINDS[opts.kind or "primary"]
	local b = UI.new("TextButton", {
		Size = size, Position = pos or UDim2.new(), AnchorPoint = opts.anchor or Vector2.new(0, 0),
		BackgroundColor3 = UI.C[k.bg], BackgroundTransparency = opts.transp or 0, BorderSizePixel = 0, AutoButtonColor = true,
		Text = text, TextColor3 = UI.C[k.fg], TextSize = opts.ts or 16, Font = opts.font or UI.BOLD, Name = opts.name or text,
		TextXAlignment = opts.xa or Enum.TextXAlignment.Center, ZIndex = opts.z or 1, LayoutOrder = opts.order or 0,
	}, parent)
	UI.corner(b, opts.radius or 8)
	if opts.xa == Enum.TextXAlignment.Left then UI.pad(b, 12, 8, 0, 0) end
	if onClick then b.Activated:Connect(onClick) end
	return b
end
function UI.setKind(b, kind)
	local k = KINDS[kind]
	b.BackgroundColor3 = UI.C[k.bg]
	b.TextColor3 = UI.C[k.fg]
end
function UI.scroll(parent, size, pos, opts)
	opts = opts or {}
	local s = UI.new("ScrollingFrame", {
		Size = size, Position = pos or UDim2.new(), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 6, ScrollBarImageColor3 = UI.C.dim, CanvasSize = UDim2.new(), AutomaticCanvasSize = opts.horizontal and Enum.AutomaticSize.X or Enum.AutomaticSize.Y,
		ScrollingDirection = opts.horizontal and Enum.ScrollingDirection.X or Enum.ScrollingDirection.Y, Name = opts.name or "Scroll", ZIndex = opts.z or 1,
	}, parent)
	return s
end
function UI.clear(o)
	for _, c in ipairs(o:GetChildren()) do
		if not (c:IsA("UIListLayout") or c:IsA("UIGridLayout") or c:IsA("UIPadding") or c:IsA("UICorner") or c:IsA("UIStroke") or c:IsA("UIScale")) then c:Destroy() end
	end
end

-- "125 750 kr"
function UI.kr(n)
	n = math.floor((n or 0) + 0.5)
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse():gsub("^ ", "")
	return (n < 0 and "-" or "") .. out .. " kr"
end
function UI.time(sec)
	sec = math.max(0, math.floor(sec + 0.5))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

-- product picture: a model in a ViewportFrame, framed by its bounding box
function UI.viewport(parent, model, size, pos, opts)
	opts = opts or {}
	local vf = UI.new("ViewportFrame", {
		Size = size, Position = pos or UDim2.new(), BackgroundColor3 = opts.bg or Color3.fromRGB(235, 237, 240), BackgroundTransparency = opts.bgT or 0,
		Ambient = Color3.fromRGB(170, 170, 175), LightColor = Color3.fromRGB(255, 250, 240), LightDirection = Vector3.new(-1, -1.4, -0.8),
		BorderSizePixel = 0, Name = "Bild", ZIndex = opts.z or 1, LayoutOrder = opts.order or 0,
	}, parent)
	UI.corner(vf, opts.radius or 8)
	model.Parent = vf
	local cf, sz = model:GetBoundingBox()
	local cam = UI.new("Camera", { FieldOfView = 30 }, vf)
	local r = sz.Magnitude / 2
	local dist = r / math.tan(math.rad(15)) * (opts.zoom or 1.05)
	local dir = (opts.dir or Vector3.new(-1, 0.65, -1.2)).Unit
	cam.CFrame = CFrame.lookAt(cf.Position + dir * dist, cf.Position)
	vf.CurrentCamera = cam
	return vf, cam
end

-- tween helper
function UI.tween(o, t, props, style)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- header bar with a title and a close button (used by every big window)
function UI.header(parent, title, onClose)
	local bar = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = UI.C.panel2, BorderSizePixel = 0, Name = "Rubrik" }, parent)
	UI.corner(bar, 10)
	UI.text(bar, title, UDim2.new(1, -60, 1, 0), UDim2.fromOffset(16, 0), { font = UI.BOLD, ts = 18, name = "Titel" })
	if onClose then
		UI.button(bar, "X", UDim2.fromOffset(32, 32), UDim2.new(1, -38, 0, 6), { kind = "secondary", name = "Stäng" }, onClose)
	end
	return bar
end

-- check mark row: "✓ Vevhus"
function UI.check(parent, text, done, order, active)
	local row = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = active and UI.C.accent or UI.C.panel2, BackgroundTransparency = active and 0.2 or 1, BorderSizePixel = 0, LayoutOrder = order or 0, Name = text }, parent)
	UI.corner(row, 6)
	UI.text(row, text, UDim2.new(1, -36, 1, 0), UDim2.fromOffset(10, 0), { ts = 14, color = done and UI.C.text or UI.C.dim, font = active and UI.BOLD or UI.FONT })
	local box = UI.new("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -26, 0.5, -9), BackgroundColor3 = done and UI.C.green or UI.C.panel, BorderSizePixel = 0, Name = "Bock" }, row)
	UI.corner(box, 4)
	if done then UI.text(box, "✓", UDim2.fromScale(1, 1), nil, { xa = Enum.TextXAlignment.Center, font = UI.BOLD, ts = 14 }) else UI.stroke(box, UI.C.line, 1, 0) end
	return row
end

-- a horizontal bar 0..1
function UI.bar(parent, size, pos, value, color)
	local bg = UI.new("Frame", { Size = size, Position = pos or UDim2.new(), BackgroundColor3 = UI.C.panel2, BorderSizePixel = 0, Name = "Stapel" }, parent)
	UI.corner(bg, 4)
	local fill = UI.new("Frame", { Size = UDim2.fromScale(math.clamp(value or 0, 0, 1), 1), BackgroundColor3 = color or UI.C.green, BorderSizePixel = 0, Name = "Fyllning" }, bg)
	UI.corner(fill, 4)
	return bg, fill
end

return UI
]]></ProtectedString></Properties></Item>
